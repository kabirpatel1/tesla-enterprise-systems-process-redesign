				</cbs-ref>
				<cbs-ref Ref="BE7741D52E4541D0919217B9105587DA" ID="9F38E63538A846BABFA9C8C79C8B7060" OriginalMap="Automotive - Sales &amp; Service Organizations: Credit Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E5E3915523C041318D36C59BA7D40B3D">
					<title>Credit Management</title>
				</cbs-ref>
				<process ID="8B2E639DC2BD489CACDBD5E723B2D969" OriginalMap="Automotive - Sales &amp; Service Organizations: Electronic Bill Presentment and Payment" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="26621CF9BDD740DBA071D9806F3114C1">
					<title>Electronic Bill Presentment and Payment</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="C336F251A4354DC49EB2BD25B25DC561" ID="5BCB641057BB40E8A2F92E9A3D21BBB0" type="SAP" key="S8" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D2DBE6BB265C43C99961FE9C99428D95">
						<title>SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt.</title>
					</product-ref>
					<process-ref Ref="25E8251BAC7144ADB54A2CC7B08CD730" ID="DEA04687A6B0408992B72EF5D1B5C954" variantOf="B4F85D50F05043EFB1B4DD4F9CC98F54" OriginalMap="Automotive - Sales &amp; Service Organizations: FI-AR: Electronic Bill Presentment and Payment" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5AB4630223E94F06831F6BF4E4F761DE">
						<title>FI-AR: Electronic Bill Presentment and Payment</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="6797271F3B47481CA145D3DE8662BE71" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="65FB0D4353FF49F581243A4D0E295761">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Present invoices and
account information to your customers or suppliers. Provide
self-service functions via the internet.</p>
					</short-description>
				</process>
				<process ID="FD432400D85547BE9200B5AF4D173966" OriginalMap="Automotive - Sales &amp; Service Organizations: Collections Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5A83824119204D74A1B3AB28F1216FB3">
					<title>Collections Management</title>
					<product-ref Ref="C336F251A4354DC49EB2BD25B25DC561" ID="5625CE40051747A7A72E727EF51A0AB1" type="SAP" key="S8" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A53B576EFBC34EF58E1524352E229C52">
						<title>SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt.</title>
					</product-ref>
					<sap-cover>1</sap-cover>
					<process-ref Ref="62A1113A399C4D8CAC905D054133DDD2" ID="DBC9DD63043440359577D14B28D2E4C1" variantOf="192BC82C266C46DFB6F43BCC7415222A" OriginalMap="Automotive - Sales &amp; Service Organizations: FI-AR: Collections Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="536DF7C85A4E4CF79E4F98ECD293163D">
						<title>FI-AR: Collections Management</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="BA474D869D264B61A37D30C31FBA95C9" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="65D9C3244E584092AFDDC207A6B93EC1">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Includes payment
reminders, processing of promise-to-pay agreements, collection
agent portal, collection strategies, collection controlling, and
dunning.</p>
					</short-description>
				</process>
				<business-objective-ref Ref="5BB5265DB86E445CAB73BFBB7D826693" ID="39E8D35D84464293BD5A5CCAC5A7FCEF" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve collections, reduce receivables" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D2DB2AFF500649A3BBB04E72EA2E5BCA">
					<title>Improve collections, reduce receivables</title>
				</business-objective-ref>
				<business-objective-ref Ref="AE3EC19E70C14287B54868E7E30CE89B" ID="6F47E1ED28AA4E6FB9126392AF7E57D6" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve procurement processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8EDC2964AB804557B53EFAD1C2BFC25C">
					<title>Improve procurement processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="34C4C771C8EE4DD1BBE3018A55729900" ID="43F3FC574E184230BB5C08481A5A34DD" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce transaction costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="91C749FAF27B4483BB4E1B241259953F">
					<title>Reduce transaction costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="B25BD3ECF2F0465D8C923200AFADC18C" ID="E62685FEF19346B1B23F1FE16FE4316F" OriginalMap="Automotive - Sales &amp; Service Organizations: Lower communications expenses" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D545700989164808AA2E0C23EA580D6C">
					<title>Lower communications expenses</title>
				</business-objective-ref>
				<business-objective-ref Ref="6AB711814CF1406C867710E536A461DB" ID="AD852F690A424663B71211217BA914D9" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve cash management, minimize borrowing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="624705B034DF457BB468EF58F7002EC7">
					<title>Improve cash management, minimize borrowing</title>
				</business-objective-ref>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="18C2F893CF8E4FE4B21A692696A57E09" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce administration, improve business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B8FDB05143924711AF93E7B6B67F6CD4">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Financial supply chain
management enables collaboration within enterprises - and within
their business networks - by using defined business policies and
shared services to handle all customer-related and supply
chain-related financial processes. Financial supply chain
management also helps automate the financial supply chain by using
the Web and other electronic service models.</p>
				</short-description>
				<process ID="ED5DEC41050E4AEA9656F6A0185886B6" OriginalMap="Automotive - Sales &amp; Service Organizations: Credit Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6DB3DEDF20B646E2B939B4C40A5C8E0F">
					<title>Credit Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="C336F251A4354DC49EB2BD25B25DC561" ID="65EE4D82648A4B3EA6D4A8597F62819F" type="SAP" key="S8" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7A80A2E5352D488B920ED9D9AD67FC91">
						<title>SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt.</title>
					</product-ref>
					<process-ref Ref="290CB9B0B4F34214BDB6A752AA325EC0" ID="67C90865945C49D5AEECC5929F796FF3" variantOf="970D3892748746C0B52603CC2ABCDED2" OriginalMap="Automotive - Sales &amp; Service Organizations: FI-AR: Credit Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C8A35F35ADBC42E3B307C6473A9660BD">
						<title>FI-AR: Credit Management</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="775F2BC2975845149A8AB6E66181D12A" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B6E12FF4BB764C34B650E520ACFFD29E">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Manages credit limits
offered to customers. Analyzes credit information using both
external and internal information to accurately adapt customer
scoring.</p>
					</short-description>
				</process>
				<process ID="767335195EBF4FFB9C28B9D023330D90" OriginalMap="Automotive - Sales &amp; Service Organizations: Dispute Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="00FA88D375B846B99FE6D1AB63E95CF7">
					<title>Dispute Management</title>
					<sap-cover>1</sap-cover>
