						<title>Incentive Processing in ERP</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="5964BD4DAE884FB6AA250FE4A07A27F8" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E6884F2C8D2647F1B41710BC29C412B8">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>You use Incentive Processing to manage your transactional data and
carry out your commission calculations. The process steps are
executed automatically by the ICM system.</short-description>
				</process>
