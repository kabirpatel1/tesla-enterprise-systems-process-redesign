						<title>SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt.</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="EFC58D2EC6CE47E795F4D4A82D20F9B6" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="83B0169563D2418D87DC3889B182AFC6">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Uses dispute management
processes to accelerate information gathering and problem
assessment . Manages all communication electronically.</p>
					</short-description>
					<process-ref Ref="498C51F1C4EE4B40BC47231A982E3EC1" ID="979F06E8E6E64ACC9A6A5BAF343A3EF2" variantOf="C984EFB7DC48443482EA224F3C974986" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: FI-AR: Dispute Resolution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6E9E29A8CCAB4C7FA93255FAA1C0B240">
						<title>FI-AR: Dispute Resolution</title>
					</process-ref>
				</process>
