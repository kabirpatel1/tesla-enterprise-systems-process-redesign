				</process-ref>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="6F17534A226F454397132F4C5153E290" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3FB673C8EDD34AE88DB5C79FBA4C3D5A">
					<title>SAP ERP</title>
				</product-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">At end-of-lease (EOL) the contract is terminated with or without return of the equipment and a conclusion fee may be applied or not. If the equipment is not returned, the lessor is compensated. Returns management and contract status update is triggered.</P>
				</short-description>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="268CED8B5DDD4819B144B3D9DED692C3" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="35E8E363873E43DEA603972AC4CE8555">
