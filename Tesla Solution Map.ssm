						<title>Debit Memo Processing in ERP</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Records and manages
customer accounting data via the Accounts Receivable (AR)
component. Connects AR directly to the G/L using a special
reconciliation account.</p>
					</short-description>
					<process-ref Ref="62A1113A399C4D8CAC905D054133DDD2" ID="BDAC360D5AF54E6A9B9FF11BF83B3109" variantOf="192BC82C266C46DFB6F43BCC7415222A" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: FI-AR: Collections Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="00758CA915024FA4B84771D02A62C76D">
