			</business-objective-ref>
			<process ID="09C24A909FCC40799A7EB39DF455726F" businessArea="Marketing" responsibleOrgUnit="BSG M" runningNumber="CPF 045" variantOf="3298B907A08944F6BCBCEA28F0936E19" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Execution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BBE765D1560847968BA900E9FE409E9B">
				<title>Trade Promotion Execution</title>
				<bpr-element-ref ID="07FECA20AF1B42FBA84AB42A92940E87" Ref="urn:bprid#3298B907A08944F6BCBCEA28F0936E19" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Execution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="664938CE41FA4813B59CCAE9B8E3C2F0">
					<title>Trade Promotion Execution</title>
				</bpr-element-ref>
				<content><![CDATA[The customer place products orders. The manufacturer's system apply pricing conditions to each order, shipment and invoice to ensure that funds are being transferred at the appropriate time. The customer receives promotion discounts in support of the display, feature and reduced-price activity. Many of the payments made to the customer are based on fixed-fund commitments. As shipments are made, the balance within these accounts remains whole until the account manager releases the payment upon receiving validation of the performance. Payments need to be made and accepted via check, credit memo, invoice deduction or other method.]]></content>
				<short-description>The field sales representative receives the promotion plan from the account manager and plans presales store visits. During these visits, the field sales rep presents the promotions to the store manager or other decision maker and attempts to sell additional floor stack and sales collateral to support the promotion.</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="EADABF36BCDB4A908C72E1A14BC013E4" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="664EDDA79B134D1C8DE1E5EEA3104269">
					<title>SAP ERP</title>
				</product-ref>
				<sap-cover>1</sap-cover>
				<process-ref Ref="9310B108E82240348397EF57DBA83853" ID="3C3C748D43954266B621A86470407F3B" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Execution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D6AC5413475D4920A2EC6CD776C6A2A6">
					<title>Trade Promotion Execution</title>
				</process-ref>
				<process-ref Ref="3298B907A08944F6BCBCEA28F0936E19" ID="DD002654C12D4A3BA6EBE746D93085BF" variantOf="3298B907A08944F6BCBCEA28F0936E19" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Execution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="39B3359E39C646F7B4072729DC16FC80">
					<title>Trade Promotion Execution</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="32C9111D944B4D9396C2D946F5448C13" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="40556BE90A6C485597655D7DEE7CCDE2">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="25CA8353395D4C30BC2DCDDF65B81F02" businessArea="Sales" responsibleOrgUnit="CRM" runningNumber="CRM 013" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="087DA6C91818443C91EA2585FBFD9DA7">
				<sap-cover>1</sap-cover>
				<title>Billing</title>
				<bpr-element-ref ID="6040F00E3D9543D496C78738220B0092" Ref="urn:bprid#27E7DB71E4894B719F259DEB40F5B455" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B5AB87A5E654437EA78C64F2CB2E1EDF">
					<title>Billing</title>
				</bpr-element-ref>
				<product-ref ID="EFD3B7783CBA4CD38115723B786355FC" Ref="999E64EA02ED4FD18A0BD49DFC180254" key="S12" type="SAP" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FBD51B5B48F746DE9B29924F4AB76803">
					<title>SAP ERP</title>
				</product-ref>
				<content>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process in order to create customer invoices in SAP CRM. Here, one or more than one billing due list item is copied into a billing document. You can either create the billing document with reference to the delivery, or to the sales order. It is also possible to create billing documents with reference to contracts. You make the necessary setting in Customizing. The following describes delivery-related billing.</P>
				</content>
				<product-ref Ref="BC192F4F7D5145DABCF5FCB9234BC1CD" ID="8397F848640A4E6BA21B3E1825175ABB" type="SAP" key="SAP Service Management (SAP CRM)" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Management (SAP CRM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="94A69CE201DB4CF3914634D6FEF88B7D">
					<title>SAP Service Management (SAP CRM)</title>
				</product-ref>
				<product-ref Ref="D672C3E0DEE24F3D9EE9A70A2FA771DE" ID="1CCE0145AD9143EDB08FB156F08E473A" type="SAP" key="SAP Sales Management (SAP CRM)" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Sales Management (SAP CRM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="945F5A3A8A43478EB5141E233110D266">
					<title>SAP Sales Management (SAP CRM)</title>
				</product-ref>
				<product-ref Ref="BEC0B6B9C9DE4597B6C8C1336EFD574E" ID="AB2BCF11D2E54D759D8370C7AA90A632" type="SAP" key="SAP Marketing (SAP CRM)" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Marketing (SAP CRM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6A040306EFA94E39A0641E18F6F1A412">
					<title>SAP Marketing (SAP CRM)</title>
				</product-ref>
