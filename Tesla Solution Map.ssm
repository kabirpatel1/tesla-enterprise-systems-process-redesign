					</hyperlink>
					<hyperlink ID="B8A6D94A7E5C400FAB3021163E920F30" openInSeparateBrowser="true" href="http://download.sap.com/SMIGlobal/download.epd?context=0421CFE45BF1B71A5591FF83FCBA3E2F5E866CA718342AEF8644364E6763174B706D2FB2C4136F67A2B9CD0D108CC7845A59B75FB9630A63" OriginalMap="Automotive - Sales &amp; Service Organizations: Case Study: China Merchants Bank" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2D587225EF8443BFBDDAEA664C0B4762">
						<title>Case Study: China Merchants Bank</title>
					</hyperlink>
					<hyperlink ID="4E0F8574577944B6AAB3D1E623225CED" href="http://download.sap.com/SMIGlobal/download.epd?context=C8BD6B216F8A9EACBD905236707BB29DBF08DC5EC6ECF7334DCAF3E1D4B51D70B143EC1746B12BC4A476A5081333612B637FE864353932AD" OriginalMap="Automotive - Sales &amp; Service Organizations: IDC Case Study: SAP HCM at Autostrade" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="18E7DFB729D14DDF92E3FABBCCAEB598">
						<title>IDC Case Study: SAP HCM at Autostrade</title>
					</hyperlink>
					<hyperlink ID="CAA37702DE484386811250701A66E9AD" href="http://download.sap.com/SMIGlobal/download.epd?context=6A6E660116DEBC6A1487DB3E88E356935BA6193D594E02639C00F548F927694B6D7B70B3AC35A58B2C45FF7D78436DB1F4EA7074206E22B3" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Case Study: SAP ERP at Shanghai Power" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="83C5AF1F2A7C457EA415569F72991C7C">
						<title>SAP Case Study: SAP ERP at Shanghai Power</title>
					</hyperlink>
					<hyperlink ID="9A7C55B0B55A4A7095CBFB2A9F9D1CDF" href="http://download.sap.com/download.epd?context=870C1C7723AD1A579D64AF19774A42458548EEF16DBCBE5FDC1A0FD040E4E4CC019F4494B86ED251EE270E08F7FB48C9AE79B4BA9CFF1A26" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Case Study: Nagano Healthcare" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="95995407223540C28310AB90780004CB">
						<title>SAP Case Study: Nagano Healthcare</title>
					</hyperlink>
					<hyperlink ID="7C726F59B13648AFB1C5D3C367DDE3F7" openInSeparateBrowser="true" href="http://download.sap.com/SMIGlobal/download.epd?context=BFA5B3E66EDF98E664516A8A9E4799CCC33FA783059AD63E67DA7D6DF43B82A50F019DDD789CAE508A83D923654C6C1791289C9793F7601A" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Carolina Turkeys" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1D7EB292A10E448184DC49AB2C7AC42A">
						<title>Success Story: Carolina Turkeys</title>
					</hyperlink>
					<hyperlink ID="90F34447BEA74AAF9185F45989358919" href="http://download.sap.com/download.epd?context=38DF8EB00D68AEC32E665A9F8013FC15A87533B6CE08D8E952C495CC45F10ED3868AD14237F5C8F79146491D57D7E49A6663327D33E3FE3D" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Volkswagen AG" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1D054A4D99FF4BF2A79DA4EF8CE1B4A8">
						<title>Success Story: Volkswagen AG</title>
					</hyperlink>
					<hyperlink ID="C2B6F166468F4E9999DD0C36C4503C4C" href="http://download.sap.com/download.epd?context=A180B76BDEA78B6813B3E58E664EBCB90CF49F512074955878D75F747BD8C070B552826CB552953F046A4C85314E952387CCD297C620AFD7" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Canada Post" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A58DF011CDD84C00A4BED0F9E3B280BC">
						<title>Success Story: Canada Post</title>
					</hyperlink>
					<hyperlink ID="9E2649E6A32D454DBCF5F2CCFE052546" href="http://download.sap.com/SMIGlobal/download.epd?context=E29793E14A6C7D26F5CF63AE28AD95167A7C22501423186F938AEC68FC838C6BDF6BA1031339451CA8DA1A4F7C017A0BEB03E449E143612F" OriginalMap="Automotive - Sales &amp; Service Organizations: Reference Slide: SAB Ltd." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A02917D06FC244559ED30D4D0AC126C9">
						<title>Reference Slide: SAB Ltd.</title>
					</hyperlink>
				</folder>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Through its dynamic
workforce process management capabilities, SAP ERP Human Capital
Management (SAP ERP HCM) can streamline and integrate essential
workforce processes such as employee administration, payroll, time
management, and legal reporting. Because it is a single, scalable
solution, it lets you deliver better service for lower IT costs
(costs that escalate in proportion to the number of systems you are
attempting to maintain). Built on a global platform customized for
legal compliance and best practices in 47 countries (with many
other countries delivered by partners using standard SAP tools,
programs, and master data to ensure seamless integration of
employee and payroll processes), SAP ERP HCM enables companies to
standardize and consolidate all workforce-related processes and
data onto one platform, yet ensure that adherence to local
regulations and laws can be attained.  With SAP ERP HCM,
companies can operate in local languages, currencies, best
practices, and regulatory requirements in their facilities around
the world. In short, SAP ERP HCM delivers the tools you need to
make your HR department run smoothly and efficiently today and
tomorrow. It frees you to be more productive and responsive, to
spend more time and energy on activities that generate real ROI and
make your enterprise more competitive.</p>
				</short-description>
				<folder ID="6229081A045B4F09A3901434D21ACF00" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Roles" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EF2AD3C8D21C4958B1753EBCC642E892">
					<title>SAP Roles</title>
					<hyperlink ID="81E49A401AFC4207849932CFCAA00B35" href="javascript:smnavigate('16BABE6440C64A9C84D0FE50E42482CA')" Ref="16BABE6440C64A9C84D0FE50E42482CA" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role HR Administrator" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A0406C55C3BC4BFA9DD781B68F58D2F2">
						<title>SAP Role HR Administrator</title>
					</hyperlink>
					<hyperlink ID="4374D35831434893BAB7A782386D6623" href="javascript:smnavigate('8410FD81648045EE852E5D22C83243D3')" Ref="8410FD81648045EE852E5D22C83243D3" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Employee Self-Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D85368D4E2FD4EC0BE0AB86C22B80804">
						<title>SAP Role Employee Self-Service</title>
					</hyperlink>
					<hyperlink ID="869FCD74C49E4A3F8E2F3723C9825CE6" href="javascript:smnavigate('0D5D747D76F3434FBB763B0F09172B6E')" Ref="0D5D747D76F3434FBB763B0F09172B6E" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Manager Self-Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DC4AA1F5B53E48BFB5410AAAF02AA17D">
						<title>SAP Role Manager Self-Service</title>
					</hyperlink>
				</folder>
			</level1-item>
			<level1-item ID="0C08D9D7121843C1A0C4E8B570D6E6A8" OriginalMap="Automotive - Sales &amp; Service Organizations: Workforce Deployment" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3145B005BB104B5196584D70E66CDEB2">
				<title>Workforce Deployment</title>
				<process ID="F1BB672634FB4C8AB1423A01B8A50B8C" OriginalMap="Automotive - Sales &amp; Service Organizations: Project Resource Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="24C4BF68E042408B9F3B0A76F92C508F">
					<title>Project Resource Planning</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="F800D6FDF26C4B35B4613144A32F9048" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7EC7389F3EFA4BA3988F16E91A9F80BD">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Offers Project Resource
Planning, a Workforce Scheduling Application designed for
Professional Service Organizations (IT, Legal, Training, etc.) and
dealing mainly with deployment issues. Utilizes resources more
efficiently to fit organizational needs and lets users assign
workers to appropriate jobs, projects and teams.</p>
					</short-description>
					<product-ref Ref="1F196FA5333149BE88F6C580C9AFC74C" ID="5E2F80CAB05D441A838498034D28FDD0" type="SAP" key="SAP Workforce Deployment for Retail and Wholesale Distribution" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Workforce Management for Retail and Wholesale Distribution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="ECA259E0BE5845FCB071290F09F9A3F4">
						<title>SAP Workforce Management for Retail and Wholesale Distribution</title>
					</product-ref>
					<product-ref Ref="BF1F02BB137540D1962A6707CE222EA5" ID="99587D44F8C74409ACDB218BAB3BA2A2" type="SAP" key="SAP Resource Management for Professional Services" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Resource Management for Professional Services" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="703C7956105647CBAEDB22E99097127B">
						<title>SAP Resource Management for Professional Services</title>
					</product-ref>
				</process>
				<process ID="277F628617F044E88DCA2F5DF29A6B93" OriginalMap="Automotive - Sales &amp; Service Organizations: Resource and Program Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9DB29D773A3F4D95BCFACF0928EAA599">
					<title>Resource and Program Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="AB91955290B6404CB85FD391585848BB" ID="126CDAE9E1A8408195FF461E536DFBE2" type="SAP" key="S70" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Resource and Portfolio Management (SAP RPM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E20A1A22E9374CDF85AA433C4FB4A2F3">
						<title>SAP Resource and Portfolio Management (SAP RPM)</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="0BC4D76A07FD47B29CD1B9FB9624FB41" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2BB1177B710441DE87394530B830A191">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Unifies project
management, time tracking, financial data, and employee skills
information in a portfolio management paradigm via SAP xApp
Resource and Program Management (SAP xRPM). Provides resource
management, project portfolio management, project execution, and
skills management. Serves as an integral contributor to workforce
deployment solutions across other SAP solutions. Allows users to
create project teams based on skills and availability, monitor
progress on a project, track time, analyze results, and much
more.</p>
					</short-description>
					<product-ref Ref="BF1F02BB137540D1962A6707CE222EA5" ID="8F24D8567EAB484F8EE5EB05148BE65A" type="SAP" key="SAP Resource Management for Professional Services" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Resource Management for Professional Services" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F14A1119154240C7BA24464B64CD8CD5">
						<title>SAP Resource Management for Professional Services</title>
					</product-ref>
					<product-ref Ref="1F196FA5333149BE88F6C580C9AFC74C" ID="D80ADFEA373E4F84990C7DB04EE5325A" type="SAP" key="SAP Workforce Deployment for Retail and Wholesale Distribution" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Workforce Management for Retail and Wholesale Distribution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="68510E701C7D4170B05D7BFB904D8064">
						<title>SAP Workforce Management for Retail and Wholesale Distribution</title>
					</product-ref>
				</process>
				<process ID="AAF148530BC447ECA3E61FCFA9BEDF57" OriginalMap="Automotive - Sales &amp; Service Organizations: Retail Scheduling" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7104DD75C80B4FBB8BB5B29FC49D53AD">
					<title>Retail Scheduling</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Schedules retail staff
based on customer volume, shift schedules, and skills.</p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D23CFC86CDF145FE8FD644E9BF93A479" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0D687E8689EF479E8C41D3443440C56B">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="BF1F02BB137540D1962A6707CE222EA5" ID="25A078E9CEFB4EEAA456860FE176343A" type="SAP" key="SAP Resource Management for Professional Services" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Resource Management for Professional Services" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6D53EC24536148459110CC8CB1012CA7">
						<title>SAP Resource Management for Professional Services</title>
					</product-ref>
					<product-ref Ref="1F196FA5333149BE88F6C580C9AFC74C" ID="4988411D01D1426B89EBBB09FB31A6A3" type="SAP" key="SAP Workforce Deployment for Retail and Wholesale Distribution" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Workforce Management for Retail and Wholesale Distribution" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CE75D5D2CE3E4C7E9D04510D1AEDC937">
						<title>SAP Workforce Management for Retail and Wholesale Distribution</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="31A439EAE7C34693BCAFD08D9FE714C3" ID="EFDC393570FD47108AF91E60BC0BCE02" OriginalMap="Automotive - Sales &amp; Service Organizations: Re-deploy labor to higher value-added activities" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="49AC66923C4946858B4E254B9AB22243">
					<title>Re-deploy labor to higher value-added activities</title>
				</business-objective-ref>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="C75CC25D327246C79FE89AFFD353BBF0" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce administration, improve business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6F0F2A6B7A51435FA54636116589316C">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<folder ID="0BFFE07C51E24745B8792AB05B793711" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Collaterals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5406C0799641439590247DFB2592D6E0">
					<title>Value Collaterals</title>
					<hyperlink ID="35FC90A492BD49149EC9805BF9A8779A" href="http://download.sap.com/SMIGlobal/download.epd?context=E29793E14A6C7D26F5CF63AE28AD95167A7C22501423186F938AEC68FC838C6BDF6BA1031339451CA8DA1A4F7C017A0BEB03E449E143612F" OriginalMap="Automotive - Sales &amp; Service Organizations: Reference Slide: SAB Ltd." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D3F9E0B651B74E1A93B73CC9FDF228FF">
						<title>Reference Slide: SAB Ltd.</title>
					</hyperlink>
				</folder>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Lets SAP ERP HCM serve
as an integral contributor to workforce deployment solutions across
other solutions of the SAP Business Suite. Allows users to create
project teams based on skills and availability, monitor progress on
a project, track time, analyze results, and much more. Empowers
users to eliminate redundant or ineffective projects, increase
profitability through the smarter use of resources, and manage the
workforce as efficiently as possible. </p>
				</short-description>
			</level1-item>
			<folder ID="559BBC93368D49819EE05B700383C9F6" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Collateral" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="86F22987DBE04853A0DE8BBC81E18CD0">
				<title>Value Collateral</title>
				<hyperlink ID="E9BBF29EBD984FE38522D6E284377163" href="http://download.sap.com/SMIGlobal/download.epd?context=47C9AEAD29404910478025EC3783DC085FCA9FA3663976F97E17C0DDDC12C49E30F84D287473FBB3E923B64CDE51F4FBE9EBE10EB86D5E3A" OriginalMap="Automotive - Sales &amp; Service Organizations: Solution Overview: SAP ERP Human Capital Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5983A76B78AC4A9C9D008EB30F2A3C3E">
					<title>Solution Overview: SAP ERP Human Capital Management</title>
				</hyperlink>
				<hyperlink ID="EFF10C2F47D0459ABCD0BDB69EBFF38C" href="http://download.sap.com/download.epd?context=3E4B9002C5E177EBE625FC0D7FD2208C4DBE9CA6B009DAA084B3654442E0ECB4C6BE74B5E4CF3670E1D136EEC68BED98ABB41AE4EE33F5A6" OriginalMap="Automotive - Sales &amp; Service Organizations: Solution in detail: Tight Integration With Multiple Solutions" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="09F734E299E84E59B3D0F86F797266CC">
					<title>Solution in detail: Tight Integration With Multiple Solutions</title>
				</hyperlink>
				<hyperlink ID="08FF89F99F674C1BA120A0459D2B5777" href="http://download.sap.com/SMIGlobal/download.epd?context=E7B19D4252793FD0D9AA8AAB374757B915D1911C3A08225B460FBDFAB86F9E3ABE14B9FD349D760CFBC7422ABD7F08E31784942F7248704A" OriginalMap="Automotive - Sales &amp; Service Organizations: Top 10 Reasons to Choose SAP ERP Human Capital Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6477C89B29124B71824E917925BB8735">
					<title>Top 10 Reasons to Choose SAP ERP Human Capital Management</title>
				</hyperlink>
				<hyperlink ID="D2BEAA7514A84D67A05711557CA3AF69" href="http://download.sap.com/SMIGlobal/download.epd?context=A585D0224F926F234111A30435B9403E331BEE7423E6F5DEAE95D35217B6A67137234E0A21BD9EF4CFF3FAC68778A59C76D7668AEFD65C61" OriginalMap="Automotive - Sales &amp; Service Organizations: ASUG/SAP Benchmarking Study: How Top Organizations Drive Company Profits Efficiently" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8E76F2ACDB0D466F987B3316059A361D">
					<title>ASUG/SAP Benchmarking Study: How Top Organizations Drive Company Profits Efficiently</title>
				</hyperlink>
				<hyperlink ID="8AA496CE6C2444859726AE622B43119A" href="http://download.sap.com/SMIDE/download.epd?context=94BBD0CF9109DB66FF0C7024D1BA85C024D251A82B08AE80673C6EF1978200A8054FA1A224E75CCC162CA9FA1068BD94FEA609EFE5E10F57" OriginalMap="Automotive - Sales &amp; Service Organizations: Business Transformation Study: SAP ERP Upgrade" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EFB0B371EEA045C1BE23DC5D2B8AA780">
					<title>Business Transformation Study: SAP ERP Upgrade</title>
				</hyperlink>
				<hyperlink ID="DC4046B1C8B74911904283DEE9DB2D7A" href="http://download.sap.com/SMIGlobal/download.epd?context=D21E9474894DAA3304811C8F1349E9DEF52FBB7FD54F759B0290B0953971790598483B5A41D370760340FC744F384B2C4BE0AA5B3EA9D94E" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Statoil Upgrade to SAP ERP 6.0" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="934A4E55276B4EF9A75D42AC91D9C9A1">
					<title>Success Story: Statoil Upgrade to SAP ERP 6.0</title>
				</hyperlink>
				<hyperlink ID="B15363B2D07342CC97BEAE34BE03C70F" href="http://download.sap.com/SMIGlobal/download.epd?context=779FD584697886AFDA56F22F6450B3E7F581EE7075165D08B73AEF24D3840EABF46C15C959703F48B0EFF3A528D3152F3D31D96BC2E35FBE" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Philip Morris International SLO and Service Optimization" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EE5A9C75ED9A4FA49D53EFE34F6F752B">
					<title>Success Story: Philip Morris International SLO and Service Optimization</title>
				</hyperlink>
			</folder>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">To meet the demands of
today's knowledge-based economy, companies must maximize the
potential and productivity of their employees.  Maximizing the
investment in the organization’s human capital is crucial to
business success.  This requires transforming the human resource
(HR) function from an administration department into a strategic
contributor of human capital management (HCM) strategies.  HCM for
business means integrating employee processes and information with
business processes and strategies to drive business results. More
specifically, modern HR departments must:</p>
				<ul xmlns="http://www.w3.org/TR/REC-html40">
					<li>
						<div>Improve workforce
efficiency and productivity</div>
					</li>
					<li>
						<div>Deliver best-in-class
HR processes at the lowest possible cost</div>
					</li>
					<li>
						<div>Plan future workforce
needs and measure strategies</div>
					</li>
					<li>
						<div>Find the right talent
for today and develop the right talent for tomorrow</div>
					</li>
					<li>
						<div>Educate the workforce
to ensure each employee has the right skills to excel in their
jobs</div>
					</li>
					<li>
						<div>Align corporate
strategies with team and individual goals</div>
					</li>
				</ul>
				<p xmlns="http://www.w3.org/TR/REC-html40">Companies that have
robust tools to implement HCM strategies will be able to maximize
the contribution of their workforce. Those that will not find it
difficult to compete in today's dynamic marketplace. SAP ERP
Human Capital Management (SAP ERP HCM) is a comprehensive
solution that enables your professionals, executives, and line
managers to optimize your investment in your most important
resource:  your employees. </p>
			</short-description>
		</level0-item>
		<level0-item ID="3DEE825E17594CAA98847480C173CC56" OriginalMap="Automotive - Sales &amp; Service Organizations: Corporate Services" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="65BE3807636243F2B785CF5BB0BB8A28">
			<title>Corporate Services</title>
			<level1-item ID="C46995FDC6014DFCA9D934E5BCAC9802" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8BE2E3D16BEA4F319E425BF134DCFCC4">
				<title>Travel Management</title>
				<cbs-ref Ref="078DF2E1143B11D4B5CE006094B9DD6A" ID="AE147C018A9A453E9E711E885671FF4F" OriginalMap="Automotive - Sales &amp; Service Organizations: Employee Self Service: Travel &amp; Expense" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9ABDA1DACF3D43B9BBFC1886F60FF92A">
					<title>Employee Self Service: Travel &amp; Expense</title>
				</cbs-ref>
				<process ID="DC0F7C0BE13B4287BE5192F40EAB7410" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel Request and Pre-trip approval" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D47F81C751C644C7BCDE96FBB5A8A557">
					<title>Travel Request and Pre-trip approval</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="719BEEB2620E4CD8A954D20B43A0" ID="9AB615307AE946E4A93A9FA249C21FBC" variantOf="F954314B47F944DC917181EEF3C8E434" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel Request and Pre-trip approval" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1FECF915B8C04798A44C8D40D747FE22">
						<title>Travel Request and Pre-trip approval</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="F4E44A81A0504F14A427B7DAB3BF0E8B" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6DBB599C265844CB8F2D1C8F42A7FD07">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="344FE1DDFCEC464081D2A633C4A16430" ID="B0D5FC384F4744839BF0B8244BD23DC9" type="SAP" key="DUET" OriginalMap="Automotive - Sales &amp; Service Organizations: DUET" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F9F6F728CF51448AB85427E79F72A992">
						<title>DUET</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">Streamlines approval
processes with SAP Travel Management to reduce process costs to a
minimum. Sends data such as trip destination, purpose, estimated
cost, and preliminary distribution of costs to the approving
manager or his portal inbox automatically. Pays advances that the
traveler requested in this self-service scenario by cash, check, or
bank order automatically once the request has been approved. Uses
workflow conditions for automating approval, e.g., a maximum limit
for estimated costs.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Duet travel management allows users to requests travel within
the Outlook Calendar. Duet workflow routes travel requests, travel
plans and expense reports including associated travel budget
information to the approving manager’s Outlook Inbox. Approval
notifications are returned to the requester’s Outlook Inbox. In
addition, Duet makes the travel cost information available to the
SAP ERP application for expense reporting.</p>
					</content>
				</process>
				<process ID="4F099CD269584091B7D45C7C642BF5B5" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel Planning - Online Booking" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2BFA2C5D2591401B84718B3E63771B04">
					<title>Travel Planning - Online Booking</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="89A298DF89B944BC99A7FBECC429" ID="55E50FEFB32844038EC0A5C5829D79C0" variantOf="C0EB36F8CEAF4EA88AEAEAFE4445B13E" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel Planning / Online Booking" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9212F066B4ED460198E86C671D140FBD">
						<title>Travel Planning / Online Booking</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="FE3AEF5477F3407DA498BE3D7BCDB423" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3A06876FEE8641AB8B8477AE29B90EB4">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p style="MARGIN: 0cm 0cm 0pt; mso-layout-grid-align: none" xmlns="http://www.w3.org/TR/REC-html40">Enables business travelers
through a self-service scenario to book flights, hotels, cars,
country-specific rail options, and look up related information.
Performs online booking by connections to central reservation
systems such as Amadeus, Galileo and Sabre. In addition SAP
NetWeaver Exchange Infrastructure (SAP NetWeaver XI) allows direct
connections to hotel reservation systems, low cost carrier
consolidators and Deutsche Bahn (German rail). Supports
communication with travel agencies fully and makes it more
efficient. Cuts agency fees substantially for online bookings and
lets the agency concentrate on ticketing and strategic quality
assurance. A 100% data synchronization of bookings and, if
requested, profiles is supported too. </p>
					</content>
				</process>
				<process ID="017CC3B1D3764E3F8E68C73C0ED05426" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel and Expense Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F92ECF353C844686A44D6ED9834138DB">
					<title>Travel and Expense Management</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="3B0E7B6225B34995A107961B917F" ID="E719183745E84B0A83CF12A77329D643" variantOf="BACA4A0945DE4B3A931253CB3472B24C" OriginalMap="Automotive - Sales &amp; Service Organizations: Online Self Service for Travel Expenses" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="35CC32CFD97A4E7EAF15510FB3A5178D">
						<title>Online Self Service for Travel Expenses</title>
					</process-ref>
					<process-ref Ref="4AD858412FEA45B489A996ABA792" ID="C0E5517E076841B9A1CC13C35E7B4910" variantOf="BACA4A0945DE4B3A931253CB3472B24C" OriginalMap="Automotive - Sales &amp; Service Organizations: Mobile Self Service for Travel Expenses" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CCB58744788E41A886E86759E6FA76C1">
						<title>Mobile Self Service for Travel Expenses</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="5496187E43CE4E218AF9E6B838A63161" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="283589A068874777B83639C78E337E52">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">Supports the entire
business trip lifecycle - from online buying to expense
reimbursement and integration into SAP ERP Financials and SAP ERP
HCM via SAP Travel Management, a true end-to-end solution. Supports
receipts and per diems reimbursement, cost assignments, multiple
payment modes, etc., via Travel and Expense Management. Allows
sophisticated expense policy rules to be set up to meet national
tax, fiscal, and legal requirements. Offers a ready-to-run version
for eighteen countries with pre-configured settings based on legal
requirements, thereby accelerating implementation. Provides
flexible configuration parameters for easy adoption of further
company-specific or international statutory needs. Features credit
card clearing interfaces to the leading card providers for personal
cards, corporate cards, and lodged cards. Allows to set up control
procedures in order to comply with Sarbanes Oxley and IRS
requirements.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">In addition to the
online Travel and Expense Management solution SAP Travel Management
provides an offline solution, which enables travelers to record
their working hours and travel expenses offline based on SAP's time
management (CATS) and travel management applications via Mobile
Time &amp; Travel . Synchronizes data with the SAP systems using
the SAP Mobile Infrastructure. Integrates customers' mobile
employees with their main SAP systems - anytime, anywhere - to
increase employee efficiency, improve data quality, and streamline
business processes. Enables travelers on the road to access the
itinerary data transferred from the travel planning solution, and
create expense reports from these. To run Mobile Time &amp; Travel
the installation of SAP Mobile Infrastructure is needed on the
laptop. Please note that the business process "Mobile Self Service
for Travel Expenses" is not included in the SAP ERP shipment.</p>
					</content>
				</process>
				<process ID="3B434EF098D440F4801AD274D1F6FE78" OriginalMap="Automotive - Sales &amp; Service Organizations: Global Travel Policy Compliance" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="223487E4C3DF4D1C8A161E8B2CB79607">
					<title>Global Travel Policy Compliance</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Travel
Planning:</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Controls online booking
by corporate travel policy parameters, helping travel managers to
bundle travel volumes to preferred providers and negotiated fares.
Provides a better compliance with travel policy, which in turn
facilitates a better negotiation position for central travel
service procurement and has an immediate effect on direct
purchasing costs. </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Travel and
Expenses:</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Allows management to
implement effective travel policy strategies and easily control
travel budgets for the global enterprise or institution. Handles
trips to locations all over the world, and can also be used in many
countries throughout the world. Permits the international standard
version to be configured to meet country-specific requirements.
Offers ready-to-run country versions that already include the
specific national statutory and tax regulations.</p>
					</content>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="4B120B720167492AA9B29AE37338D3FD" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C29AC04E860946858C0C70BE3BF5A8B0">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="EB5638CCD78940CC8281E585ECF86237" OriginalMap="Automotive - Sales &amp; Service Organizations: Travel and Expense Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="01640A1FF7B14C13B7393A837436ACE5">
					<title>Travel and Expense Analytics</title>
					<sap-cover>1</sap-cover>
					<content>
						<P xmlns="http://www.w3.org/TR/REC-html40">Keeps all booking and expense data in one place so users can benefit from easy-to-use reporting tools and full data ownership. Provides exact reporting for total travel cost control and analytical exception monitoring. Renders volumes with travel service providers transparent making it easier for users to negotiate and procure travel services.</P>
					</content>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="ABCB39F83D3546169D47DB2F35E17213" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="64DE28D0F6A74AC2BEE2EE7E6FB25F6B">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="C1374ACF65B540BE83E489B09572FC50" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce administration, improve business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="02F6D1C14563407F958678887DC83184">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="7B2D91B57E3A450E8E3AF973B199AE1A" ID="D1A550992473451DA5680A49C6B65FCC" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce travel related expense" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BBD30E2B54C7433E96E3294003614E02">
					<title>Reduce travel related expense</title>
				</business-objective-ref>
				<cbs-ref Ref="FF2B494F7DA4473180A05B1E717F7BB8" ID="1311F70DF344434FA2147603B1CF40E8" OriginalMap="Automotive - Sales &amp; Service Organizations: Credit Card Clearing for Travel Management and Financials" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="43F05DC81EE94CAAAE00686E1A1522A1">
					<title>Credit Card Clearing for Travel Management and Financials</title>
				</cbs-ref>
				<content>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				</content>
				<cbs-ref Ref="8472DA01E2C411D3A7CF0060086E8F06" ID="E70E346A23FF4AA1B0CB9255A681BC4E" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Provider: One-Step Travel Management (Collaborative)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="611C2C6F63B643DE846EAEE7B22EFBB4">
					<title>Service Provider: One-Step Travel Management (Collaborative)</title>
				</cbs-ref>
