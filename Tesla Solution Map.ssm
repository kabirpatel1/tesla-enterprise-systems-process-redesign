				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this process to create warranties in the system and to assign installed base components or individual objects to these warranties. The assignment can be performed manually, or automatically with reference to a product with warranty assignment. After registering an individual object, Internet customers in E-Service for example, receive the information about the automatically assigned customer warranty on their screen.</P>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="DA2F40B2FC2047ADA3430E6812CB7FC1" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F3869A734E59499FAC990A3EB9624115">
