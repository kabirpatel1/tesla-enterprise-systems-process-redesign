			<process ID="224ABE1679F147C4939ECD20DB4F6F07" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 167" solmanAvailability="2" variantNumber="0" OriginalMap="Automotive - Sales &amp; Service Organizations: Strategic Service Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7D41E2754F544EEEB99303EF9DC2A2F8">
				<title>Strategic Service Planning</title>
				<process-ref Ref="810405F28BEB47CDB5D25CDEB405A967" ID="C6255AA74E30446082438FBEA53C882F" variantOf="810405F28BEB47CDB5D25CDEB405A967" OriginalMap="Automotive - Sales &amp; Service Organizations: Strategic Service Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1EB30385D4D9485A818428C5A54C2BD3">
					<title>Strategic Service Planning</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Provides long range analytical planning of future resource requirement for the anticipated service business.</P>
				</short-description>
				<process-ref Ref="E77C5E3EBDA64068E10000000A114AB6" ID="E27DBC9530944D398275CC7CAB7A79F1" variantOf="810405F28BEB47CDB5D25CDEB405A967" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Strategic Service Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FC8F4943C19F419CB479D067B1B258CB">
