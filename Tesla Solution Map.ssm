				<sap-cover>1</sap-cover>
				<title>Parts Monitoring</title>
				<bpr-element-ref ID="B66AFC2D04574BCDA394EECBFAEF0DE3" elementname="BusinessProcess" Ref="urn:bprid#A4821C30819911D912D100306E055DA7" OriginalMap="Automotive - Sales &amp; Service Organizations: Parts Monitoring" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="13E7012EC8944F99A05D87AC0C58575F">
