			<process ID="FF83BF3EC8304E499EF71DE7C743411F" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Planning and Forecasting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6EB5C9D401CC48B2AF697EC8C60333D6">
				<!--#!#1616#!#-->
				<sap-cover>1</sap-cover>
				<title>Sales Planning and Forecasting</title>
				<process-ref icon="technical-variant-ref.gif" ID="79FB21C930324B408D307C16138BE79E" Ref="7EF14C55F18D45C2B2DE43ECA3038CA3" variantOf="85FA052B39E04974888B7F64806BD290" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Planning and Forecasting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E1A63E7673C44592A1D76C056F960E1A">
					<title>Sales Planning and Forecasting</title>
				</process-ref>
				<short-description>In Sales Target Planning, a sales manager set sales or contribution targets for the sales employees in the field. Since the sales manager and the sales employees use a common planning platform, the planning tasks performed by the sales manager are closely reconciled with the business planning and operational planning tasks performed by the sales employees. You can specify as many dimensions for entering planning figures (such as sales region, product group) as you need for your planning requirements. The different planners can access the same data but plan at different levels.</short-description>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="8483717B4B3B4C4FA30FE499661B9DC4" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CFCC6D55D9DD4326AD079607DB5E344F">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="78E81F3F2AB14AAE870C14BD09AA9726" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Account Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FC72D049667A48208F90E5BDA309B279">
				<!--#!#1616166#!#-->
				<sap-cover>1</sap-cover>
				<title>Account Processing</title>
				<process-ref icon="technical-variant-ref.gif" ID="333F6694C4244D25801BAD5AF7363F1E" Ref="D93E883E742E9D13E10000000A114AB6" variantOf="F590728B3729414F9DFD03A852E85DB4" OriginalMap="Automotive - Sales &amp; Service Organizations: Account Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4EB997539AE14318AFD3E14685CE56B0">
					<title>Account Processing in CRM</title>
				</process-ref>
				<process-ref icon="technical-variant-ref.gif" ID="1797D1B6D0534BDFA260841C23517720" Ref="EF7ECAA3E09A4DEDB11EFF025B12" variantOf="F590728B3729414F9DFD03A852E85DB4" OriginalMap="Automotive - Sales &amp; Service Organizations: Account Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="273DE7E77F0142D88748AA0A62237011">
					<title>Account Processing in ERP</title>
				</process-ref>
				<short-description>
					<p class="MsoNormal" xmlns="http://www.w3.org/TR/REC-html40">
						<span lang="EN-US" style="mso-ansi-language: EN-US">Provides you with a
solution for managing and processing business partners and contact
persons. In addition, the integration of business transactions,
contacts, marketing attributes and so on provides quick access to
and easy maintenance of all the information on business partners or
contact persons.</span>
					</p>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="05AB7DE178714BC9AA18D2B8F6050799" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="33560EE139C246B0A3D9F725D3CAF851">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="18840B979D434CBAA176F058D66B5638" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D7847D42896949A9AA529844CB407A8D">
