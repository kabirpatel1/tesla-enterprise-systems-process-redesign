				<process-ref icon="technical-variant-ref.gif" ID="A701EE26D5DE4624BD76CB6D1982CCDB" Ref="638B13D3E4D047F28672B2BCDFF6" variantOf="635996015DB747CF8A49B7E1AB25B0A6" OriginalMap="Automotive - Sales &amp; Service Organizations: Quotation Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="641960A254C840439B256405AD96B9CB">
					<title>Quotation Processing in ERP</title>
				</process-ref>
				<short-description>With this business process you can assure your business partners that you will deliver a certain product configuration and quantity of products at a specific time and price. During sales order processing, the sales employee can make use of a variety of sales functions and special quotation functions:</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="AADF3253D7B749FB802F925E90A90343" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E0A5471CC9D14EFE98E0151A48C32C68">
					<title>SAP ERP</title>
				</product-ref>
				<process-ref Ref="19CF6C3E5F939E13E10000000A114AB6" ID="493A51043FC447CEA4CB569B526ED733" variantOf="635996015DB747CF8A49B7E1AB25B0A6" OriginalMap="Automotive - Sales &amp; Service Organizations: Quotation Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4046ED52C7E44DA8BE32A53A9E5FAA65">
					<title>Quotation Processing in CRM</title>
				</process-ref>
