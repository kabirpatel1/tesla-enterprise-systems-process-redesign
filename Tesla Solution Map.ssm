				<process-ref ID="BA53027F69204BD499F411E235470791" Ref="2941D560819911D912D100306E055DA7" variantOf="A4821C30819911D912D100306E055DA7" icon="technical-variant-ref.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Parts Monitoring" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2D3D41DBAB684AE8AF2499A141EF5718">
