				<title>Service Parts Sales</title>
			</bpr-element-ref>
			<title>Service Parts Sales</title>
			<process ID="9254A7E35284469D9C8A654C4F8AD004" businessArea="Sales" responsibleOrgUnit="CRM" runningNumber="CRM 131" variantOf="35B401CC52C140F58172E97A3F4AE18B" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="60615895E2644EAF998F4F8A311C5290">
				<sap-cover>1</sap-cover>
				<title>Sales Order Processing</title>
				<bpr-element-ref ID="975D4D8B6DD248F9A1D53201B977CA62" Ref="urn:bprid#35B401CC52C140F58172E97A3F4AE18B" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="494E066D684C42E881811B576FBEA474">
					<title>Sales Order Processing</title>
				</bpr-element-ref>
				<content>
					<P xmlns="http://www.w3.org/TR/REC-html40">This business process makes it possible for you to deliver a specific product configuration and quantity, or to provide a service at a specific time. During sales order processing, a sales organization accepts the sales order and is responsible for fulfilling the contract.</P>
				</content>
				<process-ref Ref="C9861AF075E511D912D100306E055DA7" ID="6D2DBA82CDCE4003A5787E9D6F11C980" variantOf="35B401CC52C140F58172E97A3F4AE18B" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Order Processing for Service Parts" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="34162D74CFD642F786F1610926F51244">
