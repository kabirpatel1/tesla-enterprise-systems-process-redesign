				<title>Automation and standardization of business processes</title>
			</business-objective-ref>
			<kpi-ref Ref="kpi-0OPCF002" ID="7FBB789D091F4E078B713B85370CA81B" OriginalMap="Automotive - Sales &amp; Service Organizations: Campaign/Event Cost Revenue Ratio" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1DF4DFF9C41647C4BEABF3F6828BAC79">
				<title>Campaign/Event Cost Revenue Ratio</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0OPCF038" ID="D3A85679C3E1463C9ABAE1F6AAEC4756" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Satisfaction Index" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B81E7539E3F841F5864334345651B5B6">
				<title>Customer Satisfaction Index</title>
			</kpi-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">This scenario
facilitates the continuing trend of automotive companies attempting
to optimize existing customer relationships and attract new
customers through creating unique brand images. Efforts
within brand management include a structured but highly individual
customer treatment across all communication channels, such as
websites, call centers, or via the dealer network. The organization
can track all the information about customers, business
transactions, partner and vehicle relationships and use it in its
customer contacts as well as in its collaborative marketing
activities, such as</p>
				<ul xmlns="http://www.w3.org/TR/REC-html40">
					<li>Strategic Brand Management</li>
					<li>Sales or Service Campaigns</li>
					<li>Customer Loyalty Programs &amp; Satisfaction Surveys</li>
					<li>Event Management e.g. for Factory pick up</li>
					<li>Commercial Advertising on TV, Radio, or other media</li>
				</ul>
			</short-description>
		</business-scenario>
		<business-scenario ID="7356AD27E8BB4CA5B21F9444A4199A8E" bprid="A10C85BE4CE44C6B9E4D6ED353783A7E" responsibleOrgUnit="BSG M" xmlns:bpr="http://www.sap.com/ns/bpr-common" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Lifecycle Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0CA821C3B60C4131A34DB5EDEBB60F21" modified="8/14/24 08:05:05 PM">
			<title>Vehicle Lifecycle Management</title>
			<process ID="B8F8B0EC3E0B493A9018209E82376706" businessArea="After Sales &amp; Services" variantOf="0E39B69DBD864BEFACAF570E3A424347" runningNumber="CRM 204" responsibleOrgUnit="CRM" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A964E3576BD84849B97145B2D580B650">
				<sap-cover>1</sap-cover>
				<title>Installed Base Analysis</title>
				<content>
					<P xmlns="http://www.w3.org/TR/REC-html40">Shows the monetary business volume of all orders referencing to an Installation during a specific time period. Enables analysis on costs, revenues, and profit generated by an Installation. Provides information about the location of Installations and shows the amount of orders for an Installation during a specific time period.</P>
				</content>
				<process-ref Ref="05207B4010772D45E10000000A114AB6" ID="C1C92F993C2749F3A691D1A858DAFCAD" variantOf="0E39B69DBD864BEFACAF570E3A424347" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="19C1C5462CA84A67A4A106D1491F48A0">
					<title>Installed Base Analysis</title>
				</process-ref>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="C1BFDED17C3A4413A414428C63ABBC4E" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="914E7C29D2FA44F0BB5DC25F20DF1622">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="6C965C3640654CAC84D9F2570DA035E2" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Information Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="80460E38898644019CC3C0A420DA9226">
				<sap-cover>1</sap-cover>
				<title>Vehicle Information Processing</title>
				<process-ref icon="process-ref.gif" ID="3E105A8F80FC4944995769699F4212BE" Ref="C6A47020FFF711D812D100306E055DA7" variantOf="7DB107849AEC4164A57FBC785F3B7CC9" OriginalMap="Automotive - Sales &amp; Service Organizations: Individual Object Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D2E51969D8A94DC3AF08F1CADF4D7DD4">
					<title>Individual Object Processing</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">As the automotive industry moves from a volume- and logistics-driven business toward one that focuses on customers by emphasizing comprehensive sales and service, companies need to track information. mySAP CRM helps organizations manage all information about customers, business transactions, relationships, and individual vehicle configurations. mySAP CRM classifies individual objects, customers, business partners, and product masters as unique entities, or objects, in business processes and establishes them as central references for almost all transactions between a company and its business partners. And because every organization wants to track different components and attributes, individual vehicle object capabilities are integrated into all mySAP CRM processes so organizations can establish criteria to model unique entities.</P>
				</short-description>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="FDB5025DB43441B3B14E0AB693AB92D5" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="267FFAD39B454D35BC9CF6AA79B9C071">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="0EFC1E833BD045EB911C717CDD4497E9" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Information Processing with Channel Partners" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CD9673B291E94A32B5D2E3675416B37F">
				<sap-cover>1</sap-cover>
				<title>Vehicle Information Processing with Channel Partners</title>
				<process-ref icon="process-ref.gif" ID="F74418BCC49343CEADDF3F8336431E84" Ref="0A5737D0FFF811D812D100306E055DA7" variantOf="4028BC4CA6E64A048B0BE7957378AFE4" OriginalMap="Automotive - Sales &amp; Service Organizations: Individual Object Processing with Channel Partners" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1BD210C88D74410C8E48C596EAF0D59E">
					<title>Individual Object Processing with Channel Partners</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Dealers can interact directly with OEMs or importers by providing access to shared data residing in the central vehicle database and supporting customer information management. Dealers can access and maintain information via the web or directly via the integrated Dealer Management System.</P>
				</short-description>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="D70AC28D03EE418E99662706A4102AA4" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="954B81839B9B46C4841B5E3C6EB43D16">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<bpr-element-ref ID="0D3D7DCE7CC54594AFF7A8C89776D6D1" elementname="Scenario" Ref="urn:bprid#A10C85BE4CE44C6B9E4D6ED353783A7E" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Lifecycle Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0364B1431DE445D99DB91CE6F7B180FD">
				<title>Vehicle Lifecycle Management</title>
			</bpr-element-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">The automotive industry
is currently moving from a mainly volume- and logistics-driven
business model towards a customer-focused business model
emphasizing an all-embracing sales and service offering. This
requires to not only know the customers and their driving
behaviour, it also requires to know exactly about the vehicles they
are driving. The vehicle history is an integral part of marketing,
sales, and service activities. For example, when a customer is
entering a dealership with a service request it is important to
know in detail which services have been performed before. That way
a brand and its service network can deliver excellence in service
processing and differentiate from the competition.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40">This scenario enables
the management of a vehicles information along its entire
life-cycle. The organization knows all the history from planning
over sales &amp; distribution and the entire after sales phase. The
vehicle information can be maintained by the brand owner and all
other partners down the channel and includes all business
transactions, relationships to customers and partner, attributes
and configuration, documents, and much more.</p>
			</short-description>
			<business-objective-ref Ref="786FA0F4565144BB953F06EA5D1BB9B7" ID="773D2589381B433887EC27EC8B74FE8A" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve service quality" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9E47DBC3D6C3456EB2283FF9148FCFE1">
				<title>Improve service quality</title>
			</business-objective-ref>
			<business-objective-ref Ref="3CE88DE6996C41D2BB8FBF72AF16E430" ID="8F117E26A976402EB64328C53EC0CA6F" OriginalMap="Automotive - Sales &amp; Service Organizations: Personalized customer interaction" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="45C756904C3A42E085719DB7FB523B18">
				<title>Personalized customer interaction</title>
			</business-objective-ref>
			<business-objective-ref Ref="1044451A470142FC950CCE8F9B987157" ID="E464993D86AE425F8B413C47B5BAC35A" OriginalMap="Automotive - Sales &amp; Service Organizations: Provide a single face to the customer" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="494AC1239D814EA196A511BFF69D262F">
				<title>Provide a single face to the customer</title>
			</business-objective-ref>
			<business-objective-ref Ref="0F377A62EC8849C0BA60C0BC435A5114" ID="611A971F0DBD4EE6A156F342EEC2734E" OriginalMap="Automotive - Sales &amp; Service Organizations: Collaborate with business partners" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="40A5AA230769459FBBD27D4BE5C5E1EA">
				<title>Collaborate with business partners</title>
			</business-objective-ref>
			<business-objective-ref Ref="8064C226B9B64E9F8117021EFA17CAD0" ID="210C2D2347714933BBC81C7B75F0AEF4" OriginalMap="Automotive - Sales &amp; Service Organizations: Gain market share with new products and brand extensions" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AA637478458C47AFA0BC956536A7685A">
				<title>Gain market share with new products and brand extensions</title>
			</business-objective-ref>
			<business-objective-ref Ref="232596C4A8D142939BA5D6F41B558F9D" ID="7392EEDF17284006A570B633CF2E22DE" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve customer retention and loyalty" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4E1854195A8047B1BEE96650E147150D">
				<title>Improve customer retention and loyalty</title>
			</business-objective-ref>
			<business-objective-ref Ref="1818E74A594D4A6D9C0A1A551D74D570" ID="D6DDF4CEA28046D19FC5E753FFD5D222" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce time-to-market &amp; volume" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AB551D77068F433BA643ACABD786DDE9">
				<title>Reduce time-to-market &amp; volume</title>
			</business-objective-ref>
			<kpi-ref Ref="kpi-0OPCF038" ID="F1E9349131DA4243B5CBD187F7021C95" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Satisfaction Index" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="41B119E0D8514CDE81669DD54E5FF368">
				<title>Customer Satisfaction Index</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0OPCF016" ID="6004EDB49A36484593816A059C20DE4B" OriginalMap="Automotive - Sales &amp; Service Organizations: Percentage of Service Requests" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6F063FB4FAEB4BB280EE07D97D137BE7">
				<title>Percentage of Service Requests</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0HRPA003" ID="7DCDB6DF1D584132A4D7443C67F88CAC" OriginalMap="Automotive - Sales &amp; Service Organizations: Average Length of Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BB01A3A1F5F44A9AB36869E184E9AF0B">
