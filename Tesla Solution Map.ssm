						<title>Success Story: Roche Diagnostics</title>
					</hyperlink>
					<hyperlink ID="7BD3EF16A0AB42E4B88A5DB6603C0D23" href="http://download.sap.com/SMIGlobal/download.epd?context=4F9DCFD1B5451057C1F84DC215A29CD77032F22CA925B9CCFC85AC97B6F6948DF66C94637AD29CDDE497D05E6F1E32E59241BBBCA46C5970" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Fournier Pharma" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1AE3723AB9B94F80A0839B8956ADD757">
						<title>Success Story: Fournier Pharma</title>
					</hyperlink>
					<hyperlink ID="4241E8BEDC984E3BBFEABE970E4A4A78" href="http://download.sap.com/download.epd?context=E96CCF0EF5848EA388D4CDDE37DD36D4AFAA3F913FCC830E0B04CA46E1B9059C68CEBA3AD6E59BDDD3E5F52728A0E551B9C407FCC510BDB1" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: KSM Castings" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="484C8ABA0C6D48E1943C382CEE7D15DC">
						<title>Success Story: KSM Castings</title>
					</hyperlink>
					<hyperlink ID="9C681C268843409BA28606E56F3498F6" href="http://download.sap.com/download.epd?context=D0E87186A788950E75D9AECF531B6465FA365FBCC33C4C30AD449A20E95DE27F11A5FF5FAB330CEF778999A86092C41E5A8AA558ADB95295" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: VWR International" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3CD258EC18264DCE8EA470AFA8CA4CDA">
						<title>Success Story: VWR International</title>
					</hyperlink>
					<hyperlink ID="C22B0248B096433AACB55DC56BB359E3" href="http://download.sap.com/SMIDE/download.epd?context=B9606F957BFBAE36F4CC377A254ABAFFAE813E73EA2CC94F7972B85C552BA851248B2D7B8B655EA9C3905499E1EC7F99FF050935A7B2729C" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: ZF Lenksysteme GmbH" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0AFF6A6CB0384A09A7EBBE524F50D768">
						<title>Success Story: ZF Lenksysteme GmbH</title>
					</hyperlink>
				</folder>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Quality management is
the comprehensive solution that supports the company throughout the
product life cycle and along the supply chain. It offers a wide
range of functions and collaborative services, which are fully
integrated into SAP ERP, for assuring and managing the quality of
products and assets. It also focuses on prevention and continuous
process improvement through collaboration and sustained quality
control.</p>
				</short-description>
				<folder ID="A0B15A96EC1140E986708D0A3F9B6200" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Roles" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3B937E50034C4ED48B5414CFA30116E3">
					<title>SAP Roles</title>
