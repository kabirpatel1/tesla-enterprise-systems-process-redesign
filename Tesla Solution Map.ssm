					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="B154DFB38E8C47E0B484EADD95539823" OriginalMap="Automotive - Sales &amp; Service Organizations: Self-Service Support" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8FEDD27EE5CE4C9180EAE75D99AD27C3">
				<title>Self-Service Support</title>
				<process-ref Ref="25BC556A2BCA43BF8173C2B40BA26BE6" ID="B4C36D6B9FA5426BA03AB1EC679C83C2" variantOf="25BC556A2BCA43BF8173C2B40BA26BE6" OriginalMap="Automotive - Sales &amp; Service Organizations: Self-Service Support through FAQ and Solution Search" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DCB7401D1B5E48A387E5C85C77259099">
					<title>Self-Service Support through FAQ and Solution Search</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">In this process customers try to solve their product problems through searches of frequently asked questions (FAQs). FAQs are sorted by product. Each FAQ is linked to a list of possible solutions. FAQ Search is a self-service tool that reduces interaction costs, increases customer satisfaction and improves efficiency and profitability.</P>
				</short-description>
				<process-ref Ref="741BCA985A094877BD4D99D38042AEA0" ID="ABC609136886420D96206EC6E61D4025" variantOf="25BC556A2BCA43BF8173C2B40BA26BE6" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Self-Service Support Through FAQ and Solution Search" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3AFF3DBBCF214D36BAF2147B6FD34FC5">
					<title>Self-Service Support Through FAQ and Solution Search</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="A6C68AA9BF3A4E4AA716A31582B1E408" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BD640B0D227541E5A91C18BB172BFF1F">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="AC4A34ED71924C879E17552BBDCBE146" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 186" solmanAvailability="0" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service and Support" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B1667E1DD4F34032B050898F7DE16B40">
				<title>Customer Service and Support</title>
				<sap-cover>1</sap-cover>
				<process-ref Ref="307DD147AE1845EE95DF81062BE703C6" ID="3CA8059E53364BF0A56731D386FF5368" variantOf="307DD147AE1845EE95DF81062BE703C6" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service and Support with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B700006168C4474582957E0177D8978B">
					<title>Customer Service and Support with Interaction Center</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Allows customer service agents to handle complaints, address customer concerns, answer technical questions, assist with returned materials, and make exchanges. Customers can be identified using the relevant partner information or data about their installed base. Agents use the solution database to search for a suitable solution for their customer’s problem, create service orders, determine existing contracts, and select products from proposals if needed.</P>
				</short-description>
				<process-ref Ref="4B73C448DB7F482BA8F690D96F42" ID="F4A50932974B4F18AE60F65961742240" variantOf="307DD147AE1845EE95DF81062BE703C6" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service and Support with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="685083A91B33454E97DE74C6A07FF9BF">
					<title>Customer Service and Support with Interaction Center</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="5EFCF7A8913B40B9967B70CA315EE342" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C2267BF89A154D71A3525DC88BEE3FAA">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="B80198D7FAAF4299B83E2CC606F1C8C3" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D0157D6198394FCFBE3C4F509D569009">
				<title>Service Contract Management</title>
				<process-ref Ref="3BBC4204EDCB465E9CAF229D88D81506" ID="9BEEAB46CC3546338D779975D8764E35" variantOf="3BBC4204EDCB465E9CAF229D88D81506" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2C4D30F2BBA24D6EB31BB2EFD9ED1063">
					<title>Service Contract Processing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>You use this process to create a service contract that can be used later on as a basis for service processes.</short-description>
				<process-ref Ref="7EB9B25F6E7D4E43BBAFA367EF7FEE9B" ID="CB97420216294C369423A2F66190E9F4" variantOf="3BBC4204EDCB465E9CAF229D88D81506" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B73AE033247B481EB3D78DBB189F66CD">
					<title>Service Contract Processing in CRM</title>
				</process-ref>
				<process-ref Ref="970588814A4E43D4BA651474985F6CA5" ID="9CDAF038EA4A4D2785AEAF4CE9325F71" variantOf="3BBC4204EDCB465E9CAF229D88D81506" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E99FFA12DBBD4424A90058E359274883">
					<title>Service Contract Processing in ERP</title>
				</process-ref>
				<process-ref Ref="1D9B342079C111D912D100306E055DA7" ID="4EB5927AF07942E69AB7755B3E0A0E42" variantOf="3BBC4204EDCB465E9CAF229D88D81506" OriginalMap="Automotive - Sales &amp; Service Organizations: Usage-Based Service Contract Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1FC74CF638C4445997ABAA7895A9CA75">
					<title>Usage-Based Service Contract Processing in CRM</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="F1DAFBEF587E400E8CFA7F4994BFF84B" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8A445312CE594CE8B72BD443F0C5EB86">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="4253F7B5D5BA40FAB7ECAFA128344CE9" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 163" solmanAvailability="2" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Request Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5A050FB92AC44C8E9228D9128F6B11EA">
				<title>Service Request Management</title>
				<process-ref Ref="1D7BCA5C7480452E8431756DB9A1399D" ID="EC185DD66FFA4960A82E2085CC690A6A" variantOf="1D7BCA5C7480452E8431756DB9A1399D" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Request Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4FCABF2F69004B1E9C90DE69A69FF157">
					<title>Service Request Processing</title>
				</process-ref>
				<process-ref Ref="94855C75085A4E0C92030E95A13A5CE0" ID="D9C47469F1E348EDB5E65F1BAE24D471" variantOf="94855C75085A4E0C92030E95A13A5CE0" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Notification Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1869F4D400354423BA4EB0D274FDEC44">
					<title>Service Notification Processing in ERP</title>
				</process-ref>
				<process-ref Ref="066B85E51DDC4274BAE2825D5BB75A33" ID="B33DAD04B588423DB4A94F5B69240F2D" variantOf="066B85E51DDC4274BAE2825D5BB75A33" OriginalMap="Automotive - Sales &amp; Service Organizations: Malfunction Notification / Service Notification" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E98D71191BA14A418684FF15055B9AEC">
					<title>Malfunction Notification / Service Notification</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">In this process customers create a service request. Having previously selected an installed base component, they choose a service product and a service contract, schedule an appointment, and upload attachments. They can also monitor the status of their request.</P>
					<P xmlns="http://www.w3.org/TR/REC-html40">This process reduces interaction costs and increases customer satisfaction.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="526F6C84012749728ABCD05F535EB71C" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C5B77FD5979F484D96F1946FEA3D9E48">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="974BBED074AB49CABC9B4DFD999DCA53" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 062" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C6FB216DC0CD4C5FAA66EA64905C996B">
				<title>Installed Base Management</title>
				<process-ref Ref="E83ABB5820B34CD2A0245DB0132E18F0" ID="D13A4519F0E04E9E997F90CA93BB24D3" variantOf="E83ABB5820B34CD2A0245DB0132E18F0" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="09EC21C09BC24C40B9D408CD8A6BB017">
					<title>Installed Base Processing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Customers use installed bases to manage service-relevant information for products or services that they have acquired. For example, components in an installed base could represent a credit card in the financial industry or a car in the automotive industry.</P>
				</short-description>
				<process-ref Ref="A7B0F2AF748A4B598DDA7D3422BF" ID="9329A564CD7C4E0591AD667D854EE7D0" variantOf="E83ABB5820B34CD2A0245DB0132E18F0" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3975E4F9DB254F199E665BC14D5A7738">
					<title>Installed Base Processing in CRM</title>
				</process-ref>
				<process-ref Ref="4CA86C3E5F939E13E10000000A114AB6" ID="29E80907B648481A9C26B019EC30666D" variantOf="E83ABB5820B34CD2A0245DB0132E18F0" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Processing in CRM Web Channel" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3525798F71014BDD900E3DF7C80A2A01">
					<title>Installed Base Processing in CRM Web Channel</title>
				</process-ref>
				<process-ref Ref="50C4EB7718144CC692A7C2773FA53672" ID="D1374BA2952F4C1EA155F8EAEDC9AD85" variantOf="E83ABB5820B34CD2A0245DB0132E18F0" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4B6BCFA824D54801BE069D2BA821BCCA">
					<title>Installed Base Processing in ERP</title>
				</process-ref>
				<process-ref Ref="A600E0D0872711D912D100306E055DA7" ID="3E08F26D82614C01B35D5BAE67A3FEA5" variantOf="E83ABB5820B34CD2A0245DB0132E18F0" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Processing with CRM Mobile Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AA53506D5C1A4B6CA97F222C128C812E">
					<title>Installed Base Processing with CRM Mobile Service</title>
				</process-ref>
				<process-ref Ref="D269683E1F403F68E10000000A114AB6" ID="449E32F625074ED58A1F7966DE6F5F0F" variantOf="E83ABB5820B34CD2A0245DB0132E18F0" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Installed Base Processing with ERP Mobile Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B31D88F8249849949D89FB23FA0082C7">
					<title>Installed Base Processing with ERP Mobile Service</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="141DC8A9FE7D4DC78445B61EDA0C533C" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="28B06472A19743A1BD7ED6641250AF36">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="56A1F22C21994936A91AF18402E7D473" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Plan Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7BD872A21E2B4C418447A1C29FC97A74">
				<title>Service Plan Management</title>
				<process-ref Ref="AB7A6C4DDD4848339414B970575001B6" ID="02D29100FD534B1AA80E6E8CD7AECDA4" variantOf="AB7A6C4DDD4848339414B970575001B6" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Plan Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="82E4B8DE56CF4DDCBA32CECEF6A1BCB8">
					<title>Service Plan Processing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this process to create and maintain service plans. A service plan is a functional enhancement of the service contract, whereby the service plan is represented as an individual item category of the service contract item. The maintenance of service plans takes place at item level of a service contract.</P>
				</short-description>
				<process-ref Ref="B3F3E2B9DBD649D993EC5CB6EEFD959A" ID="22167BBF96264CDEB40EA141CD56143E" variantOf="AB7A6C4DDD4848339414B970575001B6" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Maintenance Plan Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D4246EB874B14D6CB17013EAC41A0F3A">
					<title>Maintenance Plan Processing in ERP</title>
				</process-ref>
				<process-ref Ref="D583783E3CB49D13E10000000A114AB6" ID="4008C0E20E914DF3AF569535144308E9" variantOf="AB7A6C4DDD4848339414B970575001B6" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Plan Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="244DDB85CA054FBBA937F388228F6676">
					<title>Service Plan Processing in CRM</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="DCC5E9E4949A450E88D42C7B58B9DAB3" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4CFA960B6AEF4EE9863AE9F063AC3C8F">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="EBF252B24DA94D31A00F96140B5DB174" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 157" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Quotation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F3C99456462E4AFA835C40EB871722D9">
				<title>Service Order Quotation</title>
				<process-ref Ref="31216D2B080440A5A2FF470A44555238" ID="D0A922B920414BE78A135A5DB0997DD5" variantOf="31216D2B080440A5A2FF470A44555238" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Quotation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0A822D238B48417D8C67E674C789F598">
					<title>Service Order Quotation</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this process to offer customers a service order quotation before concluding the actual service order. This gives customers the opportunity to find out more about prices and delivery conditions before agreeing to the service order.</P>
				</short-description>
				<process-ref Ref="194B773E30F19E13E10000000A114AB6" ID="280B4DDA795545D4B237BC566B189D0D" variantOf="31216D2B080440A5A2FF470A44555238" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Quotation in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6AB83297C86F4631AB1B7A1D5F526452">
					<title>Service Order Quotation in CRM</title>
				</process-ref>
				<process-ref Ref="F9BFCBBB01C24DA89FB1546FDFA0B5EA" ID="173F5E3FDD8B4694805795AB6F50329C" variantOf="31216D2B080440A5A2FF470A44555238" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Quotation in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F68915627ECC496686FC11FDE8B7D37F">
					<title>Service Order Quotation in ERP</title>
				</process-ref>
				<process-ref Ref="6D2AD8A08FD911D912D100306E055DA7" ID="E63243FCA585425ABEB6827FD5A5AB35" variantOf="31216D2B080440A5A2FF470A44555238" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Quotation with CRM Mobile Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="878BF31635A841A595B9DAB554EE0AD1">
					<title>Service Order Quotation with CRM Mobile Service</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="7D013143064C490BAA0847B12E486898" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="57D92D7F94A74FBF8D2BDA99EBACD483">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="28756B3AB3BA49A4A33DDD61859544FE" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 128" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Employee Resource Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A574D35756184E489D76DABE55A7D0B7">
				<title>Service Employee Resource Planning</title>
				<process-ref Ref="D181F06EAB4F4A57B2A6FC7A371B55C1" ID="C2D93CEA3429435C9C237D53ECBAECBD" variantOf="D181F06EAB4F4A57B2A6FC7A371B55C1" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Resource Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8FF036495DB54AF48BEDE4F3E517325E">
					<title>Service Resource Planning</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use resource planning to create assignments for the items of a service order that are relevant for resource planning. You do this by using the resource planning tool to allocate service tasks to available employees. Service employees can either accept, or reject the assignments.</P>
					<P xmlns="http://www.w3.org/TR/REC-html40">If you work with mobile terminals (laptops or handhelds), your employees can download their assignments onto these devices.</P>
				</short-description>
				<process-ref Ref="0D0F65FE7C934E6797DB1ECC7EF14FD0" ID="D957071CF6234869ADAAA24A0344C516" variantOf="D181F06EAB4F4A57B2A6FC7A371B55C1" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Employee Resource Planning in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9C67140E3C63418FB970ED96D8D75444">
					<title>Service Employee Resource Planning in ERP</title>
				</process-ref>
				<process-ref Ref="7286105348474B26A7BF4B72A0AA" ID="EFE8EC4FD28741A18965D688B73F3C46" variantOf="D181F06EAB4F4A57B2A6FC7A371B55C1" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Employee Resource Planning in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="69793658D67244CA81178D1282513DF8">
					<title>Service Employee Resource Planning in CRM</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="47942B0E97E24F1F85D3ABCF8030F525" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="709FCAE6821F4B418CA3B79FF1295DAA">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="B34366FA49CA42B79C06A561E90C386D" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 155" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Management and Field Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BA6D9F86C4004D0EB3422ABD4EF69CA6">
				<title>Service Order Management and Field Service</title>
				<process-ref Ref="D23B49C32221413BB5F222585DFF3FBE" ID="7C1BA4489C4E46658AD5B1C00C855234" variantOf="D23B49C32221413BB5F222585DFF3FBE" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4F11CD010BAA4483AFDFF21044200AA3">
					<title>Service Order Processing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use amount allocation to allocate items to multiple external and internal recipients. These items may be either billable or non-billable because of warranty claims, and they may stem from service orders or service confirmations. You can assign internal and external recipients when you create the service order or service confirmation.</P>
					<P xmlns="http://www.w3.org/TR/REC-html40">When you create an amount allocation document, the bill-to party and invoice value are copied from the service order or service confirmation. You can still process or edit this data in amount allocation.</P>
				</short-description>
				<process-ref Ref="5044773E30F19E13E10000000A114AB6" ID="16D4AC8B3EC440CAA499C11F36FB88F9" variantOf="D23B49C32221413BB5F222585DFF3FBE" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing for Planned Services in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F2601778FF014F018F40D94FF2D42C0F">
					<title>Service Order Processing for Planned Services in CRM</title>
				</process-ref>
				<process-ref Ref="2F3FAF880A2A4834A46C6DB77B343CAA" ID="CDA3A1EB5C574642A8B448F698C09E00" variantOf="D23B49C32221413BB5F222585DFF3FBE" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing for Planned Services in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3A854E1E093446A49B69D0613D141EE4">
