					<title>Incentive Plan Maintenance</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="C90F3071D34A40E6BF32C7787F9E" ID="4D3D01D4C3DB4671B8483F6E5323F02E" variantOf="8A17D58061FD4372B42F833EC8F75880" OriginalMap="Automotive - Sales &amp; Service Organizations: Incentive Plan Maintenance in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6CC1F1E913F7443AAB1E3D8C6DAF846B">
						<title>Incentive Plan Maintenance in ERP</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="3650AA99656B4393A91708CDB4266C49" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C693A2522CC14EB39A3FE24906C461C8">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">You use this process to design your commission plans with all
the related master data in ICM. This is the second part of your
implementation project. However, you must also carry out any
amendments or additions after the implementation, for example if
you change your incentive strategy and plans or if you add new
commission recipients.</p>
					</short-description>
				</process>
				<process ID="507292134EAB4204BA4287208636BAD3" OriginalMap="Automotive - Sales &amp; Service Organizations: Incentive Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CF591C6B588D4D03AA82611AEE8DFA00">
