		<business-scenario ID="BA0E234F62A94148B5AFA2914DC3EE99" bprid="23603C4655E1B903E10000000A114AB6" xmlns:smc="http://www.sap.com/ns/smc" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Parts Warehousing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B601D63BE5E6434891FEFC7FD4644BC8">
			<bpr-element-ref elementname="Scenario" ID="C1721C07B79049898215F78A93BE4B36" Ref="urn:bprid#23603C4655E1B903E10000000A114AB6" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Parts Warehousing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7B20E9B9915C4264866900663E5AEE3C">
				<title>Service Parts Warehousing</title>
			</bpr-element-ref>
			<title>Service Parts Warehousing</title>
			<process ID="BE126EBE1BEE43A7B6FD54C61C311A29" businessArea="Logistics" responsibleOrgUnit="SRM" runningNumber="SCM 009" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="Automotive - Sales &amp; Service Organizations: Inbound Processing and Receipt Confirmation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A2FD54EE81BF4F088A6184B3006DBBA9">
				<sap-cover>1</sap-cover>
				<title>Inbound Processing and Receipt Confirmation</title>
				<alias-title selector="2CA9369DADFA4A0494450F2CD470B631" selectorTitle="Service Management">Parts Inbound</alias-title>
				<bpr-element-ref ID="54D97A057AB5436496DB3C0C7C06A45E" Ref="urn:bprid#4DA3FAE72CB34A22B27C5CE0A5A08BAB" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Inbound Processing and Receipt Confirmation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2F718A0BE2D44ED1A0B4910A78B9E948">
					<title>Inbound Processing and Receipt Confirmation</title>
				</bpr-element-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to confirm receipt of goods.
In Enterprise Buyer, requesters can create confirmations
themselves, even if the purchase order is in the backend system. It
is possible to create express confirmations directly in the Check
Status application without having to switch to another application.
Alternatively, an internal dispatcher or shipping department can
take delivery of goods and confirm centrally. In this case, an
additional approval workflow through the requisitioner is possible.
Then, the goods receipt is posted in the backend system.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">Inbound processing  covers the physical inbound delivery
processing that succeeds the procurement process. It includes ASN
processing, physical Goods Receipt and putaway of materials in
Warehouse Management up to sending the proof of delivery to the
business partners</p>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				</short-description>
				<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="BF715BD2888C46DDA91023FE819CBA27" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="Automotive - Sales &amp; Service Organizations: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C4F64ACDBD30406EBD1340E14928EAD2">
					<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="1B0BABC4358F467EB4F0B992DCC61933" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C0847D2E164C4CBA9C019EC0A5565C94">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="9024953E1707465CA1752D81DB6A05CF" businessArea="Logistics" responsibleOrgUnit="SRM" runningNumber="SCM 010" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="Automotive - Sales &amp; Service Organizations: Outbound Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F961EC38F0B2472A882D54628904BE9B">
				<sap-cover>1</sap-cover>
				<title>Outbound Processing</title>
				<alias-title selector="2CA9369DADFA4A0494450F2CD470B631" selectorTitle="Service Management">Parts Outbound Processing</alias-title>
				<bpr-element-ref ID="CC6C02AA098A417CB433E11284CCF4BB" Ref="urn:bprid#2D66D703E2B34DC99CDEEC93A54408AF" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Outbound Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="ECA7250610EB43FB9386CC76A2D5D527">
					<title>Outbound Processing</title>
				</bpr-element-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Outbound with WM: Outbound processing comprises the preparation
of goods to be delivered from a warehouse to a receiving location.
Outbound processing within the scope of warehouse management
typically comprises activities like the notification of goods to be
supplied from a warehouse to a customer for which the outbound
delivery serves as the reference document, picking, packing,
physical goods issue in warehouse, loading, goods issue and goods
issue posting to IM, advising advanced shipping notifications to
business partners and, obtaining a proof-of-delivery from the
receiving business partner.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
        Outbound without WM: Outbound processing without WM comprises
the preparation of goods to be delivered from a warehouse to a
receiving location. The warehouse is managed on a storage location
level using Lean WM.
        <br></br>
        Outbound processing within the scope of lean warehouse management
typically comprises activities like the notification of goods to be
supplied from a warehouse to a customer for which the outbound
delivery serves as the reference document, picking and physical
goods issue in warehouse, loading, goods issue and goods issue
posting to IM, advising advanced shipping notifications to business
partners and, obtaining a proof-of-delivery from the receiving
business partner.
       </p>
				</short-description>
				<process-ref Ref="B9D510D0819C11D912D100306E055DA7" ID="8648964F64814D88B66CAAA48F15EAC0" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="Automotive - Sales &amp; Service Organizations: Outbound Processing with Warehouse Management in SCM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="047403BE4CFC4BA3986C4DF6BB6ADD65">
					<title>Outbound Processing with Warehouse Management in SCM</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="C2E35CD512BB45AF94A4003B0A6D0DEA" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="51CC360532D343A69C6E00A4655FC355">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="1E1A952BD6244C708A916F7DA40779C9" businessArea="Logistics" responsibleOrgUnit="SRM" runningNumber="SCM 013" variantOf="9C6A9433062744A495D22507A5E03C38" OriginalMap="Automotive - Sales &amp; Service Organizations: Physical Inventory" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="014BC062D46D48A8A1D5DFBEEB7F42AF">
				<sap-cover>1</sap-cover>
				<title>Physical Inventory</title>
				<alias-title selector="2CA9369DADFA4A0494450F2CD470B631" selectorTitle="Service Management">Equipment and Parts Physical Inventory</alias-title>
				<bpr-element-ref ID="CD7D0E9FD93B41B8B2CAF4B2F12B37E8" Ref="urn:bprid#9C6A9433062744A495D22507A5E03C38" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Physical Inventory" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DC804382BD3F41CDB743AFEA825E7CB1">
					<title>Physical Inventory</title>
				</bpr-element-ref>
				<short-description>Physical Inventory is a process that all companies with their own stocks or special stocks in their warehouse eventually face. There are several different kinds of physical inventory that can be managed, for example: periodic inventory, continuous inventory, cycle counting or inventory sampling.</short-description>
				<process-ref Ref="D63DD46081AA11D912D100306E055DA7" ID="5C63F186D6824E8C93608CEF790BB1C4" variantOf="9C6A9433062744A495D22507A5E03C38" OriginalMap="Automotive - Sales &amp; Service Organizations: Physical Inventory on Storage Bin Level in SCM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2C52F3BBCFA34291BDDEBB33346BC2B4">
					<title>Physical Inventory on Storage Bin Level in SCM</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="085CA4D2C9D040D08C70172906037FB7" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="337A2D2A165F45DF898745213E6AE3E0">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="132D81B67BB444E3905B1F206DA934B1" businessArea="Logistics" responsibleOrgUnit="SRM" runningNumber="SCM 011" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="Automotive - Sales &amp; Service Organizations: Warehousing and Storage" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A93B5276744443748D3401DB54745DB1">
				<sap-cover>1</sap-cover>
				<title>Warehousing and Storage</title>
				<bpr-element-ref ID="9E11FA2209B843C5AC287A12637F86E2" Ref="urn:bprid#6265FCA0C10D4D85A120C2864C5AA299" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Warehousing and Storage" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="ED10112E607E40E1BB7B16EDB180648C">
					<title>Warehousing and Storage</title>
				</bpr-element-ref>
				<short-description>Warehousing and Storage includes multiple processes throughout the warehouse from the time materials enter the warehouse via Goods Receipt until they exit the warehouse with a Post Goods Issue. Specifically covered in this process you will find the management of inventory including putaway strategies and replenishment. Possible variants include task and resource management and Radio Frequence (RF) support. Optional steps include support for production supply, Value Added Services and Yard Management.</short-description>
				<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="BD055ACFA1D64711A4058CC9773DA510" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="Automotive - Sales &amp; Service Organizations: Warehousing and Storage in SCM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="916C63E70036444ABAB7AD0BB81E03FB">
					<title>Warehousing and Storage in SCM</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="86498E60C6264378897970E048B09FC3" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8C8747A10FB64B3AA61E41EB9D4F94D8">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<hyperlink ID="A1A8E6F8ED4245AA9EE8BDA4675AA391" href="http://help.sap.com/SCENARIOS_BUS2007/helpdata/EN/46/762F912BF459D8E10000000A1553F6/content.htm" openInSeparateBrowser="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Parts Warehousing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="34DEA418D6BD4510BE3B9DF1DDEDAEF9">
				<title>Service Parts Warehousing</title>
				<short-description>See also</short-description>
			</hyperlink>
			<business-objective-ref Ref="DECD4E771AC24E749C94DCF0779B6C74" ID="08209DF474814ECFB427160AA1CFEB24" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve capacity utilization" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1C9C92BDA5304FF086E97EF36CE3CE24">
				<title>Improve capacity utilization</title>
			</business-objective-ref>
			<business-objective-ref Ref="17130406E476406F9D2E5F2DE929F0D3" ID="96D22CEBB12346AF97A9729043DBB2DA" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce inventory carrying costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DF88FAEF13634A758362F3A50C713167">
				<title>Reduce inventory carrying costs</title>
			</business-objective-ref>
			<business-objective-ref Ref="0E946F0D85A5474AB07FE701864D9108" ID="4911D41405D140F88D99D05608EEAFAF" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve inventory visibility" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="86CABA85FA9F407B8A4BB2EF9DD418E4">
				<title>Improve inventory visibility</title>
			</business-objective-ref>
			<business-objective-ref Ref="2FEE065DBCAC4AD0A2D7A733234DB4F0" ID="6CAF44DC4BC847679FAE3BD1F20281ED" OriginalMap="Automotive - Sales &amp; Service Organizations: Lower logistics costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CE783CACCCEF4428A344D8064845342B">
				<title>Lower logistics costs</title>
			</business-objective-ref>
			<business-objective-ref Ref="F86420AFDDB1484988CB9EDB502B3913" ID="B57A8715A5A845938421EDB62E2914EC" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce inventory levels" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8E5682E99EE5465FB7F23D301CF56B46">
				<title>Reduce inventory levels</title>
			</business-objective-ref>
			<short-description>Service parts warehousing enables efficient warehouse processing,
allowing manufacturers and distributors to minimize costs while
simultaneously maximizing customers service levels. It includes
processes for inbound, outbound, and internal warehouse functions,
as well as cost saving and efficiency-increasing features such as
slotting, value added-service, cross-docking, yard management, and
labor management. In addition, service parts warehousing
enables and integrates with service parts planning, service parts
sales and service parts claims and returns to enable an integrated
solution for managing both forward and reverse logistics for
service parts. Warehouse monitoring and service parts analytics
provide additional visibility into the supply chain, further
enhacing the value of service parts warehousing.        </short-description>
		</business-scenario>
		<business-scenario ID="99C900A674724BA695D8A839F9664D6B" bprid="655DAB462FD14236E10000000A114AB6" mostRecentPackageID="A4F3610195E4654CB4DE8C809A11FAC8" xmlns:smc="http://www.sap.com/ns/smc" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Parts Sales" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="794B13031FCE4EC7AA34F29D9404194A">
