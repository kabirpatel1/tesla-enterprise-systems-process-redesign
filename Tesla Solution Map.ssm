			<level1-item ID="6C5372EDF4EA4675A3CCFBBE26504A74" OriginalMap="Automotive - Sales &amp; Service Organizations: Financial Accounting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6AF41FAD7B5F402583B8E782CE7B45EB">
				<title>Financial Accounting</title>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="16995B53590C4A6896C8C50BA78F19C3" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce administration, improve business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2DE31D70B34B4DDAA5E1A008755B25FF">
