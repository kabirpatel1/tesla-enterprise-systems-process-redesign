				<process-ref icon="process-ref.gif" ID="CB64A6082B2348F5ACA5D59C121EC4F3" Ref="FCA66C3E5F939E13E10000000A114AB6" variantOf="BD5FA6B7FEA643C8A5889FF51806EE1D" OriginalMap="Automotive - Sales &amp; Service Organizations: Processing Leases at End of Term" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F864534FFAED4002823544C83B62CE9E">
