				</product-ref>
			</process>
			<process ID="1AA1EC11059046BB9818750063FFD106" bprid="2352C94614CA4336E10000000A114AB6" businessArea="Product Development and Introduction" OriginalMap="Automotive - Sales &amp; Service Organizations: Rebate Agreement Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="802A63DB1BA749DAAF31B78D2F840C8E">
				<bpr-element-ref elementname="BusinessProcess" ID="D4BD1E142E3A47A09FC20071AB9B9ABB" Ref="urn:bprid#2352C94614CA4336E10000000A114AB6" OriginalMap="Automotive - Sales &amp; Service Organizations: Rebate Agreement Processing in CRM  for Service Parts" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5D839B8DD13C4E54A961BE46463F687D">
					<title>Rebate Agreement Processing in CRM  for Service Parts</title>
				</bpr-element-ref>
				<sap-cover>1</sap-cover>
				<title>Rebate Agreement Processing</title>
				<process-ref Ref="2352C94614CA4336E10000000A114AB6" ID="C5EFF69DD1CE4E79A364975BAF351A77" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Rebate Agreement Processing in CRM  for Service Parts" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8461D6C7E42F42508B8CD95FDF182825">
					<title>Rebate Agreement Processing in CRM  for Service Parts</title>
				</process-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">You use
rebate processing to process special discounts that are paid
retroactively to a customer. These discounts are based on specific
terms and conditions that are defined in rebate agreements. The
goal of rebates is to build long-term customer
relationships.</span>
					</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">Rebate
processing enables you to define rebate agreements and perform
accounting for rebates given during the validity period of a rebate
agreement.</span>
					</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="LAYOUT-GRID-MODE: line; mso-ansi-language: EN-US; mso-no-proof: yes">With this function you can also integrate consumable rebate
programs into the rebate processing of your parts sales
processes.</span>
					</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="LAYOUT-GRID-MODE: line; mso-ansi-language: EN-US; mso-no-proof: yes">In special consumable rebate programs, earned rebates can be used
up by returning specific unused products.</span>
					</p>
				</short-description>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="B86C887C7E6A40C78C2C29EE3AE716EF" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B5FC2BF552D84DD799653515E01F2B52">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="F6DD6FA419D44308AC0628251087CE0B" bprid="39D87218D9DF4EF8A00E1225C0F8750D" variantOf="39D87218D9DF4EF8A00E1225C0F8750D" businessArea="After Sales &amp; Services" runningNumber="CRM 224" best-practice-available="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Entitlement Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5CF2F9F3F2454E14BFE7D2EF9C0B4B00">
				<title>Entitlement Management</title>
				<bpr-element-ref ID="3C9E7BE634C043BB97304224E7290DB8" elementname="BusinessProcess" Ref="urn:bprid#39D87218D9DF4EF8A00E1225C0F8750D" OriginalMap="Automotive - Sales &amp; Service Organizations: Entitlement Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C4FC9AAA771D46ACA6B1FA5CC27703FD">
					<title>Entitlement Management</title>
				</bpr-element-ref>
				<sap-cover>1</sap-cover>
				<short-description>Enables seamless support for remanufacturing and recycling
programs, through a flexible approach to managing deposit-refund
situations in different lines of business.</short-description>
				<process-ref Ref="688DA8D079EB11D912D100306E055DA7" ID="F2A3B0AF2F7E40E294B919E1A545526C" variantOf="39D87218D9DF4EF8A00E1225C0F8750D" OriginalMap="Automotive - Sales &amp; Service Organizations: Entitlement Management in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FECC12C5D77149EEA1116CEB6F446033">
					<title>Entitlement Management in CRM</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="A78B35B7CDB041249778FD68CFEA7478" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="383F770BDB6642939C06350B8736C614">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">The Service Parts Sales scenario covers all integrated processes
tailored to the needs of the selling service parts to the market.
With this solution, you can run your salse operations in an
integrated way. All elements are closely integrated with the other
business scenarios of the Service Parts Management solution.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">The Service Parts Sales scenario is designed to serve
high volume sales operations that are typical for the service parts
business. The scenario enables you to handle huge
amounts of schedule line items and orders in a reduced time frame.
It is also designed to support you in improving your fulfillment
rate of product availability by offering improved product
availability and backorder solving capabilities. Furthermore, it
supports the typical third-party order processes to leverage the
whole distribution network. Foreign trade processes are integrated
in all the sales  processes as well.    </p>
			</short-description>
			<business-objective-ref Ref="9DE313AAAD0F49C493CA7788334B973C" ID="5908A090D16948F68A94A73CECF58CBF" OriginalMap="Automotive - Sales &amp; Service Organizations: Better service levels" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2E0F0E5BA3CD4A379D52A5B9B4751739">
				<title>Better service levels</title>
			</business-objective-ref>
