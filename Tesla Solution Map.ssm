			<kpi-ref Ref="kpi-0OPCF038" ID="821D9E9879F34554A92FCB2D67D11677" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Satisfaction Index" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="71843A2E6C674F7D9D1D90DEDDCD2722">
				<title>Customer Satisfaction Index</title>
			</kpi-ref>
			<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="02F74D33474F4AF5A8924AC97807831F" OriginalMap="Automotive - Sales &amp; Service Organizations: Automation and standardization of business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B7E76EFEA92C4BCFB6A3CBCAAF31F822">
				<title>Automation and standardization of business processes</title>
			</business-objective-ref>
			<business-objective-ref Ref="0F377A62EC8849C0BA60C0BC435A5114" ID="4075639C08FC4EB19949E7C0564B83A0" OriginalMap="Automotive - Sales &amp; Service Organizations: Collaborate with business partners" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E3B996C6DEA24DB0B14C253E57D7B1E7">
				<title>Collaborate with business partners</title>
			</business-objective-ref>
			<business-objective-ref Ref="1DA25610EA4347449E27205410C6B0E2" ID="8CEBEF4A042F45D48DA839F60FD508E6" OriginalMap="Automotive - Sales &amp; Service Organizations: Develop service offerings" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="72CFF47C68E94224B77FA174F3D75548">
				<title>Develop service offerings</title>
			</business-objective-ref>
			<business-objective-ref Ref="4020EE5AD23046F89022D3171F282A7B" ID="AA3EB5E4349441739B002D66886D6913" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve transparency and auditability of activities" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C1A1219B9D18416B8D59888D67EC8FB4">
				<title>Improve transparency and auditability of activities</title>
			</business-objective-ref>
			<business-objective-ref Ref="85BB0C47B41243DABAA52E6FE788A8EF" ID="FDD583D895574A6CBC422EB8E35B2FE7" OriginalMap="Automotive - Sales &amp; Service Organizations: Increase data transparency" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3CFDE5994B7641D0AF23A425EB0D007A">
				<title>Increase data transparency</title>
			</business-objective-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">This scenario describes
management of service contracts and warranty claim management in
the automotive industry. Claims from customers and partners such as
dealers are entered, checked and evaluated against contractual data
and all kinds of business rules which can be freely defined. The
process can be automated to a large extend to minimise the manual
effort. Accepted claims trigger subsequent processes, i.e. payment
or service operations.</p>
			</short-description>
		</business-scenario>
		<short-description>More than two-thirds of automotive customers say that the quality
and convenience of services is a key decision criteria for a brand
or a dealership. Customer service is therefore a discipline which
has most relevance for customer loyalty and retention. Consistent
communication and reliable service offerings need to be delivered
across multiple channels whether the customer contacts the brand
owner directly via an interaction center or whether the customer's
vehicle needs a service in the dealership. </short-description>
	</scenario-group>
	<scenario-group ID="70749D7CB4384F13BCCE912AB69F4DCA" OriginalMap="Automotive - Sales &amp; Service Organizations: Dealer Business Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="585E915AAEEB488A8931FAEC3B6C86FF" modified="8/14/24 08:11:28 PM">
		<title>Dealer Business Management</title>
		<business-scenario ID="6D91D83B317C4C4F8EB614076DEA3AB3" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="05F0FB3292FE4442A8207D12FD119449" modified="8/14/24 08:10:57 PM">
			<title>Customer Management</title>
			<kpi-ref Ref="kpi-0OPCF004" ID="84683BF693064FF093F1EDE4E484EAA8" OriginalMap="Automotive - Sales &amp; Service Organizations: Contact Efficiency" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="757E8931985142298B15EFE81F560DF7">
				<title>Contact Efficiency</title>
			</kpi-ref>
			<kpi-ref Ref="0E245E2C4FD04153AF104E13E2A7015D" ID="1460582CFC2A496A98B4F328F19FC3D4" OriginalMap="Automotive - Sales &amp; Service Organizations: Number of Leads Generated" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5599FB0973174ABB9D4C439398CA879F">
				<title>Number of Leads Generated</title>
			</kpi-ref>
			<kpi-ref Ref="41212EB4B5DC4E178C3A0B942B220F14" ID="8B26D1DDB46A44D9872C17293EF5856E" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Call Rate" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FE63785A50824427B1B9AE01D21940AE">
				<title>Customer Call Rate</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0OPCF002" ID="1F20CEF6B99E40E192CA8A18A868DBEA" OriginalMap="Automotive - Sales &amp; Service Organizations: Campaign/Event Cost Revenue Ratio" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="500A786BE3EB46DBA8D70D41F3F09B78">
				<title>Campaign/Event Cost Revenue Ratio</title>
			</kpi-ref>
			<business-objective-ref Ref="CC2CCE5DF5194E1EAD5F395D364DF75A" ID="CB85D858A76C4E69BF9D0D31AE23F2CD" OriginalMap="Automotive - Sales &amp; Service Organizations: Efficient sales planning and management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2D300B1E2C06458292D8D774B78D77D8">
				<title>Efficient sales planning and management</title>
			</business-objective-ref>
			<business-objective-ref Ref="4F9A7FC6709E4649A57ECE4BBD91BB2D" ID="233979D64C7A457397841FA2E0EC9C1D" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve sales lead generation and process" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="000FD4CCC1EF41CC85064870C5765F1C">
				<title>Improve sales lead generation and process</title>
			</business-objective-ref>
			<business-objective-ref Ref="232596C4A8D142939BA5D6F41B558F9D" ID="D57947F5F42F405E96B36C14BB6787E9" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve customer retention and loyalty" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="20A3E8FB1C79444FA12CE73ABC23EFA2">
				<title>Improve customer retention and loyalty</title>
			</business-objective-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">Dealers can optimize existing customer relationships and attract
prospects by having critical vehicle, sales and customer
information in an accessible and concise manner. This is vital for
sales personal to actively turn more leads into customer conquests
and satisfied customers. Solution also supports integrated office
functionality to manage customer appointments for test drives,
calls or visits, recording customer comments and work flow for
customer follow-up. Solution provides greater transparency to
analyze and react to core sales processes at a dealership. Targeted
marketing activities can also be leveraged based on data that
includes sales transactions, contact, customer and vehicle
data.</p>
			</short-description>
			<process ID="131DEBBDA3F14B0082B725708BAAB84A" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Master Data" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6A8AA7405FA24E79A6785234D635D6DE">
				<title>Customer Master Data</title>
				<sap-cover>1</sap-cover>
				<content>
					<p xmlns="http://www.w3.org/TR/REC-html40">A special designed
userinterface as part of SAP Dealer Business Management empowers
the salesstaff to review, update and maintain customer data in an
efficient way, potentially restricted to their necessary set of
data.</p>
				</content>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Contains a comprehensive set of customer specific information
that is vital for your business. Sales order data, including
incoterms and payment terms or special price agreements, are linked
to the same set of customer information as financial accounting,
bank details, and level of credit worthiness. Customer data
maintenance can be restricted via authorization for a specific user
role. For example, sales and service personnel can enter updates
from the field while still maintaining a secure, centralized
corporate financial view. This will provide one consistent,
integrated view of your customers.</p>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="75CFD69185C642D694BBFDCEBA568889" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2431C79380764EC7954C80F2F007C957">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="C3F6ED3881C141608BC494F0FC6C96B4" ID="3D8E757601274172B241B24D12054694" type="SAP" key="SAP Dealer Business Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Dealer Business Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6B5CFC49638141E783535A34B68B0BB7">
					<title>SAP Dealer Business Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="2118DBB3FC034009B945C48894EB9A18" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer and Vehicles" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="473D77338F9643C686136E5838DE8578">
				<title>Customer and Vehicles</title>
				<sap-cover>1</sap-cover>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Comprehensive
information about the customer are important for the dealer. The
user can easy and quick manage important customer information and
his relations to the dealership: vehicles belonging to the customer
and all sales transactions.  In the service operations area, the
complete service history of the vehicle, and the order history of
the customer can be accessed on one click.</p>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="171D698285854D129E6B8EC63908073D" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9C30E0FB4AF344248E5E448589E02A8E">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="C3F6ED3881C141608BC494F0FC6C96B4" ID="6B7A944F84F7451EBD6091EF9CCC0145" type="SAP" key="SAP Dealer Business Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Dealer Business Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="92D559B1A69542BDBAECD5FED62527D0">
					<title>SAP Dealer Business Management for Automotive</title>
				</product-ref>
			</process>
			<partner-opportunity-ref Ref="4043B153B04744C3B64120782B1C1CD2" ID="1C679849DC55470D8356690F36459CF1" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Data Quality Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B1ABE60C054944BA8C9DA5FF3140C619">
				<title>Customer Data Quality Management</title>
			</partner-opportunity-ref>
		</business-scenario>
		<business-scenario ID="D4C7D2AC736747A5A0AD98DF7F429612" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Sales and Administration" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A797790322FD496DAF357064D38804C2">
			<title>Vehicle Sales and Administration</title>
			<kpi-ref Ref="kpi-0OPCF011" ID="67682DDFE09B45F4B27BDE22C5365E47" OriginalMap="Automotive - Sales &amp; Service Organizations: Market Share" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EAF12D6C48BF4D5882A91CCF02E53D4E">
				<title>Market Share</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0ENCO001" ID="1256573347B14C23A78463AFAA6DCABF" OriginalMap="Automotive - Sales &amp; Service Organizations: Cost Of Capital" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A9514FDD55EE4D638923A2E81B01B85D">
				<title>Cost Of Capital</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0OPDEL010" ID="AE9F61BE71614C28BEB391AEB1393500" OriginalMap="Automotive - Sales &amp; Service Organizations: Contribution Margin Rate" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6F0A9CB37E5A48CA9CB8CDEF826D9BD2">
				<title>Contribution Margin Rate</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0ENPR046" ID="1F6CDC346CB84E45BB23BBC76C38837E" OriginalMap="Automotive - Sales &amp; Service Organizations: Revenue" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6CD82D01CCD84AD08950EEF7C5CAA694">
				<title>Revenue</title>
			</kpi-ref>
			<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="59F897EDAC14462D8CDB8E032E618E86" OriginalMap="Automotive - Sales &amp; Service Organizations: Increase collaboration (internally &amp; externally" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B0B60886F4CF45DA8AC014B6CCA4FEE0">
				<title>Increase collaboration (internally &amp; externally</title>
			</business-objective-ref>
			<business-objective-ref Ref="0E946F0D85A5474AB07FE701864D9108" ID="0C15F79132DA439B92AD91DC50B51309" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve inventory visibility" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="63553C51BC504E408D16D4492D10D5C0">
				<title>Improve inventory visibility</title>
			</business-objective-ref>
			<business-objective-ref Ref="6647E7A5976F4945A88F21E44BE301C3" ID="ACB0DCC705884410A6013C69B0E45614" OriginalMap="Automotive - Sales &amp; Service Organizations: Shorten order-to-cash cycle" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A967C1A7F0104764993F4A2D5DBC5A78">
				<title>Shorten order-to-cash cycle</title>
			</business-objective-ref>
			<business-objective-ref Ref="C2BE6D29949F4237BA3608E1F88B7547" ID="612F45090BAF4AEBB742591DF3D8E5E2" OriginalMap="Automotive - Sales &amp; Service Organizations: Increase inventory turns" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="06294DFA787A431CBB8956B29B0BA4FC">
				<title>Increase inventory turns</title>
			</business-objective-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">This scenario enables vital locate-to-order and build-to-order
processes that allow dealers to link customer requests and vehicle
orders with existing stock at their site, within the enterprise,
and in the pipeline to minimize administration, finance, and daily
operational activities of vehicle sales. Comprehensive vehicle data
administration also enables the ability to compile vehicle history
starting with planning, then sales and distribution, up to and
including after-sales processes involving warranty claims,
services, vehicle trade-in and resale. Solution also supports
definition of the retail transaction price including sales
quotation and sales order, by dealer location, customer, and brand
for newly configured vehicles and used vehicle sales. Country
specific tax calculations also satisfy legal requirements and are
settled directly in accounting. Integrated document flow from sales
order to accounting reduces manual work and improves the
transparency of the entire value chain to the dealer.</p>
			</short-description>
			<process ID="9876362C42AE4106A72A3CFEBD1CE7C9" bprid="D7A281066D674E42B793E5FAA70C489B" variantOf="D7A281066D674E42B793E5FAA70C489B" businessArea="After Sales &amp; Services" runningNumber="AUM 044" best-practice-available="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle and Vehicle Search" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8D0C85772BD1496E99FCB3D2B4D3FC80">
				<sap-cover>1</sap-cover>
				<title>Vehicle and Vehicle Search</title>
				<bpr-element-ref ID="36125F3D35E74D9F93677C9D05F2541A" elementname="BusinessProcess" Ref="urn:bprid#D7A281066D674E42B793E5FAA70C489B" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="312F765E73D04D128652DEF5C9F7D10C">
					<title>Service Order Processing</title>
				</bpr-element-ref>
				<process-ref ID="3CCECFCE43EF49B8BD2B3B0701CCD30C" Ref="A5874600A1EC11D912D100306E055DA7" variantOf="D7A281066D674E42B793E5FAA70C489B" icon="technical-variant-ref.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="570E820C351B48E3965249AE1FD814CD">
					<title>Service Order Processing</title>
				</process-ref>
				<level2-item ID="9A0A5011FF724DEC88552F74E4C82FF9" OriginalMap="Automotive - Sales &amp; Service Organizations: Fast Vehicle Search TREX" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="61E402DC48084FA7A90BAAB86251AB71">
					<title>Fast Vehicle Search TREX</title>
					<sap-cover>1</sap-cover>
					<short-description> TREX Search Engine</short-description>
					<content>
						<p class="MsoNormal" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Search
and Classification (TREX) provides SAP applications with numerous
services for searching, classifying, and text-mining in large
collections of documents (unstructured data) as well as for
searching in and aggregating business objects (structured data).
TREX processes documents in a wide variety of formats and in more
than 30 languages.</span>
						</p>
					</content>
				</level2-item>
				<short-description>
					<p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span lang="EN-US" style="mso-ansi-language: EN-US">
         The vehicle is the key focus in
the sales and service business.
         <span style="mso-spacerun: yes"> </span>
         It is used as the essential
object for all customer specific and business process related
data. Attributes of a vehicle including technical and registration
data, manuals, options, mileage, and warranties are all linked to
the vehicle and can be updated at any time.
         <span style="mso-spacerun: yes"> </span>
         Once this information is
captured, a vehicle lifecycle is created to be tracked and
monitored over time.
         <span style="mso-spacerun: yes"> </span>
         Visibility to business processes also extends to assessing the
current status of a vehicle in the distribution network to ensure
that the latest information is readily available for all required
parties in a transaction.
         <span style="mso-spacerun: yes">  </span>
         A failure-tolerant, full text search capability.allows vehicle
queries to be done by a user based on specific vehicle data.
         <span style="mso-spacerun: yes"> </span>
         A fast search vehicle engine is
also available to enable access to comprehensive vehicle
databases.
        </span>
					</p>
					<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					<br xmlns="http://www.w3.org/TR/REC-html40"></br>
				</short-description>
				<content>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				</content>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="9D46A7738CA54A5587D5125F81385917" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="572ABCC9A0FD4E9BB7DBF9FD53537FF6">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="C3F6ED3881C141608BC494F0FC6C96B4" ID="B254568BB316440DA82C77C37A2C2901" type="SAP" key="SAP Dealer Business Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Dealer Business Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="661F68E8E57148B6AC3C16A5A815D150">
					<title>SAP Dealer Business Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="BEE10A648DB443DDA46CE0C951AACCD6" bprid="E5229D7C21DE4D3E89FC1ED7248301F4" variantOf="E5229D7C21DE4D3E89FC1ED7248301F4" businessArea="After Sales &amp; Services" runningNumber="AUM 045" best-practice-available="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Procurement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4E38BCF98F4D4162BC53FA23CB93AE2C">
				<sap-cover>1</sap-cover>
				<title>Vehicle Procurement</title>
				<bpr-element-ref ID="7B2C1905743F4FF08C724C515277FE01" elementname="BusinessProcess" Ref="urn:bprid#E5229D7C21DE4D3E89FC1ED7248301F4" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Confirmation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="750972BA670A44FDB233273F4974F542">
					<title>Service Confirmation</title>
				</bpr-element-ref>
				<process-ref ID="D899F702AB7C4003AC8CF5277E89BB03" Ref="EF1FA590A1ED11D912D100306E055DA7" variantOf="E5229D7C21DE4D3E89FC1ED7248301F4" icon="technical-variant-ref.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Confirmation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="48501391BADD4F8FA2CFC194412FC7A1">
					<title>Service Confirmation</title>
				</process-ref>
				<content>
					<p xmlns="http://www.w3.org/TR/REC-html40">Dealer salesmen need
more than accurate information on the vehicle features,  in case
of a vehicle what is built for an individual customer, he needs to
promise a valid arrival date to his customer. For stock vehicles,
dealers need to have detailed information on the supply chain, what
will be delivered, what does he need to pay and profitable sell to
his market.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">SAP Dealer Business
Management includes process steps to create and change purchase
orders, process incoming invoives and goods receipts for
vehicles.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">These process steps can
also be triggered via external legacy systems.</p>
				</content>
				<short-description>
					<p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span lang="EN-US" style="mso-ansi-language: EN-US">Vehicle procurement is a business
process requiring tight collaboration and integration with the
automaker and specific brand. It involves the vehicle distribution
process to the dealer including the invoice. For the OEM, this is
where the factory touches the customer, where sales revenue and
brand equity are equally important. </span>
					</p>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="0BBD549F8518457C87CBC40A0FB28A4E" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D0ECE8856195491BB37BE9E53FDF1FF9">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="C3F6ED3881C141608BC494F0FC6C96B4" ID="1FE48FA174B04CC4A4D382A257D63E8D" type="SAP" key="SAP Dealer Business Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Dealer Business Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CC1EBE83AC6242FB9D38EEF33E7C07D6">
					<title>SAP Dealer Business Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="7A56801ABCC847D486710BEC93B9C6FB" bprid="FF072E4729EA42D2A3BFF8AB7791AD38" variantOf="FF072E4729EA42D2A3BFF8AB7791AD38" businessArea="After Sales &amp; Services" runningNumber="AUM 046" best-practice-available="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Quotation and Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B5D1C19C353A46C7ADD4A61EB9C41822">
				<sap-cover>1</sap-cover>
				<title>Quotation and Order Processing</title>
				<process-ref ID="2EC1EC1D45B94EE2869A43CDA615E410" Ref="257037E0A1EE11D912D100306E055DA7" variantOf="FF072E4729EA42D2A3BFF8AB7791AD38" icon="technical-variant-ref.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Order Split" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D46213BBBC3A477F990B55DDCAE986B4">
					<title>Order Split</title>
				</process-ref>
				<bpr-element-ref ID="283B3EC22780405BB7652A00BD2CF09E" elementname="BusinessProcess" Ref="urn:bprid#FF072E4729EA42D2A3BFF8AB7791AD38" OriginalMap="Automotive - Sales &amp; Service Organizations: Order Split" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="90A80D2B394448C79CF96A3A359AF57D">
					<title>Order Split</title>
				</bpr-element-ref>
				<short-description>
					<p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt; tab-stops: 72.0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span lang="EN-US" style="FONT-FAMILY: Arial; mso-bidi-font-size: 10.5pt; mso-bidi-font-family: 'Arial Unicode MS'; mso-bidi-font-weight: bold">Quotations are made for new and used vehicles, and created for a
customer. The referring vehicle is than reserved for that customer,
and cannot be sold to another party. Copy functions allow creating
a sales order based on the quotation for a vehicle. </span>
						<span lang="EN-US" style="FONT-FAMILY: Arial; mso-bidi-font-size: 10.5pt; mso-bidi-font-family: 'Arial Unicode MS'; mso-bidi-font-weight: bold">Customer creditability is checked during the creation of the
quotation, gives an overview on other open orders, and may block
the order for fulfillment. Detailed pricing capabilities allow
adding customer specific rebates, or special surcharges, local tax
handling, currency conversions, and much more. </span>
					</p>
				</short-description>
				<content>
					<p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span lang="EN-US" style="mso-ansi-language: EN-US">
         With the combination of customer,
vehicle, and order, users can easily access information from
various viewpoints like orders per customer or orders per vehicle
regardless if the user is simply checking customer data or creating
a new service order.  Order processing is done with the SAP DBM
order engine allowing users to trace order progress by detailed
status information at the item level. Business processes are then
executed stepwise by actions triggered by the user.
         <span style="mso-spacerun: yes"> </span>
         Process flow and control is done
in action matrices configured in the SAP system.
        </span>
					</p>
				</content>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="4A0A92E332C54BFE8AE549B9C94A0CF8" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="623640EE045B4C5DAA98C9892F531CF5">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="C3F6ED3881C141608BC494F0FC6C96B4" ID="2E1F486F6E8F45249D1272454439DB50" type="SAP" key="SAP Dealer Business Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Dealer Business Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="368DE1F4BEEA4235B4B32BCDFA8997F2">
					<title>SAP Dealer Business Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="FBCF800910DB465AA3D837B7BFB7BF83" bprid="724E7507B4F04A6FA0B8F97731AFC79F" variantOf="724E7507B4F04A6FA0B8F97731AFC79F" businessArea="After Sales &amp; Services" runningNumber="AUM 060" best-practice-available="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Order Split, Delivery and Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="13500AEB70E4406A9A36B0ECD5BCFD7D">
				<sap-cover>1</sap-cover>
				<title>Order Split, Delivery and Billing</title>
				<bpr-element-ref ID="008342A553EC4AA5A096C0253AC3D02C" elementname="BusinessProcess" Ref="urn:bprid#724E7507B4F04A6FA0B8F97731AFC79F" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing of Service Order" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="689469C1D68E4286A5CF9050DBE9BF5C">
					<title>Billing of Service Order</title>
				</bpr-element-ref>
				<process-ref Ref="257037E0A1EE11D912D100306E055DA7" ID="B6BA4714680842AC91C29D9F5237B20F" variantOf="FF072E4729EA42D2A3BFF8AB7791AD38" OriginalMap="Automotive - Sales &amp; Service Organizations: Order Split" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7C89B72D28A54086820CAD34179388BF">
					<title>Order Split</title>
				</process-ref>
				<process-ref Ref="AEF05C60B26111D912D100306E055DA7" ID="A002EF083627438F93B3960C1F561969" variantOf="724E7507B4F04A6FA0B8F97731AFC79F" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BB37A8FD5AB64FCEBE359F50E67966CF">
					<title>Billing</title>
				</process-ref>
				<short-description>
					<p class="MsoNormal" style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span lang="EN-US" style="mso-ansi-language: EN-US">Sales order splitting is important
in case of multiple ‘bill-to’ parties. Vehicle sales may also
involve upfitting, registration and other handling fees that can be
charged to the customer, to dealer cost, or other parties involved
like leasing companies. Once the order has been processed and the
customer has picked-up his vehicle, the dealer’s inventory is
updated by recording the goods movement for inventory management,
the billing document can be created and subsequent payments can be
managed. The bill is immediately posted to the dealer’s financials
to ensure visibility to open orders and missing or late
payments.</span>
					</p>
					<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					<br xmlns="http://www.w3.org/TR/REC-html40"></br>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="1047F463166343C3A6C34EF5C1F5CA81" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C992F436BD2E48D2919A79641CAEA9BA">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="C3F6ED3881C141608BC494F0FC6C96B4" ID="EA7D508B721D4FBC88206CE509E948B2" type="SAP" key="SAP Dealer Business Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Dealer Business Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D71E4D829F1E4DB2AD7AF2D14C538189">
					<title>SAP Dealer Business Management for Automotive</title>
				</product-ref>
			</process>
			<partner-opportunity-ref Ref="4043B153B04744C3B64120782B1C1CD2" ID="8BC3CF0A6DFB4881BECBBDCD48A689C6" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Data Quality Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="43960C4D579C4B7CA684C14ABCFC1B15">
				<title>Customer Data Quality Management</title>
			</partner-opportunity-ref>
			<partner-opportunity-ref Ref="8EFB0AC97FBC48D69B68B6F64F1E9825" ID="F36334DDC87F44938DF05D8541A7BCCE" OriginalMap="Automotive - Sales &amp; Service Organizations: Fleet Management &amp; Rental" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6BC1922AC1614AA093F42C714D71793D">
				<title>Fleet Management &amp; Rental</title>
			</partner-opportunity-ref>
			<partner-opportunity-ref Ref="3F34DD3DC92B49D889493065F484D728" ID="7075EAC0B87B4BAABA14FF26166A987C" OriginalMap="Automotive - Sales &amp; Service Organizations: Recidual Value Calculation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="87DC20E940CE4CACB6CEC275B157ED9C">
				<title>Recidual Value Calculation</title>
			</partner-opportunity-ref>
		</business-scenario>
		<short-description>
			<div style="MARGIN-LEFT: 2em" xmlns="http://www.w3.org/TR/REC-html40">
				<p>Across the OEM-Dealer value chain, the increasing amount of
friction created by business process and communication breakdowns
is causing OEM’s and dealers to expend substantial resources to
market, sell and service motor vehicles. This situation is
manifested in significant numbers of unsold vehicles and parts,
poor customer service and sales satisfaction scores burdening
manufacturers and dealers alike with additional costs that
ultimately impact profitability, brand equity, and most
importantly, customer value and retention.</p>
				<p>SAP Dealer Business Management is a new class of solutions that
trigger a fundamental shift in managing dealer operations for both
OEM’s, importers, distributors, and dealer groups. The solution and
its industry-specific business process platform is integrated with
SAP ERP encompassing every function of a dealer's operation,
including customer management, vehicle sales and administration,
vehicles service and parts management – plus every link in the
OEM-to-dealer ecosystem. SAP Dealer Business Management supports
the growing needs and volumes of any size automotive
dealership—from a single, independent location to a large
multi-brand, multi-location dealer group. By utilizing a single,
integrated solution, dealers and their partners can make more
informed decisions, better serve customers and execute more
efficiently across multiple brands, territories, and dealer
locations driving improved margins with processes that make it
easier for customers to buy vehicles, acquire needed services,
parts, or accessories.</p>
			</div>
		</short-description>
	</scenario-group>
	<hyperlink ID="3D8F379796C84A388349BA937A5E3A63" href="" icon="netweaver.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Powered by SAP NetWeaver" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0EDF5398D99B42378DA167C7F6F65D07">
		<title>Powered by SAP NetWeaver</title>
	</hyperlink>
	<folder ID="66711E54257E4525BC81C2CDCCCB4DCF" xmlns:smc="http://www.sap.com/ns/smc" OriginalMap="Automotive - Sales &amp; Service Organizations: Enterprise Management &amp; Support" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0FA0E2119C6746E18A2B4A960E226025">
		<title>Enterprise Management &amp; Support</title>
		<level0-item ID="3A4C78D9A4A84900905B1F60CD25093B" OriginalMap="Automotive - Sales &amp; Service Organizations: Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="36088FCC1B914FD2BDB35BB3C6149F6F">
			<title>Analytics</title>
			<level1-item ID="F54D6508CD57415BB7D3650E3B3964A9" OriginalMap="Automotive - Sales &amp; Service Organizations: Financial Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A064603234364264ADF7F7A04A0A54FD">
				<title>Financial Analytics</title>
				<process ID="7DA309D963FA4010A33A0BF624E75F2A" OriginalMap="Automotive - Sales &amp; Service Organizations: Financial and Management Reporting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="00BB14AF9A304FE5B7E424B711AC05BE">
					<title>Financial and Management Reporting</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="0C41CE9517374BDDAAC2A1EB79F806CE" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9854986016114EE6A27078E27CF16702">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Includes a series of
standard analyses to meet the needs of all users ranging from the
chief financial officer to individual line managers and sales
assistants responsible for improving the contribution margin for an
individual market segment. Examples of financial reports include
financial statements, asset reports, accounts receivables and
accounts payable, and inventory statements. Examples of management
reports include operating expenses per cost center/business
process/service, cost of goods manufactured per product, and
contribution margins per market segment.</p>
					</short-description>
				</process>
				<process ID="CF03CD406B524794AA90B8ECDD5EBF6F" OriginalMap="Automotive - Sales &amp; Service Organizations: Financial Planning, Budgeting and Forecasting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="53E985793570489AB44E2219DD1121CB">
					<title>Financial Planning, Budgeting and Forecasting</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D971B0CDC8894ED7AD994F8B1539CABD" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0B4B1987ECA54E2FBF3938D169D77B6F">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma">Provides strategic
planning of financial results for multiple years based on generic
and/or business-specific value drivers. Allows you to
collaboratively plan the profit &amp; loss statement, balance
sheet, and cash flow statement, to accelerate this complex process.
Supports a structured entry of capital requirements by
organizational unit.</span>
							<br></br>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma">Provides an
analytical planning workbench to model planning scenarios as well
as preconfigured planning applications for a quick start of
operational planning (for example, cost center planning and sales
planning). Supports traditional budgeting and rolling forecasts and
collaborative planning. Data integrity is ensured, and planning
cycles are reduced dramatically using workflow and status
tracking.</span>
						</p>
						<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma">For a complete overview
about SAP functionality in this area, see also the SAP Business
Planning and Consolidation application within SAP Corporate
Performance Management (CPM).</span>
          
        </p>
					</short-description>
					<process-ref Ref="353E2C80CE8C11D8265800306E055DA7" ID="F0BFB94EE1F74472983D9DED890BDF0D" variantOf="EA54107D3C2F46458614AC49CBE63419" OriginalMap="Automotive - Sales &amp; Service Organizations: Strategic Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A719CD470360431494D671B9D84B4DB7">
						<title>Strategic Planning</title>
					</process-ref>
					<process-ref Ref="64FAF4D14BB54D12886FD8B9CA26C991" ID="F1E37BD81542431C83E509CD0288A6B4" variantOf="C50AB542B67B4816B24DDAF0C21957C6" OriginalMap="Automotive - Sales &amp; Service Organizations: Financial Statement Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1C7AF3C9AB864757A16C554DA5167894">
						<title>Financial Statement Planning</title>
					</process-ref>
					<process-ref Ref="4C66B4610FB84B0CB6FF2183FD577A15" ID="C39E4D7AFD134DC1B59BEBA043BAADD1" variantOf="2BB1095BD8754128BEE3159EEC2C4B49" OriginalMap="Automotive - Sales &amp; Service Organizations: Investment Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="290F01107A034F82BCB495CF39E21D8D">
						<title>Investment Planning</title>
					</process-ref>
					<product-ref Ref="19CF60A17A5B48EA94514D01A68430C7" ID="CD0FA9C20EC3455DB1DED4E80A627284" type="SAP" key="SAP Business Planning and Consolidation" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Business Planning and Consolidation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5C9F431E2B704AE38E4FCF1FA05D7F0F">
						<title>SAP Business Planning and Consolidation</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="F4C9F847F74A42D28410CA9AE370AB99" ID="34E545C965FF444490FA69280E19E699" OriginalMap="Automotive - Sales &amp; Service Organizations: Extend market share" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B8C12E97C1364542AC484383A1DD6CB2">
					<title>Extend market share</title>
				</business-objective-ref>
				<business-objective-ref Ref="790D124164E6495D99C9DF78901ADB08" ID="034BCF753E244130B577CE12A384353F" OriginalMap="Automotive - Sales &amp; Service Organizations: Maximize profitability by customer" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F60A366F324B4115BDC6F8673FB0D8DD">
					<title>Maximize profitability by customer</title>
				</business-objective-ref>
				<business-objective-ref Ref="DCF69F3072F942F6BFCF61799AD935D0" ID="39B5FBE02C994202818484AE31DA2075" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve asset and maintenance management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="494969412D564A19A10975BE41AA802F">
					<title>Improve asset and maintenance management</title>
				</business-objective-ref>
				<process ID="A66EB83BF2914F369E39A0F02B6A2CB4" OriginalMap="Automotive - Sales &amp; Service Organizations: Profitability Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C6D32D51977D4616BD62C104A16A4D36">
					<title>Profitability Analytics</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="DACC8AEC984447E785F515E4FD80864B" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8810C74C3E9648769DD3F12701955AEF">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="1C19AFB3A573459FB17FF9075EB5" ID="B2E562B286EC4F0A9C0E7BF3F622DE43" variantOf="164D8D28E9DA48F091D9E17F59B044C0" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Profitability Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CA63C8FCEE474C43A6F503096D311370">
						<title>Profitability Analysis in ERP</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Allows you to analyze
the profitability of your products and services by multiple
dimensions, such as customer and region. Provides in-depth cost
analysis, which leads to a better understanding of the
profitability of your products and services. Integrates the
embedded profitability planning capability with other planning
applications.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma; mso-bidi-language: AR-SA; mso-fareast-font-family: 'MS Mincho'; mso-ansi-language: EN-US; mso-fareast-language: JA">For a complete overview about SAP functionality in this area, see
also the SAP Business Profitability Management by Acorn application
within SAP Corporate Performance Management (CPM).</span>
						</p>
					</short-description>
					<process-ref Ref="4E01B6E3FB32479DA8E50720A9169372" ID="B8E367543248487CB11374014CED6B7F" variantOf="96B6AB1B5BEA4A1693C8E5B7342CC10F" OriginalMap="Automotive - Sales &amp; Service Organizations: Profitability Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="44DA43165EFF428BB073688109E14EC0">
						<title>Profitability Management</title>
					</process-ref>
					<product-ref Ref="19CF60A17A5B48EA94514D01A68430C7" ID="73C4621F0D494BFF9725FBAA78209865" type="SAP" key="SAP Business Planning and Consolidation" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Business Planning and Consolidation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7A4F104D790C4E6F8DFF2BE5BAC1D201">
						<title>SAP Business Planning and Consolidation</title>
					</product-ref>
				</process>
				<process ID="CDD474115382422F8D2B500EC2DB3C3E" OriginalMap="Automotive - Sales &amp; Service Organizations: Product and Service Cost Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BB58485E365246AA833A6F8552DA6BAF">
					<title>Product and Service Cost Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="B0C4D061644E4021BED18A20D833A2A2" ID="2C6641D2E31644E59C6041B7C57D8CB3" variantOf="967FCA6062AF42D5957C7DEBC770F2C3" OriginalMap="Automotive - Sales &amp; Service Organizations: Product and Service Cost Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A2041A00BACF4ECB921AB81735B5DBB0">
						<title>Product and Service Cost Analytics</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="1D6EA22056AB4685BD9F8D55FCF967FD" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="568A9B0B73A34E98A319B724FA895469">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="76F727A40F2D4E609F05682C80DFC9D3" ID="1781B42E005A48299EB57FD33120C5AE" variantOf="C0683C9DC39A4DA79DDBB83C07BAD6B8" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Design Cost Estimate" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CCAA00A4B805440D9B567ED6262B19B1">
						<title>Product Design Cost Estimate</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Enables you to know the
costs incurred by your products and services. Breaks down the costs
for each step of the production process. Involves lot-based and
periodic cost management at the level of orders and materials as
well as the level of individual sales document items. Interfaces to
a simulation-oriented costing platform and provides input for
re-engineering and product design cost estimate.</p>
					</short-description>
				</process>
				<process ID="89D801CE807247339411FE2D75C2AA6D" OriginalMap="Automotive - Sales &amp; Service Organizations: Overhead Cost and ABC/M Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C94911A9EE0C402EA000EDA587EBE607">
					<title>Overhead Cost and ABC/M Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="8D8214103AAB4180B6C2013AB31D0F99" ID="CDF1A9119FD3450E972DF222A8150080" variantOf="C0683C9DC39A4DA79DDBB83C07BAD6B8" OriginalMap="Automotive - Sales &amp; Service Organizations: Overhead Cost and ABC/M Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="54803E4226FA45D8BCCE39C4A54ED544">
						<title>Overhead Cost and ABC/M Analytics</title>
					</process-ref>
					<process-ref Ref="76F727A40F2D4E609F05682C80DFC9D3" ID="0027F052DCCD4B21A0158E66CE75AE47" variantOf="C0683C9DC39A4DA79DDBB83C07BAD6B8" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Design Cost Estimate" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="55295EE1822445A59DE6104A30797412">
						<title>Product Design Cost Estimate</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="9DC0FD16305C4EE3B375FC56320F1C8D" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1BC9A551F2014D5CAA0A3E01481BC77F">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Supports various
methodologies for the assignment of overhead costs to cost objects,
ranging from pro rata allocations of period expenses to causal cost
assignments, or Activity Based Costing using drivers tracked in the
ERP system. This provides allocation methods to suit your business
needs and allows fast implementation with reduced cost.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma; mso-bidi-language: AR-SA; mso-fareast-font-family: 'MS Mincho'; mso-ansi-language: EN-US; mso-fareast-language: JA">For a complete overview about SAP functionality in this area, see
also the SAP Business Profitability Management by Acorn appliation
within SAP Corporate Performance Management (CPM).</span>
						</p>
					</short-description>
					<product-ref Ref="19CF60A17A5B48EA94514D01A68430C7" ID="204E4935379F4D99956DCF29340A3B2F" type="SAP" key="SAP Business Planning and Consolidation" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Business Planning and Consolidation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AB12179F3B9743BA97AD8938CD35BF50">
						<title>SAP Business Planning and Consolidation</title>
					</product-ref>
				</process>
				<process ID="01CBFD8DE2AF4B51AF80E2EDC340AFEF" OriginalMap="Automotive - Sales &amp; Service Organizations: Payment Behavior Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="155A490116E54B14B32AE562D943654C">
					<title>Payment Behavior Analytics</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="A043BD3A34CC4E4180A2EA77C02E086A" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5B6079B6CAE34E9E9940DCAB426097DF">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Provides support for the
management of receivables via the analysis of the payment history.
Determines the days sales outstanding (DSO) as a basis for the
optimization of payment conditions.</p>
					</short-description>
				</process>
				<process ID="2FE5051C8C244C46B5FADBE5172E79C7" OriginalMap="Automotive - Sales &amp; Service Organizations: Legal and Management Consolidation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E50A2085F1534F31ACB8E0035680B8CB">
					<title>Legal and Management Consolidation</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="40E2BAB0206845F4AB64B2B34A7FE68B" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2C3BB3DAAB8F4441B708B4C3E805A1CA">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="F5B0D792B022484D853E2A960F21A5C2" ID="B08DA390BA6C4F34A440B6AD2077F8A1" variantOf="8D6835555388492CAC231CC101C4C9C1" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Group Close" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FCBE60BA94734F4D948558930666AF51">
						<title>Group Close</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Enables you to fulfill
statutory requirements according to multiple GAAPs and provide
up-to-date information to management. Includes comprehensive
accounting functions operating on multi-dimensional data
structures. Customer-definable organizational units (for example,
companies, business areas, and profit centers), support for matrix
organizations. Monitor for the graphical control of the entire
process from data collection through consolidation. Decentralized
access to the consolidation system.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma; mso-bidi-language: AR-SA; mso-fareast-font-family: 'MS Mincho'; mso-ansi-language: EN-US; mso-fareast-language: JA">For a complete overview about SAP functionality in this area, see
also the SAP Business Planning and Consolidation application within
SAP Corporate Performance Management (CPM).</span>
						</p>
					</short-description>
					<product-ref Ref="19CF60A17A5B48EA94514D01A68430C7" ID="639DA175AA9B473285A1D25930DF9E9E" type="SAP" key="SAP Business Planning and Consolidation" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Business Planning and Consolidation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="53EE6B9252AA40CCACB517EB60971EC1">
						<title>SAP Business Planning and Consolidation</title>
					</product-ref>
					<process-ref Ref="2B91653C6C995B6FE10000000A114AB6" ID="CF7F55B37B144D0EA80197AD867E3054" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Group Close with EC-CS" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6045DFFF22284597817A09713C490E44">
						<title>Group Close with EC-CS</title>
					</process-ref>
				</process>
				<process ID="E6905171332F471284C4B4C0B8799090" OriginalMap="Automotive - Sales &amp; Service Organizations: Balanced Scorecard" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="90853F0235694F8985C0E18FD42E1772">
					<title>Balanced Scorecard</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="67F79A8784BA4563B49DE52178BC2013" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A1D59A596E164B8E88CB9C3D04C3D640">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="BFAD531205AA49A8A5C49A4EED28" ID="27DC4CA7BF4D4F50B326535B520B5A57" variantOf="FEFC8A7CC5FE40A58ABE42A1417B053C" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Strategy Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8E7893B76C3B4D1596E6F815082302F6">
						<title>Strategy Management</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="0AF855E0CE8C11D8265800306E055DA7" ID="E36E28B4D7C2428688B9BC08E90DE354" variantOf="9D5FF372DD4845BC813545D0C37D83B2" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Based Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="02F4790075AC44E0ACA41582369644FB">
						<title>Value Based Management</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma">
          Helps operationalize
your strategies through translation into strategic objectives,
targets for qualitative / quantitative measures and resource
allocation via strategic action programs (initiatives). Value-based
management provides the effective link between strategy,
measurement, and processes to create shareholder value.
          <br></br>
							</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma">For a complete overview
about SAP functionality in this area, see also the SAP Strategy
Management application within SAP Corporate Performance Management
(CPM).</span>
						</p>
					</short-description>
				</process>
				<process ID="DD401C2D8FB5447BAE5473BAFADE73D4" businessArea="Finance" responsibleOrgUnit="ERP" runningNumber="ERP 082" variantOf="6DF80E5AF7FA4410A298B0EFF79111F1" OriginalMap="Automotive - Sales &amp; Service Organizations: Risk Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="695BBB3AC56C44CE9C60C5CF921034C5">
					<sap-cover>1</sap-cover>
					<title>Risk Management</title>
					<bpr-element-ref ID="CAF1D2F110774B0FAEDBD03BA74CC5C2" Ref="urn:bprid#6DF80E5AF7FA4410A298B0EFF79111F1" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Risk Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="988BBAF8BCFE4698A290EFC9BE457FD5">
						<title>Risk Management</title>
					</bpr-element-ref>
					<process-ref Ref="D1D771A808FF423F904ED477BA51" ID="48AA129973B3406EA996FF15A55D77F3" variantOf="6DF80E5AF7FA4410A298B0EFF79111F1" OriginalMap="Automotive - Sales &amp; Service Organizations: Risk Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="59F2A6A755CB492798995792355FAE47">
						<title>Risk Management</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="C4115E4B7C914F1289B9E0A9B9991CE7" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="294A61DEC1FD4FB297A7F50551B9585D">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Addresses the need for
an enterprise to perform reliable risk management - a requirement
that is becoming increasingly important. Organizations must
constantly keep up with new commercial and corporate legal
regulations, as well as inherent market and operational risks.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma; mso-bidi-language: AR-SA; mso-fareast-font-family: 'MS Mincho'; mso-ansi-language: EN-US; mso-fareast-language: JA">For a complete overview about SAP functionality in this area, see
also the Risk Management application within SAP Governance, Risk
and Compliance Management (GRC).</span>
						</p>
					</short-description>
					<product-ref Ref="D34F3CC5FC784FBBAC92C567195B8BAF" ID="9BA04BCEFC99446EB3CC479B3DE69113" type="SAP" key="SAP GRC Risk Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP GRC Risk Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FA865AE0390643A2A12C9CB9EAA50086">
						<title>SAP GRC Risk Management</title>
					</product-ref>
				</process>
				<process ID="EC1C75229A1A49458DAAC836C1CB941C" OriginalMap="Automotive - Sales &amp; Service Organizations: Management Cockpit" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9EB6FDFED27141C6A2C8D084D9FACA4D">
					<title>Management Cockpit</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="9CE37CFE626F48C8ACA528D6AE4993AA" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CC9C7032C79D470C9BDDF516BCC1DBA6">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="738C56B0CE8C11D8265800306E055DA7" ID="CBEE70C5F57D4641A0F7385C46704E1E" variantOf="E061EB1F143E43B39780966A795BE77A" OriginalMap="Automotive - Sales &amp; Service Organizations: Performance Measurement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D847440135CA41AEAEAC0DCBD7C33843">
						<title>Performance Measurement</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Enables you to display
measures in an ergonomically suitable way. The exception-based
analysis function allows middle to senior management to quickly
assess the business performance of business units.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma; mso-fareast-font-family: 'MS Mincho'; mso-fareast-language: JA; mso-ansi-language: EN-US; mso-bidi-language: AR-SA">For a complete overview about SAP functionality in this area, see
also the SAP Strategy Management application within SAP Corporate
Performance Management (CPM) and functionality available in SAP
NetWeaver.</span>
						</p>
					</short-description>
					<process-ref Ref="2FE5051C8C244C46B5FADBE5172E79C7" ID="2D6DE26425DA4738BA6AA0625A08C100" OriginalMap="Automotive - Sales &amp; Service Organizations: Legal and Management Consolidation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6A697E51B3DC41F780C2895021DB256F">
						<title>Legal and Management Consolidation</title>
					</process-ref>
				</process>
				<process ID="59715B06C1204590A2E36A84291BD73C" OriginalMap="Automotive - Sales &amp; Service Organizations: Corporate Investment Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FA263CB6856C4B21914F0CFEB746CCF4">
					<title>Corporate Investment Management</title>
					<partner-cover>4</partner-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Manages corporate master data (such as details on legal
entities) and relationships to and between individuals (such as
board members or auditors). Manages ownership relationships for
subsidiaries and minority-owned entities with details on
investments, equity, and shares. Supports the investment process
including integration to Financial Accounting and Consolidation
capabilities. Supports data collection and KPI reporting for
entities. Encompasses legal and statutory reporting on ownerships
and relationships.</p>
					</short-description>
					<product-ref Ref="ECA08BBDC43A4DD59BFFBDFBC5E098A0" ID="AA9317DC07EC4CF8BD45F8389A895AEE" type="partner" key="zetVisions - zetControl Corporate Investment Management (CIM)" OriginalMap="Automotive - Sales &amp; Service Organizations: zetControl Corporate Investment Management (CIM) 1.5. by zetVisions" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F1D4C24A3D664C2582BF98EA800D5940">
						<title>zetControl Corporate Investment Management (CIM) 1.5. by zetVisions</title>
					</product-ref>
				</process>
				<folder ID="213B90A2E23944B084433A2E674DBFF9" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Collaterals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C9BFFB19AEEA45669EA015544749A14F">
