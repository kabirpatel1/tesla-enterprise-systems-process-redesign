			<business-objective-ref Ref="8064C226B9B64E9F8117021EFA17CAD0" ID="F009B13B5E1043308FB52C3EF91624FC" OriginalMap="Automotive - Sales &amp; Service Organizations: Gain market share with new products and brand extensions" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="30CE022A800A4F8FBA9B18F6DB7BA49D">
				<title>Gain market share with new products and brand extensions</title>
			</business-objective-ref>
			<business-objective-ref Ref="4F9A7FC6709E4649A57ECE4BBD91BB2D" ID="E42387B4BB174CB79A58A8899FB88536" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve sales lead generation and process" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1650FC8667674F3088C721D566C158CB">
				<title>Improve sales lead generation and process</title>
			</business-objective-ref>
			<business-objective-ref Ref="DCF69F3072F942F6BFCF61799AD935D0" ID="E93B8B49B0CA449596103B5AD4DFD612" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve asset and maintenance management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6E6843ABE6464D42AF46D0DFA12EF489">
				<title>Improve asset and maintenance management</title>
			</business-objective-ref>
			<business-objective-ref Ref="662F6DC8CD3D4189A5E56B6C1596649A" ID="A9C1637B88F344A8B70A2B877B46023D" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce cost of services" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="527EF45EF85C4FCAA54A35B93ACD2D8C">
				<title>Reduce cost of services</title>
			</business-objective-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">The asset finance and
leasing capabilities provide seamless, integrated vehicle leasing
support from start to finish. Companies can use these capabilities
to manage current leasing processes, adapt to new practices,
collaborate with business partners anywhere in the world, and cut
costs. The scneario includes fully integrated contract and
financial capabilities, which support the following:</p>
				<ul xmlns="http://www.w3.org/TR/REC-html40">
					<li>Integration with individual vehicle objects</li>
					<li>Multiple currencies</li>
					<li>Automatic lease classification</li>
					<li>Individually determined billing methods</li>
					<li>Automated accrual activities</li>
					<li>Automated inception processes</li>
					<li>Automated fixed-asset updates</li>
					<li>An integrated, flexible, and comprehensive pricing model</li>
				</ul>
			</short-description>
			<kpi-ref Ref="kpi-0OPCF038" ID="09A30F4ADB2947C79F02DF91807FCB6A" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Satisfaction Index" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="807F8B12DD3346B2A2DD619A2902DBFF">
				<title>Customer Satisfaction Index</title>
			</kpi-ref>
		</business-scenario>
		<short-description>In the highly competitive automotive industry, companies must fight
hard to attract prospects, win new customers, and create a trusted
relationship which leads to life-time customer retention. When
customers buy a vehicle today they look for individual mobility, as
well as for a brand image which meets their lifestyle. Therefore
Brand Equity Management is one of the core processes for OEMs and
importers playing in the automotive market. Besides managing
customer relationships it is also important to manage relationships
to the vehicle itself, and, as vehicles are sold through an
indirect channel, down to the dealership network. A tight
collaboration with the dealerships is key for achieving an
excellence in sales &amp; service processes and thus winning market
shares.</short-description>
	</scenario-group>
	<scenario-group ID="79305AA30C1E4B978EC39A27B9650B23" integrated-with-supplier="true" integrated-with-consumer="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F8BEF59621F949AC9373744B17CF19F8">
		<title>Vehicle Management</title>
		<business-scenario ID="757318966F45468781068EF1970D1647" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Planning &amp; Forecasting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="55DA297F74444269A97DE7AA7EFA024A" modified="8/14/24 08:06:43 PM">
			<title>Vehicle Planning &amp; Forecasting</title>
			<kpi-ref Ref="kpi-0OPPLAN008" ID="7D9875EF4D584753832AF9DC4886AF0D" OriginalMap="Automotive - Sales &amp; Service Organizations: Forecast Accuracy" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0FE6082FBBBF4685A61686378A273A4C">
				<title>Forecast Accuracy</title>
			</kpi-ref>
			<business-objective-ref Ref="CBAB3ED1502C4060A56ADFEA376D70DB" ID="9D20FC7763EA4715829C4A55345E1FF2" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve forecast accuracy" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6F09363E82ED4F078C6F33E1D24D646E">
				<title>Improve forecast accuracy</title>
			</business-objective-ref>
			<process ID="E8D034285909473092AEF63BE0DA8B7D" businessArea="Logistics" processOwner="Stefan Theis" responsibleOrgUnit="BSG M ASM Solution Management" runningNumber="SCM 002" solmanAvailability="1" variantNumber="0" OriginalMap="Automotive - Sales &amp; Service Organizations: Business Planning &amp; Simulation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C6CD26EEEF8A42BAAB2619D14D2AE35E">
				<title>Business Planning &amp; Simulation</title>
				<process-ref Ref="46A8BFF366E04740B08F6CA2F5D92667" ID="144B459A294544E390E985B294C63C61" variantOf="5BD7EFDEAD6343BFB1183452243A8212" OriginalMap="Automotive - Sales &amp; Service Organizations: Demand Planning and Forecasting" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="965D01068B5342A892E734D1A4DD402C">
					<title>Demand Planning and Forecasting</title>
				</process-ref>
				<short-description>Toolbox with flexible interactive planning possibilities, to create a demand plan on any level of detail. Promotion Planning capabilities are included. Different forecasting algorithms and flexible macros, to carry out any kind of calculation or check, are offered as well as collaboration possibilities.</short-description>
				<sap-cover>1</sap-cover>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="39B49F05A54C405D8034ACDD47301FCB" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4367966EE8FA403DB6F7A1928153E01B">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="0E664D5A772F424A975B3904F4F9BCC2" ID="A1292905DED34B6FAB03AEA0F156A9CA" type="SAP" key="B47" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP NetWeaver" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4BF375F1727B434995813B263E3540A7">
					<title>SAP NetWeaver</title>
				</product-ref>
			</process>
			<business-objective-ref Ref="DECD4E771AC24E749C94DCF0779B6C74" ID="78BA18BDE03B4FAF99E24CE76D389CF4" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve capacity utilization" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A23359A04C784903AAACABCC72B2A314">
				<title>Improve capacity utilization</title>
			</business-objective-ref>
			<kpi-ref Ref="kpi-0OPMAKE004" ID="4CC2422C5B4D41AEA2FB41151071B2E6" OriginalMap="Automotive - Sales &amp; Service Organizations: Capacity Utilization" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5064664BB5CE4E02B69D6186918F2813">
				<title>Capacity Utilization</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0OPPLAN004" ID="C7F72F9AA0C44F4F8BF3A74F86171EC4" OriginalMap="Automotive - Sales &amp; Service Organizations: Demand, Supply Planning Costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="143041EF03024810B3C0C8ABE3951DE4">
				<title>Demand, Supply Planning Costs</title>
			</kpi-ref>
			<process ID="BC2974E0B33342909C5AC0586D1013EF" businessArea="" responsibleOrgUnit="BSG M" runningNumber="CPF 024" variantOf="F81E478BED6342EA97AD93EED7642A89" OriginalMap="Automotive - Sales &amp; Service Organizations: Collaborative Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="453148CC61B141F8892B5AC16850C3C2">
				<title>Collaborative Planning</title>
				<bpr-element-ref ID="E83EB51328934C4FB540DD067D91326C" Ref="urn:bprid#F81E478BED6342EA97AD93EED7642A89" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Collaborative Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B4A1590AE5794C028A32150C1B730150">
					<title>Collaborative Planning</title>
				</bpr-element-ref>
				<process-ref Ref="E93207405CDD4BF295C5703557F7AED7" ID="35BFA6234FAC491CA25A46FBD9C399A3" variantOf="F81E478BED6342EA97AD93EED7642A89" OriginalMap="Automotive - Sales &amp; Service Organizations: Collaborative Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8987D44E3C88480698A073067FB92BC0">
					<title>Collaborative Planning</title>
				</process-ref>
				<short-description>Integrates web-based collaborative planning with portal technology. Allows several parties to take part in the planning process.</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="8856F0A7A9864AF4A8AF0D22B485963A" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="85F1182EA7EA4CAC9AB64A18B3CD53A5">
					<title>SAP ERP</title>
				</product-ref>
				<sap-cover>1</sap-cover>
				<product-ref Ref="24040719A2984CB2ABB2D895A7B11BD3" ID="196A37E1B08846C68E7D21F91F015AAA" type="SAP" key="SAP Sequenced Manufacturing for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Sequenced Manufacturing for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6758ECE6BB5B4D7CB1E919FDE320FBEC">
					<title>SAP Sequenced Manufacturing for Automotive</title>
				</product-ref>
				<product-ref Ref="0E664D5A772F424A975B3904F4F9BCC2" ID="4DD5949BFFEF4A1DB8D4FAA91E58ECD9" type="SAP" key="B47" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP NetWeaver" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4A462FD64ABD4212B01F4FAF1580CE5F">
					<title>SAP NetWeaver</title>
				</product-ref>
			</process>
			<process ID="AC44D92207554879B0B40EB0993A39E9" OriginalMap="Automotive - Sales &amp; Service Organizations: Planning based on fully configured Orders" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="071E80F8C6244AA7A790CE4B2A643A07">
				<title>Planning based on fully configured Orders</title>
				<sap-cover>2</sap-cover>
				<short-description>Planning based on fully configured orders is a mid-term planning
process which is typically used for highly configurable products
with a high number of product characteristics and dependencies. It
is used to establish a feasible mid-term plan based on orders
which are buildable. In addition it enables to verify and
adjust the resource and constraint situation. </short-description>
				<product-ref Ref="24040719A2984CB2ABB2D895A7B11BD3" ID="3D83A0712DEF4F688C224FD976987C71" type="SAP" key="SAP Sequenced Manufacturing for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Sequenced Manufacturing for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="22EF251599844EADBD5AB56A35737104">
					<title>SAP Sequenced Manufacturing for Automotive</title>
				</product-ref>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="936500C48E9D4A0E8FB08D8EA000F7A3" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="12B34415FA304F84B3F4D4A243D4E08F">
					<title>SAP ERP</title>
				</product-ref>
			</process>
			<short-description>
				<P xmlns="http://www.w3.org/TR/REC-html40">This scenario enables the alignment of sales and manufacturing/procurement from a planning perspective in a mid-term or long-term view. It includes the collaborative planning and forcasting of sales activities as well as the vehicle manufacturing or procurement. Manufacturing oriented planning is typically done for fully configured vehicles or on option level.</P>
			</short-description>
			<business-objective-ref Ref="F86420AFDDB1484988CB9EDB502B3913" ID="8DAF76D2BFCB4BA1A3A5F9451AEF8272" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce inventory levels" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="383D9F5474F94996B116478A0FDCB0C8">
				<title>Reduce inventory levels</title>
			</business-objective-ref>
		</business-scenario>
		<content>
			<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
		</content>
		<short-description>
			<p xmlns="http://www.w3.org/TR/REC-html40">Vehicle sales &amp;
distribution in the Automotive industry are highly flexible and
complex. Furthermore they are subject to change due to new
regulations and the increasing need to improve customer
satisfaction in the vehicle buying experience. It requires high
visibilty in monitoring and optimization for retailing processes in
order to improve their efficiency and decrease the cost.</p>
		</short-description>
		<folder ID="BB2F8E6BD0324D5FAAAD14B4F1C7959D" OriginalMap="Automotive - Sales &amp; Service Organizations: Order-to-Delivery" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4E9CDE351D4D4E13B239145873ED72F1" modified="8/14/24 08:07:46 PM">
			<title>Order-to-Delivery</title>
			<business-scenario ID="4492683403EE4B13BFBE980D7090ECC7" bprid="CC5473414A719C6FE10000000A114AB6" BPR-Status="" best-practice-available="false" responsibleOrgUnit="BSG M" OriginalMap="Automotive - Sales &amp; Service Organizations: Order-To-Delivery (Locate-To-Order)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DE88CC37E77A471E8D02A0F48681349B" modified="8/14/24 08:08:10 PM">
				<title>Order-To-Delivery (Locate-To-Order)</title>
				<bpr-element-ref ID="FBCE0E567B58489FA00B992A13E721A1" elementname="Scenario" Ref="urn:bprid#CC5473414A719C6FE10000000A114AB6" OriginalMap="Automotive - Sales &amp; Service Organizations: Order-To-Delivery (Locate-To-Order)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="63682AC76A7646E69AAAB50EFCE72BC3">
					<title>Order-To-Delivery (Locate-To-Order)</title>
				</bpr-element-ref>
				<process ID="7556F51D3F594084A88856EF84D44C6C" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Search" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A958563226A148FEB4954CD9451A34BD">
					<sap-cover>1</sap-cover>
					<title>Vehicle Search</title>
					<process-ref icon="process-ref.gif" ID="2A380F21D2464219AEB04D079C2E80B7" Ref="CDF4EC80F4DD11D812D100306E055DA7" variantOf="D27F23F131FA461E9096A5DFCE77190F" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Search" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F023CA5B993447119A848A19FD400883">
						<title>Vehicle Search</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">You use the vehicle search to search for vehicles in your vehicle stock that fulfill certain criteria (e.g. status, availability, configuration, etc.).</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="5194244E53C94043AD3C8FB6FE7129D6" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AADF2FCF6FA6460EB3D2DEFF01E049B2">
						<title>SAP Vehicle Management for Automotive</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="2452D4AFC6DE412BA94CB61A942F0DF6" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="92FA3601343C47E78E7722880BE6D0EC">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="91B8967FE30048839463D09FA403E5BB" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Reservation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0AFED3E607A041E088334429BF388C45">
					<sap-cover>1</sap-cover>
					<title>Vehicle Reservation</title>
					<process-ref icon="process-ref.gif" ID="205ABB80F78049B88E6EC77FC03E3E86" Ref="7F249D60F4DF11D812D100306E055DA7" variantOf="05A0656DC1054FDB84DE3CD73EBB18A2" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Reservation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B1E0FFB615A24980B6C9F9FDA61DAC52">
						<title>Vehicle Reservation</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">The reservation process can be used by both importers and dealers. With this process dealers begin the sale of vehicles, which ends in a sales order. Importers can assign an amount of vehicles to individual dealers. Dealers can set reservations to assigned vehicles. Using this process importers can assure a fair reservation management of vehicles for their dealers.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="0CA2CB4C50584C32A7321C12A952BFFE" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CC10AF61C2B842D5A4EEDA9AEA356CB3">
						<title>SAP Vehicle Management for Automotive</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="90709DA8593546409C8902672F21A879" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7F32035A0C9D40DBB5FC802DE2484945">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="FA3C546436FD4B2FBCB1F9E1D03DD64C" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Delivery" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9F964CE15F674C2492E41E66C592AB24">
					<sap-cover>1</sap-cover>
					<title>Vehicle Delivery</title>
					<process-ref icon="process-ref.gif" ID="3D46D459A3B94811A5DDCBD96C918A4C" Ref="1189F761F28B11D812D100306E055DA7" variantOf="586DF8D7FBED431E8A0900861297C672" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Delivery" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="16D58AE0E7DB43E1A42B127FAEF6087F">
						<title>Vehicle Delivery</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process to initiate the delivery of your vehicles to your customer, e.g. your dealer, sales organization, etc. By sending the delivery documents you transfer all shipping relevant information to your dealer or your logistics partner.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="E57C5759061A4018BBD656645DFA8223" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BB98BC73093346BF9679A29B190C195B">
						<title>SAP Vehicle Management for Automotive</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="A030338AD91045AEBC3B8CFB2CA833F2" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DAE2146F43CB4FBBA429CD953A65839D">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="1291FA7EB09E48ADADE146E0278585FA" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Order Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="76994C5F78E04BFDAAE173A9995D0DBA">
					<sap-cover>1</sap-cover>
					<title>Vehicle Order Management</title>
					<process-ref icon="process-ref.gif" ID="81E5E9BEA6BB47678C7DC6B929FE86D3" Ref="0BB7BEB0D72611D812D100306E055DA7" variantOf="505FE2E0D72611D812D100306E055DA7" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Order Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DCD797AE02894B0885B6C031443BD25D">
						<title>Vehicle Order Management</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">This process is used for your dealers, fleet customers or sales subsidiaries to order vehicles from you as a vehicle importer. It includes the process of configuring and ordering a vehicle which may be on stock or made-to-order.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="FCAA278938AB4834AB57172991B35201" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B92C5042ECDB42648256133D9149C064">
						<title>SAP Vehicle Management for Automotive</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="E1E150A942F54C87A6B767993FB7B928" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FAB0D520E83846ADB17CF7587D6924CE">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="7C6AAA2D45894FB6A87561818213122F" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Dealer Vehicle Sales" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6B204C632D154971B39BBCF9E6791438">
					<sap-cover>1</sap-cover>
					<title>Dealer Vehicle Sales</title>
					<process-ref icon="process-ref.gif" ID="E59795E9EEA342C88189233D1F178280" Ref="AC8A33E0E20211D812D100306E055DA7" variantOf="CECC50E8FF60407498EAA0992B45022C" OriginalMap="Automotive - Sales &amp; Service Organizations: Dealer Vehicle Sales" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2A71459B0C6B48EFA7B25DFA0BFFA046">
						<title>Dealer Vehicle Sales</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">This process is used for your dealers, fleet customers or sales subsidiaries to order vehicles from you as a vehicle importer. It includes the process of configuring and ordering a vehicle which may be on stock or made-to-order.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="6C48516A62534C369B05E8971BA694AB" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4718FB49C4CF4409B1B236880DC12369">
						<title>SAP Vehicle Management for Automotive</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D07725ED23934E6680D4E3A57F810748" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6DE82AD42B3A4C1AAE525E25110FE4D9">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="67C393A9087C430186C1C4817B81A26A" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Incentive Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5DD90D16740841C08315C95BB3DC73A9">
					<sap-cover>1</sap-cover>
