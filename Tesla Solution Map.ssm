				<process-ref icon="technical-variant-ref.gif" ID="060ED5F956BD47FDB1207E4CEC7E08B0" Ref="E78C6EEC7F184760B46A09A30F6C" variantOf="452D2431D86B4367B8497DDB434532B9" OriginalMap="Automotive - Sales &amp; Service Organizations: Campaign Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C34764D23AED4E00A11CAE13136BC90E">
