			<process ID="00EBE09315994FE89E8F1ABA06950786" bprid="39D87218D9DF4EF8A00E1225C0F8750D" variantOf="39D87218D9DF4EF8A00E1225C0F8750D" businessArea="After Sales &amp; Services" runningNumber="CRM 224" best-practice-available="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Entitlement Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F9434ACC1DD7498A862683D27EB8F19C">
				<title>Entitlement Management</title>
				<bpr-element-ref ID="5BB1B33E8F044FA79AFDFCAA37CE5BB7" elementname="BusinessProcess" Ref="urn:bprid#39D87218D9DF4EF8A00E1225C0F8750D" OriginalMap="Automotive - Sales &amp; Service Organizations: Entitlement Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="59B90446E418451EA04AB0A43853FD6F">
					<title>Entitlement Management</title>
				</bpr-element-ref>
				<sap-cover>1</sap-cover>
				<short-description>Enables seamless support for remanufacturing and recycling
programs, through a flexible approach to managing deposit-refund
situations in different lines of business.</short-description>
				<process-ref Ref="688DA8D079EB11D912D100306E055DA7" ID="8D5893DC901842F0A699D6BCB7B4072B" variantOf="39D87218D9DF4EF8A00E1225C0F8750D" OriginalMap="Automotive - Sales &amp; Service Organizations: Entitlement Management in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="707B20A6545B42B1BAC54F78FD89ED6A">
					<title>Entitlement Management in CRM</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="A2090C81F97243DFB9A13F7CB4033130" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="936EE5B7F5C540888EFF764A83BF481F">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="62F454C123CB47B2AA8E8329D8820475" businessArea="Sales" responsibleOrgUnit="CRM" runningNumber="CRM 013" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="994D275A7F0E43AD88025ABA7785A6E9">
				<sap-cover>1</sap-cover>
				<title>Billing</title>
				<bpr-element-ref ID="A1CF9C3D15ED4C609AD8A8DE9A1B6F8C" Ref="urn:bprid#27E7DB71E4894B719F259DEB40F5B455" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0065F2CB02694DE1BE8C1BE1E471C278">
					<title>Billing</title>
				</bpr-element-ref>
				<product-ref ID="766CF516AC9B402CB7CE3C7DE426C622" Ref="999E64EA02ED4FD18A0BD49DFC180254" key="S12" type="SAP" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="614CB54DDA2A4809AD3D9B3D6B235F1E">
					<title>SAP ERP</title>
				</product-ref>
				<content>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process in order to create customer invoices in SAP CRM. Here, one or more than one billing due list item is copied into a billing document. You can either create the billing document with reference to the delivery, or to the sales order. It is also possible to create billing documents with reference to contracts. You make the necessary setting in Customizing. The following describes delivery-related billing.</P>
				</content>
				<product-ref Ref="BC192F4F7D5145DABCF5FCB9234BC1CD" ID="C9FD53D8362E443C9747B92C08B71880" type="SAP" key="SAP Service Management (SAP CRM)" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Management (SAP CRM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AF0E435792324B0DAA0486D5F15F2584">
					<title>SAP Service Management (SAP CRM)</title>
				</product-ref>
				<product-ref Ref="D672C3E0DEE24F3D9EE9A70A2FA771DE" ID="293642CD7FA84ADCA9D1DE98ED3D03A2" type="SAP" key="SAP Sales Management (SAP CRM)" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Sales Management (SAP CRM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="339729F2D5B94A74995BFA4C594025B2">
					<title>SAP Sales Management (SAP CRM)</title>
				</product-ref>
				<product-ref Ref="BEC0B6B9C9DE4597B6C8C1336EFD574E" ID="CB1CB701AA0E47F5AF3154A1E3D1FE84" type="SAP" key="SAP Marketing (SAP CRM)" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Marketing (SAP CRM)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EC15214D199F4AAB955CD6F16C2ED59E">
					<title>SAP Marketing (SAP CRM)</title>
				</product-ref>
				<process-ref Ref="A7660F608BB711D912D100306E055DA7" ID="EB740027DB4F47F0BEB8F2D582C54E0A" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing in CRM for Service Parts" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4B361F2FD0AB45CDB84C348A697788E9">
					<title>Billing in CRM for Service Parts</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="F0426877EECA485C8335B2BF73850A6A" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="970E806AA531438C8C8E74F744AA5E6E">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<process ID="370BBF2AADA94863AA5A49D8F98C683D" businessArea="After Sales &amp; Services" responsibleOrgUnit="CRM" runningNumber="CRM 118" variantOf="111EEDADD48547BEA2E2C320443D46B4" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Service Letter Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CD34C70C21BC4820B4B2FDFE96E73393">
				<sap-cover>1</sap-cover>
				<title>Product Service Letter Processing</title>
				<bpr-element-ref ID="6D057324ACBB4ACE955DC4F30D91E95C" Ref="urn:bprid#111EEDADD48547BEA2E2C320443D46B4" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Service Letter Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C4E0A98894924EFA8CD1B816B211B2BB">
					<title>Product Service Letter Processing</title>
				</bpr-element-ref>
				<short-description>Creates and edits product service letters (PSL). Product service
letters are documents that contain previously identified or
potential defects occurring or likely to occur in a product and the
instructions for the execution of services that are necessary to
eliminate these defects. Product service letters are created by the
manufacturer and forwarded to the retailer, or are created by the
retailer themselves.</short-description>
				<process-ref Ref="3625773E30F19E13E10000000A114AB6" ID="9C174FD30F6447709D6F6CE21D6471F3" variantOf="111EEDADD48547BEA2E2C320443D46B4" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Service Letter Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4B3C629AB053432CA6CE80417DE4A026">
					<title>Product Service Letter Processing</title>
				</process-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="99957385F5264FC3AC7A43CC8A79A23E" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CC0CC01E29D84872A7150F5A61FA1AE5">
					<title>SAP Service Parts Planning for Automotive</title>
				</product-ref>
			</process>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">The Service Parts Claims and Returns Scenario covers all
integrated processes tailored to the needs of handling claims from
business partners or of returning service parts from the
distribution network, from car dealers, for example. Within this
scenario, different  business process variants and combination
might occur. The solution supports the running of returns
operations in an integrated way. All elements are closely
integrated with the other business scenarios of the Service Parts
Management solution.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">The Service Parts Claims and Returns Scenario is designed to
serve the end-to-end integration of the reverse logistics chain. Is
starts with a customer complaining, goes over to the return
authorization (RMA) and ens with the goods receipt, the inspection
of the return, and the triggering of follow-up activities.   </p>
			</short-description>
			<business-objective-ref Ref="9DE313AAAD0F49C493CA7788334B973C" ID="479BAD1B44834820B62ECE9D62381C17" OriginalMap="Automotive - Sales &amp; Service Organizations: Better service levels" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DB8050C6D83845B7AECBDB8C8EEE14E1">
				<title>Better service levels</title>
			</business-objective-ref>
			<business-objective-ref Ref="3D5AB1E8E7AE4580A1DEDB373FBD338E" ID="E52EA571BAAB4D969BE46A5CE8F1401E" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve customer retention and loyalty" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="76A6831F8BD1454EB6EB1F9DD119A91D">
				<title>Improve customer retention and loyalty</title>
			</business-objective-ref>
