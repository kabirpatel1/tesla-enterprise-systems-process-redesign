	<scenario-group ID="1C3566B6AED94D8880BA1E0A478EBB94" integrated-with-consumer="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B052527C96394D9E8BF061E392FF5C81" modified="8/14/24 08:10:30 PM">
		<title>Customer Service</title>
		<business-scenario ID="7D74E6E56F7840B59FE5B4744DCC7922" bprid="3049A7A2C691471681F0E4EC2A9EAB07" responsibleOrgUnit="BSG M" xmlns:bpr="http://www.sap.com/ns/bpr-common" OriginalMap="Automotive - Sales &amp; Service Organizations: Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9DD3FB3DF1654B56B90B03C04059E03B">
