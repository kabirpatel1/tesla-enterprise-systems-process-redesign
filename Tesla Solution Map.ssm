				<title>Sales Order Processing (Third Party Order Processing)</title>
				<bpr-element-ref ID="EDEFFF7CCEA14B26B5DAB6DD0A9906B2" Ref="urn:bprid#35B401CC52C140F58172E97A3F4AE18B" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7E74EA46724542068808BB79334F977D">
