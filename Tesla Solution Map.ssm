					<title>Improve cash management, minimize borrowing</title>
				</business-objective-ref>
				<folder ID="EF8691D5BC55482681772A8598451382" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Roles" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F56C75AA653F4F2B90BA4C49C73F48C9">
					<title>SAP Roles</title>
					<hyperlink ID="0EC49C4BE88846D19014018CDCCA0D05" href="javascript:smnavigate('20B003974E7A44E7B074A7287A1C0466')" Ref="20B003974E7A44E7B074A7287A1C0466" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Business Unit Analyst" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="344D36157CE843CDAF6DDE6F2BF12115">
						<title>SAP Role Business Unit Analyst</title>
					</hyperlink>
					<hyperlink ID="8CD0E2A6A06745ECAB2C3164FC9CADAD" href="javascript:smnavigate('0D5D747D76F3434FBB763B0F09172B6E')" Ref="0D5D747D76F3434FBB763B0F09172B6E" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Manager Self-Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="83B4B2349778443496E9E97ED57443F2">
						<title>SAP Role Manager Self-Service</title>
					</hyperlink>
				</folder>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">SAP ERP provides
financial analytics that help organizations define financial
targets, develop a commensurate business plan, and monitor costs
and revenue during execution. Comprehensive financial analytics
enable businesses to create and simulate value flows in a
cross-functional, cross-company, or collaborative environment. </p>
					<h4 xmlns="http://www.w3.org/TR/REC-html40">See also</h4>
					<ul xmlns="http://www.w3.org/TR/REC-html40">
						<li>
						</li>
					</ul>
				</short-description>
			</level1-item>
			<level1-item ID="886C94E57C7440B39CDCAF12DF134F09" OriginalMap="Automotive - Sales &amp; Service Organizations: Operations Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="76E6C68550244C59A568DB22C0602AF1">
				<title>Operations Analytics</title>
				<process ID="747C2C182B954346BF1B9CB9892855E9" businessArea="" variantOf="5612904627474355976D1223CCAFCDBB" runningNumber="ERP 086" responsibleOrgUnit="ERP" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4B4851DA676B432198E3964DBA54A0E5">
					<sap-cover>1</sap-cover>
					<title>Sales Planning</title>
					<process-ref Ref="D1C982D0CE8B11D8265800306E055DA7" ID="3A634AEEDDB54A67B0B4DA7FC1DC82B5" variantOf="5612904627474355976D1223CCAFCDBB" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8541758A4B04489D92D420AFBA9843CA">
						<title>Sales Planning</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="F4017DDE45E54900BA2E38928822CE22" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F3ED616A3ACE47DDBBB21ED31B0A00FA">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>Sales Planning is a planning application for translating company
targets into concrete, concerted marketing, sales, and service
strategies. This application is based on a reconciled top-down and
bottom-up sales planning process helping to increase visibility
resulting in improved decision-making and profitability.</short-description>
				</process>
				<process ID="954958659EE1416594A3A02C7C1123E0" OriginalMap="Automotive - Sales &amp; Service Organizations: Procurement Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A08EB53DA84B4807A2960CE9DA93884A">
					<title>Procurement Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="9FE20D4186867001E10000000A114AB6" ID="432BE9881231468B89C0FEDCDC58BC82" variantOf="6A2415CE101A4243A5DD548D897BA7EE" OriginalMap="Automotive - Sales &amp; Service Organizations: Evaluating Vendors and Monitoring in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DB2B122E491A42E2BAE7B337CF768E4A">
						<title>Evaluating Vendors and Monitoring in ERP</title>
					</process-ref>
					<short-description>Monitors purchasing operations (for example, how many goods have
been received for purchase orders for the last month) using various
standard analyses and reports and facilitates the detailed analysis
of the purchasing activities and procurement processes taking place
within your enterprise (for example, ranking your suppliers
according to purchasing values).</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Global Spend
analysis</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Most sourcing projects
start by identifying high-potential opportunities, by gathering
historical information on how much spend was allocated to certain
vendors for different commodity groups. In order to leverage the
maximum spend volume for future negotiations, the analysis must
span the entire enterprise and include data that is often collected
from a wide range of heterogeneous systems.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP SRM addresses this
issue by utilizing master data mapping information - for example,
for suppliers, categories, and materials - across multiple
execution systems for spend reporting. Mapping information can
originate from multiple sources and is uploaded to SAP Business
Information Warehouse. Data from previous sourcing projects can
also be utilized, as well as information acquired from third-party
service providers such as Dun &amp; Bradstreet. Similarly, SAP
SRM also supports materials classification for UNSPSC and eCL@ss ,
as well as internal material schemas.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Spend analysis sheds
light on the past allocation of purchasing volume to vendors (on a
category basis as well as for individual materials). It also
provides information on which materials are purchased from specific
vendors. This data can then be sliced and diced by a multitude of
dimensions, such as region, purchasing documents and capabilities
for drilling down to the line item level - providing information at
every level.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Operational
reporting</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Buying behavior analysis
shows trends and patterns for the organizations procurement. It
gives answers to questions like how much of total spend goes
through catalog procurement, does the usage of p-cards increase or
decrease, how many requisitions are created per day and from which
regions.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Operational performance
measurement helps the organization to understand procurement
patters, track bottlenecks and identify areas of improvement.
Typical measurements are lead time between for example the creation
of a shopping cart until a purchase order is issue, the approval
time number of erroneous requisitions that need to be
reprocessed.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Analysis of catalog
usability: Analysis of procurement pattern regarding purchasing
from catalogs, purchasing volume from different catalogs and
goods.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Approval and compliance
analysis : Requisitions can be captured and analyzed according to
compliance with existing approval policy as well as to negotiated
contracts. Such measurement can be lead time for approval, reasons
and frequency of requisitions rejections, maverick behavior such as
requisitions referring to non-preferred suppliers.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
         Supplier evaluation
Vendor Evaluation provides you with Web-based surveys that you can
use to evaluate your vendors. You can configure individual surveys
and questionnaires, select the criteria that you want to evaluate,
and stipulate when the evaluation is to take place. You can then
transfer the data that you gather from the questionnaires and
surveys to the
         <em>SAP Business Information Warehouse</em>
         . You
can use this information in the future to help you select vendors
and negotiate conditions.
        </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Supplier
performance reporting</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Supplier performance
reporting provides suppliers with about a dozen standard reports.
For example, the expiring contracts report helps suppliers easily
identify which of their contracts will expire soon and must be
renegotiated for renewal or any amendments. Suppliers can also
easily identify which invoices have not yet been issued and which
deliveries are not yet shipped by using the open invoices and open
deliveries reports. These reports help suppliers ensure prompt
receipt of payments and timely shipment of goods to their
customers. The overview report on incoming payments saves suppliers
from having to check when their customers have paid and which
payments are due.</p>
					</content>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="CD6339392C914C5AA75B4A4BB9777AF3" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="172E1A45E3024BB0ACDCE644A6D7CE2A">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="FB48FF4E404D4A4D9CD011B9543C95A6" OriginalMap="Automotive - Sales &amp; Service Organizations: Inventory and Warehouse Management Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9031492FA5854C9E9E3CBC759E4421E5">
					<title>Inventory and Warehouse Management Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="9FE20D4186867001E10000000A114AB6" ID="00E193B8D8D4427C9CBB2B28400F12F7" variantOf="6A2415CE101A4243A5DD548D897BA7EE" OriginalMap="Automotive - Sales &amp; Service Organizations: Evaluating Vendors and Monitoring in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4A80E4D1BD1E46BB948A5653225BA097">
						<title>Evaluating Vendors and Monitoring in ERP</title>
					</process-ref>
					<process-ref Ref="A6744FEB84BC45B0BBDF5D75BA240463" ID="A88896B6693E4CBAB3A6054F1FFAB947" variantOf="575BAFDDF9A54E6DB3CCB151C112811F" OriginalMap="Automotive - Sales &amp; Service Organizations: Supply Chain Monitoring and Control" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6BBC64DA183C43BC897E983C37E59B78">
						<title>Supply Chain Monitoring and Control</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Inventory controlling
provides different standard analyses and reports display actual
stock situation according to quantity-based and value-based
criteria. Other reports are available for monitoring
characteristics on a periodic basis.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Warehouse analytics
helps analyze warehouse activities information. It is possible in
the future releases to extract and transfer information to the SAP
BW, where it evaluates and reduces the extensive information from
warehouse management to a few essential performance measurements.
Key performance indicators (KPI) for warehouse management support
the analysis of the physical flow of quantities and workload in the
warehouse.</p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="6D145CB213F44E2D89712B3401E6C915" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="78DF44E11ACC47F182638AF698DD2D87">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="363B96B207214C0C867B3765913398CB" OriginalMap="Automotive - Sales &amp; Service Organizations: Manufacturing Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EEFE8D24DC9A4C53BC8BA582317AF67C">
					<title>Manufacturing Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="A6744FEB84BC45B0BBDF5D75BA240463" ID="81AE56C4E6CB4D9E8C85335FAD2CA74A" variantOf="575BAFDDF9A54E6DB3CCB151C112811F" OriginalMap="Automotive - Sales &amp; Service Organizations: Supply Chain Monitoring and Control" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="113EAE0DB13141FC8E27D1434C64946D">
						<title>Supply Chain Monitoring and Control</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Provides various
standard analyses and reports to visualize production-related
information.</p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="5A20325531654706A3613A7293EDD989" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="40E5EDE30EE6459A8DC2A78E24E2CAD8">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="10636EABF74D40699A614B1062A2005F" OriginalMap="Automotive - Sales &amp; Service Organizations: Transportation Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8277A8BA87B74CA1965169F8F1C1A386">
					<title>Transportation Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="A6744FEB84BC45B0BBDF5D75BA240463" ID="41BCBD8ABB04495AACBB189FB308D565" variantOf="575BAFDDF9A54E6DB3CCB151C112811F" OriginalMap="Automotive - Sales &amp; Service Organizations: Supply Chain Monitoring and Control" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="AC4F40D08BEB4786B5729E3445AB1776">
						<title>Supply Chain Monitoring and Control</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">KPIs provide a means of
judging the performance of business processes internally by time
period, collaboratively with others within your distribution supply
chain, and externally by benchmarking against similar
companies.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Strategic performance
management: On a strategic level, distribution statistics give you
the feedback needed for true closed-loop supply chain management,
which is key to driving continuous improvement, delivering superior
performance over time, and ensuring that your supply chain
continues to be efficient and competitive.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Operative performance
management: On a day-to-day operational level, the solution
provides constant surveillance of key performance measurements and
automatically generates an alert when there is a deviation from
plan, so that you can keep processes working at maximum
efficiency.</p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="B3C6D9B732BE422CBBC29C7ED13150C7" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="051902F3F01C4534AD80A374CD9CA8FB">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="944A0B95CAD74A6BAE977ECA83C235EA" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="58CB40D20F8A47C98BC57B9004869890">
					<title>Sales Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="1C19AFB3A573459FB17FF9075EB5" ID="7A45BEED672A4F2CAF410EB897E61BEA" variantOf="164D8D28E9DA48F091D9E17F59B044C0" OriginalMap="Automotive - Sales &amp; Service Organizations: Profitability Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DF7322C134AB406D89E43B31C9CF6995">
						<title>Profitability Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="6A845E3EBDA64068E10000000A114AB6" ID="00838BDCFA56405BAEB048563B556247" variantOf="7FFF6C3A93E94385BD363D1C7751AFD1" OriginalMap="Automotive - Sales &amp; Service Organizations: Web Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E65D15CE768A4207A97D3BEADB375A3D">
						<title>Web Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="7C2F6529FEBD44F2ADC9EA6C8EB331D2" ID="6C92E661A09940169B6CF7BFB7939518" variantOf="CC0B505F478D4305910D638658BCBCEA" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract and Quotation Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="15F3FB6191B94F5488A74F218A0019E5">
						<title>Service Contract and Quotation Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="07D70C2C28B7417E9FE02FFA8232F0A2" ID="1CA38CDDA775436499C9DD4449B2ED38" variantOf="13F2757CE3414BE09D6AFD27620716D1" OriginalMap="Automotive - Sales &amp; Service Organizations: Warranty Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="92B6CA5FEAC4471FAE4986D009971606">
						<title>Warranty Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="339DCAE6984347038E5931ADE639" ID="3C5795417693486F82F5A7AD3084920A" variantOf="6A4958F685A9409FB2FFAD7C38B60187" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Order Related Cost and Revenue Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3AC45767299C411DADEF1B7C41E0B28D">
						<title>Order Related Cost and Revenue Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="73E1EC1682AB4540869EF06F5B3B1A30" ID="0399899781EF472696EC3475DD4A5F1B" variantOf="1CE9658D766B42308DB4AA81EE91361E" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EE600C9000D440EF982F180E0836EA97">
						<title>Billing Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="E01772FFA0C14E6F844AD0C8BF35499C" ID="A2184394858C4A7C91A9B8E41DE053A8" variantOf="5C56AC0751684DA58DF5113548DFB26E" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Quotation and Order Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C75EF19ECF4D4DFFB49397E469452D48">
						<title>Sales Quotation and Order Analysis in ERP</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Enables salespeople to
quickly and easily understand the actual status and overall
effectiveness of the sales organization. Helps obtain the data
necessary to proactively address trends and measure success and
revenue shortfalls.</p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="1FFC046F197B453EBDE8D2BD630D41E2" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A1898F92FD734735866ABF9209847B01">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="44B59E8C275044FEB6D42B26F2DC86AB" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3D75EDD5683A40A883D3E134955AF022">
					<title>Customer Service Analytics</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="AD55F1D9CD9C4F4E91EC6ABA38B17126" ID="D651F8D5B6DE4EC3B06257ECC85BDF6A" variantOf="1B8AFB3E36AB4147BCF9E8A986AE4B02" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order and Quotation Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8139ECD7B44140CEB34FF900D918B58C">
						<title>Service Order and Quotation Analysis in ERP</title>
					</process-ref>
					<process-ref Ref="17C2C91DF7FA4C7F957EE355F1F7BB4F" ID="A51B8C0A037E417B932EB0856FA537AA" variantOf="FB009D54A49D480C8E5AE45661C1CEB0" OriginalMap="Automotive - Sales &amp; Service Organizations: Complaints and Returns Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="99E0B9289BC74A698C9342756357CA8D">
						<title>Complaints and Returns Analysis in ERP</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Provides organizations
with a comprehensive view of key figures of all service-related
scenarios. Enables companies to analyze:</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Service
Profitability</strong>
         : Monitors financial trends, analyzes costs
and revenues per customer, service organization, service contract,
and service operation, identifies unprofitable and successful
services.
        </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Installed Base
Analysis</strong>
         : Shows the volume of all orders referencing to
an installation during a specific time period. Enables analysis on
costs, revenues, and profit generated by an installation. Provides
information about the location of installations and shows the
amount of orders for an installation.
        </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Customer
Analytics</strong>
         : Provides companies with a comprehensive view
of their customers. Helps companies understand the true value of
their customers and gain insights to understand customer behavior
and customer satisfaction.
        </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Warranty
Analytics</strong>
         : Provides information about the amount of
products with or without warranty, monitors expired warranties in
the installed base, and analyzes costs and profit of warranty
processes.
        </p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="FBF008904C904098A202A934C949FF10" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="833498A70D8944398A1AEA207D689CD9">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="92A9927DE0F54CCF81F6ADF6F31C2CB8" OriginalMap="Automotive - Sales &amp; Service Organizations: Program and Project Management Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4AC29F2D84814AEF8611A4FEE9D52246">
					<title>Program and Project Management Analytics</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Project
Information System</strong>
         : Is a flexible, comprehensive
information system that you can use to monitor and control your
project data. Enables you to evaluate individual projects, partial
projects, or multiple projects. Includes overview reports and
reports offering various degrees of detail. Is designed to meet the
needs of both project management and ordinary project personnel.
Predefined InfoCubes are available for the SAP BW.
        </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Product Design
Optimization Analysis</strong>
         : With the concurrent costing tool,
provides product cost information in the early product development
stages. Based on the target costing approach, enables
design-to-cost engineering and early cost optimization. The
possibility to calculate product characteristics and design
alternatives provides valuable information to the product design
team.
        </p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="82BD7ABE0A8E462F8CB639E9763D7C06" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1D22314B9DAE42688B9D07186CBF2C9C">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="259D4FD4B1754F85BEE9AA0E43D8DF92" OriginalMap="Automotive - Sales &amp; Service Organizations: Quality Management Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3127B36079034D8481BBF831EC992478">
					<title>Quality Management Analytics</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Quality
Costs</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Provides orders to plan,
collect, settle, and evaluate quality-related costs (appraisal
and/or nonconformity costs).</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Quality
Management Information System</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Quality data are
delivered into SAP BW and into the logistics information system
(LIS). Both aggregate the operational data and calculate key
figures to be used for quality analysis. SAP BW offers
state-of-the-art comfort, such as Web reporting. Both systems
provide standard and user-defined quality analyses of key figures
(quality scores), performance indicators (Cpk), trends, exceptions,
correlations, Pareto diagrams, etc. You can use these results for
vendor evaluation, internal and external benchmarking, balanced
scorecards, and other methods of quality analysis.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Web Reporting
Using the SAP BW</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Delivers predefined
business content for SAP BW for the evaluation of inspection lot
and notification data.</p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D29E36F4F62A452C9514A49B31622BB9" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5BDEFA5795444173B4C613EBD8A816B6">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="6B03017376EC444CB651C109F96C64FF" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce administration, improve business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C71D6F9F07D14C92997891AEBB4BA385">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="2FEE065DBCAC4AD0A2D7A733234DB4F0" ID="B6AA8445F4EE4DB7A96DC7B7AB62B212" OriginalMap="Automotive - Sales &amp; Service Organizations: Lower logistics costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5D5176110B614EC2AEB761FE5A076AAB">
					<title>Lower logistics costs</title>
				</business-objective-ref>
				<process ID="1063CE75DA8E4897A2B4E45182F0993B" OriginalMap="Automotive - Sales &amp; Service Organizations: Asset Analytics &amp; Performance Optimization" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5E2E1ECB9727417E9413E5A30B1328EB">
					<title>Asset Analytics &amp; Performance Optimization</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Cost-effective
maintenance requires a detailed understanding of the costs caused
by the individual asset, manufacturer, production facility, or
production site.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Reporting and
Asset Information System</strong>
         : Asset life-cycle management
offers a broad range of reporting features for technical objects
and operative instruments (such as orders and notifications). The
information system also provides strategic evaluations for a
organization including MTTR/MTBR[RP1] analysis.
        </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Asset Business
Content in SAP BW</strong>
         : Asset life-cycle management also
offers business content in SAP BW. Notification- and order-based
InfoCubes and queries provide important information about asset
availability, performance, and costs.
        </p>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="5745CED665924488BE4B8688412D40B6" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="745AC2653BE74196855435A395300ADA">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<folder ID="1A029349A0354A92B7480C69EA9B6060" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Collaterals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="75D6E0D8B29A44FFB0BCEA97BB3FBECC">
					<title>Value Collaterals</title>
					<hyperlink ID="6929AE3F8B6447E8B1E0B69BE3DE0191" href="http://download.sap.com/SMIGlobal/download.epd?context=282B7C137FDA6F012F1E853575C453C9FF864E691C479B81C71F6D7327EF7A87ED02EB7B1B2B33B43A8A8362C7763152786A00C0988848C1" OriginalMap="Automotive - Sales &amp; Service Organizations: Reference Slide: O.C.C. Public Company Limited" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F168AC01DFE24A6AB4D1A0D9C365F91F">
						<title>Reference Slide: O.C.C. Public Company Limited</title>
					</hyperlink>
					<hyperlink ID="1304089477854C9F88BAFACCF2648857" href="http://download.sap.com/download.epd?context=B2D607C9D47570440B2E1F2F567D110FECC584AFAC790A0CCA9B41162A85319CC6F3D136FA2D028F669AA1C20E0B09B4942BB2165D46F256" OriginalMap="Automotive - Sales &amp; Service Organizations: Reference Story: Alois Pöttinger Maschinenfabrik GmbH" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="46421B6B4EFC49E99786E71353DAB529">
						<title>Reference Story: Alois Pöttinger Maschinenfabrik GmbH</title>
					</hyperlink>
					<hyperlink ID="35EEDD84D10D4DF3880130ABBE899887" href="http://download.sap.com/KIO0004/download.epd?context=9EA0A9510F42E540AF476CAC249C82255BB496F3705E9F9D65EED03C754D18AB7EE952E227A1103A45802229E5EE8B9FAA135F5B9A62F364" OriginalMap="Automotive - Sales &amp; Service Organizations: Reference Story: Samarco Mineracau S.A." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EBA7406F260A46578D03236D0C909BEA">
						<title>Reference Story: Samarco Mineracau S.A.</title>
					</hyperlink>
				</folder>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">SAP ERP provides
operational analytics that facilitate the compilation of detailed
operations reports and support informed operational decision making
- giving management and employees the information they need to
increase insight into business processes. In addition sales
planning can allow organizations to generate a complete picture of
the entire supply chain, including the impact of sales on
operations.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					<h4 xmlns="http://www.w3.org/TR/REC-html40">Further
Information</h4>
					<p xmlns="http://www.w3.org/TR/REC-html40">
        Please visit the SAP
Service Marketplace to get further information on 
        <a href="http://service.sap.com/~form/sapnet?_SHORTKEY=01100035870000699337&amp;">Operations Analytics</a>
        within SAP ERP.  
       </p>
				</short-description>
			</level1-item>
			<level1-item ID="5B4FC52793C3492C942B8B87238AAD97" OriginalMap="Automotive - Sales &amp; Service Organizations: Workforce Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="86C89CF4B2B44326B2E9512AE1EE3FA4">
				<title>Workforce Analytics</title>
				<process ID="454595E3B1184AD2A4872D4BCDFD48CD" OriginalMap="Automotive - Sales &amp; Service Organizations: Workforce Planning" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DB1E85904F464499B5F9A526900ECF36">
					<title>Workforce Planning</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="67274F1DFEF34491B82FDCBEF4CEF5C2" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0FBD060B96BD432E94DB04116579DC62">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>Understand current workforce trends -- and plan future needs --
by using workforce demographic data.</li>
							<li>Use more than 200 predefined reports to analyze headcount
development, turnover rates, and workforce composition.</li>
							<li>Link the results of this analysis directly into headcount
planning, budgeting, and key talent processes, such as recruiting
and learning.</li>
						</ul>
					</short-description>
				</process>
				<process ID="3426FFCE37E242D7956DADF10C165F3C" OriginalMap="Automotive - Sales &amp; Service Organizations: Workforce Cost Planning &amp; Simulation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A669DD67FC07474F801B8F42B3D91E54">
					<title>Workforce Cost Planning &amp; Simulation</title>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="09C5EC98BAAA437BAE83DFFA613FA10B" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A906DC55EDF94B1FA584067AA22496DE">
						<title>SAP ERP</title>
					</product-ref>
					<sap-cover>1</sap-cover>
					<short-description>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>Support HR professionals in all workforce cost-planning tasks,
and empower HR executives to develop effective strategies.</li>
							<li>Provide access to a broad range of workforce-related data to
support accurate planning, facilitate simulated planning scenarios,
and enable continuous monitoring of actual performance relative to
plan.</li>
						</ul>
					</short-description>
				</process>
				<process ID="4B7D34C3C5354D81BBD399AC3B95F7DB" OriginalMap="Automotive - Sales &amp; Service Organizations: Workforce Benchmarking" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8A0FCDDD1FF64362AB772659D67EAEF6">
					<title>Workforce Benchmarking</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="0BAE19A3B9A747E4A32E3FFBB4A3" ID="FE771BC1BA3E4C7C808A19509E9AF3E5" variantOf="37A5E7EA66F54A01B8F1B78917F2009B" OriginalMap="Automotive - Sales &amp; Service Organizations: Planning and Simulating Workforce Costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E3A1E3AB1D0C41D7A687CFD17D7F7844">
						<title>Planning and Simulating Workforce Costs</title>
					</process-ref>
					<process-ref Ref="C920042C539A499EA73AF69B15EE1228" ID="2D418514B40241D5A48FBB00050F4F09" variantOf="75E2665DF48D4C37A3CD535C9AC053D7" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Analyzing and Benchmarking HCM processes and strategies" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C79DFD7B7F32409EA47A5A8779581625">
						<title>Analyzing and Benchmarking HCM processes and strategies</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="F33E54F619B44A4E882C0F872B5CB9FB" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A3E3DE99C0A8488C847B61A4337E61A5">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Measure standard workforce processes and compare with external
benchmarks and internal operating thresholds.</p>
					</short-description>
				</process>
				<process ID="C66012F36A204230BD88335429E4447F" OriginalMap="Automotive - Sales &amp; Service Organizations: Workforce Process Analytics &amp; Measurement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E844FF85CE3C44A4AC318BD3C894F222">
					<title>Workforce Process Analytics &amp; Measurement</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>Measure and analyze typical core HR processes such as payroll,
employee administration, time management, and benefits.</li>
							<li>Analyze organizational structures, relationships, and
attributes of jobs and positions.</li>
						</ul>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="F09F7F3614A94C41BEFC0A2B6C864A51" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CEF4E783784F4A99939EBA282298B951">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="DF05AB56A9C4409B9E666122514E5F38" OriginalMap="Automotive - Sales &amp; Service Organizations: Talent Management Analytics &amp; Measurement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3AABC9708AB04A76908CFB94ED957744">
					<title>Talent Management Analytics &amp; Measurement</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="71C4344FB95F4902BD834FE29323FD66" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F1AC8DA537AF4D6FAC99660749BE22FF">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>Identify key attributes of your talent pool.</li>
							<li>Measure recruiting processes.</li>
							<li>Measure and analyze learning programs.</li>
							<li>Analyze succession programs.</li>
							<li>Monitor performance management processes.</li>
							<li>Measure employee compensation programs.</li>
						</ul>
					</short-description>
				</process>
				<process ID="B199E6806809440392823991DE68E8C9" OriginalMap="Automotive - Sales &amp; Service Organizations: Strategic Alignment" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C0B5855B54124E90971A760BA7B4CDAF">
					<title>Strategic Alignment</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="AE745B6E143E4FA0B14D2FDD9E53" ID="6D177B08A31E4C588BAB9252796617D4" variantOf="A010C229B13C4F499D596293A3DB22F4" OriginalMap="Automotive - Sales &amp; Service Organizations: Planning and Simulating Workforce Strategies" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E56FC78EE5524650B574AD97D33F8791">
						<title>Planning and Simulating Workforce Strategies</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="5E992423AD2D4031B8019A68271CB9E1" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E2A64F335E0A4922A73112AE7B116BAF">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Ensures that all
departments support the strategic direction of the enterprise.
Helps employee teams work toward common objectives, regardless of
location. Balanced scorecard framework provides predefined
workforce scorecards, built around generic metrics, targets,
milestones, and other data. Scorecards are integrated with
management-by-objective (MBO) goals, aligning employee goals with
corporate strategy.</p>
					</short-description>
				</process>
				<business-objective-ref Ref="CBAB3ED1502C4060A56ADFEA376D70DB" ID="8EEF1FF6DF7B4C82B14AF6D5A97B59D5" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve forecast accuracy" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="04C36F46498E49A68B742052AD7FCC77">
					<title>Improve forecast accuracy</title>
				</business-objective-ref>
				<business-objective-ref Ref="C741DC2A4F51492C888EF4D4010891C1" ID="5AFB3FC61460463A9158E43B74DE21B7" OriginalMap="Automotive - Sales &amp; Service Organizations: Improved quality and accuracy" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="099C0356DB564DF582178A44C69B9BDF">
					<title>Improved quality and accuracy</title>
				</business-objective-ref>
				<folder ID="156D84589F884494A4DF29D9E50936E3" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Collaterals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CEC5944BEDA84758888047330B172B80">
					<title>Value Collaterals</title>
					<hyperlink ID="3888D815FF5741659A8EB574CF4BEF55" href="http://download.sap.com/SMIGlobal/download.epd?context=EF117B97B4CDAAC305396B2ECFD9A59390CD088AFF200A5611703F2056FAD98BD00B5E39FAD3E4B91AA2D45BFBD9476EA18CC9861AA43CCE" OriginalMap="Automotive - Sales &amp; Service Organizations: Reference Slide: NTN Wälzlager (Europa) GmbH" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="ADE44D070B29487A973CE40E3F38A218">
						<title>Reference Slide: NTN Wälzlager (Europa) GmbH</title>
					</hyperlink>
					<hyperlink ID="8CA8580E405B42BAA9D622595D044028" href="http://download.sap.com/SMIUS/download.epd?context=2F76F77DBCDAC86386D4F27ADD85C32559F536D5644FA14554E16CEE1CBAAD53168A807A3A960A4DE42ED59B9FA09D4DE8295B6578668F3E" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Testimonial The Home Depot: HCM (SAPPHIRE Atlanta 2007)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C25B5B6A03B54D8F93B1E3FC11273A20">
						<title>Customer Testimonial The Home Depot: HCM (SAPPHIRE Atlanta 2007)</title>
					</hyperlink>
					<hyperlink ID="C75B96FA65164B7CB596E524E8612BFB" href="http://download.sap.com/SMIUS/download.epd?context=79CB2DEFFDB7B9ACA14D528D7FF67BFC59D86C3FE90401793CA501FBE06593AC9A13566E70E95CDADDBA68CF4EA62E396C3C77D9A061DDA3" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Testimonial The Home Depot: HCM and BI (SAPPHIRE Atlanta 2007)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="916971FBB1D3413480BA54ACAFEB2917">
						<title>Customer Testimonial The Home Depot: HCM and BI (SAPPHIRE Atlanta 2007)</title>
					</hyperlink>
				</folder>
				<short-description>
					<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					<p xmlns="http://www.w3.org/TR/REC-html40">SAP ERP gives your
executives, HR professionals, and line managers reporting and
analysis options that provide real-time insight into your
workforce. They can identify trends at an early stage and make
well-informed decisions, enabling you to manage your human capital
more effectively, predict human-capital investment demands, and
track workforce costs and the ROI associated with HR
projects.  </p>
					<h4 xmlns="http://www.w3.org/TR/REC-html40">See also</h4>
					<ul xmlns="http://www.w3.org/TR/REC-html40">
						<li>
          
        </li>
					</ul>
				</short-description>
				<folder ID="195985D1C89B4BFE9FBC9DDB951700D1" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Roles" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A7EC78EEA10A4310B2D6DAC65446648E">
					<title>SAP Roles</title>
					<hyperlink ID="BFBE94E0C9664B95A7B9BDF407ACECDA" href="javascript:smnavigate('0D5D747D76F3434FBB763B0F09172B6E')" Ref="0D5D747D76F3434FBB763B0F09172B6E" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Manager Self-Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4402AD9F32654923AEDEB4501650EAD8">
						<title>SAP Role Manager Self-Service</title>
					</hyperlink>
				</folder>
			</level1-item>
			<short-description>
				<h4 xmlns="http://www.w3.org/TR/REC-html40">SAP Analytics for ERP:
Complete performance management. Realtime business insight.
Actionable analytics.</h4>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">
					<span style="FONT-SIZE: 8pt; FONT-FAMILY: Tahoma; mso-fareast-font-family: 'MS Mincho'; mso-fareast-language: JA; mso-ansi-language: EN-US; mso-bidi-language: AR-SA">SAP Analytics for ERP: Complete performance management. Real-time
business insight. Actionable analytics. SAPERP is a complete,
integrated solution for analytics and business intelligence,
including financial, operational, and workforce analytics. It
enables companies to clearly understand profit drivers of their
business, tightly link strategic plans to operational performance,
and support a single analytical platform for their
enterprise.</span>
				</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">Key functions include
the following:</p>
				<ul xmlns="http://www.w3.org/TR/REC-html40">
					<li>
						<strong>Financial analytics</strong>
        enable you to define
financial targets, develop a realistic business plan, and monitor
costs and revenue during execution. These tools let you create and
simulate value flows in a cross-functional, cross-company, or
collaborative environment.
       </li>
					<li>
						<strong>Operational analytics</strong>
        enable you to compile
detailed operations reports and support informed operational
decision making. The application also includes integrated planning
functionality that lets you generate a complete picture across the
entire supply chain, including the impact of sales on operations.
You can analyze and optimize travel spend, track partner
performance, and ensure environmental compliance.
       </li>
					<li>
						<strong>Workforce analytics</strong>
        support human capital
management policy development and decision making. You can analyze
workforce data; design, implement, and monitor corporate strategies
to optimize the workforce; and continuously evaluate how various
courses of action might affect business outcomes.
       </li>
				</ul>
			</short-description>
		</level0-item>
		<level0-item ID="2B415A953B844BF396A2F1E4E0FE15B5" pool="False" OriginalMap="Automotive - Sales &amp; Service Organizations: Financials" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6305F2BCF8864FB09B57DBD7FBEE79EB">
