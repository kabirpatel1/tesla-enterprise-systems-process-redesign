				<title>Service Parts Claims and Returns</title>
			</bpr-element-ref>
			<title>Service Parts Claims and Returns</title>
			<process ID="FEAE9BF843AE4346BC55557E71619218" businessArea="After Sales &amp; Services" responsibleOrgUnit="CRM" runningNumber="CRM 036" variantOf="1F348B17245F4C45B8DE003F59E40F61" OriginalMap="Automotive - Sales &amp; Service Organizations: Complaints Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CB657EB0A55D42F6A70732DBFA3C9C02">
				<sap-cover>1</sap-cover>
				<title>Complaints Processing</title>
				<bpr-element-ref ID="7C82ECEFA5DC448FB1640BCF29F969E1" Ref="urn:bprid#1F348B17245F4C45B8DE003F59E40F61" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Complaints Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A678C9B368A94A49802CDB8B1CA4C409">
					<title>Complaints Processing</title>
				</bpr-element-ref>
				<content>
					<p xmlns="http://www.w3.org/TR/REC-html40">Tracks established
procedures for passing complaint information into the enterprise
for resolution so that dissatisfied customers become satisfied
customers and companies can plan and manage return material
costs.</p>
				</content>
				<process-ref Ref="FDCE6C3EE1929F13E10000000A114AB6" ID="AF78E1AF14334733BBED2799A0229586" variantOf="1F348B17245F4C45B8DE003F59E40F61" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Complaints Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3B0612D8202C4D3B9691DD0235F7552F">
					<title>Complaints Processing in CRM</title>
				</process-ref>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="E2EDDB62F9144D11BEBF9D65558A57E9" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B13DE692DC35425BB9E96E0560B6F9A0">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="7BC1952A409E4473A8046A896BE21DF8" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3A61F9394E914F4D812D472C70870157">
					<title>SAP Service Parts Planning for Automotive</title>
