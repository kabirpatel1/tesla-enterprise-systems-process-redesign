				</process-ref>
				<process-ref Ref="F94D1859A0404B16B40ED06B386C9344" ID="AA687C4BC137437F872780B24CC75313" variantOf="A4821C30819911D912D100306E055DA7" OriginalMap="Automotive - Sales &amp; Service Organizations: Parts Monitoring" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="39C38BFBF3194E4EB0F75C2C2B8A0E9E">
					<title>Parts Monitoring</title>
				</process-ref>
				<short-description>Parts Monitoring provides visibility of all planning related
processes and includes follow-up activities.</short-description>
				<product-ref Ref="D038B826DE1F48B182EE921DA3ABFE40" ID="2253228DB9304D3381F863EF61E636F8" type="SAP" key="SAP Service Parts Planning for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Service Parts Planning for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="330A230296724A73957816015AD3C993">
					<title>SAP Service Parts Planning for Automotive</title>
