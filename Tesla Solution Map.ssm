					<title>SAP Roles</title>
					<hyperlink ID="7B2EAAB0821847648EE1016615D693FD" href="javascript:smnavigate('8410FD81648045EE852E5D22C83243D3')" Ref="8410FD81648045EE852E5D22C83243D3" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Employee Self-Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E291104067DE40E2B18D9F13853F14F7">
						<title>SAP Role Employee Self-Service</title>
					</hyperlink>
					<hyperlink ID="1BC3D1985C514D08B26589306ADAF6DE" href="javascript:smnavigate('0D5D747D76F3434FBB763B0F09172B6E')" Ref="0D5D747D76F3434FBB763B0F09172B6E" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Manager Self-Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="97020E038F154B9593AEBB495476FC22">
						<title>SAP Role Manager Self-Service</title>
					</hyperlink>
				</folder>
			</level1-item>
			<level1-item ID="143E8D8EBF16480385AA837B2839A541" OriginalMap="Automotive - Sales &amp; Service Organizations: Environment, Health, and Safety Compliance Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C6EDE95BDEF445368BF1D8DE5215137C">
				<title>Environment, Health, and Safety Compliance Management</title>
				<process ID="D1D0B79886C941429650B0F07ECE0189" OriginalMap="Automotive - Sales &amp; Service Organizations: Environment, Health &amp; Safety (EH&amp;S)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CBBE574B85224839A099C6979874A97D">
					<title>Environment, Health &amp; Safety (EH&amp;S)</title>
					<product-ref Ref="8FA2EBE56954D311A8220060B03C2BA7" ID="AB1FD82DFDC649E59D17C1788B926FE6" type="SAP" key="S38" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Environment, Health and Safety" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="441AC81D7A3143548D57D470562F980F">
						<title>SAP ERP: Environment, Health and Safety</title>
					</product-ref>
					<sap-cover>1</sap-cover>
					<process-ref Ref="DD161542AA8C48D38379243BA610AB12" ID="369C1E1186924CCC8EFD2F626EB4D21E" variantOf="8A5E7A1653E040D78AB53DCD283812EF" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Safety" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BDDBD88F548343FE9C65EF28F193E31F">
						<title>Product Safety</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="206A3F0C51B14610A85B3014A3E287C4" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EBEDB09EB709477394E9624CC0C24C75">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="3D10B83DF65D43919636C1828F5C977B" ID="AF9B85A9B8B3484AA7A27697AF044B98" variantOf="E7D1A56D861A44F6A0249828DB7A2A4B" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Hazardous Substance Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="232E6FC6853E46BAAA8CE18EBF034EBE">
						<title>Hazardous Substance Management</title>
					</process-ref>
					<process-ref Ref="B77E3827DAA34FA6A85C5A7A0A15AE94" ID="0AF15A19444E44FD952EC391BD2BCAC5" variantOf="2C48510B05C94E0B83A21092D2A501EF" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Dangerous Goods Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3A991514FD82402A8A4D150BB4152F9B">
						<title>Dangerous Goods Management</title>
					</process-ref>
					<process-ref Ref="2ADA6BA06E914CC498F61FC670BA0473" ID="D5A1EE9231BA464D827E01D1D72A8CA4" variantOf="D247DAB9E16D4895AED2611C14B64C9E" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Waste Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="13EABF06D75E4D59AF16D251017FFEA0">
						<title>Waste Management</title>
					</process-ref>
					<process-ref Ref="AD9BF96D7565461B8B405E33661EE6F1" ID="9957E2B5E5434C43933978CF1129913A" variantOf="36832BCF673C488FB6510234A62B49F6" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Industrial Hygiene and Safety" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C74DF7AC2D0B4D8C85F3380C01484591">
						<title>Industrial Hygiene and Safety</title>
					</process-ref>
					<process-ref Ref="B4F8B9E6A690444D9A6888BB46D50621" ID="B3C31005AC9E4E9785AFC4ADD6CCD201" variantOf="11B4542AB1E3416BB603B9AB31933A62" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Occupational Health" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="126DCFD87C7E4F6EBB4CB604FA03D930">
						<title>Occupational Health</title>
					</process-ref>
					<short-description>Environment, Health &amp; Safety (SAP EH&amp;S) helps you manage
complex, rapidly changing environment, health, and safety
regulations and their consequences across your organization --
covering product development, purchasing, manufacturing, sales,
distribution, service, and maintenance</short-description>
					<content>
						<div style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">SAP EH&amp;S provides environment,
health, and safety professionals with functionality that
helps:</div>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">
									<strong>Identify and minimize
employee health risks</strong>
           -- Enhance employee health and safety
with complete support for industrial hygiene, safety, and
occupational health functions -- helping you ensure compliance with
government safety regulations.
          </div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">
									<strong>Support preventive health
care</strong>
           -- Record all relevant health protocol data, allowing
you to track employee health care, and monitor the results of
medical examinations and diagnoses.
          </div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">
									<strong>Ensure product safety and
hazardous substance management</strong>
           -- Use specific
product-safety functions, including automatic product composition
calculation, rule-based material safety data sheets (MSDS)
authoring, automatic MSDS generation, global label management
capabilities, and MSDS shipping. SAP EH&amp;S includes inventory
reports for hazardous substances, substance volume tracking
functions and a substance information search system that can block
or approve the purchase of hazardous materials.
          </div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">
									<strong>Track dangerous
goods</strong>
           -- Store and manage regulatory data, classify
dangerous goods, perform checks during transport, and compile and
update dangerous goods documentation. SAP EH&amp;S can
automatically supply data to other applications for use in delivery
notes and packing lists. The solution can also automatically
identify appropriate transportation channels and ensure that
shipments comply with regulations before leaving the
premises.
          </div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">
									<strong>Manage waste
disposal</strong>
           -- Comply with waste disposal laws and regulations
with functions that help ensure the efficient disposal of both
hazardous and nonhazardous waste. You can manage waste data, create
hazardous waste permits, select disposal firms, allocate disposal
costs among internal departments, and ensure that authorized waste
quantities are not exceeded.
           <br></br>
								</div>
							</li>
						</ul>
					</content>
				</process>
				<process ID="E72A4886085B4F7180B310DFF703843E" OriginalMap="Automotive - Sales &amp; Service Organizations: Environmental Compliance" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="69808AA6520F4D09A678C49EDB2102FD">
					<title>Environmental Compliance</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="17FB882A7BC64FDBB4DE10CCE936CE1C" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E83376B614D945AB94FB6D460BA5A38F">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<div style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">With Emissions Management
(SAP xEM) you can</div>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">Monitor and report all environment
compliance issues on plant as well as on corporate level</div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">Control compliance activities,
manage exceptions, and track limits</div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">Support all legal and corportate
defined environmental processes, in particular compliance
reporting, permit management, and all processes concerning any kind
of air, water, and waste emissions</div>
							</li>
							<li>
								<div style="MARGIN: 0cm 0cm 0pt">Streamline all environmental
processes by seamless integration with operations control data,
production control systems, and components from SAP systems such as
Environment, Health and Safety, Enterprise Asset Management,
Materials Management, xMII, Business Intelligence, and Knowledge
Management</div>
							</li>
						</ul>
					</content>
					<product-ref Ref="8FA2EBE56954D311A8220060B03C2BA7" ID="541287F564C44F808FC7AC679B1526F8" type="SAP" key="S38" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Environment, Health and Safety" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F36EC11F9E0B45C5A0500DFA2B9CE428">
						<title>SAP ERP: Environment, Health and Safety</title>
					</product-ref>
					<product-ref Ref="2B7C3D7AF0ED4C6E84A23F718AB62D5C" ID="DFA21344FFE04E39AE1C179B62B889EC" type="SAP" key="S67" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Environmental Compliance" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C78014ED0DF34691A7DD2B78D0EC7B5D">
						<title>SAP Environmental Compliance</title>
					</product-ref>
					<short-description>SAP Environmental Compliance provides an enterprise-wide platform
to assure compliance with environmental laws and policies helping
to reduce cost, effort, and risk both on plant and corporate level.
With Environmental Compliance you can</short-description>
				</process>
				<process ID="0684DE2B73894B82A1DE79C023E1A931" OriginalMap="Automotive - Sales &amp; Service Organizations: Recycling Administration" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9240287195BD4869A12C62FDFE2671C8">
					<title>Recycling Administration</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<span xmlns="http://www.w3.org/TR/REC-html40">SAP Recycling Administration helps you to ensure compliance
with worldwide legislation on packaging waste, batteries, and WEEE
(Waste Electrical and Electronic Equipment), and to meet standards
set by distributors, for example on ‘packaging
sustainability’.</span>
					</short-description>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="6416A0DF67204F8E8A02C176657E62E8" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7C83DD5F36234EAB8F8CF5C41E73D32A">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span>SAP Recycling
Administration provides the following benefits:</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div>
									<span dir="ltr">
										<span>Increase efficiency and minimize cost by
centralizing regulatory knowledge, streamlining declaration
management, and leveraging preconfigured templates that support
more than 50 different compliance schemes.</span>
									</span>
								</div>
							</li>
							<li>
								<div>
									<span dir="ltr">
										<span>Improve data quality by accurately
tracking quantity flows of packaging, covered products, and
batteries in circulation.</span>
									</span>
								</div>
							</li>
							<li>
								<div>
									<span dir="ltr">
										<span style="COLOR: black">Maximize compliance
control by accurately calculating product-related recycling fees,
automatically displaying fees on billing documents</span>
									</span>
									<span>
            and
            <span style="COLOR: black">timely generating declarations
based on up-to-date compliance scheme
information.</span>
									</span>
								</div>
							</li>
							<li>
								<div>
									<span style="COLOR: black; 0pt: ">
										<span>
											<span new="new" times="times"> </span>
										</span>
									</span>
									<span dir="ltr">
										<span style="COLOR: black">Minimize rework by successfully passing audits
based on the automatically generated documentation
trails.</span>
									</span>
								</div>
							</li>
							<li>
								<div>
									<span dir="ltr">
										<span style="COLOR: black">Increase visibility
of recycling cost by drilling down into cost bases and cross
product, cross country management reporting.</span>
									</span>
								</div>
							</li>
							<li>
								<div>
									<span dir="ltr">
										<span>Gain advantage by proactively adopting
upcoming packaging sustainability standards from distributors like
Wal-Mart.</span>
									</span>
								</div>
							</li>
						</ul>
					</content>
					<product-ref Ref="B7FE3F08AD604F44A27D5D24406ED1F1" ID="A978D37668AC44FD82EA853E8DB4EBAA" type="SAP" key="SAP ERP: SAP Recycling Administration" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: SAP Recycling Administration" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="97197DDE261F46C68FB26019DE8B418B">
						<title>SAP ERP: SAP Recycling Administration</title>
					</product-ref>
				</process>
				<process ID="0252479F552E4798AC31408168C96142" OriginalMap="Automotive - Sales &amp; Service Organizations: Compliance for Products" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="037E66FFCA4F465BABA6FDBE5803F6D3">
					<title>Compliance for Products</title>
					<product-ref Ref="8FA2EBE56954D311A8220060B03C2BA7" ID="9DCC870A69E740B7B7B64F478EA9AF49" type="SAP" key="S38" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Environment, Health and Safety" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="08C95962DE7D4C80B16CAF64ED95CFE1">
						<title>SAP ERP: Environment, Health and Safety</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="89B1B7AE3AA4479CBB721F875FD4446D" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CD66D9ABF73A478AAD52D6CC2523146E">
						<title>SAP ERP</title>
					</product-ref>
					<partner-cover>4</partner-cover>
					<short-description>Compliance for Products (CfP) helps you to develop, produce and
distribute your products along environmentally compatible lines –
more efficiently than your competitors. The solution’s cleverly
devised functions help you to achieve this goal quickly and as
cost-efficiently as possible.</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> Compliance for Products provides the following functions:</p>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>Reduces your time and efforts for reducing compliance risks and
business efforts to be compliance and stay competitive</li>
							<li>Ensures visibility and transparency on the compliance status of
materials, parts and products internal and to external
partners</li>
							<li>Improves product development by sharing up-to-date information
with all people involved in environmental efforts</li>
							<li>Reduces logistic costs by using the same master data for all
materials, parts and products</li>
							<li>Harmonizes system landscape while using an adoptive business
solution which covers all existing and upcoming regulations such as
the international material data system (IMDS), the directive on the
restriction of the use of certain hazardous substances in
electrical and electronic equipment (RoHS) and the directive on
waste from electrical and electronic equipment (WEEE).</li>
							<li>Leverages SAP NetWeaver technology to reduce TCO and uses a
common data exchange platform for communication with internal and
external business partners</li>
						</ul>
					</content>
				</process>
