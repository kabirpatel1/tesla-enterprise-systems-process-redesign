				<process ID="63897002942F4DD4A1A46E71656AE525" OriginalMap="Automotive - Sales &amp; Service Organizations: Portfolio Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="09EABB5EF8A749019EC3C9FEBA035C54">
					<title>Portfolio Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="E1C6649AF8F74DEDB6CEB2B5ADD512C8" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="743812109BCF4B3BABFB8945AAD7B715">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="1AEC637727264BD59044AF963C639FCB" ID="92C0030E41B54E73BFB9325570F10A22" type="SAP" key="mySAP ERP: SAP Real Estate Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: SAP Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0751A0721439428F8F08A590E9C8112A">
						<title>SAP ERP: SAP Real Estate Management</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">Portfolio Management
helps you evaluate your real estate portfolio, define your
business' real estate infrastructure and manage business partner
relationships. SAP Real Estate Management can help you do the
following:</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div>Evaluate the
performance of your real estate objects</div>
							</li>
							<li>
								<div>Provide you with
standard reports on costs, revenues, vacancies, measurements,
contracts, conditions, maintenance and service costs and more</div>
							</li>
							<li>
								<div>Define flexible object
structures according to architecture, usage and building
services</div>
							</li>
							<li>Enter master data to tailor your real estate infrastructure to
accommodate primary business activities</li>
							<li>
								<div>Enable transparent
views of your contractual partners</div>
							</li>
							<li>
								<div>Depict objects
graphically via integration to CAD/CAFM and GIS systems</div>
							</li>
							<li>
								<div>Enable a
holistic management of real estate life cycle</div>
							</li>
						</ol>
					</content>
					<process-ref Ref="46E5592A7E8C465088007CE89D9B2CED" ID="3C594F2B57C440F2B60C4475921F063E" variantOf="4FEBB73337E7463FA0043C0C6645E521" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Managing Property Portfolio" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="81BE0B84146E40A9A4D699A8E993F967">
						<title>Managing Property Portfolio</title>
					</process-ref>
					<partner-cover>4</partner-cover>
				</process>
				<process ID="CDA713FF140948DDAE072BB2FC0A6071" OriginalMap="Automotive - Sales &amp; Service Organizations: Commercial Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E9827772593D4A75AFF359B4A806B940">
					<title>Commercial Real Estate Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="E1F8CD127FD94F4690DA7E31090F03C5" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="359B4094C31A40DFB589A3311274F655">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="1AEC637727264BD59044AF963C639FCB" ID="BC8E28A0EFB74A3BB879F443C8730723" type="SAP" key="mySAP ERP: SAP Real Estate Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: SAP Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E9E56CC626B0425CBF8EF6B3D2EE73E0">
						<title>SAP ERP: SAP Real Estate Management</title>
					</product-ref>
					<process-ref Ref="99DEE0B569DE4C768A7F1E1DE9346A5E" ID="4512C2D189854748AD971654332E3675" variantOf="72639AB0CE7711D8265800306E055DA7" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Managing Contracts in SAP RE" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D4D0FC3655464D59A98343342BE87036">
						<title>Managing Contracts in SAP RE</title>
					</process-ref>
					<process-ref Ref="AFC7CFD1E0A24D739F826F0754354D63" ID="3177F95B1C534F349E122C8AF3FDB73D" variantOf="6E168380CE7E11D8265800306E055DA7" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Adjustment of Conditions" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FDD35DC545274BD9B55B46BC91458831">
						<title>Adjustment of Conditions</title>
					</process-ref>
					<process-ref Ref="B0CC46E59DBE42DFAB87CB556C8EFEE5" ID="70EDF3E57D8E4F7D90320F1D5BEE144F" variantOf="C5715DB0CE7B11D8265800306E055DA7" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Charge Settlement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F99B171FA944495BAE18F44D5A39ED73">
						<title>Service Charge Settlement</title>
					</process-ref>
					<process-ref Ref="5FCCB2FFC3CB429B9118B78667695B03" ID="B573F6A42DD04F46BAE7A96F10D7D82A" variantOf="B1A8EEC0CE7A11D8265800306E055DA7" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Managing Sales-Based Leases" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D9F0A12CF9704D35A80D3653773F6AEC">
						<title>Managing Sales-Based Leases</title>
					</process-ref>
					<process-ref Ref="D032348334B04B5DB089AFC6429D0A06" ID="31404110ACEA4CDFA17866922AD0455D" variantOf="2937E6EFF7CB463EA629CD312516E8B1" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Third Party Management in SAP RE" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C8916D469D564C6F9E124028C66A5530">
						<title>Third Party Management in SAP RE</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Commercial Real
Estate Managers</strong>
         such as managers of retail, office,
industrial and residential property are looking for solution to
cover their core business processes based on an ERP solution. Their
key challenge is to make technological adaptation work. SAP Real
Estate Management provides them with:
        </p>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>More efficiency and productivity</li>
							<li>Increased portfolio transparency</li>
							<li>Better options to compete against other professionals</li>
							<li>Higher level of flexibility to adapt the business to changing
needs</li>
						</ul>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP Real Estate
Management can help you do the following:</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div>Match vacant
properties to prospect tenants</div>
							</li>
							<li>
								<div>Create contract
offers</div>
							</li>
							<li>
								<div>Manage lease and
vendor contracts</div>
							</li>
							<li>
								<div>Monitor lease
deadlines and renewal options</div>
							</li>
							<li>Carry out rent adjustments</li>
							<li>
								<div>Manage percentage rent
agreements </div>
							</li>
							<li>
								<div>Calculate chargeable
expenses, balances, advance payments, and adjustments</div>
							</li>
							<li>
								<div>Track settlement
results</div>
							</li>
							<li>
								<div>Manage correspondence
for rental processes</div>
							</li>
							<li>
								<div>Handle mandates and
management contracts</div>
							</li>
						</ol>
					</content>
				</process>
				<process ID="19E98FC3D98E43B1B519586166AEEDCA" OriginalMap="Automotive - Sales &amp; Service Organizations: Corporate Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A9C3D59B8627493CA33F064B4CD9A4F5">
					<title>Corporate Real Estate Management</title>
					<sap-cover>2</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D7A5E0CA60A743979BB436E8066AAC8B" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0BE2D7B6DE204FCF8644FBE1F1ADE0BB">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="1AEC637727264BD59044AF963C639FCB" ID="72CDCE40491D417A91993E21A379FEAC" type="SAP" key="mySAP ERP: SAP Real Estate Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: SAP Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5ACF3044766E41EAB00CEB1ACA904310">
						<title>SAP ERP: SAP Real Estate Management</title>
					</product-ref>
					<process-ref Ref="EE323C4656E1B803E10000000A114AB6" ID="D7F2D419845541F4B92547FDCA8F998E" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Corporate Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A65BE7B14A8743E9B6BB5DAB30CB7E9A">
						<title>Corporate Real Estate Management</title>
					</process-ref>
					<process-ref Ref="0C9C3C4656E1B703E10000000A114AB6" ID="215C7D6DAA104450BAE187C82115E336" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Real Estate Room Reservation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="40DC608DD17145BC935BA516B9834720">
						<title>Real Estate Room Reservation</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Corporate Real
Estate Managers</strong>
         such as managers of corporate offices and
branches want to integrate the significant function of property
management in overall processes such as controlling, reporting and
financials. Their key challenge is to increase space utilization,
prevent budget violations, and enable user-friendly service
management. SAP Real Estate Management provides them with:
        </p>
						<ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>Comprehensive space management</li>
							<li>Automated integration to maintenance, repairs, budgeting,
accounting and controlling</li>
							<li>Improved options of cost allocation</li>
						</ul>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP Real Estate
Management can help you do the following:</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div>Manage corporate
portfolios </div>
							</li>
							<li>
								<div>Assign resources such
as employees or contractors to to spaces and handle moves</div>
							</li>
							<li>
								<div>Handle the reservation
of objects and booking of additional services</div>
							</li>
							<li>
								<div>Enable efficient move
management</div>
							</li>
						</ol>
					</content>
				</process>
				<process ID="57CB54F1BC7F4430BCD11B219B617AF9" OriginalMap="Automotive - Sales &amp; Service Organizations: Facilities Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2BE81EC3A5C34E469885BAF68934D6E5">
					<title>Facilities Management</title>
					<sap-cover>1</sap-cover>
					<partner-cover>4</partner-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="9A8500157D80452BBCE11F3695926737" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="71E7119B34D84D108F0236900B0A6D8C">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="1AEC637727264BD59044AF963C639FCB" ID="3826BA28E60E4D3CAC123A01CE2BE313" type="SAP" key="mySAP ERP: SAP Real Estate Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: SAP Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7D97F2974D0044E2A1435BD70F3606E6">
						<title>SAP ERP: SAP Real Estate Management</title>
					</product-ref>
					<product-ref Ref="E6CB1AE4388C46BF8250CFCB5980ACF4" ID="C911C7CC907D4B97B14DEF9E1BF86170" type="SAP" key="mySAP ERP: Sales/Service Order Processing" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Sales/Service Order Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="829B79CCE4A649CCB9EE5C1AFF691EEE">
						<title>SAP ERP: Sales/Service Order Processing</title>
					</product-ref>
					<product-ref Ref="8FA2EBE56954D311A8220060B03C2BA7" ID="187981A1ED954DB884F95BEF8044B4BB" type="SAP" key="S38" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Environment, Health and Safety" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B8BE015DD2F54E458DC2661D6E557BA5">
						<title>SAP ERP: Environment, Health and Safety</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Facilities
Management</strong>
         supports all processes related to building
operations, including maintenance on rental objects, service
management, the administration of available spaces, and building
operations. SAP Real Estate Management can help you do the
following:
        </p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div>Conduct scheduled and
unscheduled maintenance on your rental objects</div>
							</li>
							<li>
								<div>Display costs in
integrated reports</div>
							</li>
							<li>
								<div>Handle framework
agreements with external service providers</div>
							</li>
							<li>
								<div>Assign services to
externals</div>
							</li>
							<li>
								<div>Monitor modernization
and maintenance tasks</div>
							</li>
							<li>
								<div>Handle malfunctions
and problems reported via phone</div>
							</li>
							<li>
								<div>Prepare and procuring
good and external services</div>
							</li>
							<li>
								<div>Manage available
spaces</div>
							</li>
							<li>
								<div>Maintain space and
rooms as graphical representations with CAD/CAFM systems</div>
							</li>
						</ol>
					</short-description>
				</process>
				<process ID="FBDC8BC6C0BF437EAC896944A3B93F6A" OriginalMap="Automotive - Sales &amp; Service Organizations: Support Processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="95D14079DC874D919B0DC9E4A8FCC510">
					<title>Support Processes</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="99CDB65200ED4765BB33C8026496C8E9" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F2FD2EAEFB8544B2B330EFD4E30140EE">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="1AEC637727264BD59044AF963C639FCB" ID="F2DC8C4E3CCA4CDBBAFE98882576EC83" type="SAP" key="mySAP ERP: SAP Real Estate Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: SAP Real Estate Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="7A1B3C6143F24F47876B607DF738B4AB">
						<title>SAP ERP: SAP Real Estate Management</title>
					</product-ref>
					<product-ref Ref="C336F251A4354DC49EB2BD25B25DC561" ID="5ECD2AF1004D469FB56834333CA2FCC9" type="SAP" key="S8" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt." OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="80FF569A39F7465582CA9CC37E6BF189">
						<title>SAP ERP: Financial Supply Chain Management - Biller Direct, Dispute, Credit and Collections Mgmt.</title>
					</product-ref>
					<product-ref Ref="5CE3CF2EC8F1431F8BF94EB3FE33B368" ID="1627C469C7164525B3296D6DA82E6552" type="SAP" key="mySAP ERP: SAP Financial Supply Chain Management - Treasury Management and In-House Cash" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP: Treasury - SAP Treasury and Risk Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="501FB7E7AE16415FAA603F4BFC964F00">
						<title>SAP ERP: Treasury - SAP Treasury and Risk Management</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Support
Processes</strong>
         help you manage the accounting and controlling
activities related to your real estate portfolio. You are able
to define investment strategies through accurate costs and revenue
performance data, improve how you manage integrated property
portfolios and gain complete cost transparency. Correspondence and
document management are available for all real estate processes and
enable you to optimize relationships with your business partners.
Additional tools for new technologies guarantee flexibility and
long term investment security. SAP Real Estate Management can help
you do the following:
        </p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<div>Invoice
contracts</div>
							</li>
							<li>
								<div>Manage rent
collection, payments and dunning</div>
							</li>
							<li>Carry out the planning and settlement of costs and
revenues</li>
							<li>Identify costs incurred by real estate objects</li>
							<li>Handle correspondence and document management for all real
estate processes</li>
							<li>Enhance customer-specific functions</li>
							<li>Integrate to external systems and services   </li>
							<li>Integrate to industry solutions </li>
						</ol>
					</content>
				</process>
				<content>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				</content>
				<cbs-ref Ref="C57C4AAC5CF842C0A8D5B4780AE66C4F" ID="DEA608E62064455788313958D9636EE3" OriginalMap="Automotive - Sales &amp; Service Organizations: Real Estate: Third Party Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="739F4221E79C4856A273A9D8758A1283">
					<title>Real Estate: Third Party Management</title>
				</cbs-ref>
