						<title>Vehicle Billing</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process to send an invoice for a particular vehicle or a group of vehicles to your dealer.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="DB0BBBE6379946AF9267F4464E366853" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="08908A7CCB4140F8B1A11F651AE7D3B2">
