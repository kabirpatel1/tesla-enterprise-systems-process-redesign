				</cbs-ref>
				<process ID="1AA3C237A4804E5389DC64BBDC59B8D0" OriginalMap="Automotive - Sales &amp; Service Organizations: HCM Processes &amp; Forms" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D58BDE682EC5409199AC58BA6DD37316">
					<title>HCM Processes &amp; Forms</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="3A61C04D2AF146F089B677DC1DF490B0" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3FD98A0E53EB4B1E8BBF2BAF644FBC49">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="D6EF106925184D27836EA67FB869" ID="423CBEFECBC046688263175119E674E8" variantOf="E669E869542747D1A7655CB8067F3B77" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Administering Employee HR Data" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="87FD2429B70F4021AA870B6BE6369C71">
						<title>Administering Employee HR Data</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
         HCM Processes &amp;
Forms automate paper-intensive and time-consuming employee-related
processes such as hiring, termination, organizational reassignment,
and maternity leave.
         <span style="mso-spacerun: yes"> </span>
         Interactive Forms by Adobe accelerate data entry and flexible
workflow templates enable organizations to handle routine workforce
processes quickly. The application is very flexible and empowers
organizations to define standardized processes. All involved
business roles such as affected employees, affected managers and HR
professionals can be directly involved in the process. Regardless,
if you implement an HR shared service delivery model with SAP
self-services or even include an HR shared service center,
Interactive Forms by Adobe build a strong automation layer for your
workforce processes.
        </p>
					</short-description>
					<product-ref Ref="0596CE705CA84D09A8B1CDD8CC820067" ID="810E983D3B80465FB14A86561266DAB4" type="SAP" key="SAP Interactive Forms by Adobe" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Interactive Forms by Adobe" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="66B7A5DBDF0048929146A9C7D40AD801">
						<title>SAP Interactive Forms by Adobe</title>
					</product-ref>
					<product-ref Ref="CEF4FB75818F43C0AB9E4C13C4E88D1C" ID="77F758E271844C6AAB3DC3BD5445245A" type="SAP" key="SAP NetWeaver Records Management" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP NetWeaver Records Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1BA9C2F41E19471D92DC28ED6032D92B">
						<title>SAP NetWeaver Records Management</title>
					</product-ref>
				</process>
				<folder ID="C91DEA90D95845ECB2778D7826490592" OriginalMap="Automotive - Sales &amp; Service Organizations: Value Collaterals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B6C809205ADC44E7B191BDAB40993C49">
					<title>Value Collaterals</title>
					<hyperlink ID="839D169CF9724FD5924ABC64031BDFC2" href="http://download.sap.com/SMIGlobal/download.epd?context=7E480EA1C717B353A225FD9EF2DD15366EF8003182918D6F0E84352FAB63FA538799E17E82E30A37DBD0C5FC682A6FD8F37051643C5D58F2" OriginalMap="Automotive - Sales &amp; Service Organizations: Solution in Detail: Introducing HCM Processes and Forms" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4D759A465D424AB195FFC0FAD8FF8895">
