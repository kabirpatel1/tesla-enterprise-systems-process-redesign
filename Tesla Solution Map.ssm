					<process-ref icon="process-ref.gif" ID="356A01681BF5403E83E36E81A72E9604" Ref="D3DC6F3EBA879D13E10000000A114AB6" variantOf="8D1856B5F48E458F8230706F55291E87" OriginalMap="Automotive - Sales &amp; Service Organizations: Incentive Processing with CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EDB2B40E437044B68E975A0F3DC480A5">
						<title>Incentive Processing with CRM</title>
					</process-ref>
					<short-description>You use this process to transfer sales transaction data to the ICM incentive plan for commission calculation.</short-description>
				</process>
				<process ID="8601AA96B9A444AEA23C50FB98B13812" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EE0591308F67463283061886D832DDD4">
					<sap-cover>1</sap-cover>
