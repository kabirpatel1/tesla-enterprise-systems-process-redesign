				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Real estate management
solutions support every stage of the real estate portfolio
lifecycle to streamline business processes and optimize investment
portfolios.</p>
				</short-description>
				<folder ID="85C8E0DE49CE49A19DBEB98D56F64EA6" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Roles" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="375C02DA47474EFDA60CE1D104083514">
					<title>SAP Roles</title>
					<hyperlink ID="FAC91AFBB7B24F4399E8292496BA9854" href="javascript:smnavigate('6994BDFC0DD849778ABD87676B700A0E')" Ref="6994BDFC0DD849778ABD87676B700A0E" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Maintenance Planner" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FC6935AF03834A46A4D99C0C0EB97193">
						<title>SAP Role Maintenance Planner</title>
					</hyperlink>
					<hyperlink ID="84E6ECF38F0342F99856670FFD4971B8" href="javascript:smnavigate('734924778BE4456CAD8DABF87AFC314D')" Ref="734924778BE4456CAD8DABF87AFC314D" icon="sap-product.gif" noAutoNavigate="false" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Role Maintenance Supervisor" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EC560D64D54045BCB74F11639190EF5D">
