				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="5B671D9F48A943CCBA41766C22FCE80A" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9E8346089B2249BC82E9884E6E4B5AC4">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="3D3C43A0FD234AF3B8CE741BCCBA41EE" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 060" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Depot Repair" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D8D89359D6EE46D3BA76A36B8CD856C2">
				<title>Depot Repair</title>
				<process-ref Ref="6F01F2E46D044A3D808A5BBDFDE7520C" ID="599277AE0FDF41528EB0694C56173885" variantOf="6F01F2E46D044A3D808A5BBDFDE7520C" OriginalMap="Automotive - Sales &amp; Service Organizations: In-House Repair Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="EA4B825B23B24A57B05274671772BF49">
					<title>In-House Repair Processing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">The customer contacts the service provider with a request for his or her defective product to be repaired. You create an in-house repair order in SAP CRM.</P>
				</short-description>
				<process-ref Ref="BC28783E3CB49D13E10000000A114AB6" ID="11858CC3212F4DFAA89CE73A3416B46B" variantOf="6F01F2E46D044A3D808A5BBDFDE7520C" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: In-House Repair Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5236EADED4C440C8B6090D832AAE91D2">
					<title>In-House Repair Processing in CRM</title>
				</process-ref>
				<process-ref Ref="EAC177D6F60348ADBB9481E7B66C5A56" ID="2D46E38CA81A4D9E902A349B7DD99D32" variantOf="6F01F2E46D044A3D808A5BBDFDE7520C" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: In-House Repair Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2CE1B293985942E88E2AB8FD3487A6AD">
					<title>In-House Repair Processing in ERP</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="37DC8BB512CD4258B853D4B3232CE8D4" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A93E58BF1D2C4E2EA24B916EA58118C1">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="27C71B83630B44759E8E54733CFBD6AD" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 146" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Confirmation Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E3FC6DF2F7914E238FB6C7FB39CF4D5E">
				<title>Service Confirmation Processing</title>
				<process-ref Ref="812FF99CE16D45A7AC63C8C406F921DD" ID="3DD608972E6348769E6D13CD0B82599F" variantOf="812FF99CE16D45A7AC63C8C406F921DD" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Confirmation Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B4B43CED814A40439F7FEDC114ED69F6">
					<title>Service Confirmation Processing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to confirm working times, materials used, and expenses for services performed. To simplify the task of confirmation, you can plan these confirmation items in a service process (for example, a service order) or an in-house repair order. The field service representative then references the process or order and copies the relevant planned items to a service confirmation document.</P>
					<P xmlns="http://www.w3.org/TR/REC-html40">Confirmation data is automatically posted to integrated SAP R/3 systems to enable an update of stock data, working times, and controlling data.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="1DD25E2472CA457695DEBBF03AAF0A3E" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2FD87A1664FC46EC9307942C6323BDA1">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="4C696B2FDF2E4A4AA35BBACF043C28D6" businessArea="Sales" processOwner="Volker Hildebrand" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 013" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="96FA0227E52B461DB24A4E6AA9555482">
				<title>Billing</title>
				<process-ref Ref="27E7DB71E4894B719F259DEB40F5B455" ID="4FC41B3DBC804E1F8336D675D0D987C3" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F6539806D136493193590AA10AF1B1C0">
					<title>Billing</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process in order to create customer invoices. You can either create the billing document with reference to the delivery, or to the sales order. It is also possible to create billing documents with reference to contracts. You make the necessary setting in Customizing. The following describes delivery-related billing.</P>
				</short-description>
				<process-ref Ref="D09E4F3E80844168E10000000A114AB6" ID="797DB3394C0E4448B33DE28C49660C0E" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3D5159AA67554BE99B1FA5BD82D44D91">
					<title>Billing in CRM</title>
				</process-ref>
				<process-ref Ref="A7660F608BB711D912D100306E055DA7" ID="1F0E78FEFBBA4296835C738FA958207A" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing in CRM for Service Parts" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F57E8E8F88064F0A9856B9C097776971">
					<title>Billing in CRM for Service Parts</title>
				</process-ref>
				<process-ref Ref="D55382A0D0A911D8265800306E05" ID="C0143CA1FDD7404BA33FF93E1C69258F" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Invoice Correction Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9D71F8E7B0804B93A2C02660ADC2CF87">
					<title>Invoice Correction Processing in ERP</title>
				</process-ref>
				<process-ref Ref="7222026AA69A47AD88417DB742A9" ID="8DDEF62448F94935AF81DCE1E9030A13" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9CB39467B7314FD78EC5DB4E290A37E4">
					<title>Billing in ERP</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="4A0842BFCAFF4BD889FAB0A3567ECF88" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5521E239657042EC89B6479AA0982993">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="572C8F74825B4D8280256B5FAE6D288F" businessArea="After Sales &amp; Services" processOwner="Barbara Althoff-Simon" responsibleOrgUnit="BSG S ASM" runningNumber="CRM 158" solmanAvailability="2" variantNumber="0" covered-by-ERP="true" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Performance Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0FDB692074274FD2B949F489AFC1B148">
				<title>Service Performance Analysis</title>
				<process-ref Ref="0B31C0101F6B413191561E7E597083F3" ID="9D30A57C4B814F4E8F445274E5996972" variantOf="0B31C0101F6B413191561E7E597083F3" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Performance Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9EE19BE6816B401D8F0583A5AA290FD4">
					<title>Service Performance Analysis</title>
				</process-ref>
				<sap-cover>1</sap-cover>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to analyze the operational performance of your service organization from the following perspectives:</P>
					<UL xmlns="http://www.w3.org/TR/REC-html40">
						<LI>
							<DIV>Financial</DIV>
						</LI>
						<LI>
							<DIV>Customer</DIV>
						</LI>
						<LI>
							<DIV>Internal</DIV>
						</LI>
						<LI>
							<DIV>Employee</DIV>
						</LI>
					</UL>
					<P xmlns="http://www.w3.org/TR/REC-html40">This enables you get a balanced view of the current situation, taking into account the goals of your organization in each of these areas. The analyses described in this process for each of the above analytical perspectives are examples of the many different analyses of service performance that you can perform in SAP BW with data extracted from your operational systems.</P>
				</short-description>
				<process-ref Ref="45FC653E81623F68E10000000A114AB6" ID="619A5A42DB5247FDB14A7F663B2D4725" variantOf="0B31C0101F6B413191561E7E597083F3" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Performance Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4D4E47B9F56E4BC8BB6078541E7F0E0A">
					<title>Service Performance Analysis</title>
				</process-ref>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="5CE8F6F256F04557B5CB4D8BA5CCB1D7" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FF8A3C50556F46CB8B13550B9CB53615">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<short-description>
				<P xmlns="http://www.w3.org/TR/REC-html40">Service Operations for Depot Repair and Field Service enables the long-term planning and optimization of resources (people, tools, parts) as well as their deployment and short-term scheduling as customer service requests or planned service activities occur. The delivery of services can be executed inhouse or in the field using mobile solutions for field technicians. Outsourcing of services, service sourcing and procurement, billing and payment processes are part of the overall solution.</P>
			</short-description>
			<business-objective-ref Ref="A7F78C9AEB4F41799B1D93B2D2232922" ID="D4E2D141B8A74EE7AE308C750A3A493D" OriginalMap="Automotive - Sales &amp; Service Organizations: Enable cross-sell/up-sell capability" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BCAFBB60E26C4D6B8A73EDC9FD469502">
				<title>Enable cross-sell/up-sell capability</title>
			</business-objective-ref>
			<business-objective-ref Ref="5C0DBA7FB7AD494DB0F78C38CD5FB9DC" ID="F993BFA1A21D47F68DEA384E34618D22" OriginalMap="Automotive - Sales &amp; Service Organizations: Improved quality and accuracy" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FDA30EC2B71443F7A9CCB7EA836406E6">
				<title>Improved quality and accuracy</title>
			</business-objective-ref>
			<kpi-ref Ref="kpi-0OPCF021" ID="56726DBBF06B495DB8F388F038D88D83" OriginalMap="Automotive - Sales &amp; Service Organizations: Percentage of Breakdowns" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="B8CEE3EB4C744B47AC1165D7F53D8B97">
				<title>Percentage of Breakdowns</title>
			</kpi-ref>
			<kpi-ref Ref="kpi-0OPCF028" ID="7B6ECD4970ED433E8796F834C2BC4405" OriginalMap="Automotive - Sales &amp; Service Organizations: Response Time: Field Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A1AA34D8EF7C41FF8A6BA370A43B0051">
				<title>Response Time: Field Service</title>
			</kpi-ref>
			<partner-opportunity-ref Ref="524B234B47CE46AFB425177BD0BC0700" ID="C4B70E8404F2489F8CDDDF4381282613" OriginalMap="Automotive - Sales &amp; Service Organizations: Voice Enabled Service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9BB9EED51F9B42288D8BE6062C3CC646">
				<title>Voice Enabled Service</title>
			</partner-opportunity-ref>
		</business-scenario>
		<business-scenario ID="8786D58B43F3427E8400F0B7B4EF5EFA" bprid="745AC750589F46CD89810A68EF639FD7" responsibleOrgUnit="BSG M" xmlns:bpr="http://www.sap.com/ns/bpr-common" OriginalMap="Automotive - Sales &amp; Service Organizations: Warranty Management" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="02C63FA1838F47018C3F2CDDFF168D74" modified="8/14/24 08:10:16 PM">
			<title>Warranty Management</title>
			<process ID="A8953C5680124C4C845BD622C1827694" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract and Quotation Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="71E16CFB6ABD4076B0DE341173D0889B">
				<sap-cover>1</sap-cover>
				<title>Service Contract and Quotation Analysis</title>
				<process-ref icon="technical-variant-ref.gif" ID="CFFBA434DA1C4264BF324204541ED9F5" Ref="C2FE653E81623F68E10000000A114AB6" variantOf="CC0B505F478D4305910D638658BCBCEA" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Contract and Quotation Analysis in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CC98DAC9B8BC435FB7CC8327FB2E5463">
					<title>Service Contract and Quotation Analysis in CRM</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to analyze your service contracts and quotations from various perspectives, in order to determine whether changes are necessary to optimize your contract range. For example, you can analyze customer satisfaction with contracts and services performed under contract, and monitor the financial aspects and volumes of existing contracts.</P>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="C15C301D5DF24EB1888EF92CD3C4955B" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E9DAAE65873B4651AB2E139292854B52">
					<title>SAP ERP</title>
				</product-ref>
			</process>
			<process ID="6C4BE3D4FCD44E9D8BC24F27E877C4BF" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Warranty Claim Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DEBA67F4AEEB474FB7DC337DCB0BDFC7">
				<sap-cover>1</sap-cover>
				<title>Warranty Claim Processing</title>
				<process-ref icon="process-ref.gif" ID="02D0624FB3BB4F04AA6067D5F9488F7B" Ref="7C7243EFB0E340D281B4815E937B0F42" variantOf="7C19BAEAFDA748758CB6D0A990B80858" OriginalMap="Automotive - Sales &amp; Service Organizations: Warranty Claim Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="15A3F21127644918B5750FC86AB9864C">
					<title>Warranty Claim Processing in ERP</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Warranty Claim Processing fulfills the needs both of manufacturers, importers or vendors of complex products and their suppliers. In this business environment, the prerequisites for a right to warranty are becoming more extensive and more complex. Warranty restrictions due to the length of service or age of the product, authorization processes and comprehensivecheck mechanisms in the warranty claim make warranty claim processing in many companies a timely and costly procedure. Furthermore, due to a European legal initiative, the warranty or guarantee period for products of specific industry sectors has been extended to at least two years. The number of incoming warranty claims has, understandably, increased in the wake of this decision. Warranty Claim Processing offers you a software solution that can deal with a large number of warranty claims comfortably and, as far as possible, automatically. Only those claims that produce negative results in the automatic checks are included in manual processing. You also have a maximum amount of flexibility as regards the warranty conditions that you can define.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="2C69EDC63CFC40D5AE4B62F9249BEA71" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="216EC4839947497F86D18DF76C5AB55C">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="0A80AE6B452C4020BAEFC1E2F601FD85" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D03EF8923B38436980B2EB4FAA1AA1FE">
				<!--#!#16161616#!#-->
				<sap-cover>1</sap-cover>
				<title>Billing</title>
				<process-ref icon="technical-variant-ref.gif" ID="0A07DEC3C24F45C7953CB77E3FA2B111" Ref="D09E4F3E80844168E10000000A114AB6" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="07A19602DA9548AE87271049E2E0D343">
					<title>Billing in CRM</title>
				</process-ref>
				<process-ref icon="technical-variant-ref.gif" ID="E6A9122F492B467FAD7622291741133C" Ref="7222026AA69A47AD88417DB742A9" variantOf="27E7DB71E4894B719F259DEB40F5B455" OriginalMap="Automotive - Sales &amp; Service Organizations: Billing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="47C01C2BE6554CC9997EE0137597AD76">
					<title>Billing in ERP</title>
				</process-ref>
				<short-description>You use this business process in order to create customer invoices in SAP CRM. Here, one or more than one billing due list item is copied into a billing document. You can either create the billing document with reference to the delivery, or to the sales order. It is also possible to create billing documents with reference to contracts. You make the necessary setting in Customizing. The following describes delivery-related billing.</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="E64BC40E94664F928058842548EC293A" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3D0AAD8A036243659402DF33FBAEB992">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="52ADF729EA4C48FBA5E00BD6EAF9B067" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="553265521566423A8F3B27B8120A1CC5">
