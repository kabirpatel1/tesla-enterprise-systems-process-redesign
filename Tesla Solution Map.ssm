						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="FD814371CB2A44A4B348C5380BF5A5D1" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Late Order Assignment" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="76E57F104D2E4F18A5BCF51822BDA1F5">
					<sap-cover>1</sap-cover>
					<title>Vehicle Late Order Assignment</title>
					<process-ref icon="process-ref.gif" ID="5246F2CBAB754DA3A89FFCC1DE0F7EE2" Ref="79B91AB0F4E211D812D100306E055DA7" variantOf="57D980553AC34F7081A4B7A560B6D394" OriginalMap="Automotive - Sales &amp; Service Organizations: Assignment of Vehicles to Sales Documents" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0C8606DD9E4A41398704CD5C4CE0882A">
						<title>Assignment of Vehicles to Sales Documents</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">Importers use this process to assign available vehicles for existing sales orders which have no relation to a vehicle yet and which have been created by dealers.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="BAB3E456EC194F58B1E5868F5E7AC698" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3A901E53F820418D80D4A8D23D1BD75B">
