					</product-ref>
				</process>
				<process ID="3C4CA286114E49208608D79079173123" OriginalMap="SAP Supply Chain Management: Detailed Scheduling" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="0795AF7A706A4817ACD36C095EAED345">
					<title>Detailed Scheduling</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="648BAC1ACD64480CBEFC789FDA09168B" ID="169D0CDA0E1E4D979C1FA2F84E8BBE5A" variantOf="3E060BBF9FB54B8FA7829222DBE7409D" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Production Scheduling (Manual Scheduling)" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4E9BEB9D043040B2A4806551D1A6AB9F">
						<title>Production Scheduling (Manual Scheduling)</title>
					</process-ref>
					<process-ref Ref="397B66D0EB7111D812D100306E055DA7" ID="323D78BD188A425D8186279ED1ACAD90" variantOf="3E060BBF9FB54B8FA7829222DBE7409D" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Production Scheduling for Project Manufacturing (ETO)" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4286E9479045434E868D3083F3F745D5">
						<title>Production Scheduling for Project Manufacturing (ETO)</title>
					</process-ref>
					<process-ref Ref="10A09EC2DB6B4D0EB2D0F086D876DB85" ID="4FCC5C6FB0B24D55ADC7E226E0304726" variantOf="3E060BBF9FB54B8FA7829222DBE7409D" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Production Scheduling Optimization" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="735BCCD25C694F6DB180CC33F8DFE937">
						<title>Production Scheduling Optimization</title>
					</process-ref>
					<process-ref Ref="5EFE5423AB1742AD90E2C55C8E7E5732" ID="E4F99E23A65644E2BD8D5EE3D133865E" variantOf="3E060BBF9FB54B8FA7829222DBE7409D" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Production Scheduling with Block Planning" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="979F7F48C5354D59A6E4F12D826EECBC">
						<title>Production Scheduling with Block Planning</title>
					</process-ref>
					<process-ref Ref="F6F7F10C82BD4036A2F4A9245155B098" ID="B3F20225B6024E23AE86E3C31B4F1C39" variantOf="3E060BBF9FB54B8FA7829222DBE7409D" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Production Scheduling with Production Campaigns" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="ED2EBCAAA40C4104AB7AE66EA891B7EE">
						<title>Production Scheduling with Production Campaigns</title>
					</process-ref>
					<process-ref Ref="D45841883A394C3780D05C4C68C7E809" ID="F896E12B1E6F44B085135DE434EB8C91" variantOf="3E060BBF9FB54B8FA7829222DBE7409D" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Production Scheduling with Scheduling Heuristics" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="0523C9502B484E09938FF042B25AEB15">
						<title>Production Scheduling with Scheduling Heuristics</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D550C2DFBC7247319AED82DE8FC1191D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6C83A417E00841CB83ED03248D318B9F">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">What-if simulations and
evaluations of orders sequences support the planer with flexibility
and control. Due to the seamless integration with the execution and
inventory management system, material shortages or critical
resource situations can be seen immediately and the schedules can
be manually or automatically adjusted accordingly. Detailed
Scheduling fulfills requirements of process as well as discrete
industries (takt-based and job-shop scheduling for configurable and
non-configurable products in an make-to-stock and/or make-to-order
environment; block planning, campaign planning, push production for
process industries). Customer-specific planning needs can be served
with individual heuristics and optimizers to extend the standard
planning tools with user- and industry-specific components, like
trim optimization algorithms in mill industries. These individual
heuristics and optimizers are launched directly from PP/DS planning
screens. Combined with standard optimizers and heuristics, they
form one integrated planning system.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Detailed Scheduling
delivers optimized order sequences that can be released for
production. Scheduling heuristics and solvers take into account
constraints and costs to schedule the optimized order sequence,
based on business objectives. Dynamic alerts and order pegging
structures improve the visibility of the product flow.</p>
					</short-description>
				</process>
				<process ID="AC19F334354A409E8167B62254B90890" OriginalMap="SAP Supply Chain Management: Multilevel Supply &amp; Demand Matching" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E655EE7C8F7B48FB837335F653206256">
					<title>Multilevel Supply &amp; Demand Matching</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="3E43F915FF6745A3A5D72DDC7C86AA8E" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6EDF77CDB9574F3B90FD7D56D80C950C">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">The CTM planning run is
powered by the CTM engine, which matches the prioritized demands to
the available supplies in two phases. First, it builds the CTM
application model based on the master data that you have entered.
It then matches supply to demand on a first come, first served
basis, taking production capacities and transportation capabilities
into account.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Capable-To-Match
planning uses constraint-based heuristics to conduct multi-site
checks of production capacities and transportation capabilities
based on predefined supply categories and demand priorities. The
aim of the CTM planning run is to propose a feasible solution for
fulfilling demands.</p>
					</short-description>
				</process>
				<process ID="51797F8607664FD39E9E6FBFF66EF3B5" OriginalMap="SAP Supply Chain Management: Materials Requirements Planning" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="618DC4BDFFD94C6380A6BFF37EF89654">
					<title>Materials Requirements Planning</title>
					<sap-cover>1</sap-cover>
					<short-description>MRP is part of the production planning process and generates
replenishment schedules for all manufactured components,
intermediates, purchased parts, and raw materials. MRP sets due
dates for production orders and purchase requisitions through
lead-time scheduling, depending on buffers, operation times,
lot-sizing rules and so on. The planning run is supported by
optimization tools when resource situations can be taken into
account simultaneously.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="117438D8F8BD4D31858999F0B9CCF3CE" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="0CB9001C1D604AF2B6A09ED6C9AC0ABC">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="714BA6E397CA43ADBBBA0B189A8A7572" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FAAD378E323B46F2AB4E1C40EB1D12FA">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<short-description>Production Planning &amp; Detailed Scheduling supports the process
of assigning production orders to resources in a specific sequence
and time-frame.</short-description>
				<business-objective-ref Ref="79377C3EA92B4FCAA863C07EADBD2C5F" ID="650FF1B38FE94916B3B4CC10294D7377" OriginalMap="SAP Supply Chain Management: Collaborate with business partners" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="95CC081919BE45649764EFD72364F53D">
					<title>Collaborate with business partners</title>
				</business-objective-ref>
				<business-objective-ref Ref="1818E74A594D4A6D9C0A1A551D74D570" ID="8478114214A542E8AF9A9746E677C704" OriginalMap="SAP Supply Chain Management: Reduce time-to-market &amp; volume" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6D089F06C64E47F98A163DEB83489049">
					<title>Reduce time-to-market &amp; volume</title>
				</business-objective-ref>
				<business-objective-ref Ref="DECD4E771AC24E749C94DCF0779B6C74" ID="F51FA5058C734FE798E6BFC8511BE957" OriginalMap="SAP Supply Chain Management: Improve capacity utilization" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1C7BC97F4A4F4A3192C08FC9DFA41682">
					<title>Improve capacity utilization</title>
				</business-objective-ref>
				<business-objective-ref Ref="E2C085B3FAE8458FA6E09D6EAF7DD327" ID="47CF8A227EFA4284B0468A0A8357100F" OriginalMap="SAP Supply Chain Management: Reduce down-time" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B2DA79816C034A3E9EE9945C3103DA6B">
					<title>Reduce down-time</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="525E18958B6D4DB4B84DBD83AA9E0163" OriginalMap="SAP Supply Chain Management: Manufacturing Visibility &amp; Execution &amp; Collaboration" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="464D892879004D20BB7779A4A75FC0DE">
				<title>Manufacturing Visibility &amp; Execution &amp; Collaboration</title>
				<process ID="C11A9DB403FD410690EB8F7AF7C53EFD" OriginalMap="SAP Supply Chain Management: Make-to-Order" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="0BA21789044B4A469A37CF2C939F0C79">
					<title>Make-to-Order</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Supports customer order
specific planning and production. The make-to-order process depends
on industries. The solution supports assembly processes for (non-)
configurable products in a repetitive manufacturing environment, or
the production of (non-) configured products with production
orders. For both processes the visibility of the customer order is
key. This is achieved with dynamic alerts and order pegging
structures during planning and execution.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="E84FB55C35E643F29EF24E3491340385" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FAA43B24CF1F4CA4838FFDD7B6A34C3C">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="C2662202F4A8486F87A2D58F8F448B0C" OriginalMap="SAP Supply Chain Management: Repetitive Manufacturing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9965607584B94C1B9F41696F84E4E15E">
					<title>Repetitive Manufacturing</title>
					<sap-cover>1</sap-cover>
					<short-description>Repetitive manufacturing is a rate-based lean production control
system. Based on production and assembly lines, the takt times are
used for scheduling. Optimizer and heuristics are available for
model-mix planning and line balancing. Continuous input and output
is considered during scheduling. The production runs without any
orders for run schedule quantities and production versions.
Backflush of labor and material at reporting points support the
lean execution process.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="26E048E5AA3A474AAFB3546E8528B90A" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2AE322B6024346858D3C79B2C4953BCB">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D058C00833924EAA91B7AB0FA80FFF80" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A45152173203469F8613BB3A34069F2F">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="73AC2C95C8DE403A8BE301E9399033B4" OriginalMap="SAP Supply Chain Management: Flow Manufacturing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="39CADE4B9F4F4251A62AB7DA669BDAB5">
					<title>Flow Manufacturing</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">In a flow manufacturing
environment, the customer demand from CRM will be pulled through
the production process. The key elements of the solution are line
design and line balancing, demand management, line
sequencing/model-mix planning, lean execution, backflush, and
Kanban management.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A6CF01A69D9A4ED08B70EDB5B021249D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="65B7E1ED2A9044EC8DF9AF73D9559571">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="0BD166A1D2F0413FB9F6180071E30EAC" OriginalMap="SAP Supply Chain Management: Shop Floor Manufacturing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9724850943394BBA94E5E2B42BBE678A">
					<title>Shop Floor Manufacturing</title>
					<sap-cover>1</sap-cover>
					<short-description>In shop floor manufacturing, production orders track and control
the production. The real-time integration between CRM, production
planning and execution improves quality and speed of processes. The
confirmation of labor and material issues takes place at operation
level. Milestones, backflushing and automatic goods receipts can
reduce the number of business transactions. Multi-level production
processes can be controlled. The seamless integration to quality
management enables quality inspections during production. Other
characteristics are control of rework, batch tracking, and serial
number management.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="B1F9FA16A9B04E6D9EC6C226423B4D04" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="86395C2C44C548078339FC2692C4DB37">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="371773C83347418990A7F2EA0793C4C4" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="460FA2827F854C96AD76A291D63567F3">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="11892DE1022C4905A706964EA99B64A3" OriginalMap="SAP Supply Chain Management: Lean Manufacturing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9F3C5233A49E45F9924BE54AD57F9F65">
					<title>Lean Manufacturing</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Continuous improvement
and elimination of waste across the organization are key for lean
manufacturing.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>The forms of
waste are:</strong>
						</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<strong>Inventory</strong>
         . Inventory must always be
minimized.
        </li>
							<li>
								<strong>Defect correction</strong>
         . Resources spent on defect
correction are waste.
        </li>
							<li>
								<strong>Unnecessary processing</strong>
         . All unnecessary
activities, particularly non-value-adding ones, are to be
avoided.
        </li>
							<li>
								<strong>Unnecessary motion</strong>
         . Materials and
work-in-progress (WIP) should follow a minimal path through the
factory.
        </li>
							<li>
								<strong>Transport</strong>
         . Transport of materials should
simply be avoided. Time in transport does not add value.
        </li>
							<li>
								<strong>Waiting</strong>
         . WIP is to be minimized.
        </li>
							<li>
								<strong>Overproduction</strong>
         . Produce only if there is a
customer demand.
        </li>
						</ol>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="C5FC3E51CAC24282BC41F4A66F7C9318" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="199AF341B10B49E6805D10688FB1E183">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Key Concepts in
lean manufacturing are:</strong>
						</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<strong>
          Continuous flow
          <br></br>
								</strong>
         Material flows continuously from raw material through to
finished product without "waiting" for large batches to be run.
Lean addresses the waste of set-up time by minimizing set-up times,
rather than minimizing the number of set ups.
        </li>
							<li>
								<strong>
          Value Stream
          <br></br>
								</strong>
         The value stream encompasses all the actions required to
bring a physical product through the main manufacturing and
business processes from acceptance of raw materials or components
to delivery of the to completed item. The Lean Enterprise
coordinates all supply lines (internal and external) and links all
parts of the value stream so that they converge at the appropriate
points in time .The value stream is mapped out to analyze all steps
from start to finish, and redesign them to ensure  that they add
value to the final product.
        </li>
							<li>
								<strong>
          Value-Added Activities
          <br></br>
								</strong>
         Activities in the value stream are identified as
value-added (VA) or non-value-added (NVA). NVA activities are
eliminated as much as possible. Some NVA activities are
unavoidable; these are sometimes referred to as essential NVA
activities. Once mapped, the value stream activities are identified
as VA or NVA.
        </li>
							<li>
								<strong>
          Pull Production
          <br></br>
								</strong>
         Production and purchasing activities are based on signals
from the follow-on process. That is, materials are supplied when
needed, avoiding unnecessary WIP and speeding the flow of material
through the system. This ensures that work is performed only when
required.
        </li>
						</ol>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>SAP SCMs key
elements for lean manufacturing are:</strong>
						</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<strong>
          Kanban
          <br></br>
								</strong>
         provides full electronic integration, allowing electronic
Kanban signals to be triggered via hand-held devices and
transmitted for internal production, or even directly to suppliers,
without the traditional Kanban card.
        </li>
							<li>
								<strong>
          Direct Production
          <br></br>
								</strong>
         is used, the production orders for a product are networked
together to form a “collective order”. This ensures that the
hierarchy of production orders can be managed as a whole, and
enables companies to simply pass interim products or components to
the next work-center for the following production order, instead of
moving them into stock. It also allows lean production execution
while backflushing labor and material.
        </li>
							<li>
								<strong>Integrated Product and Process Engineering
(iPPE)</strong>
								<br></br>
         The integration of engineering design activities with those of
manufacturing engineering avoids unnecessary iterations across
functional boundaries and accelerates product development and
time-to-market. SAP supports this process by providing a set of
master data that is consistent across the design and manufacturing
application areas. iPPE also allows to design and balance
production lines
        </li>
						</ol>
					</content>
				</process>
				<process ID="0DBE29ABF1414344AC51E43661BE2FF2" OriginalMap="SAP Supply Chain Management: Process Manufacturing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D36A9B9316E94FEA96ABAADB122D44C8">
					<title>Process Manufacturing</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">Process manufacturing
supports the plant as a multi-process facility. Resource and recipe
management are the basis for planning and sequencing of batches or
production lots. The solver schedules the process order sequence to
avoid costs like cleanout or changeover. This can be achieved with
production campaigns, block planning or detailed scheduling with
focus on critical resources. Process orders are used for
scheduling, execution and costing. Process management coordinates
the data exchange between the SAP execution and connected process
control systems. These processes can be documented and evaluated.
The seamless integration with the quality management ensures
process control and stability.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Batch Management
fulfills the requirements of the pharmaceutical and chemical
industry for managing and tracking batches or production lots
during the whole production process.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">The SAP APO Optimization
Extension Workbench (APX) provides a new means of making
optimization strategies more flexible. The primary purpose of the
workbench is to extend the standard planning tools in SAP APO to
include user-specific optimization components. These individual
optimizers are launched directly from SAP APO. Together with the
standard optimizers and heuristics, they form one planning system.
This system provides the right degree of flexibility to be adapted
to the precise needs of the user.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">In addition to the
functional integration of the external optimizer in the standard
SAP APO component environment, the optimizer is to be incorporated
closely so that it can freely use the SAP APO data stock (from the
liveCache and the database server). The optimization results can
then be returned to the SAP APO dataset.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Process manufacturing
supports the plant as a multi-process facility. Resource and recipe
management are the basis for planning and sequencing of batches or
production lots. The solver schedules the process order sequence to
avoid costs like cleanout or changeover. This can be achieved with
production campaigns, block planning or detailed scheduling with
focus on critical resources. Process orders are used for
scheduling, execution and costing. Process management coordinates
the data exchange between the SAP execution and connected process
control systems. These processes can be documented and evaluated.
The seamless integration with the quality management ensures
process control and stability.</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="98C12B41D2C946139AF24DB7AD446833" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F9A3CC164DE44B7DB8E0F622D808962B">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="3580DDE0A7724CB593CB5F3720CF0A0C" OriginalMap="SAP Supply Chain Management: Batch Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F22E2AF492C3457FB06695820A9930E5">
					<title>Batch Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="35FF2EF2B3D0497CA4331F4784FCF78C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7C26A383070E4084AFD44503AE80AD4D">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="3C518310C68744149CA287005B9E3251" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2D0F561E8DE84803A02CD3AD87C2C36E">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>There are
various reasons for this:</strong>
						</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>Legal requirements (for example, guidelines on Good
Manufacturing Practice GMP ) or regulations on hazardous
materials</li>
							<li>Defect tracing, recall activities, recourse requirement</li>
							<li>The requirement for differentiated quantity-based and
value-based inventory management, for example, through
heterogeneous yield/result quantities or unequal constituents in
production</li>
							<li>Usability differences and the monitoring thereof in Materials
Planning, Sales and Distribution, and Production</li>
							<li>Production or technical requirements, for example, material
quantity calculations on the basis of different batch
specifications</li>
						</ol>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">In various industry
sectors, particularly the process industry, you have to work with
homogeneous partial quantities of a material or product throughout
the entire quantity and value chain. In the SAP system, a batch is
the quantity or partial quantity of a particular material or
product that is manufactured according to the same recipe.</p>
					</short-description>
				</process>
				<process ID="9FF507742C4243AAB20CC7FE8AEF823D" OriginalMap="SAP Supply Chain Management: Manufacturing Intelligence Dashboard" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7AEB7D3C300541CF9EDCB719AF687141">
					<title>Manufacturing Intelligence Dashboard</title>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="549F2203733C424094B0A678E4377EA7" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F0A1A02740FB4902BAC4D0E9F28DB86E">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Manufacturing Intelligence Dashboards for the Production
Supervisor provide configurable entry pages that deliver alerts,
Key Performance Indicators (KPIs), manufacturing content, worklists
&amp; production confirmations and decision support to production
personnel that they need to be responsive to exceptions and
unforeseen changes in demand or supply, to deliver superior
production performance thru higher visibility.</p>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="26C8047ACF384707B8A3637702FDDF49" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="AFEDE944FFA54DF0A5E019F749A032E5">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="96D56A80CB2D45F9AFECE7E51863B337" OriginalMap="SAP Supply Chain Management: Manufacturing Visibility" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="0B35FF37D97E4215AD99D3DD41E03F6C">
					<title>Manufacturing Visibility</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="59ACB23A571349D29FA54F71BE4A0BE0" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B506B799FD4C4AF993F99C1083812EDE">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<a id="53E61CE8D50247AB8127F8120DAE458E" name="53E61CE8D50247AB8127F8120DAE458E">
								<b>
									<span id="53E61CE8D50247AB8127F8120DAE458E" smcid="53E61CE8D50247AB8127F8120DAE458E" elementname="process" selector="title">Manufacturing Tracking &amp;
Monitoring</span>
								</b>
							</a>
        : The production process is tracked from
release of the manufacturing order through finished goods receipt,
including machine breakdown disruptions.
       </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<a id="FB21783870FC44A3A2F71BB6C101426F" name="FB21783870FC44A3A2F71BB6C101426F">
								<b>
									<span id="FB21783870FC44A3A2F71BB6C101426F" smcid="FB21783870FC44A3A2F71BB6C101426F" elementname="process" selector="title">Alerts &amp; Follow-Up for
Manufacturing</span>
								</b>
							</a>
        :Closes the gap between planning and
execution by notifying the production planner in the event of a
machine breakdown.
       </p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<a id="5B825974179A4D67BFB1134D8A662A5E" name="5B825974179A4D67BFB1134D8A662A5E">
								<b>
									<span id="5B825974179A4D67BFB1134D8A662A5E" smcid="5B825974179A4D67BFB1134D8A662A5E" elementname="process" selector="title">Manufacturing Analytics</span>
								</b>
							</a>
        : Combines
production and plant maintenance-related information and provides
also planning related KPIs.
       </p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Manufacturing visibility
manages events throughout the production process from release of a
manufacturing order through transferring the data to the data
warehouse, where it is analyzed. During production, process steps
are reported, ensuring a transparent manufacturing process. In most
cases, companies only want this kind of transparency for internal
purposes, since this data is not meant for external publication;
however, it is also possible to provide information on events to
external parties such as customers, subcontractors or sold-to
parties, using various channels to provide the information quickly
and to ensure transparency of planned and actual events.</p>
					</short-description>
				</process>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Manufacturing Visibility &amp; Execution &amp;
Collaboration enables manufacturers to meet and deliver on their
production plans by managing production processes, workforce and
resource deployment on the shop floor and document, monitor and
dispatch inventory across the production life cycle.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
       Fore more detailed information please refer to 
       <referencemap Title="SAP Manufacturing" ID="CB2684A2DF7645399F10F2A047F0C32A" File="SAP%20Business%20Maps/A09E2A66E19F4BF18906223A34CD80F7.ssm" visible="true" Ref="A09E2A66E19F4BF18906223A34CD80F7" icon="solutionmap.gif" selector="title" xmlns="" OriginalMap="SAP Supply Chain Management: SAP Manufacturing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1FDA8E7ED6A44527B4F4BEE7794305EE"></referencemap>
					</p>
				</short-description>
			</level1-item>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">SAP Manufacturing supports discrete and process oriented
manufacturing processes from planning to execution and analysis. It
creates feasible, optimized production schedules taking material
and capacity constraints into account. Manufacturing operations
manages shop floor execution and feeds back into planning and
analytics. Tight integration with other Supply Chain and ERP
processes ensures a fast, flexible approach to engineering changes
and customer requirements to manufacture products on time and in
the desired quality.</p>
			</short-description>
			<level1-item ID="8F99F4AEC0004201B2465BDED8B32A4B" OriginalMap="SAP Supply Chain Management: MRP based Detailed Scheduling" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="67320320E87848A1AE1D33842D973C27">
				<title>MRP based Detailed Scheduling</title>
				<process ID="4A6BA87B76374CE6AFA212956ADE2A4A" OriginalMap="SAP Supply Chain Management: Production Planning" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F84C97644EF44C72A44D49533A6C84A1">
					<title>Production Planning</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Production planning
enables the planner to create feasible production plans across the
different production locations (also with subcontractors) to
fulfill the (customer) demand in time and to the standard expected
by the customer. For the long and medium-term time horizon,
rough-cut planning is based on time buckets and determines
requirements of resources (machines, humans, production resource
tools) and materials. Solvers, real-time data, and high supply
chain visibility (KPIs, alerts) support the planner´s
decision-making process.</p>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="28771EE67C5D4F019E0BA5661BDB5821" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C4EC52FC04D84F00B82F801389E415F4">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">MRP based DS combines MRP in ERP-PP with Detailed Scheduling in
APO-PP/DS without the necessity to transfer master data for routing
and BOM to APO. MRP based DS allows to use the advantages of PP/DS
for Detailed Scheduling, Simulation and Alert Monitoring at a
significantly reduced implementation effort. Additionally, with MRP
based DS integrating collective orders to APO becomes possible.</p>
				</short-description>
				<process ID="85ACC699F3A546DBA574475768B5E2BA" OriginalMap="SAP Supply Chain Management: Detailed Scheduling" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6AF0D62B0402457CA4ECFB99FEC09620">
					<title>Detailed Scheduling</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Detailed Scheduling
delivers optimized order sequences that can be released for
production. Scheduling heuristics and solvers take into account
constraints and costs to schedule the optimized order sequence,
based on business objectives. Dynamic alerts and order pegging
structures improve the visibility of the product flow. What-if
simulations and evaluations of orders sequences support the planer
with flexibility and control. Due to the seamless integration with
the execution and inventory management system, material shortages
or critical resource situations can be seen immediately and the
schedules can be manually or automatically adjusted accordingly.
Detailed Scheduling fulfills requirements of process as well as
discrete industries (takt-based and job-shop scheduling for
configurable and non-configurable products in an make-to-stock
and/or make-to-order environment; block planning, campaign
planning, push production for process industries).
Customer-specific planning needs can be served with individual
heuristics and optimizers to extend the standard planning tools
with user- and industry-specific components, like trim optimization
algorithms in mill industries. These individual heuristics and
optimizers are launched directly from PP/DS planning screens.
Combined with standard optimizers and heuristics, they form one
integrated planning system.</p>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="0D1A1E180F004BC6A4A8DACC3FFCB0BD" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="39E9615CE68F438EAA23709295C6CDCA">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
			</level1-item>
		</level0-item>
		<level0-item ID="4E262B7A9D4748CEA65C6DE19A05BDBC" OriginalMap="SAP Supply Chain Management: Warehousing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5685E626E4B841BDA46623C5B0994217">
			<title>Warehousing</title>
			<level1-item ID="272F42A457FA4573B019EE8BD3A795B8" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="117983E34951495D8A8FCC1C3B6EF265">
				<title>Inbound Processing &amp; Receipt Confirmation</title>
				<process ID="D799BD6E8E88498EB0D1E56EBF45613F" OriginalMap="SAP Supply Chain Management: Determination of External Demands" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8EC7C75D0F654728BB1AC26BE7A4CE2C">
					<title>Determination of External Demands</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Determine the data
describing a demand for a material that is procured externally.
This data includes the quantity that is required, the
release-to-supplier date of the demand, and the goods receipt date
for the delivery, or the location to which the material has to be
shipped.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="4D9BC515084048F5B7162B453DC05941" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D57C8045BFAA4D9FB17AE540CFE273D7">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="5EAA694725504476A927BDC188498B0F" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="04AB704AC2FA480D841FC3185C5F2D80">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="559B7CF2F6034EB6BF5E2593B820BDF1" OriginalMap="SAP Supply Chain Management: Acknowledgement of Receipt within Logistics" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B0FA479901C9446DBD767E9A6C8A205D">
					<title>Acknowledgement of Receipt within Logistics</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Confirmation of the
quantity received forms the basis of the information flow to the
planning and purchasing departments. Customers can consider the new
stock or requirement situation and see the receipt in the order
history. If the receipt is relevant for Warehouse Management, the
receipt confirmation is linked to physical inbound processing.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="0A2ADAFF18F445B184E61FFECE945DED" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="339237FF4FFA4621AE0C968594275B2D">
						<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="B1C24496B7F9449DA189D5A17FA54AC2" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8C66AED8DB4E4DBDA4B4C9A47A3A9443">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<process-ref Ref="6EBA6746CC604FBAA46BDF57BB59AFB4" ID="74A732252DD1409AAD1C3CAB5D4AE2EC" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation without Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F4E1768CA03F4ABE8410068047F92264">
						<title>Inbound Processing and Receipt Confirmation without Warehouse Management</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="545B4D185B504B9AB570C7E6659DB375" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="20BFD7E9082949B6A704F042D714670C">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="16272E70A7E74964A91A502D886FDBA3" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DF83B48D62C54D0485EF77CE666CF165">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="E8FB99F9EFFE4F13BBE044522257FA86" OriginalMap="SAP Supply Chain Management: Advanced Shipping Notification" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5A3F67AA65314AD2A223FF5BE5D09C40">
					<title>Advanced Shipping Notification</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">An ASN is a document
from the vendor which contains the exact materials, quantities, and
the delivery date with reference to a purchase order.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="9ABD002EBAC2409193F002D8ADE86A02" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6A49A8F5A3BF4F55A77E2FBDF965F9AE">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<process-ref Ref="6EBA6746CC604FBAA46BDF57BB59AFB4" ID="274747B76DF945B69485C6FF6E211526" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation without Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="99CF8EC5FF6346489EFC800BEC301692">
						<title>Inbound Processing and Receipt Confirmation without Warehouse Management</title>
					</process-ref>
					<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="20DDADE25A3644AAB24731132915B4A2" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1F1E734B53BE4ECBB0FDD17714A95E55">
						<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D97F6C822BCB432AABD3EAD10D6A7D8D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A07ED83FEA1B42DD83433489B8E07B46">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="3539D7569A3C483FA867ACF29163B509" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F6382AEE339941B780719339182D4992">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="55CD25BF24BC43F08382729A29AFF713" OriginalMap="SAP Supply Chain Management: Value-Added Services" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="000D2760F5B94F5E802E331DD5984184">
					<title>Value-Added Services</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Value add activities are
possible in inbound or outbound processes in the warehouses and
need to be appropriately managed. Support for service activities on
warehouse operations enable a company to decide on the type of
activities required, retrieve the value of a group of activities
around a warehouse process, and manage the execution of those
activities.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="D6CD99D891884FD0ACD051F8490B3D92" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E585873242A44334886E239AA505EB52">
						<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="D7569D12A3A9417BAEA7A052C14E7995" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D795218C69B442EF943564BF31D761CD">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="48B9F0034E404BF2B5D460043BFED3FC" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F9444ACD6E914BC99170373AA03D90C7">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="125F064449A5445E8E2F060FFE49F32F" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3556F6BABB6B47329B7269D8BC732C8E">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="4584741306944D5D88145355AF0AF434" OriginalMap="SAP Supply Chain Management: Yard Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6581091876254E39A1695E8B8525EFFC">
					<title>Yard Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Yard management gives
the warehouse an overview of stocks located on trailers, trucks, or
railcars in the yard. Sequencing functions decide which stock is to
be received into the warehouse at which point in time. Inbound
trailers can be scheduled to a door, or sent to a parking space in
the yard.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="373799A677CF4AC38584D3C699AFDEDB" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="EF30DAAFDAEC47B9B742B01247BDBBC6">
						<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="94305A7D965D4ED99DCB46D8AFFAA0F7" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="35C8D4D8A6BE45009E46C2970B4D31E0">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="3C5285480F544DD5805511AA1D11B5A7" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8C386CB334674C9BA42D6D9E621E864D">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="649D4843DA524747A560F4683EA85574" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7CB604836374499EABE4C17378F359E1">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="CCA0E9E8A08B4BA6B66E00DF0B793075" OriginalMap="SAP Supply Chain Management: Delivery Monitoring" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="867C114501F34968AEE3262F26B28866">
					<title>Delivery Monitoring</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The delivery monitor
provides an overview of deliveries in working processes. It gives
an overview of the workload in different areas, for example
shipping, transportation, or invoicing, while also allowing you to
collectively process documents that have the same selection
criteria. Specialists in different execution areas of the company
can use this tool to gain a quick overview of their workload, drill
down to single documents, and trigger follow-up activities.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="1AB98B99FF374AE68CF7A37EC1041510" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="663AED07C24F49E89C2A9C074BEBD6C2">
						<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="A057F58C49A34BC68B8156A09F9FB5E0" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="15B7495F5F4543B383110D2936E7ED19">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="74BA6AE8A32D466BA91C1E98C866FE7F" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A36EBDAA13D54458BCB244C3FDA22B49">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D4CBAEEAFF374BDA90FD7EAB7D7D51C0" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="23D85722236740878B95F73755488127">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="DF2950BC89164000A2A77DE0976C393B" OriginalMap="SAP Supply Chain Management: Goods Receipt" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6407C37C8A2A4304B29DCDECD208B74A">
					<title>Goods Receipt</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="A86BE410819A11D912D100306E055DA7" ID="B3321B25DE794D6F8F26587E2D2F7A63" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supply Chain Management: Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1EFEAC8130D84E7585BF9E4BE8EA827A">
						<title>Inbound Processing &amp; Receipt Confirmation with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="6B7BF189DD17425E89D9264A6D69BA49" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FFBB0FF639DB49A1803DDE04851F2251">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<process-ref Ref="6EBA6746CC604FBAA46BDF57BB59AFB4" ID="5E83299F447348D384BE7E8B020B995F" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Inbound Processing and Receipt Confirmation without Warehouse Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1F3247755CC14674BDA84B482D0B1162">
						<title>Inbound Processing and Receipt Confirmation without Warehouse Management</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A8D832386544433FAD65DCC3993C2E43" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="33680DD5EFDD4C6B8AD54762F169B2D2">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="BA67F0E321AE44BBBD14B5987741B0A3" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5C52195AF1CC410E84307B433C3D3587">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Goods receipt is a
follow-on activity to a purchase order. It forms the basis for
updating the AC modules and inventory management, and can trigger
WM and QM processes. </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">With the Warehouse
Management system, you can control the goods receipt and goods
issue processes at a physical level. Goods receipts are possible
from purchase order, inbound deliveries (advanced shipping notice),
stock transport orders, or from production. Goods receipt starts
the putaway process, which is supported by different advanced
strategies.</p>
					</short-description>
				</process>
				<process ID="75FCBC700A2D4D18B305684D6A19C348" OriginalMap="SAP Supply Chain Management: Material Valuation" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C3220C7487F1406386059406BF5DD008">
					<title>Material Valuation</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The receipt confirmation
automatically triggers the material valuation and creation of
documents for accounting. Documents for controlling are also
created if necessary.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="726198AF787042C5BB5F8235378BC16A" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D2D6FFA99C2E4D7C9B89F0BC0C5F6D26">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="FA39B6FB7E33402280931F90D8E728C1" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6752DE257D0A45428B5374DB41CDA62B">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="79377C3EA92B4FCAA863C07EADBD2C5F" ID="099D0A83D79F4FF0A0F888737BD42251" OriginalMap="SAP Supply Chain Management: Collaborate with business partners" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D222FD651FF14CE68A22EA2E82353512">
					<title>Collaborate with business partners</title>
				</business-objective-ref>
				<business-objective-ref Ref="F2C200A7E4CB49D68520B0714B6755B8" ID="B2309B75EC0E4F0D840A41D65CCE0B57" OriginalMap="SAP Supply Chain Management: Reduce order lead-time" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C941563BA1F84015829CCBA792B3EF5A">
					<title>Reduce order lead-time</title>
				</business-objective-ref>
				<business-objective-ref Ref="AC83EDB1A4ED456384A47C945EBF3AF7" ID="D92802B507CD42F681C50082AF5CF0AC" OriginalMap="SAP Supply Chain Management: Lower cost procured goods and services" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3ACB7701031445DD8EC2DC9A0234E7D0">
					<title>Lower cost procured goods and services</title>
				</business-objective-ref>
				<business-objective-ref Ref="FC3D6BE4668748588488C3D3E23A3E4C" ID="22D1DE5A5E094E6A8A80E75A864ADDDE" OriginalMap="SAP Supply Chain Management: Minimize investment in operating facilities" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DEFEF455E7284C39ABA1771A8C1E4610">
					<title>Minimize investment in operating facilities</title>
				</business-objective-ref>
				<business-objective-ref Ref="F86420AFDDB1484988CB9EDB502B3913" ID="D70A3CCE185C4D7383835F284DBEA7D1" OriginalMap="SAP Supply Chain Management: Reduce inventory levels" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="EFA9996EBFE24AA09A194D6C328A179C">
					<title>Reduce inventory levels</title>
				</business-objective-ref>
				<business-objective-ref Ref="34C4C771C8EE4DD1BBE3018A55729900" ID="8F1D651B1A5345CD8BEEA73FEC9220B4" OriginalMap="SAP Supply Chain Management: Reduce transaction costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="044F55A52CD549DD9B010E91D4524A93">
					<title>Reduce transaction costs</title>
				</business-objective-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Companies can receive and process externally procured goods into
their warehouse. Using RFID-enabled tools, they can capture
detailed and overview information. Inbound processing incorporates
all process steps for receiving.</p>
				</short-description>
			</level1-item>
			<level1-item ID="DA77945282254EE9BAD98A8D58885DC3" OriginalMap="SAP Supply Chain Management: Outbound Processing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B44AF5763EB64E2D8235E57650F0FD31">
				<title>Outbound Processing</title>
				<process ID="9710BAF8838D46A3B0110ED646CF8198" OriginalMap="SAP Supply Chain Management: Delivery Processing &amp; Distribution" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4ED36184B4E04D1DBCD8890D72EF1C83">
					<title>Delivery Processing &amp; Distribution</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Delivery processing
controls the actual fulfillment of sales orders, purchase orders
and stock transport orders. The execution of logistics tasks is
handled here. With delivery processing, the goods are shipped and
relevant documents are printed out. The sales requirements can be
distributed to alternative locations. The delivery might be shipped
to the customer directly from the fulfilling locations (more than
one delivery), or consolidation may occur at one location before
one complete shipment is transported to the end customer.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="B9D510D0819C11D912D100306E055DA7" ID="844DCE88222945B58599D9AD28699927" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="SAP Supply Chain Management: Outbound Processing with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="311FB2C0A46B4534B7ACC938B6A9177D">
						<title>Outbound Processing with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="B864983443A74E0A84A6356CF41E6BB2" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="AC350DEB304A4451B9F31391EDAF06AF">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<process-ref Ref="E83ABCD431B4417D94514C1CCBACB7C6" ID="DEF73A8B048E4C209DEBAC2A6359C76E" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing without WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="05C40AFA4266457EBF2101118C864106">
						<title>Outbound Processing without WM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="95C6DE92D47148D1A63101747892B146" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="45B5B73C7E574B45ACFAE3E7A33A2B52">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="A5ACADECFCBE40B39E1A4E2EEBAB607F" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="646CCE1C051C4845A26F5A9141B6CB82">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="64C376A9C1FF4FEFB12DD931FDEAB436" OriginalMap="SAP Supply Chain Management: Delivery Monitoring" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="AFCADCAE23BA44B3844762965461A64F">
					<title>Delivery Monitoring</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The delivery monitor
provides an overview of deliveries in working processes. It gives
an overview of the workload in different areas, for example
shipping, transportation, or invoicing while allowing you to
collectively process documents that have the same selection
criteria. Specialists in different execution areas of the company
can use this tool to gain a quick overview of their workload, drill
down to single documents, and trigger follow-up activities.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="A4E9565D65A848E99862CC07B7B2A2E9" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="327CE9C2CD9D4131AC3444ED40B03E41">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<process-ref Ref="B9D510D0819C11D912D100306E055DA7" ID="BFDE94CFEF71493EAE2FA8A6A65E97DE" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="SAP Supply Chain Management: Outbound Processing with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9F8BCD1612784258BCCD1415F804038E">
						<title>Outbound Processing with Warehouse Management in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D6BCEC476EB54B178C1364C481BD23F6" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6E4D3C951FD64EFDAC02224786EFB2EE">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="3DA93BD3716D4577A8AE0AE3C4A668C2" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6AD9AFF39437436FAB1B418C73B117BB">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="430C71D5A74E40A7AE3F145CFAA44272" OriginalMap="SAP Supply Chain Management: Value-Added Services" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D3D4904A597244ACB2F8DE4E8C0DC00C">
					<title>Value-Added Services</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Value add activities are
possible in inbound or outbound processes in the warehouses and
need to be appropriately managed. Support for service activities on
warehouse operations enable a company to decide on the type of
activities required, retrieve the value of a group of activities
around a warehouse process, and manage the execution of those
activities.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="1E58753996AD41DF819ABB41A1795644" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3B1BC37507E3439D9608C4F9B6A8389F">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<process-ref Ref="B9D510D0819C11D912D100306E055DA7" ID="3C4D8886ECE240E5A0BD46F4CB5CC8C9" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="SAP Supply Chain Management: Outbound Processing with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="854F4F06A8EF47258EF3F6C91A4493D6">
						<title>Outbound Processing with Warehouse Management in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="0A84743362FB4A078BAF10837F91DA81" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3E4E6A479FE74488B453A5C42C72A48A">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="0FB37E7E91344F0A83BD43A0696F8D96" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="15A1F597A00B425A8308D16B9030FC90">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="2E7DEE7136544751ACF305F71573E4BB" OriginalMap="SAP Supply Chain Management: Yard Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8DE9EB3A463342999E6CD186210AFF9D">
					<title>Yard Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Yard management gives
the warehouse an overview of stocks located on trailers, trucks, or
railcars in the yard. Sequencing functions decide which stock is to
be received into the warehouse at which point in time.
Inbound trailers can be scheduled to a door, or sent to a parking
space in the yard.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="66DEAF801D144FDF8F472C3BCB69C060" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="EFEDCF02C9344C29ADB16717234FC41F">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<process-ref Ref="B9D510D0819C11D912D100306E055DA7" ID="A8645F1DEACC4C758499C652CD0B5B19" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="SAP Supply Chain Management: Outbound Processing with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="066426F772264F84B1D183D928196646">
						<title>Outbound Processing with Warehouse Management in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="3C3D5111F7D440A29CBE90819A8C97A2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="42A4C1673F0E4CE8BCACB13B35CD7049">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="E01A4E509AD7421B8799937C9B2E3271" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FF291652F094431690A811851D22D042">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="A814EF75DF874932979744075E99886C" OriginalMap="SAP Supply Chain Management: Goods Issue" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4DBE4B9B9D9E4E4C8E5A30E088F80556">
					<title>Goods Issue</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="B9D510D0819C11D912D100306E055DA7" ID="F94656C85C28455986A45A725DB631B2" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" OriginalMap="SAP Supply Chain Management: Outbound Processing with Warehouse Management in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A3FB588FB4864145B7789FF7E75A073A">
						<title>Outbound Processing with Warehouse Management in SCM</title>
					</process-ref>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="1436D44EEBBE4916B534CDA1E0387E69" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2C05EFE971CE4E4C928CC219C9098ADF">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<process-ref Ref="E83ABCD431B4417D94514C1CCBACB7C6" ID="81DAA529200F480A95FBD6AD67490491" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing without WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B4B7F97B60D24E36BC64982D538555A7">
						<title>Outbound Processing without WM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="CDB2622A15E94F8295608B5C13193CD4" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="0182A24B218843388FD6FACA7BDAFB11">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="15EB04394E0A48A682AD4F57B1C21037" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9B95AF14ECD24BB4910AB0E4905790D2">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">When you post goods
issue for an outbound delivery, the following functions are carried
out on the basis of the goods issue document:</p>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>Warehouse stock of the material is reduced by the delivery
quantity.</li>
							<li>Value changes are posted to the balance sheet account in
inventory accounting.</li>
							<li>Requirements are reduced by the delivery quantity.</li>
							<li>The serial number status is updated.</li>
							<li>Goods issue posting is automatically recorded in the document
flow.</li>
							<li>Stock determination is executed for the vendor's consignment
stock.A worklist for the proof of delivery is generated.</li>
						</ol>
						<p xmlns="http://www.w3.org/TR/REC-html40">After goods issue is posted for an outbound delivery, the scope
for changing the delivery document becomes very limited. This
prevents any discrepancies between the goods issue document and the
outbound delivery.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The outbound delivery
forms the basis for goods issue posting. The data required for
goods issue posting is copied from the outbound delivery into the
goods issue document, which cannot be changed manually. Any changes
must be made in the outbound delivery itself. In this way, you can
be sure that the goods issue document is an accurate reflection of
the outbound delivery.</p>
					</short-description>
				</process>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Prepares and ships goods to their destination.</P>
				</short-description>
				<business-objective-ref Ref="9DE313AAAD0F49C493CA7788334B973C" ID="897F571DC88244D5B9C67D8FAE93260E" OriginalMap="SAP Supply Chain Management: Better service levels" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="48CDE518BFAB42208BED62DAA9D7E14D">
					<title>Better service levels</title>
				</business-objective-ref>
				<business-objective-ref Ref="4BCBAF009C724066BBC923318E9DC65B" ID="F94770EEB85344D5AEFB6D6413543411" OriginalMap="SAP Supply Chain Management: Reduce late orders" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F4E62A7052154915B17476C538E71B81">
					<title>Reduce late orders</title>
				</business-objective-ref>
				<business-objective-ref Ref="86FF92A88F17487887DCDC0AA2D6143C" ID="360086F850F842E7A4DCEE0036B59EE9" OriginalMap="SAP Supply Chain Management: Fewer returns, more efficient process" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E339455D195947BFBF53175F1BEB8857">
					<title>Fewer returns, more efficient process</title>
				</business-objective-ref>
				<business-objective-ref Ref="AC83EDB1A4ED456384A47C945EBF3AF7" ID="CDD4705DAFCD4479AAC63499256B2971" OriginalMap="SAP Supply Chain Management: Lower cost procured goods and services" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D8B22F57B7184BC58769F2F9FFE6284C">
					<title>Lower cost procured goods and services</title>
				</business-objective-ref>
				<business-objective-ref Ref="D0C91B33F60C44008B15D830F68B294A" ID="E114DF35443C4B1EA11ED70F65E1DF8A" OriginalMap="SAP Supply Chain Management: Reduce order processing costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="59D629F1431444ECA150598D3ED9B3B1">
					<title>Reduce order processing costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="851EEB1F23704D0CB4A4ABD0B2665054" ID="2DAC458AB36D4880859322F100A5C0FD" OriginalMap="SAP Supply Chain Management: Improve order fill rate" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="717E415B110449F1957BE8676DDA3AA8">
					<title>Improve order fill rate</title>
				</business-objective-ref>
				<process ID="7B52ADC380404C17BCEE03BF7D124758" OriginalMap="SAP Supply Chain Management: Proof of Delivery" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C382227ACCA64B2EBB709FA182D0279A">
					<title>Proof of Delivery</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="50C0BD144CD5438085D408956EAA4FCE" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="ABA1C2DDD3664741842E0B7FBDC54ED7">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="80986A90694240E5B464AF032A62527C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5B998F1D34FC40D2B2B1958C40DDE546">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="50DE372B7FD94D3B9FCAEED9C3F74270" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5F1FBF5C3B254E41B68EE11CC3775019">
						<title>SAP ERP</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">You are now in a
position to issue an accurate invoice based on the customer's
confirmation of goods received. You no longer need to create credit
memos. The reasons for deviation that occur most frequently in
"real world" scenarios such as stock shrinkage, theft, certain
characteristics of goods (volatility, for example), and
transportation damage are recorded and analyzed in the system. This
analysis is especially valuable when you are negotiating with
forwarding agents, vendors, or customers, since all deviations can
be reflected.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Proof of delivery (POD)
is an instrument involved in business processes in which an invoice
is issued only after the customer has confirmed the delivery's
arrival. In addition to the proof of delivery itself, you can also
record the POD date, POD time, the actual quantity that arrived and
the reason for possible differences in quantities. This is
especially important for deliveries where the delivery quantity
varies because of the nature of the goods or for which the exact
delivery quantity is unknown from the start.</p>
					</short-description>
				</process>
				<process ID="1C1A6D377A424AB79C1B0D2A64560AD1" OriginalMap="SAP Supply Chain Management: Fulfillment Visibility" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="532F982DB9EE49B3A23129A6059F5C7D">
					<title>Fulfillment Visibility</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="F716CEAEB95D4DAF90F1D2F442BBDE8F" ID="71F5B81DD99A454DB4263EDE87B46C84" variantOf="2D66D703E2B34DC99CDEEC93A54408AF" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Outbound Processing with WM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="78BAF2450DE34C5FAF45CAC822377BFF">
						<title>Outbound Processing with WM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D550BCA8843B49A5ADD76B5A6FF36881" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4A2CEFFDBFC64325900E6BC62ABF3495">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Fulfillment
Tracking &amp; Monitoring</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">This describes the
visibility along the fulfillment process from warehouse events
through proof of delivery from the customer beginning with the
creation of the sales order. Once the shipment is created, the
customer can monitor the process status via the Internet. After
picking, packing, and loading activities are complete, outbound
delivery begins.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Alerts &amp;
Follow-Up for Fulfillment</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Follow up activities are
triggered in the form of emails to the customer in case there is a
delay. Data is fed back to the application system.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>Fulfillment
Analytics</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Provides input for
analyzing the execution and reporting compliance of the carriers as
well as the transportation duration.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Fulfillment Visibility
monitors the delivery process and provides active tracking of the
delivery for the customer. Events are reported from within the
company as well as by business partners. During internal activities
and outbound delivery to the customer, all parties concerned,
including logistics providers and forwarding agents, ensure the
flow of information by sending messages to inform SAP EM of both
timely delivery and any unplanned events. With monitoring and
visibility tools, the whole fulfillment process is made transparent
at every stage for both customers and partners, which means they
can monitor when events were planned to take place and when they
actually take place.</p>
					</short-description>
				</process>
			</level1-item>
			<level1-item ID="DEBCB719E17D435D97FB79D4CD801D02" OriginalMap="SAP Supply Chain Management: Cross Docking" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FF263B62E0404684B31C0BA1F6914D8E">
				<title>Cross Docking</title>
				<process ID="1C2C04B3AD3D4E48B54717F98CE69A8D" OriginalMap="SAP Supply Chain Management: Planned Cross Docking" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4A876881DD064585861D345C121F3AF8">
					<title>Planned Cross Docking</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Planned Cross Docking
can be accomplished automatically in the background or manually
using the Cross Docking monitor. The user can match inbound
deliveries to outbound deliveries by creating a cross dock
decision. Execution can be carried out in one step or two steps,
depending on the warehouse requirements. One-step Cross Docking is
the transfer of goods with one transfer order from the inbound to
outbound area directly. Two-step Cross Docking: is the transfer of
goods from inbound to an interim storage type (for example, staging
area, repacking zone) and create a subsequent transfer order from
the interim storage type with destination outbound deliveries.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="9470651AD7884749830E599ACF454D9E" ID="3E7EED56E1C5415E8D3407ADB8C97938" variantOf="F3043AFFDC5D494FA924395CB022B817" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Cross Docking" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7636EDF4CE3E4A2C90A14449F6528E8A">
						<title>Cross Docking</title>
					</process-ref>
					<process-ref Ref="669993D081A811D912D100306E055DA7" ID="160E8F19AC6D474F8BCA8AFE02FB3BFB" variantOf="F3043AFFDC5D494FA924395CB022B817" OriginalMap="SAP Supply Chain Management: Cross Docking in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="659D2AD637B54E13A180BA2EBFACB20C">
						<title>Cross Docking in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="C1FADE4E1C9D4BAC89E9DEED09AF4461" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5E2A777E22F6404F83D066AD1FA99E35">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D5A7D20302D541E3B146B2672FFF0DCC" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="044340FCB4E34EADA3FD83F9087CED35">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="DAFFE6122EBF491085EC102F5DE9E4D8" OriginalMap="SAP Supply Chain Management: Opportunistic (unplanned) Cross Docking" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C918797170D14DDFACF8D87885A377EC">
					<title>Opportunistic (unplanned) Cross Docking</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Opportunistic cross
docking gives the warehouse the possibility to detect cross dock
opportunities in a dynamic environment, thereby reducing material
handling and material movement within the warehouse.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="9470651AD7884749830E599ACF454D9E" ID="86138497EF3544C2B36C945CF0997C2A" variantOf="F3043AFFDC5D494FA924395CB022B817" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Cross Docking" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="58DEC0E5047F43FCBEE60B01EAF6D476">
						<title>Cross Docking</title>
					</process-ref>
					<process-ref Ref="669993D081A811D912D100306E055DA7" ID="D4EC5D84D6C2485E88F12E2044F0B1BE" variantOf="F3043AFFDC5D494FA924395CB022B817" OriginalMap="SAP Supply Chain Management: Cross Docking in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="41079B668F324A8B9C5D76F6DFF1C682">
						<title>Cross Docking in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="B53AA38FB1FF46B6A46180DE7660AC4F" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9AEA849955564B7BBB307DE99147CCC5">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="9AFFA02A38ED471C95982E015FB1EEA6" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E0D21918D0D84C5AAE4D98A633927718">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="79377C3EA92B4FCAA863C07EADBD2C5F" ID="E35197F2C9D142A888C2FDC33EF9C89D" OriginalMap="SAP Supply Chain Management: Collaborate with business partners" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="91FC465D93C44EE5B51F6FE81FFCC417">
					<title>Collaborate with business partners</title>
				</business-objective-ref>
				<business-objective-ref Ref="17130406E476406F9D2E5F2DE929F0D3" ID="A3E7A40ABEE54805B2CBAA557359950C" OriginalMap="SAP Supply Chain Management: Reduce inventory carrying costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F3FCFF586DD44FC89AAB58BE900C7389">
					<title>Reduce inventory carrying costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="98F94D73800644438EF5AE6C85B9974B" ID="F6D159E943754EC393AF76E5DD21511D" OriginalMap="SAP Supply Chain Management: Lower work-in-process inventory" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5802D9C167994021B3B2DA0AB04B6B73">
					<title>Lower work-in-process inventory</title>
				</business-objective-ref>
				<business-objective-ref Ref="F86420AFDDB1484988CB9EDB502B3913" ID="F6202EB5C65E446FAA2DA263D8CC3234" OriginalMap="SAP Supply Chain Management: Reduce inventory levels" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7BE5894CDBB2492996D8E2DEE0B7D7DC">
					<title>Reduce inventory levels</title>
				</business-objective-ref>
				<business-objective-ref Ref="851EEB1F23704D0CB4A4ABD0B2665054" ID="BAA0ECABBF9E4226A52AC0FFC5EE8876" OriginalMap="SAP Supply Chain Management: Improve order fill rate" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7E3E9C893C4F47F1A699D144BB955032">
					<title>Improve order fill rate</title>
				</business-objective-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Warehouse personnel can
direct inbound goods from receiving to issue without interim
storage. By using cross-docking, companies can minimize duplicate
goods movements within the warehouse, optimize the flow of goods
from inbound to outbound, and shorten routes within the
warehouse. </p>
				</short-description>
			</level1-item>
			<level1-item ID="C6B903365F34429DA1AB47560F0094E2" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="AC9DEFC638414B40901A184CFCC66D8B">
				<title>Warehousing &amp; Storage</title>
				<process ID="399B13C02D454B7183B1CB9302AB88AF" OriginalMap="SAP Supply Chain Management: Strategies" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2BBE05B2A4BB4CD7B36D2655A551119B">
					<title>Strategies</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP Warehouse Management
allows you to manage your material flow, using advanced putaway and
picking strategies. In the standard system, these strategies for
putaway include random putaway (next empty bin), bulk storage,
fixed bin or addition to stock. The picking strategies include
standard strategies first-in first-out (FIFO), last-in first-out
(LIFO), picking by shelf life expiration date (SLED) or partial
quantities first. For customer specific strategies, solutions can
be self-defined in user exits</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="1FE36E258B7A4FD6BA4F24F4C7E7F339" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8E98E722C5CD435492E47CF4B7A3BDE5">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="48C8516FB3164C2C9A3370553C450B10" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1E6517AD5637442BB41DF16AFB0F780E">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="F654AD5D5E494ED3BED4F05BBC79652B" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E38E9213D1534F0B98C4B35FCD904E8E">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="77DFEBC88A6842219B10875869647A3E" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F58FCBD4F8604A46B8E17E1981A2D8D0">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="43DB87D0FF184EB08D5BAFC6CD92B20B" OriginalMap="SAP Supply Chain Management: Slotting/Warehouse Optimization" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BF9543749815447B81E025EE2545060B">
					<title>Slotting/Warehouse Optimization</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Slotting enables the
Warehouse to store the incoming goods based on (cube) volume,
weight, and future sales demand. Rearrangement of existing stock
based on demand data is also supported. This functionality has a
close interaction with SAP APO Demand Planning. Following the
slotting run, Warehouse Optimization helps you to rearrange
materials to more optimal locations.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="066D96D2126C4F30A0530326622CFC52" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7258BB894C854E15982F154C2ED44C34">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="A7CB3E8A4FE84BC9A1B57915BD9F4498" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="43EE25474F754252B40AE72967F7DE69">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="7D675AAA2DBD43ECA48C4285F0F091FF" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7C93A8E6F8734F7FA085F7E24AB0A10A">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="BFDE3844DED64820B56D670C3DE36EA8" OriginalMap="SAP Supply Chain Management: Native Radio Frequency Processing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="444E33A0336C401BAF75A53AC62B5C79">
					<title>Native Radio Frequency Processing</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP provides direct
radio frequency allowing the use of mobile RF terminals and
handholds with scanning devices. This enables immediate and
error-free data transfer - setting a high standard of quality for
warehouse transactions. The character-based or graphical terminals
and handholds receive data directly from the SAP system without
using a middleware product and transfer results immediately to
wherever they are needed. Configurable barcode setup allows you to
use barcode standards (for example, EAN128 or SSCC) as well as any
defined barcode systems you define yourself.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="BBE670496E2C44C1AE623CB7FD30E4AB" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DC0211C061EE4E09A7E685CAC63A47C0">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="3BCB9030F33545AF8C6A19525EFA7B90" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F50CFA9CC92B461D931B669892BC740C">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="6E6B39ACF2C847B58D39AE3CF44B5E29" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CA0E1FECB17F46FDB156CB182F1B6C15">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="930408F053904F7392DF6F662758EEFE" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1010319ABAFF4A66BF29C5DD696C4427">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="AC0D1CD8EE0C48B1A99FC639681777BD" OriginalMap="SAP Supply Chain Management: Task Interleaving &amp; Resource Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="39C8AD48E4DA4A348FE546C30904A9ED">
					<title>Task Interleaving &amp; Resource Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Task and Resource
Management controls the tasks in the warehouse and optimizes the
sequence in which the tasks are executed. It ensures that, in the
warehouse, the right task is processed by the right resource at the
right time. Task and Resource Management helps to minimize the
routes in the warehouse. Task and Resource Management is easy to
handle and seamlessly integrate into the SAP Logistics Execution
System.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="14851875539B462B82F2109E277ED22C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A1BA122496B345019A332519313690FA">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="24CD84AD886C44AD8626EEABEA515CE5" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="60D8EA5D216E4A3488AEF138F479D840">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="0F0D5121040149AEA2A91ACE070C448E" OriginalMap="SAP Supply Chain Management: Multiple Handling Units" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E526703EF32446AEB6DE2DEC8FBEDDFC">
					<title>Multiple Handling Units</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">You can use Handling
Unit Management (HUM) to reflect packing-based logistics structures
in SAP R/3. In SAP Warehouse Management, you can use handling units
to process warehouse movements such as putaway, picking, or stock
transfers. Furthermore, handling units can be created in the
warehouse, labeled, and also picked for existing deliveries. HUM
allows you to uniquely identify packages, for example pallets, in
the warehouse and throughout the supply chain. This includes EAN
128 and SSCC18 labeling. The handling units can be nested and
packed with different materials or batches.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="162B04CD8C5C4B0E87C3C8CB29EE2694" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="747FA5E766E8492896312ED128B2F3B3">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="A6C8E8F8C53B49BD80BE21F049934D4F" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CEF24D1816544BECAC7019DF116E9851">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="29D80671D00D41548EACDA0FF8077D1C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CF035CA5D2364DEBB9152D92F883EF75">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="8D4071B97E464E8685B304D52178EBDD" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6E754E58CDFE4BC2A2177FA086F05116">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="F830801E7E3540E0A32085628EB1C2F5" OriginalMap="SAP Supply Chain Management: Inventory Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9573A2D6615540CFAE85966C771343B3">
					<title>Inventory Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP Inventory Management
manages the stocks of a company in quantities and values. It is
integrated with Supply Chain accounting and is responsible for
goods receipts, goods issues and managing different stock
categories (available, blocked stock, in quality assurance and so
on) and special stocks (including consignment stock, project stock
and so on). SAP Inventory Management enables a summarized
visibility of stocks in the supply chain.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="FBE070DC9D6940C6B32619F395D2B956" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9F38082A4EA047279ABA63683FE59B6F">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="F78932D3BB794B8285F6732D957355DC" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2D6BA5FED22548489C831E03A0E4B5E1">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="10D2BE019A2842E19CC26B2B7FD9E12F" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CF0FB8F2BB234FC19138CAAE21F64F7A">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="DB0711B538A04D89A678C4E702D1D928" OriginalMap="SAP Supply Chain Management: Storage and Stock Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="85F61A19A0A54E5489A02E23DF24CC0D">
					<title>Storage and Stock Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<strong>Serial Numbers:</strong>
         Serial numbers are known in
the warehouse through Handling Unit Management.
        </li>
							<li>
								<strong>Batch Management:</strong>
         Batch management is
integrated into all SAP WM processes. This includes handling of
batches and batch determination for delivery picking, production
supply, or in internal warehouse processes. Also, active ingredient
processing is integrated into the batch determination process in
WM.
        </li>
							<li>
								<strong>Hazardous Materials:</strong>
         Although many materials
that are classified as dangerous can be placed into storage along
with other goods, some require special handling and placement into
specially designed storage facilities. Some examples of these
materials include explosives, petroleum fuels and oil, poisons,
corrosive liquids or radioactive materials. SAP Warehouse
Management is designed to manage the handling and storage of
hazardous materials.
        </li>
						</ol>
					</short-description>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="083E019437B84838AEA3385BADECCF83" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4BFDCEF768154681AA1B255CAFF255A7">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="6730427D4EF649079898CE46C039858B" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="31CBF447E9844B59A0803CA2945FB5A9">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="51C67CE055BF4F12A086D2E6EB4A1C65" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7019B4828F494FB88F3DF267361466C4">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="7C98390B7A21460195BE228B1FEDB1C4" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F0DE09FE991C4B8CB7966B7782F34D97">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="3F3312A983A549259D38618399EAC759" OriginalMap="SAP Supply Chain Management: Quality Management Integration" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BC644A2DE64143018C9EB087DEB63AA1">
					<title>Quality Management Integration</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP Warehouse Management
is integrated with Quality Management (QM). This allows warehouse
administrators to manage and track inspection lots that are stored
in the warehouse.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="3975042366A146B48053FD6B722520A1" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DB8609557D9B4F8DA8C36F0CFFDF5958">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="77BD104FF64C4D129B7E6D03F37989A8" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CA354E7171F040B8A0472C0767AB04B9">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="913270F061C641C09C39442923C25CC3" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="017E71FCE1D3479AB9C56CD856B93BF4">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="0D2BD0724BD849F4B360B552BDA2D15A" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A9D4BDD1DCDF4FA496863C68B34608C9">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="3303EA8226FA4437B2D2E227BA2D2DBF" OriginalMap="SAP Supply Chain Management: Production Supply" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6FF972298D9E4243B04B278E5A143968">
					<title>Production Supply</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The material supply of
storage bins in production can be handled with SAP Warehouse
Management. Picking for work orders is supported by advanced
strategies and combined with Handling Unit Management. It is
possible to pack for a specific work order.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="D98EAF8889734AF1A6C43877A9692BB3" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5B006E01F6CD4A4FB473714FDAAFC039">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="121640787AF94792A9711DE682305A59" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="68C990182E57428B96A04C0D3B09481B">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="424D561BCF744AA1BA9C4AF3AC2995A6" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5D4D1C2DFA3846F792AD448D38ADD488">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="6F2D7A4B7F134A0F9A88EB5C4161FE75" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B59EB9AC9FF947DD86771FC5656CA51E">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="87B37B59EA7142A3B1F681B4E1D538A0" OriginalMap="SAP Supply Chain Management: Visibility of Warehouse Activities" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8ADBA86A54F1455B839D6645E69E60B6">
					<title>Visibility of Warehouse Activities</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<ol xmlns="http://www.w3.org/TR/REC-html40">
							<li>
								<strong>Warehouse Activity Monitor:</strong>
         The warehouse
activity monitor helps a manager to oversee, plan and optimize work
processes in the warehouse. It provides a tool to notify those
responsible if there are delays or errors in the overall system.
The warehouse activity monitor also helps to identify and correct
warehousing problems or critical processes soon after they
occur.
        </li>
							<li>
								<strong>Radio Frequency Monitor:</strong>
         The monitor for radio
frequency activities lets you display the current workload and
resource capacity in the entire warehouse. It is a graphical tool
that gives an overview of the current workload status in the groups
that workers are assigned to. Using the radio frequency monitor, a
warehouse manager can easily access and influence the work process
by redistributing tasks between different work groups and
prioritizing the tasks within a group.
        </li>
							<li>
								<strong>Task Monitor (available with TRM):</strong>
         The task
monitor allows you to manage and control the resources and tasks in
a site. It enables a manager to influence allocation of tasks to
different resources and to perform various operations (tasks,
resources for example). Compared to the RF monitor, the task
monitor drills down to a more detailed view of tasks (such as
picking, packing, and weighing) that can be generated from
different R/3 Enterprise documents.
        </li>
						</ol>
					</short-description>
					<process-ref Ref="6B59115081A011D912D100306E055DA7" ID="B48B01E37C3843D7A9C1F5CB540B26A9" variantOf="6265FCA0C10D4D85A120C2864C5AA299" OriginalMap="SAP Supply Chain Management: Warehousing and Storage in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DDF60FEA26BC41669887F20492E86394">
						<title>Warehousing and Storage in SCM</title>
					</process-ref>
					<process-ref Ref="45C503322CFA487CA098EFDF9A00AF55" ID="A1B890F7EDC64C4C82BCF27FF6F343F9" variantOf="6265FCA0C10D4D85A120C2864C5AA299" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Warehousing &amp; Storage" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="84606771C2734BCE9748BBE348EAD3C6">
						<title>Warehousing &amp; Storage</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="7B417382CE9B4ACAB1A9B3B2897C3A14" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="75FCD6E47E7C42DDB91A0B59F19AA4B1">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="AD03E22662C0432D9CB3731AA9233531" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E0807EFA7E624971A0B52CC799F85AA6">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="788A97759A044DDA8A3C0E11618A05E1" OriginalMap="SAP Supply Chain Management: Decentralized Warehouse" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="ABB0F1F625EB4DF68668A73708E70471">
					<title>Decentralized Warehouse</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Customers can decide to
use SAP Warehouse Management as a stand-alone system, connected
with a central ERP system. This interface is also available as a
standard interface for the connection of certified partner WM
systems. The system distributes master data and inbound/outbound
deliveries automatically. All quantity related processes, physical
movements, and picking/packing operations are handled in the
decentralized WMS. All financial based functions (such as
valuation, credit limit check, and ATP) are handled in the central
system. The system also features change control for deliveries
created centrally.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="0D350088767144B390B0C5A8FE9D8025" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5165371B4C724C418C5AE1951F8BC91D">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="06EE2B584CC64FAE90046F4BAEC43CFC" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="73FF49BC0A5348F2B615344AF4D5666C">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="9DE313AAAD0F49C493CA7788334B973C" ID="A242F49712504F3EBE4E0E482BA81610" OriginalMap="SAP Supply Chain Management: Better service levels" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F3AE62DB84D742A698FEE298E3DC7047">
					<title>Better service levels</title>
				</business-objective-ref>
				<business-objective-ref Ref="C2BE6D29949F4237BA3608E1F88B7547" ID="A7BA537E18D649D08820BA6CF098A3B3" OriginalMap="SAP Supply Chain Management: Increase inventory turns" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="572334E2D21845A49397E5AF8E19A433">
					<title>Increase inventory turns</title>
				</business-objective-ref>
				<business-objective-ref Ref="17130406E476406F9D2E5F2DE929F0D3" ID="457A3BE5AB294F8A8B101FF493CBEE20" OriginalMap="SAP Supply Chain Management: Reduce inventory carrying costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="37D8255604B6419CBF26E8F506AC5FB4">
					<title>Reduce inventory carrying costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="98F94D73800644438EF5AE6C85B9974B" ID="03A9884FF3C7492B8B055E8566BA3DC8" OriginalMap="SAP Supply Chain Management: Lower work-in-process inventory" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DB9A74197AAC487B8AD93FF2AD8CA6F9">
					<title>Lower work-in-process inventory</title>
				</business-objective-ref>
				<business-objective-ref Ref="4BC2C757B4F24EEEA9532D0E9F6AE17E" ID="F085EB18741747E0999197ADE0E8A950" OriginalMap="SAP Supply Chain Management: Optimize capital equipment and asset utilization" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CFBE10A3407B4327BC7F87FD701A464B">
					<title>Optimize capital equipment and asset utilization</title>
				</business-objective-ref>
				<business-objective-ref Ref="F86420AFDDB1484988CB9EDB502B3913" ID="AA0F6274D7F342FD8000FFE30D9994F2" OriginalMap="SAP Supply Chain Management: Reduce inventory levels" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5B3E0A8ADEDC4B2F91E9497059C87A80">
					<title>Reduce inventory levels</title>
				</business-objective-ref>
				<business-objective-ref Ref="34C4C771C8EE4DD1BBE3018A55729900" ID="5B401AC3988F466AB6FB37BED0BA2417" OriginalMap="SAP Supply Chain Management: Reduce transaction costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="788DEF8541294F9F937551E936C6562D">
					<title>Reduce transaction costs</title>
				</business-objective-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Processes
warehouse-internal movements and storage of materials.</p>
				</short-description>
			</level1-item>
			<level1-item ID="480A263977BB45EAACC77EFE3D757ADB" OriginalMap="SAP Supply Chain Management: Physical Inventory" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B5CCC84ADE2F474CB6A520B1DA1CFDE8">
				<title>Physical Inventory</title>
				<process ID="BC76C0EE96FA4325A93706423D87849F" OriginalMap="SAP Supply Chain Management: Planning Phase of Physical Inventory" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4B60A97B88A5491390C0DB91EC05391C">
					<title>Planning Phase of Physical Inventory</title>
					<sap-cover>1</sap-cover>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">The physical inventory
process can plan which material has to be counted at which storage
location on which date.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Stocks can be blocked
for goods movements before begin of counting, measuring and
weighting.</p>
					</content>
					<process-ref Ref="E86D8DD28416434EA01410403DD77832" ID="DF77667672A34417ADBED3583613C9C4" variantOf="9C6A9433062744A495D22507A5E03C38" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Physical Inventory on storage bin level" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D394E358C9CE4CFBA70BE71FF48EA574">
						<title>Physical Inventory on storage bin level</title>
					</process-ref>
					<process-ref Ref="D63DD46081AA11D912D100306E055DA7" ID="9D08DB564A72423AA95624BE8B1BF0C6" variantOf="9C6A9433062744A495D22507A5E03C38" OriginalMap="SAP Supply Chain Management: Physical Inventory on Storage Bin Level in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9493E0AEA20D43AFBD939E9620C80206">
						<title>Physical Inventory on Storage Bin Level in SCM</title>
					</process-ref>
					<process-ref Ref="46C7C11494F14C92A63D09E5BE8D5DA3" ID="27518AC1172045C7B94DE553DBFDC61B" variantOf="9C6A9433062744A495D22507A5E03C38" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Physical Inventory on storage location level" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5A9E891E08C04CC68FA53CACC4B9AD26">
						<title>Physical Inventory on storage location level</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="2F20B8470CE8477EADCE90CB730D3E32" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C91A3BF93985411FBB44B8DFD2749F40">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="B26D0E6142BB4733BAA850D20A425986" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5573496C51AC4A739AFE695769E50514">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Manage physical inventory for your company's own stocks or for special stocks in your warehouse. The following physical inventory procedures are supported:</P>
					<OL xmlns="http://www.w3.org/TR/REC-html40">
						<LI>Periodic inventory</LI>
						<LI>Continuous inventory</LI>
						<LI>Cycle counting</LI>
						<LI>Inventory sampling</LI>
					</OL>
					<P xmlns="http://www.w3.org/TR/REC-html40">Physical inventories for legal reasons, for balance sheet purposes, or for internal controlling reasons as well are supported.</P>
				</short-description>
				<process ID="CCC9850DF0D142788D912E2C9ADDD5E5" OriginalMap="SAP Supply Chain Management: Counting Phase of Physical Inventory" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="49A0EA4862C5403FB38984B1FC34CC5E">
					<title>Counting Phase of Physical Inventory</title>
					<sap-cover>1</sap-cover>
					<content>
						<P xmlns="http://www.w3.org/TR/REC-html40">RF transactions support stock counting. After the results have been entered, you can monitor the differences and trigger a recount if necessary. If you post quantity differences for your locations, an update of the material valuation and financial accounting is triggered automatically.</P>
					</content>
					<process-ref Ref="E86D8DD28416434EA01410403DD77832" ID="4ABEA94E561448BFA59DBCFC651BF5D1" variantOf="9C6A9433062744A495D22507A5E03C38" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Physical Inventory on storage bin level" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D609AE79E0BA4EB1A036352D3C129154">
						<title>Physical Inventory on storage bin level</title>
					</process-ref>
					<process-ref Ref="D63DD46081AA11D912D100306E055DA7" ID="C249C94BF6EE41B1A6952192385C8F96" variantOf="9C6A9433062744A495D22507A5E03C38" OriginalMap="SAP Supply Chain Management: Physical Inventory on Storage Bin Level in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CD3786D75BAE4D0583376B9574A3D1E0">
						<title>Physical Inventory on Storage Bin Level in SCM</title>
					</process-ref>
					<process-ref Ref="46C7C11494F14C92A63D09E5BE8D5DA3" ID="1F72105AD0064AEFB98FE70AFD78782D" variantOf="9C6A9433062744A495D22507A5E03C38" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Physical Inventory on storage location level" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1283F73E7BCB4D9D8492FE0A5251BBDB">
						<title>Physical Inventory on storage location level</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="2E211653948747B288EADD67100AD614" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3084E0FAC22F4E48BE0698358A72E659">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A60934878D474F729FC95B40697286C2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9F6880EF55D249A9941EC2397E456C70">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="6E87912E148E4F9A9C1B0D78634F7B28" OriginalMap="SAP Supply Chain Management: Monitoring of the Physical Inventory activities" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BBC9E8AAF6AD4ACE9C1E3AB85938BCBD">
					<title>Monitoring of the Physical Inventory activities</title>
					<sap-cover>1</sap-cover>
					<content>
						<P xmlns="http://www.w3.org/TR/REC-html40">Detailed functions for monitoring the completeness of the physical inventory, the status of open and completed physical inventory activities, and the results of historical physical inventory activities are available. You can monitor the activities on material or location level.</P>
					</content>
					<process-ref Ref="E86D8DD28416434EA01410403DD77832" ID="08789180943745D1B5AF847EA82FCB7F" variantOf="9C6A9433062744A495D22507A5E03C38" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Physical Inventory on storage bin level" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9930D00A185841B198E52115DA4BCD65">
						<title>Physical Inventory on storage bin level</title>
					</process-ref>
					<process-ref Ref="D63DD46081AA11D912D100306E055DA7" ID="DD589D0C73294DA9B78113E9E9E662DC" variantOf="9C6A9433062744A495D22507A5E03C38" OriginalMap="SAP Supply Chain Management: Physical Inventory on Storage Bin Level in SCM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="AFF16B71723C4AC9BB56292ED8FACB96">
						<title>Physical Inventory on Storage Bin Level in SCM</title>
					</process-ref>
					<process-ref Ref="46C7C11494F14C92A63D09E5BE8D5DA3" ID="3AF300BE5CFE4269A918542F1E1900E0" variantOf="9C6A9433062744A495D22507A5E03C38" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Physical Inventory on storage location level" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8BC9B6FEDCC14283832A593EA081C8F7">
						<title>Physical Inventory on storage location level</title>
					</process-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="1B197481A6A841898813C274A39ED2EC" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6E30D6604476449DB0564E0AF1B0DF28">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="4B0EFC59499A48428A9A63626AC1DB1F" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B81CBA021EE24DF4BD9C57EDB6D6B794">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="41D43A61446F423BBAE314252A945741" ID="6481FF59FD67470093D8C7982D155C02" OriginalMap="SAP Supply Chain Management: Reduce material and component obsolescence" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9887EFA4E93F41F595E1D8EF1B3F0E8F">
					<title>Reduce material and component obsolescence</title>
				</business-objective-ref>
				<business-objective-ref Ref="81725D9410B7466C8D3F5F6A41CEC481" ID="C6B6EA931EC34446A7456D36755AE364" OriginalMap="SAP Supply Chain Management: Improve physical inventory process" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="36242CCBBB91412ABBECE7FA9B9DEE3B">
					<title>Improve physical inventory process</title>
				</business-objective-ref>
				<business-objective-ref Ref="F170E17B0A0347F6909AA6AABE812464" ID="6B5C541F2DFF47718D104B3B073D0106" OriginalMap="SAP Supply Chain Management: Reduce fixed asset accounting cycle time" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C561539A49E34CF7A9720B4AFF4B78E2">
					<title>Reduce fixed asset accounting cycle time</title>
				</business-objective-ref>
			</level1-item>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">
      SAP Supply Chain Management includes comprehensive support of
warehousing and shipping processes. This covers the entire material
flow from receiving through storing and shipping materials.
Cross-docking, handling of packing and packages, yard management as
well as advanced warehouse management strategies for picking and
receiving accelerate the supply chain and raise efficiencies.
Direct radio-frequency and integrating barcodes enable automation
of processes and higher real-time visibility.
      <br></br>
				</p>
				<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">Please note: applied
Processes to Warehousing are enabled via SAP Supply Chain
Management or based on Add-On product SAP Extended Warehouse
Management which will be available with future release.  </p>
			</short-description>
		</level0-item>
		<level0-item ID="C20FCBEFA8184BD29C70BD121E82DF8E" OriginalMap="SAP Supply Chain Management: Order Fulfillment" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="734A7A66269349B395720159B624948E">
			<title>Order Fulfillment</title>
			<level1-item ID="D2997FEDF5C3454B81E371FD17C1F401" OriginalMap="SAP Supply Chain Management: Sales Order Processing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A9339C12CB6A47CF95884E11E4490BFF">
				<title>Sales Order Processing</title>
				<process ID="ECA92BAD073A46D19BD38377129A3AB0" OriginalMap="SAP Supply Chain Management: Rules-based Available-to-Promise (ATP)" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B7D3A1E490334671891F2D072C95BA56">
					<title>Rules-based Available-to-Promise (ATP)</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Companies use predefined
rules to automatically or manually optimize the decision-making
process for choosing between alternatives such as products,
locations, or production process models.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<process-ref Ref="EDA0F64081AB11D912D100306E055DA7" ID="42B3903D2F9D42B7B871283BA3494BD7" variantOf="F88BCD9081AC11D912D100306E055DA7" OriginalMap="SAP Supply Chain Management: Sourcing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4C601AA9137848F9BFD9CE447B09D0B6">
						<title>Sourcing</title>
					</process-ref>
					<process-ref Ref="896E103081AC11D912D100306E055DA7" ID="3070013D03D549DBAB2A73D7A0AF4E52" variantOf="F88BCD9081AC11D912D100306E055DA7" OriginalMap="SAP Supply Chain Management: Supersession" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="074F6A0402C945CA940B101050CC2374">
						<title>Supersession</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="F93F63C2A3E246C986B0B0FB70A1354C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2A954DEE45A34733AE86D60ADD7C7A77">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="6093B3A3E31944A48A232ACE3C957F0C" OriginalMap="SAP Supply Chain Management: Multilevel ATP Check" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B398706DA79E4AB3B7CFC4B7072B6AB3">
					<title>Multilevel ATP Check</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">This is useful when a
large part of the value-added activity arises at final assembly,
because the components needed to produce an end product are checked
when a sales order is created.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="AD208CB2A32149C794E84F2FCBF3D83D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E216F27922254DFC8C939AEC577D7FD0">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="81110B6A301E42CF8053E9C1470634C4" OriginalMap="SAP Supply Chain Management: Capable-to-Promise (CTP)" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="F754DB1D283143DC9410B6D00EC664C7">
					<title>Capable-to-Promise (CTP)</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The solution lets
companies call production during an ATP check when the requested
product is not completely available, in order to produce the
remaining quantity or to procure it externally.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="51C93A38A4504F4983697E6DD202A740" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C8EC975AC3AD44FBA75DB2ABE5458252">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="00852B6D7DC147C38BBC1F6F7AD29DC8" OriginalMap="SAP Supply Chain Management: Product Allocation" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3B403926020F4D8088C4B8D52D2FA3CE">
					<title>Product Allocation</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Unpredictable problems
can lead to critical situations in order processing. Product
allocations help companies address and control such problems early
by providing visibility into which quantity of a product will be
used for which purpose.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="83570FD4418F440FB5E83CEC149851D1" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5D9D02CB70C346608F6B7CD9AA750447">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="F44BB24C12A34834BAF4AA6D084C8ADE" OriginalMap="SAP Supply Chain Management: Backorder Processing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E5CBA43E51054EFE829B8413B4D6231D">
					<title>Backorder Processing</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Companies can
redistribute confirmed or partly confirmed quantities according to
priorities and hierarchies, and override or manually affect the
results of the ATP check when necessary. This is an important
feature for companies that have large key customers making up the
majority of overall demand.</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="1C892779EFFB491E90596037D937AF6A" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FFEB29C6020440FC95489F6C19E63213">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="9DE313AAAD0F49C493CA7788334B973C" ID="B21E30D44AD54E879A2A761A310B50C2" OriginalMap="SAP Supply Chain Management: Better service levels" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E794DA251D04449A962CDECE171E262A">
					<title>Better service levels</title>
				</business-objective-ref>
				<business-objective-ref Ref="4BCBAF009C724066BBC923318E9DC65B" ID="16D305FE47B240E59E4D7C593800ADBD" OriginalMap="SAP Supply Chain Management: Reduce late orders" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D56C46D0EF19475ABD52863C752491D7">
					<title>Reduce late orders</title>
				</business-objective-ref>
				<business-objective-ref Ref="D0C91B33F60C44008B15D830F68B294A" ID="0A881DB6C5F94315908475CB93E2E4EA" OriginalMap="SAP Supply Chain Management: Reduce order processing costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9C9CF27F20D2437B8521F09364CA8631">
					<title>Reduce order processing costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="B6AEDE7047D44E1BA3B0DA35092A48C1" OriginalMap="SAP Supply Chain Management: Reduce administration, improve business processes" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="5874446C57D64FB881B2220AC4A36146">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<business-objective-ref ID="2E9C32E63A944A06BE7B6E8DE05A502A" Ref="851EEB1F23704D0CB4A4ABD0B2665054" OriginalMap="SAP Supply Chain Management: Improve order fill rate" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9AE21C529A8A419288D5E26A6A781F24">
					<title>Improve order fill rate</title>
				</business-objective-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Sales Order Processing
is a mission-critical process that all customers manage in one way
or another. It includes a whole host of sub-processes and services,
including credit limit checking, foreign-trade processing and ATP
checking. While we often assume an online sales order management
system, inbound orders may take on a variety of forms, such as EDI,
Internet, or FAX. In viewing the entire process, keep in mind that
some of the sub-process and services are large subjects entirely on
their own.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
       See also:
       <a href="javascript:smnavigate('67FC443718FC47A39FC90907E0B592CA')">mySAP
Customer Relationship Management Application Map</a>
					</p>
				</short-description>
			</level1-item>
			<level1-item ID="B4DDB1ABBEF044DAAF10F4846FCB6A6D" OriginalMap="SAP Supply Chain Management: Billing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8407940F452F493A9D54F988C8A2AA17">
				<title>Billing</title>
				<process ID="B8BCFC1B49A9492C96E952ADCAB18BBC" OriginalMap="SAP Supply Chain Management: Creation and Cancellations of Invoices" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2BF3D561634C4E9EBC16CAE88A3549F6">
					<title>Creation and Cancellations of Invoices</title>
					<sap-cover>1</sap-cover>
					<content><![CDATA[
       During billing processing, you create, change and delete billing
documents such as invoices, credit memos, and debit memos. You can
create billing documents in the following ways:
       ]]><ul xmlns="http://www.w3.org/TR/REC-html40">
							<li>by having the system process a billing due list automatically
as a background task</li>
							<li>by processing manually from a worklist</li>
							<li>by creating a billing document explicitly</li>
						</ul>
						<p xmlns="http://www.w3.org/TR/REC-html40">Flexible calculation of
rebates is integrated. </p>
					</content>
					<process-ref Ref="7222026AA69A47AD88417DB742A9" ID="D2904DC5BA5B4EF982491E9129B64713" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Billing in ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D51E47A83523462B9B97F638D720EF58">
						<title>Billing in ERP</title>
					</process-ref>
					<process-ref Ref="D09E4F3E80844168E10000000A114AB6" ID="EAD4FD7D428D497986D03443414E3497" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Billing in CRM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="12E8B3E59F4042C796351D3F8563AE86">
						<title>Billing in CRM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="912A9A11F5D74DC4AD33D74921C7A229" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B61195A5F37A48E68A1B00F297FE458D">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="09087F79FEF6403C87A7846809DF5C7C" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2CED6A8EE64A4FF1A186C233C44B9AF9">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="C2F530D1ED444F4DB7748714A0BB6AE3" OriginalMap="SAP Supply Chain Management: Transfer Billing Data to Financial Accounting" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A8DF9DE6496C46F5A7EF463D0770EA07">
					<title>Transfer Billing Data to Financial Accounting</title>
					<sap-cover>1</sap-cover>
					<content>
						<P xmlns="http://www.w3.org/TR/REC-html40">Integration with Financial Accounting consists of forwarding billing data in invoices, credit and debit memos to Financial Accounting.</P>
						<P xmlns="http://www.w3.org/TR/REC-html40">The system</P>
						<P xmlns="http://www.w3.org/TR/REC-html40">a) posts offsetting entries to the appropriate accounts (with the help of "account assignment") and</P>
						<P xmlns="http://www.w3.org/TR/REC-html40">b) makes sure that FI can recognize all billing documents belonging to one business transaction (for example, a credit memo to an invoice) Integration with Controlling consists of assigning costs and revenues to the appropriate sub-ledgers.</P>
					</content>
					<process-ref Ref="7222026AA69A47AD88417DB742A9" ID="AAD42B7BB7514CF3A1ED2DDD75FC2EF6" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Billing in ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="17D14CAF97FA4AAFBC61D320DD4871B5">
						<title>Billing in ERP</title>
					</process-ref>
					<process-ref Ref="D09E4F3E80844168E10000000A114AB6" ID="2DFC4DE11BC342359A8D5E1DEBB2E55C" variantOf="27E7DB71E4894B719F259DEB40F5B455" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Billing in CRM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="36533DF2420A4CA389F852C94D70FA22">
						<title>Billing in CRM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D9183BADBC304D82A2B6475822D87E72" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="2D76E5DB42D240FEABE4F7A433A6CFD5">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="AEFCFDE8740F4ADB854A3D8EC7792EBC" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="28E52B97FCC549728570B2911DDD94E9">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="495607C0C1F0407F8ADBC16170CD219A" ID="71C1B7709840409F87D95411A04893B4" OriginalMap="SAP Supply Chain Management: Strengthen partnerships and account management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E41155FF09EE43528039B1FF8541D997">
					<title>Strengthen partnerships and account management</title>
				</business-objective-ref>
				<business-objective-ref Ref="6AB711814CF1406C867710E536A461DB" ID="71A425ED0CC8412384457762C9B99161" OriginalMap="SAP Supply Chain Management: Improve cash management, minimize borrowing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="55A9DCA5A3194AF3A4104D96F8A10F1A">
					<title>Improve cash management, minimize borrowing</title>
				</business-objective-ref>
				<business-objective-ref Ref="018BFBEAF0854CFEBDD5003A7FD38955" ID="986386BDB2C34C24B482F7D709A74921" OriginalMap="SAP Supply Chain Management: Improve accounting processes" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="EEBBF825B1F44861B7C76CB18219FFE2">
					<title>Improve accounting processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="AF2FCDE8F7F544088F6BA2ED972E1064" OriginalMap="SAP Supply Chain Management: Reduce administration, improve business processes" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3A855938F05E47269F0F2F709AA4594E">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="34C4C771C8EE4DD1BBE3018A55729900" ID="439C0C2FE96E4B03BF6FE7FE21E83FCC" OriginalMap="SAP Supply Chain Management: Reduce transaction costs" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="ECE895EE88A740159646015D1A6FC6BC">
					<title>Reduce transaction costs</title>
				</business-objective-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Billing is the final
processing stage of a business transaction in Sales and
Distribution. Information on billing is available at each stage of
order processing and delivery processing.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
       See also:
       <referencemap Title="SAP Customer Relationship Management" ID="3D468D03AF2C455483D13A392E81D1A7" File="SAP%20Business%20Maps/67FC443718FC47A39FC90907E0B592CA.ssm" visible="true" Ref="67FC443718FC47A39FC90907E0B592CA" icon="solutionmap.gif" selector="title" xmlns="" OriginalMap="SAP Supply Chain Management: SAP Customer Relationship Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6CF88F179B4848739F941C548A1EF45B"></referencemap>
					</p>
				</short-description>
			</level1-item>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">Increasingly, companies
operating worldwide are forced to globalize available information
in order to conduct business efficiently. Specifically, this means
that information has to be made available across system boundaries
as quickly as possible to provide optimized decision support.
Global ATP can be used in heterogeneous system landscapes to
provide required information as quickly as possible. The ATP check
– also known as the availability check – represents an online
search that should ensure that your company can provide the
requested product at the requested time in the quantity requested
by the customer.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">See also: mySAP Customer
Relationship Management Application Map</p>
			</short-description>
			<level1-item ID="22B3ADFCA9D349E6B7C4DADFB4F58CB8" OriginalMap="SAP Supply Chain Management: Service Parts Order Fulfillment" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4760B0518B37477692133E580C5257E1">
				<title>Service Parts Order Fulfillment</title>
				<process ID="7293E01D77D74408AE241814AA06C582" OriginalMap="SAP Supply Chain Management: Parts Marketing &amp; Campaign Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C07B781117AC4E91AF84E3FE63A6219E">
					<title>Parts Marketing &amp; Campaign Management</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="A26E2A943D044ADCB3A0AC6B60FF" ID="20FA9D7F749F492A95F9699775BB335E" variantOf="81C5873280BE433494F34AF541E377CC" OriginalMap="SAP Supply Chain Management: Marketing Planning and Budgeting" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A681CC90687E47928B08D00E825AC3B9">
						<title>Marketing Planning and Budgeting</title>
					</process-ref>
					<process-ref Ref="624E5E3EBDA64068E10000000A114AB6" ID="6FBE89BD94254BECBBB98518705EFA40" variantOf="FBDD36E9D51342AA9B4D7F369D125CBF" OriginalMap="SAP Supply Chain Management: Campaign Execution in CRM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E425F46828004B4E89D336131B51A243">
						<title>Campaign Execution in CRM</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">Parts Marketing and
Campaign Management enables companies to design, execute,
coordinate, and monitor all marketing initiatives, including
segmentations and parts specific campaigns, e.g. for committed
volumes (amount or quantities) and rebate models. </p>
					</content>
					<process-ref Ref="93515E3EBDA64068E10000000A114AB6" ID="1F48AFAB4D5141B9AC44B112ED8DB46E" variantOf="07320D1D39BC4810B7670E92F381932C" icon="technical-process-variant.gif" OriginalMap="SAP Supply Chain Management: Campaign Planning in CRM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D7F7F00865F64547B80546D7E5B4DE3E">
						<title>Campaign Planning in CRM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="1A521EFABFD645F3B61FE307D9C5746B" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BC78F10A0595429E8B3AB9C811F916D6">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="B80F698C5622416EA2F198DC25982D81" bprrefid="" OriginalMap="SAP Supply Chain Management: Parts Order Processing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3D48FC05F0E147BCAC0BB26885B2973A">
					<sap-cover>1</sap-cover>
					<title>Parts Order Processing</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Parts Order
Processing supports parts order entry using various entry channels
and performing various validation steps, like product availabilty
check, credit checks and export compliance checks.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">The product
availability check - also known as ATP check - represents an online
search that should ensure that your company can provide the
requested product at the requested time in the quantity requested
by the customer.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Global ATP can be used
in heterogeneous system landscapes to provide required information
as quickly as possible.</p>
					</short-description>
					<process-ref Ref="700F54E0760411D912D100306E055DA7" ID="3B98E258D93043D08F01D11C1A5ED4DE" variantOf="35B401CC52C140F58172E97A3F4AE18B" OriginalMap="SAP Supply Chain Management: Sales Order Processing for Service Parts (Third Party Order Processing)" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D7F0C5C6555F43B78EC00049C6F4E6BB">
						<title>Sales Order Processing for Service Parts (Third Party Order Processing)</title>
					</process-ref>
					<process-ref Ref="C9861AF075E511D912D100306E055DA7" ID="3B8A694715034C169D1C91AC11F9F4D8" variantOf="35B401CC52C140F58172E97A3F4AE18B" OriginalMap="SAP Supply Chain Management: Sales Order Processing for Service Parts" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A41AE9DDB5644AE188FE8D5BEAC44EB3">
						<title>Sales Order Processing for Service Parts</title>
					</process-ref>
					<product-ref Ref="641569040A9345DF9A765CE6464C2685" ID="A608C79C884B4BA9A6C7C460115AC77E" type="SAP" key="SAP Gloal Trade Services - Export" OriginalMap="SAP Supply Chain Management: SAP Global Trade Services - Export" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8237CB4C6A224EDE8E62F531C8C29690">
						<title>SAP Global Trade Services - Export</title>
					</product-ref>
					<product-ref Ref="726DD6C265144638A89597FFD33CF180" ID="C58D19207E9A4921B282C80E688CFD77" type="SAP" key="S202" OriginalMap="SAP Supply Chain Management: SAP Price and Margin Management by Vendavo" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="E02B15611AB0464C9961C16858026EB1">
						<title>SAP Price and Margin Management by Vendavo</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="BB9AE53040F8460CA9644602C95D813C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="658E4B3BAB5246229FC2937B01A60D46">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="253245E4D7544A23B5C25CD19C021A1E" bprrefid="" covered-by-ERP="true" OriginalMap="SAP Supply Chain Management: Complaints Processing" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="8D431CA7FF3F409DAEF6D1311891864A">
					<!--#!#1616161616161616#!#-->
					<sap-cover>1</sap-cover>
					<title>Complaints Processing</title>
					<process-ref icon="technical-variant-ref.gif" ID="424327A17A83470D839700AD809D23AA" Ref="FDCE6C3EE1929F13E10000000A114AB6" variantOf="1F348B17245F4C45B8DE003F59E40F61" OriginalMap="SAP Supply Chain Management: Complaints Processing in CRM" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1DBEA5E10E9A4C08852CD8FD225BB6E6">
						<title>Complaints Processing in CRM</title>
					</process-ref>
					<short-description>Complaints Processing tracks established procedures for passing
complaint information into the enterprise for resolution so that
dissatisfied customers become satisfied customers and companies can
plan and manage return material costs.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="0965D6B1DC9B45968B9B5BF35CC232F4" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="AE17092265C848FBA882049EB8290E60">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<hyperlink ID="EA1151DCFEC340D2B9409C9C1A6B6E05" href="http://download.sap.com/SMIGlobal/download.epd?context=2E1FFF480F55B5D80BBAAA5890D7AC3CECB1035DF838600600BDCEE250A43183B93770233ABAB8DD7E279D81A95D6BFC88FE4B6A68CD4DC9" OriginalMap="SAP Supply Chain Management: Caterpillar Logistic Services - Customer Success Story" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="3C61C3E1E8BD4A74885F18FF3A7B1B20">
					<title>Caterpillar Logistic Services - Customer Success Story</title>
				</hyperlink>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Increasingly, companies
are marketing and selling the high profitable service parts. Along
with sales and marketing, companies also need to manage the parts
orders in a holistic and efficient way. Specifically, this means
that information has to be made available across system boundaries
as quickly as possible to provide optimized decision support.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
       For more detailed information please refer to 
       <referencemap Title="SAP Service and Asset Management" ID="9CBBCD11731540D4BF5C0AB7F50AEE72" File="SAP%20Business%20Maps/7491B658A6A74FFCA994D13B4101BAA1.ssm" visible="true" Ref="7491B658A6A74FFCA994D13B4101BAA1" icon="solutionmap.gif" selector="title" xmlns="" OriginalMap="SAP Supply Chain Management: SAP Service and Asset Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="145827D644F44E5084B1112D910A4745"></referencemap>
					</p>
				</short-description>
			</level1-item>
		</level0-item>
		<level0-item ID="E3D7CDF114D04B318624D9DFBC6A35C0" OriginalMap="SAP Supply Chain Management: Transportation" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="813AB7FB2E5A4A8E81F012E9D3FBC4B2">
			<title>Transportation</title>
			<short-description>
				<p style="MARGIN: 1pt 0cm; TEXT-AUTOSPACE: ideograph-numeric; TEXT-ALIGN: justify; tab-stops: 18.0pt 36.0pt 54.0pt 72.0pt right 432.0pt" xmlns="http://www.w3.org/TR/REC-html40">
					<span style="FONT-SIZE: 8pt; FONT-FAMILY: Arial; mso-fareast-font-family: Arial; mso-fareast-language: AR-SA">Transportation costs have become a very important factor in our
economy. This is caused by increasing fuel costs and the highly
increased demand to move goods within a more and more globalized
business environment. Furthermore, the transportation market is
highly competitive, which tends to lead to very low margins in this
sector.</span>
					<br></br>
				</p>
				<ul xmlns="http://www.w3.org/TR/REC-html40">
					<li>
						<div>
							<span style="FONT-SIZE: 8pt; FONT-FAMILY: Arial; mso-ansi-language: EN-US; mso-fareast-font-family: Arial; mso-fareast-language: AR-SA; mso-bidi-language: AR-SA">
         In order to operate private fleets efficiently, either as
manufacturer or retailer or as a logistics service provider, you
need the capability to plan your transportation needs in an
efficient way. From a business perspective, the key functionalities
for dedicated
         <s>a</s>
         planning and processing tools
are:
        </span>
						</div>
					</li>
					<li>
						<div>
							<span style="mso-ansi-language: EN-US">Determination of the most
efficient transportation plan, which fulfils the given constraints
(such as service level agreements, costs, and resource
availability).</span>
						</div>
					</li>
					<li>
						<div>
							<span style="mso-ansi-language: EN-US">Identification of opportunities
for cost savings (such as consolidation possibilities and choice of
the best means of transport).</span>
						</div>
					</li>
					<li>
						<div>
							<span style="mso-ansi-language: EN-US">Maximization the utilization of
existing resources (such as using your own fleet).</span>
						</div>
					</li>
					<li>
						<div>
							<span style="mso-ansi-language: EN-US">Ability to react on execution
events and provide efficient solutions to solve possible conflicts
with the initial plan.</span>
						</div>
					</li>
				</ul>
			</short-description>
			<level1-item ID="651E8CD101D64A0D80373BBAA7BBA82E" OriginalMap="SAP Supply Chain Management: Freight Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="D932A3BC553B411398676FB4A4E7E0AD">
				<title>Freight Management</title>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">Within SAP Transportation
Management (TM) transportation requests can be received, updated
and confirmed.</span>
					</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">This business process is
carried out to capture and evaluate transportation requests. These
transportation requests are the basis for the transportation
planning and execution. In addition, the user may at this stage
pre-define a certain way through the transportation network with
dynamic route determination and calculate and save the
transportation charges (freight costs).</span>
					</p>
				</short-description>
				<process ID="6876B31ACBEA476CBAF77945D3F4032D" OriginalMap="SAP Supply Chain Management: Capture transportation requests" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="A3237083E4DA42FDA4085BD3F4BA24D4">
					<title>Capture transportation requests</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Transportation requests
can be received via open interfaces, such as Electronic Data
Interchange (EDI) or Web Services, as well as other common means of
communication, such as email, fax or phone. The requests can then
be maintained in the system.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="COLOR: windowtext; mso-ansi-language: EN-US">In
addition to the integration from above SAP TM can be closely
integrated to an existing SAP ERP, SAP EWM system or any order
management or shipping</span>
							<span style="mso-ansi-language: EN-US">system, like e.g. third party CRM
Solutions or also legacy delivery management solutions. SAP ERP a
standard mapping for ERP deliveries to shipment request in SAP TM
is available.</span>
						</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A195078370164506BC721F77C6EAFDA8" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B6A7871D76E442E5A6CFBDD43A06923B">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="61E87B3DB8974DDBACB024D25235485F" OriginalMap="SAP Supply Chain Management: Dynamic Route Determination" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7282164D67B1470CAAA84DD5FEDABC54">
					<title>Dynamic Route Determination</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="668E0E7A65604ACFA1825B621891DA81" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="4E29B92F33714AB0AAE00658EF0F0175">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="COLOR: windowtext; mso-ansi-language: EN-US">In the
transportation management system the transportation network
(geography) defines the possible transportation ways. For example
if a transport can be performed directly from the sending to the
receiving location or if this transport request must be transported
via a transhipment point (hub) is defined by the transportation
network. The solution is even allowing to dynamically insert
additional shipping requests or orders using optimization logic or
straight forward routing strategies and rules on a one-to-one basis
or for multiple orders.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="COLOR: windowtext; mso-ansi-language: EN-US">
								<span style="COLOR: windowtext; mso-ansi-language: EN-US">During the
dynamic routing determination the user can define additional
constraints for the transportation request, for example, based on
the result of the routing guide, the user may decide that the order
must be delivered via the harbour in New York.</span>
							</span>
						</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="COLOR: windowtext; mso-ansi-language: EN-US">Once the
transportation requested have been captured the user may run the
dynamic routing determination to evaluate possible paths through
the transportation network and to pre-select certain paths though
the network which will be later constraints for the
planning.</span>
						</p>
					</short-description>
				</process>
				<process ID="7E5CC80EAA1B4E68867A034F2A9FB73C" OriginalMap="SAP Supply Chain Management: Credit Limit Check" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DC633FE676704D148E52FD3BA2C47936">
					<title>Credit Limit Check</title>
					<short-description>
						<p style="MARGIN: 1pt 0cm; TEXT-AUTOSPACE: ideograph-numeric; TEXT-ALIGN: justify; tab-stops: 18.0pt 36.0pt 54.0pt 72.0pt right 432.0pt" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma; mso-fareast-language: DE">Credit checks can be performed for a transportation request within
SAP TM.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D8B6574E59CA436D9A73311B0994F513" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6E0922981F194F2C95CE955883463EAB">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="A0A9B6FCB80E474C99D5209E5F3502B5" OriginalMap="SAP Supply Chain Management: Send confirmation" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DCFC260B84084911875A543240925591">
					<title>Send confirmation</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">After evaluation of the
transportation request the user can send the customer a
confirmation of his request. This is also possible during a later
stage of the process.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="E5EE9660212C4BE7ACF92CA5849F3F9D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CB9E214C35154E49A6DBF148D6FEADA6">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="C138F5F5560A47B4857D9BE33EF19C87" OriginalMap="SAP Supply Chain Management: Distance Determination Service" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="291C1F16DE6843B1A49B356E8DBB7AFA">
					<title>Distance Determination Service</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">SAP TM provides
functionality for geocoding of locations and distance determination
between certain locations seamlessly integrating to external
vendors of geographical information services.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Retrieves distances from
third-party providers. The distance determination service is an
add-on for transportation.</span>
						</p>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="0F631C7264544036BD4699B48E202E10" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C41A01B12DB54BB0B8829DDA407049B1">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
			</level1-item>
			<level1-item ID="EFD4092183C74153B43B5A4F4A121219" OriginalMap="SAP Supply Chain Management: Planning &amp; Dispatching" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="69E529D7A5064F2698E57F908A4E9F4B">
				<title>Planning &amp; Dispatching</title>
				<process ID="BD1EB2E4375B4C668FCA278CE6DC724B" OriginalMap="SAP Supply Chain Management: Load Consolidation" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="23CD081FA9484CB2887FFCFF8378A454">
					<title>Load Consolidation</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">SAP TM provides different
possibilities to consolidate deliveries and orders to shipments. It
is possible to combine orders based on rules and strategies, based
on optimization logic in SAP TM. This can also be done
interactively and manually in SAP TM, and through collaboration
over the Internet. If you decide to rely on your carrier's
abilities to consolidate your orders to shipments, you can give it
access to your deliveries over the Internet, where it can
consolidate your shipments. During Load Consolidation, SAP SCM
will consider multi-dimensional capacity constraints of the
resources.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A65873B61B1540FE8FEC9BEAE7F5AD77" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="35C68AF691C147D092C66C274DCB32AA">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="135390660B6F4E17B8DCF0564876D26E" OriginalMap="SAP Supply Chain Management: Mode and Route Optimization" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DB48565CD933445ABB25BD939723FF44">
					<title>Mode and Route Optimization</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Mode and route
optimization is at the heart of transportation planning. The goal
is to create a least cost transportation plan while guaranteeing
customer service. The system assigns inbound and outbound orders to
modes (truck, ship) and creates the needed shipments. The
optimization algorithm used to do these assignments is controlled
by cost profiles, delivery dates, and constraints of the ship-to
and ship-from sites.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="81698C63C6E74CFAAA1E1E7D51F9D8AA" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="71C6D2303F0E4A1EBFA5816ABD280053">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="1B492D89BD8142CEBEDA6FFD998DC1B6" OriginalMap="SAP Supply Chain Management: TSP Selection" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CE404C35B2604698AB0317B33B67E90B">
					<title>TSP Selection</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="BE40C03C8A134E9DA6009E0B9514E28F" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="7E00BBAD8D7B419B917665592364627E">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">SAP TM offers several options to do so:</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">1) Priority: Certain carriers have
different priorities on certain lanes.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">2) Transportation Charge: The
least-cost carrier for this shipment will be selected.</span>
							<br></br>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">During the assignment of TSPs the
following restrictions can get considered:</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">1) Business share: SAP TM assigns
shipments in order to ensure that specified carriers receive a
defined volume of business.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">2.) Allocation: Minimum and / or
Maximum number of number for a TSP in a giving timeframe</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">TSP Selection can be
simultaneously with the route and mode optimization (also called
then one-step optimization).</span>
						</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">After having created optimized
routes (shipments), carriers need to be assigned to these routes.
This may be done manually in the execution system SAP
TM.</span>
						</p>
					</short-description>
				</process>
				<process ID="1E0427C93F5F401DB1F17223DA47D95C" OriginalMap="SAP Supply Chain Management: Transportation Visibility" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CC5C3660E78F46A9BB1300AB354D5A40">
					<title>Transportation Visibility</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="E2685A9B2FEB4EC29DFA4DDAE6559770" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="47F8896642374C71A04DB848265915F0">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>
								<span style="FONT-FAMILY: Tahoma; mso-ansi-language: EN-US">Transportation
Tracking &amp; Monitoring</span>
							</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Transportation visibility monitors
and controls the transportation process from the creation of the
delivery to the delivery receipt at the customer site, including
arrival, loading respectively unloading and unloading events as
well as customs related entries.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>
								<span style="FONT-FAMILY: Tahoma; mso-ansi-language: EN-US">Alerts &amp;
Follow-up for Transportation</span>
							</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Provides alerts to the business
partners involved along the transportation process.</span>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>
								<span style="FONT-FAMILY: Tahoma; mso-ansi-language: EN-US">Transportation
Analytics</span>
							</strong>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Provides input for analyzing the
adherence to the planned duration of the entire shipment, including
the duration of customs processing and arrival of customs
documentation</span>
						</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Transportation visibility covers
transportation and customs issues for inbound and outbound
processes. Road transportation as well as International Sea
Shipment are considered. These processes are independent from one
another, but they can also be combined. While the road shipment is
based upon a single collective shipment, the sea shipment is
represented by a transportation chain that consists of at least
three legs.</span>
						</p>
					</short-description>
				</process>
				<process ID="F6F2355058DE47A288980B76F39C5A31" OriginalMap="SAP Supply Chain Management: Shipping" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BD9D14A5A496469086988E0BA795064A">
					<title>Shipping</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="721A4999C7E44C7A93C5281FB1568C22" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="CEEF39623A6A44CF96AC8B6FF8B62A32">
						<title>SAP Industry Package</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">
         SAP TM
         <span style="mso-spacerun: yes"> </span>
         provides different options for
consolidating deliveries and orders as shipments. It is possible to
combine orders based on rules and strategies, based on optimization
logic or interactively and manually in SAP TM. It is also possible
to combine orders using collaboration over the Internet. If you
decide to rely on your carrier's abilities to consolidate your
orders into shipments, you can give it access to your deliveries
through the Internet, where it can consolidate your
shipments.
        </span>
						</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Different types of shipment
documents have been defined to enable you to reflect in the system
the various forms of transportation used.</span>
							<span lang="DE">You
can use shipment documents to:</span>
						</p>
						<p style="MARGIN: 4pt 0cm 0pt 36pt; TEXT-INDENT: -18pt; tab-stops: list 36.0pt; mso-list: l0 level1 lfo1; mso-margin-bottom-alt: auto" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma; mso-fareast-font-family: Tahoma">
								<span style="mso-list: Ignore">
          1.
          <span style="FONT: 7pt 'Times New Roman'">      </span>
								</span>
							</span>
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma">Record
actual transportation deadlines and statuses.</span>
							<br></br>
						</p>
						<p style="MARGIN: 4pt 0cm 0pt 36pt; TEXT-INDENT: -18pt; tab-stops: list 36.0pt; mso-list: l0 level1 lfo1; mso-margin-bottom-alt: auto" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma; mso-fareast-font-family: Tahoma">
								<span style="mso-list: Ignore">
          2.
          <span style="FONT: 7pt 'Times New Roman'">      </span>
								</span>
							</span>
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma">Specify
output required for transportation (such as shipping papers, XML
and EDI messages).</span>
							<br></br>
						</p>
						<p style="MARGIN: 4pt 0cm 0pt 36pt; TEXT-INDENT: -18pt; tab-stops: list 36.0pt; mso-list: l0 level1 lfo1; mso-margin-bottom-alt: auto" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma; mso-fareast-font-family: Tahoma">
								<span style="mso-list: Ignore">
          3.
          <span style="FONT: 7pt 'Times New Roman'">      </span>
								</span>
							</span>
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma">Define
transport-relevant texts.</span>
							<br></br>
						</p>
						<p style="MARGIN: 4pt 0cm 0pt 36pt; TEXT-INDENT: -18pt; tab-stops: list 36.0pt; mso-list: l0 level1 lfo1; mso-margin-bottom-alt: auto" xmlns="http://www.w3.org/TR/REC-html40">
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma; mso-fareast-font-family: Tahoma">
								<span style="mso-list: Ignore">
          4.
          <span style="FONT: 7pt 'Times New Roman'">      </span>
								</span>
							</span>
							<span style="FONT-SIZE: 8pt; COLOR: #333333; FONT-FAMILY: Tahoma">Separate
document types deal with inbound and outbound shipments.</span>
						</p>
					</content>
				</process>
				<short-description>
					<p style="MARGIN: 1pt 0cm; TEXT-AUTOSPACE: ideograph-numeric; TEXT-ALIGN: justify; tab-stops: 18.0pt 36.0pt 54.0pt 72.0pt right 432.0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span style="FONT-SIZE: 8pt; FONT-FAMILY: Arial; mso-fareast-language: AR-SA; mso-fareast-font-family: Arial">Based on the transportation requests maintained in SAP
Transportation Management (TM) optimal shipments are created. SAP
TM offers multiple tools to create and manage the planning
processes like best in class optimization, dynamic routing and
scheduling and continuous move optimization. For creating the
shipments, the system uses the transportation charges and freight
agreements, considering resource, equipment and carrier
availability at the same time. This process is known as Planning
and Executing Transportation Requests in TM.</span>
						<br></br>
					</p>
					<p style="MARGIN: 1pt 0cm; TEXT-AUTOSPACE: ideograph-numeric; TEXT-ALIGN: justify; tab-stops: 18.0pt 36.0pt 54.0pt 72.0pt right 432.0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span style="FONT-SIZE: 8pt; FONT-FAMILY: Arial; mso-fareast-language: AR-SA; mso-fareast-font-family: Arial">This business process is carried out to create and execute the
business objects that are required for driving the transportation
execution process, thus enabling margin maximization.</span>
					</p>
				</short-description>
			</level1-item>
			<level1-item ID="007C9A6E119B4C16AA0218ED04A7B293" OriginalMap="SAP Supply Chain Management: Rating &amp; Billing &amp; Settlement" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="238C16E9EF3D45868AD5398545B0A087">
				<title>Rating &amp; Billing &amp; Settlement</title>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">Based on the outgoing
transportation orders, the transportation charges are calculated in
SAP Transportation Management (TM) for the involved business
partners on the supplying and buying side. These processes are
known as Managing Supplier Transportation Charges in SAP TM and
Managing Customer Transportation Charges in SAP TM.</span>
						<br></br>
						<span style="mso-ansi-language: EN-US">The involved business
partners are supplying parties, such as the transportation service
providers and / or carriers and the buying side the involved
business partners include the ordering party, the consignee, and
the shipper.</span>
						<br></br>
						<span style="mso-ansi-language: EN-US">This business process is
carried out to evaluate, calculate and distribute the
transportation charges for the ordering party and the supplying
party. Enable the financial transactions for customer billing and
for supplier invoicing.</span>
					</p>
				</short-description>
				<process ID="63E0E3EA9CE148339FF83A21840F6520" OriginalMap="SAP Supply Chain Management: Supplier Transportation Charges" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="71E177AB3111431980AB918E8D1B24D8">
					<title>Supplier Transportation Charges</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">
         The transportation
charges are calculated in SAP Transportation Management (TM) for
the involved business partners on the supplying side. This
calculation is based on the outgoing transportation orders. The
involved business partners are supplying parties, such as the
transportation service providers and / or carriers.
         <span style="mso-spacerun: yes"> </span>
         This process is known as
Managing Supplier Transportation Charges in SAP TM
        </span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="544D630BACD34238BFBE546E78759863" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="099E966469B74F508EE429FCAD48BB75">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="A156FEA9EF234A48BD62AF5497A425A3" OriginalMap="SAP Supply Chain Management: Customer Transportation Charges" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="EF86D4BFA1DF4D44B902E1D387739FBE">
					<title>Customer Transportation Charges</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">The transportation
charges are calculated in SAP Transportation Management (TM) for
the involved business partners on the ordering side. This
calculation is based on the incoming transportation requests. The
involved business partners include the ordering party, the
consignee, and the shipper. This process is known as Managing
Customer Transportation Charges in SAP TM.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="B79A9B4D241F47B48E6BEA0E02C13FAF" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B84F32EA659E4DD2AB2AC6248B649FDE">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="B0412E3BB63E41D88A2169E80B6BDF97" OriginalMap="SAP Supply Chain Management: Transportation Charge Rates" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="1013A85ED13E428384750E250F351F5A">
					<title>Transportation Charge Rates</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Transportation Charge
rates are the basis for the transportation charge
calculation.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="579EBAA94A3A4981B2DE3F112A63D18D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="383DE1C229954FE7BF06706340E9A346">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="E8D700598750414A9DACB183A21C1679" OriginalMap="SAP Supply Chain Management: Integrate Invoice request to FI / CO system" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="DA02CEF0D4184A92B19A4C063963640A">
					<title>Integrate Invoice request to FI / CO system</title>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">After the creation of the
supplier / customer invoice request has been completed, the
settlement process with the relevant service agents is initiated.
This is performed in SAP TM.</span>
							<br></br>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Within the settlement
process, SAP is able to carry out settlement for multiple carriers
who may have taken part in a shipment. Both costs and accruals are
posted. The users then decide if they would like to settle the
costs with the carrier through classical invoice verification or
through an automated self-billing function. With self-billing, the
evaluated receipt settlement feature is used in purchasing to pay
the service agents automatically, based on the calculated shipment
costs. If required, aspects of the shipment costs can be billed to
the customer directly. This is performed in SAP ERP.</span>
						</p>
					</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="E8636E793F6B4154B01AFFEE00F63708" type="SAP" key="S12" OriginalMap="SAP Supply Chain Management: SAP ERP" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="FC12F3F15CD4478082B23C4BC2AE0FCD">
						<title>SAP ERP</title>
					</product-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="29C7C6AE069646FD8F9B76622EC28B40" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BBB01E56CAE54FA6B395851785A61D58">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
			</level1-item>
			<level1-item ID="7DB640041A52400FA20E44A12508809F" OriginalMap="SAP Supply Chain Management: Driver &amp; Asset Management" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6F25E40C38E742B5B7B7EF17B2750FB9">
				<title>Driver &amp; Asset Management</title>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">Asset Management and
driver management is becoming increasable important. Asset
Management will enable the customer to maximize the profits by
utilization the capacity restrictions of the assets, having a
global visibility in the system their different assets are hence
also enabling track and trace for container movements.</span>
					</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">
						<span style="mso-ansi-language: EN-US">Driver management allow
to maintain the driver qualification and checks for sufficient
driver qualification during the manual assignment of drivers to
assets.</span>
					</p>
				</short-description>
				<process ID="0205612097894B6FA30F96B41FDE7C8F" OriginalMap="SAP Supply Chain Management: Asset Maintenance" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BFF1A308F3F54C3598BBCA384309E7C2">
					<title>Asset Maintenance</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="E72E324F9D4A42CB8E84A2946F21C496" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="06D32B3795A24784BFAEF539FC859DAD">
						<title>SAP Industry Package</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">SAP TM allows the maintenance of
vehicles, vessel, departure schedules including the constraints of
these resources, e.g. volume, weight etc. Container, pallets and
other equipment can get considered. Container maintenance allows
the maintenance of different container types, e.g. open /
closed.</span>
							<br></br>
							<span style="mso-ansi-language: EN-US">For vehicles it is possible
to maintain the necessary qualifications, e.g. necessary driver
license.</span>
						</p>
					</short-description>
				</process>
				<process ID="EAF941FCB99F454EB947B526CFC8AFC8" OriginalMap="SAP Supply Chain Management: Driver Maintenance" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="13D3FF34D6374122963C4AAAFA04D3BA">
					<title>Driver Maintenance</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="DE96D04102734F189DD7382C74B49B6F" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="01511EE7FA9345AAAFED8C143086A70D">
						<title>SAP Industry Package</title>
					</product-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">
         Driver can be maintained in the
system together with the available qualifications.
         <span style="mso-spacerun: yes"> </span>
         During the manual assignment of
drivers to the vehicles the system will perform a check if the
driver is qualified to operate the vehicle.
        </span>
						</p>
					</short-description>
				</process>
			</level1-item>
			<level1-item ID="C54C5943D5A04173BEFA2CA852B6B4B8" OriginalMap="SAP Supply Chain Management: Network Collaboration" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="9E819F04D95C45C1866AD1E4389F642F">
				<title>Network Collaboration</title>
				<process ID="A85F5F680D4C4D5CAC7E63BAA86B28A5" OriginalMap="SAP Supply Chain Management: Collaboration Shipment Tendering" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="B4C821DE26FF47ADAB33820D198111E4">
					<title>Collaboration Shipment Tendering</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="104CB5E563CF4CD89DBE7BBBB3BE7CC2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supply Chain Management: SAP Industry Package" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="6AF59EC7348C410DBDD153C1651E4370">
						<title>SAP Industry Package</title>
					</product-ref>
					<content>
						<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
							<strong>
								<span style="FONT-FAMILY: Tahoma; mso-ansi-language: EN-US">Collaborative
Tendering: </span>
							</strong>
							<span style="mso-ansi-language: EN-US">based on your actual shipment
plans and orders, you can tender your offers to your carriers over
the Internet or using XML or EDI, directly into your carrier's or
forwarder's system. This collaborative process enables you to
integrate your business partners into your business processes and
keep control of your plans. This process is described in more
detail below. This function is supported in SAP TM.</span>
							<br></br>
						</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<strong>
								<span style="FONT-WEIGHT: normal; FONT-FAMILY: Tahoma; mso-ansi-language: EN-US; mso-bidi-font-weight: bold">SAP supports peer-to-peer tendering, broadcast and open
tendering.</span>
							</strong>
						</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">The assignment of a carrier to a
shipment needs to be confirmed by the carrier (tendering).
Tendering can be done via Internet dialog or communication via EDI
or XML files. The carrier can accept the tender, reject or accept
with modifications. Re-tendering can get performed after a giving
timeframe considering also the working hours of the TSP. Tendering
can be done in SAP TM.</span>
							<strong>
								<span style="FONT-FAMILY: Tahoma; mso-ansi-language: EN-US">
									<span style="mso-tab-count: 1">      </span>
								</span>
							</strong>
						</p>
					</short-description>
				</process>
				<process ID="5C5E9346D23641829D0D308564F3D5D5" OriginalMap="SAP Supply Chain Management: Seamless integration" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="EF3B269D35B84526A541C3DDD2803581">
					<title>Seamless integration</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">
							<span style="mso-ansi-language: EN-US">Once the TSP has been selected,
outgoing transportation orders are created. The Freight Order and
the Shipment Order are freight purchase orders to procure
transportation services.</span>
							<span style="mso-ansi-language: EN-US"> </span>
						</p>
						<span style="mso-ansi-language: EN-US" xmlns="http://www.w3.org/TR/REC-html40">The purchase orders
determine the business view of the supplier and the information
structures in which the supplier sends the invoice. This
transportation order will be communicated to the carrier via EDI or
via Fax/ Email.</span>
					</short-description>
				</process>
				<short-description>
					<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
						<span style="FONT-SIZE: 8pt">With the increased challenges in managing
labour resources like drivers and the increasing demands on
equipment, supply chain partners must work closely together in
planning and executing logistics. Shippers, suppliers and carriers
alike need to share information on how many shipments will be
tendered and how many can be accepted. Planning-area functionality
helps you forecast shipment levels and carrier capacity and
equipment allocations. You can use planning areas to determine
shipment volumes by origin, generate weekly and daily forecasts,
and collaborate with LSPs.</span>
					</p>
					<br xmlns="http://www.w3.org/TR/REC-html40"></br>
				</short-description>
			</level1-item>
		</level0-item>
		<folder ID="3AA4BFDBAF23492E8362CDFB360C5B2A" pool="true" pool-position="right" OriginalMap="SAP Supply Chain Management: SAP NetWeaver" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="C727BFEB0720420AAE8199FD9D7AAF54">
			<title>SAP NetWeaver</title>
			<referencemap ID="CCD9E0212026400A941DFFDDEC6B574D" Ref="004F8486F21E4522943507897144041B" Title="SAP NetWeaver - Technology Map Edition 2007" icon="solutionmap.gif" File="SAP%20Business%20Maps/004F8486F21E4522943507897144041B.ssm" visible="true" is-pool="false" contentElementType="" OriginalMap="SAP Supply Chain Management: SAP NetWeaver - Technology Map Edition 2007" OriginalMapID="5F7358118AA6D511B1A80090270F6F87" SrcID="BA894B19730E4ACD9B0DC95F13FEC87D"></referencemap>
		</folder>
	</folder><folder ID="D3F264D8B0C84C05855304A7D8374A67" modified="8/14/24 08:17:19 PM"><title>SRM</title><level0-item ID="4E171CF161C24538846856625C941F70" OriginalMap="SAP Supplier Relationship Management: Purchasing Governance" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4A4F4E5F361C453AA83BA9D1B226EB21">
			<title>Purchasing Governance</title>
			<level1-item ID="81B5F7CC22F3477EA21F4A71FF1C63CC" OriginalMap="SAP Supplier Relationship Management: Global Spend Analysis" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C7A0BD605ECA4ABAA8D8AA0061A13335">
				<title>Global Spend Analysis</title>
				<process ID="AED6FD9C129945B7B59E48C0CC836DC3" OriginalMap="SAP Supplier Relationship Management: Consolidated Spend Reporting" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="815B296B66AE4E34A042B896F497117A">
					<title>Consolidated Spend Reporting</title>
					<sap-cover>2</sap-cover>
					<process-ref Ref="A29A5641DA749D6FE10000000A114AB6" ID="EEED5191291B42FFBE1753D644845AC8" variantOf="D8679291C8D24A6F83981B48295307AD" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Consolidating Master Data using BW Local Master Data Alignment" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8A0C782EF46748EDB2DA5BE78C58F67A">
						<title>Consolidating Master Data using BW Local Master Data Alignment</title>
					</process-ref>
					<process-ref Ref="CDD4E5F0FF9611DA12D100306E055DA7" ID="1027D3317F1B444FBF0C825D85A6B3EF" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Consolidating Master Data using MDM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B82A2CD78A104BFC95A6FBDC94FAC693">
						<title>Consolidating Master Data using MDM</title>
					</process-ref>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">
        With the xApp Spend
Analytics package, you can:
        <br></br>
        a. Take your spend data to the next level:  Your spend data is a
rich source of valuable information that can help you run a leaner
and more profitable business. But to take full advantage of it, you
must make it usable. And to do that, you the SAP solution provides
data quality management (DQM) software and services to aggregate,
normalize, and standardize your data – as well as enrich it.
        <br></br>
        b. Enhance Sourcing and Negotiations: SAP xApp Spend Analytics
gives people in your organization the insight they need, tailored
to their role, whether they are category managers, analysts, or
managers in charge of line-of-business operations. Your company
will know how much it is spending across all suppliers, categories,
and items. With visibility into this data, confidence in the
accuracy of the numbers, and the ability to manipulate it to answer
key questions, your procurement group can identify the best
sourcing opportunities and negotiate more effectively – on an
ongoing basis.
        <br></br>
        c. Deliver Actionable data to the desktop: With SAP xApp Spend
Analytics, employees no longer need to rely on IT for key reports.
Instead, your procurement group can deliver spend analysis data
directly to their desktops. The package includes out-of-the-box
reports and role-based dashboards relevant to your strategic
sourcing and financial analysis personnel. With these reports and
dashboards, you immediately empower your team to access the
information they need to make smart and timely decisions. For added
flexibility, a report-creation wizard allows your team to build
reports right from their desktops.
        <br></br>
        d. Gain critical insight into spend data: To ensure that your
procurement group gains all the insight required to make the right
decisions, the software allows them to analyze data in the
following ways:
        <br></br>
						</p>
						<ul class="noindent" xmlns="http://www.w3.org/TR/REC-html40">
							<li>
         Drill down on hierarchies, such as a
         <br></br>
							</li>
							<li>
         supplier or category, to get more detailed information
         <br></br>
							</li>
							<li>
         Apply advanced filters to narrow data to show, for example,
only direct spend or addressable spend
         <br></br>
							</li>
							<li>
         Perform multidimensional analysis, such as viewing suppliers
associated with a particular commodity
         <br></br>
							</li>
						</ul>
						<p xmlns="http://www.w3.org/TR/REC-html40">You can even drill down
into the system where the source information resides, to gain
deeper insight. For example, someone in your procurement group can
review a purchase order or invoice detail to check line items or
cost components.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Combining these features
with services ensures a complete solution at lower Total Cost of
Ownership.   SAP provides the data quality management tools and
services to help you get clean data. SAP xApp Spend Analytics also
includes project management and onboarding services. Additionally,
configuration, help desk, training support, and sourcing
opportunity assessment are available through SAP and its
partners.</p>
					</content>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">You need to know how
much you’re spending, with whom, and on what. The SAP® xApp Spend
Analytics package helps you aggregate, cleanse, classify, enrich,
and analyze your spend data. By providing the right people
throughout the organization with desktop access to accurate and
detailed spend information, you can better identify sourcing
opportunities and improve compliance with corporate purchasing
policies, enabling you to drive realization of your anticipated
savings.</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="3ECE4BDF9A0C46ADAC08F394B41606CD" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3FA9C2ECD1A34E2DBAAFE8956DAF6ED3">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="3526AD2F3EB240B6809526A521E218A5" ID="C27264B82012417CB601F9104956C863" type="SAP" key="SAP xApp Spend Analysis (SAP xSA)" OriginalMap="SAP Supplier Relationship Management: SAP Spend Analytics" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E9471692C154432D9EB2FF35A6AA4FF7">
						<title>SAP Spend Analytics</title>
					</product-ref>
				</process>
				<cbs-ref Ref="5CF58D9F2C514BB48ABFF1AAF16D7107" ID="7BF56CCDDD0A44F48139E3850845184B" OriginalMap="SAP Supplier Relationship Management: Strategic Sourcing - Global Spend" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="12E59128EF2E4650B5938BA8C55130F2">
					<title>Strategic Sourcing - Global Spend</title>
				</cbs-ref>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">Leave no money on the table when it comes to capitalizing on
saving opportunities. With this functionality you can identify
sourcing opportunities and make informed decisions about where to
focus sourcing initiatives. Be fully informed about where your
company is spending how much money and which spend categories are
performing sub-optimally.</p>
				</short-description>
				<business-objective-ref Ref="41088BF20D2A450C90709A5E0399CBF0" ID="805D85A3921641BB83E5CD9FC597154D" OriginalMap="SAP Supplier Relationship Management: Improve data accuracy and availability" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B41144826D3644618E12F7E0A88A6DA1">
					<title>Improve data accuracy and availability</title>
				</business-objective-ref>
				<business-objective-ref Ref="9672145D0BCD4D76962D36EB37DF37AC" ID="272D6DC5ED81487EB55ED77A2C272B0F" OriginalMap="SAP Supplier Relationship Management: Provide decision support" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="36F58B8087B6439A8323A7C6F9D83D25">
					<title>Provide decision support</title>
				</business-objective-ref>
				<business-objective-ref Ref="EE12147E27634F1393C84F359A746D74" ID="864F82E581204CED95F5C58B90D8B8DE" OriginalMap="SAP Supplier Relationship Management: Flexible, fast and accurate analysis" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B7BA18FA87B64045A8F5B5265F35F65C">
					<title>Flexible, fast and accurate analysis</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="689CDAB5A0BD47F2920005CAD8280AC0" OriginalMap="SAP Supplier Relationship Management: Category Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="5D542136C74C403BBAA8D6EEBE50668D">
				<title>Category Management</title>
				<process ID="28980C52367D4415807D62035469436E" OriginalMap="SAP Supplier Relationship Management: Category Strategy Planning" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2A5B8DC242A045B98D0077D8D8E91345">
					<title>Category Strategy Planning</title>
					<short-description>As procurement organizations execute on cost savings and spend
management strategies, one category at a time, a planning framework
to help collaborate on key metrics and goals across stakeholder
groups helps to track and roll-up towards the larger goal of
savings and control.</short-description>
					<sap-cover>2</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="918258DCF4E243EFAA016B94FB8FD4D9" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2865E288959F48CEA7FECCF0BD8C1B33">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="4DB6FF0E10AF4B718BF23A0060A72615" OriginalMap="SAP Supplier Relationship Management: Category Definition" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F8B42BA74E074B3C8F5891C683B0D54C">
					<title>Category Definition</title>
					<short-description>More and more companies are moving towards Planning and Execution
of strategic initiatives at a category level.  This helps companies
focus on strategic categories that are critical to the business. 
Categories may however be logical groups of commodities with common
procurement strategies or goals &amp; metrics.  A framework to
define category groupings together with factors and variables that
affect procurement strategies and help define cross-company goals
and metrics would further strengthen the integrated SAP SRM
platform.</short-description>
					<sap-cover>2</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="48CDA94382854DDAA1CFCBB2945F3FC2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="34B67C6B38494116AF4A2D7A060079AA">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="B6FEBC50CAFD443DA3D6A95C8B48D645" OriginalMap="SAP Supplier Relationship Management: Methodology Setup" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="7E2A535E2B894978B39A602D08FF1C28">
					<title>Methodology Setup</title>
					<sap-cover>1</sap-cover>
					<short-description>
       You can use this business process to create a methodology,
comprising multiple methodology steps. You can create and assign
workflow tasks to each methodology step.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Once the methodology has been saved, you can create a collaboration
room for each methodology to create and store best practice
templates for sharing across purchasing groups and key stakeholders
when the methodology is widely adopted.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="20C126FA79494E8DB09D8F42520B27C2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C836AC103A6545119EC15B0E8256ADBE">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="CD88C5633F864CF59271A9EEC99EE10A" OriginalMap="SAP Supplier Relationship Management: Program Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E80D38EEB4D843B6A0D7332427279114">
					<title>Program Management</title>
					<sap-cover>1</sap-cover>
					<short-description>You can use this business process to model a relatively long-term
strategy for one or more categories. Each program has an objective
and a budget (spends) to meet these objectives. The objectives can
be established at an organization level or across the company.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="AEBB571E1F5F489A9568433AB583B2BF" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D7092D4DF52E44C2A62F8E5ED93DE980">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="141D87C128AD45B9BFD4C760D13950A1" OriginalMap="SAP Supplier Relationship Management: Project Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="FF585A399F3140DEB8FE60916D746EDF">
					<title>Project Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The E-Sourcing Project Management module enables purchasing
organizations to manage their strategic sourcing initiatives.  
Most strategic sourcing activities are “project-based.”  Each
activity is a deliberate, planned and qualified event.   Projects
typically have established goals, timing, and resources and are
measured against the achievement of those goals.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Project Management allows an organization to establish a central
knowledge repository of their sourcing projects and establish a
sourcing methodology which can be communicated across the
organization.   All critical documentation is stored in one central
location and accessible to global project teams.  E-Sourcing
Project Management module allows an organization to create and
maintain project schedules, track savings and costs, required
resources, and collaborator with stakeholders.  Projects are fully
integrated with RFx’s, Auctions, and Contracts allowing information
to be copied from one business process to the subsequent business
process.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Strategic sourcing activities typically are organizationally or
geographically distributed, with many participants existing outside
of the procurement organization. This often poses a challenge when
stakeholders from various disciplines are required to participate
in a sourcing event.  Often sourcing organizations have established
best practice methodologies to organize and source their specific
commodities.  E-Sourcing Projects were designed to provide a way to
organize and streamline the management of a sourcing event while at
the same time providing the visibility required to enable global
commodity teams.</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="9691EC9E864B444283814EF606AC7AE6" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B6B4FA3862384F678C652B0CC2B195EB">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="0193326E28024EDE9E28C1AF289DD667" OriginalMap="SAP Supplier Relationship Management: Buyer Performance Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="64AD19289B8C42E09429EFDB6C47EDBD">
					<title>Buyer Performance Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Buyer performance management allows to monitor procurement
values, number of purchase orders, and average prices achieved per
buyer.</p>
					</short-description>
					<process-ref Ref="87A2A180FFA511DA12D100306E055DA7" ID="E77B2E071C7045B1A1D9103815DCA8B7" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Analyzing Categories, Programs and Initiatives" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E1874CF64365445D9AC0E484BE77C1F4">
						<title>Analyzing Categories, Programs and Initiatives</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="55805C54AE624685880E44A4FA5B7636" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DDD798A31F9349EEB5E17CF0CC2444FA">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>You can use this business scenario to realize opportunities for
procurement savings. To capitalize on such opportunities, you must
be able to weigh cost-reduction goals against issues of quality,
risk, and innovation. You can do this by creating methodologies,
programs and initiatives for your enterprise, with the goal of
attaining a specific cost saving. You can subsequently analyze the
effectiveness of these programs and initiatives.</short-description>
				<business-objective-ref Ref="AC83EDB1A4ED456384A47C945EBF3AF7" ID="39FACBCDF5934E74AE26557731F38326" OriginalMap="SAP Supplier Relationship Management: Lower cost procured goods and services" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="585D1EF06F1A4E28914F174C8154B74F">
					<title>Lower cost procured goods and services</title>
				</business-objective-ref>
				<business-objective-ref Ref="EE12147E27634F1393C84F359A746D74" ID="0EEED52D2A4C4E63A0289D6B690B6010" OriginalMap="SAP Supplier Relationship Management: Flexible, fast and accurate analysis" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4BCBB2910DF64D8DACB34A104AF00B46">
					<title>Flexible, fast and accurate analysis</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="815FED5C97F044A592D86C62F7DEF972" OriginalMap="SAP Supplier Relationship Management: Compliance Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="026DF86037824B07A0F53137836E3C14">
				<title>Compliance Management</title>
				<process ID="089AA5C8D1F84F609D0F09369B40C39C" OriginalMap="SAP Supplier Relationship Management: Purchasing Policy and Compliance Analysis" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BF5DEE6FEB2943D1A2AF7747EA52D9A5">
					<title>Purchasing Policy and Compliance Analysis</title>
					<sap-cover>3</sap-cover>
					<short-description>
       Purchasing activity is often driven by the line-of-business.
Central purchasing is increasingly tasked with purchasing policy
making and governance of all purchasing activity across the
enterprise. Capabilities to communicate and analyze how behavior
matches the policies set are needed.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
				</process>
				<process ID="5FE07630AA4D42FDA0AA57E26F8AE8E1" OriginalMap="SAP Supplier Relationship Management: Buyer Compliance Reporting" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="85549A77C3894CE99C8449BC0C56AE83">
					<title>Buyer Compliance Reporting</title>
					<sap-cover>2</sap-cover>
					<short-description>
       Buyer compliance reporting allows to track buyers’ maverick spend
behavior and contract call-off quantities regardless of which
execution system the contracts reside in.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="23BFEBFB7BAA4FC9A4387DDA3DFFC5F2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4BA307B75229453EB8B464B20D50CD92">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="3524A044383F4A6196A31EB61872198B" OriginalMap="SAP Supplier Relationship Management: Business Unit Compliance Reporting" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9A2A99415375442587FC7971432F4DD6">
					<title>Business Unit Compliance Reporting</title>
					<sap-cover>1</sap-cover>
					<short-description>
       Companies are exposed to an increasingly number of regulations,
stated by law, enforced from regional or local authorities, or
originating from standards and internal policies from within the
company. Compliance with these regulations and policies – be it
adherence to Sarbanes-Oxley, to different trading regulations, or
to contractual terms with a specific supplier - must be reported
and tracked on different levels for follow up and actions, starting
from a company overall view, drilling down to business units,
departments, purchasing organizations and individual buyers.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="34BC1EE6C70B4F01B12CE833853AE56D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="41378592994B4ECE88D1D8A16D99700E">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="AB4704DA78CC4F29A479726DCD7DD7AF" OriginalMap="SAP Supplier Relationship Management: Supplier Compliance Analysis" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8C52FD0D0F8C491583AD0553CF128E64">
					<title>Supplier Compliance Analysis</title>
					<sap-cover>2</sap-cover>
					<short-description>
       Supplier compliance analysis refers to the capability to monitor,
measure and manage how suppliers comply with negotiated agreements,
such as prices, terms, and discounts, on a global basis.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="2C72D3BBE4924903BC40FC4AE7C0734C" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CB4B3E4F32724A3AA15ADDF3599F4C6A">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="AD55A7CE6A9D4DDF92C1E8019043EA22" OriginalMap="SAP Supplier Relationship Management: Embargo Screening" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1B6303E472B44442900A8D0602E04778">
					<title>Embargo Screening</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="1C1B2241A18E7001E10000000A114AB6" ID="108F2509816C4297AF6A24FDD2F819C6" variantOf="493EB9E3FCD911D812D100306E055DA7" OriginalMap="SAP Supplier Relationship Management: Embargo Check" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="256084AE664D48FEB923CB29E29C9FCC">
						<title>Embargo Check</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">The embargo check in SAP GTS provides flexible capabilities for
managing embargo distinctions. Embargo checking in SAP GTS can be
enforced using any combination of the following:
country-to-country, country group to country, or all countries to
country.</p>
					</short-description>
					<product-ref Ref="641569040A9345DF9A765CE6464C2685" ID="04B31F68F9C0489787535A1252728E29" type="SAP" key="SAP Global Trade Services - Export" OriginalMap="SAP Supplier Relationship Management: SAP Global Trade Services - Export" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6E99A18B84AD4ED1825B204CDA5F74C6">
						<title>SAP Global Trade Services - Export</title>
					</product-ref>
					<product-ref Ref="17BE21194F7F413BBC3C4B5E29640538" ID="1B14B113B75E4E41934521CD97BF2552" type="SAP" key="SAP Global Trade Services - Import" OriginalMap="SAP Supplier Relationship Management: SAP Global Trade Services - Import" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C4C07ADB42F54B56A1E9F83C432AED5A">
						<title>SAP Global Trade Services - Import</title>
					</product-ref>
				</process>
				<process ID="71144BC5F0404553861E57CD13137763" OriginalMap="SAP Supplier Relationship Management: Contract Compliance Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="622CEAB5CE944257BB5BE1C6DBA6E126">
					<title>Contract Compliance Management</title>
					<sap-cover>1</sap-cover>
					<short-description>
       Monitoring compliance through alerts on target value/target
quantity against released value/released
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
						<ul class="noindent" xmlns="http://www.w3.org/TR/REC-html40">
							<li>
         All the purchase orders and invoices created against all the
contracts in SRM and ERP systems
         <br></br>
							</li>
							<li>
         All the purchase orders and invoices created with all the
suppliers in SRM and ERP
         <br></br>
							</li>
							<li>The product categories created in SRM and ERP systems</li>
						</ul>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="292ED18BBF6F42A0B696DC87021A97E0" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="362FB1698F714432810F76D734FCD8D5">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>
      Spend Analytics, Global Spend, Category and Project Management
allows procurement executives to manage compliance, including
definition, communication, measuring and tracking of compliance
measures across the company. 
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
      Compliance measures can be defined as purchasing policies,
established as part of a sourcing or contracting methodology,
incorporated in supplier performance reviews and measured using
spend analytics.
     </short-description>
				<business-objective-ref Ref="4020EE5AD23046F89022D3171F282A7B" ID="E79BFBE1B4224914B7F8AB0AB02FEEC5" OriginalMap="SAP Supplier Relationship Management: Improve transparency and auditability of activities" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="226CD12A979C4EB2993FD5BACF9FFDF9">
					<title>Improve transparency and auditability of activities</title>
				</business-objective-ref>
			</level1-item>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">Purchasing Governance is fast gaining importance as the
management tool to not only execute on Corporate Responsibility
initiatives, but also to effectively execute on cost savings and
cost avoidance opportunities beyond the low hanging fruits of
sourcing or contract negotiation.   Purchasing Governance helps
decentralize execution while maintaining control centrally.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40">For example, companies may require environmentally friendly
products for use by janitorial suppliers, or require
local/minority-owned suppliers for certain categories.  Companies
may apply maximum spend limits on certain areas such as travel.   
Certain governments ban contracts with suppliers from certain
countries.  Other public sector/government agencies may require
detailed specification level disclosure of items purchased within
say hazardous categories.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">
      In this context, Purchasing Governance would mean:
      <br></br>
      a. Collaboratively planning, establishing and communicating global
policy guidelines, minimum performance expectations, risk
assessment and mitigation plans and compliance metrics
      <br></br>
      b. Visibility to actual spend and compliance patterns
      <br></br>
      c. Planning and Executing key initiatives incorporating purchasing
governance factors
      <br></br>
      d. Tracking and reporting on status of initiatives and key measures
of purchasing governance across internal departments, external
suppliers and key stakeholders
      <br></br>
      e. Monitoring and Control – establishing continuous process
improvements based on closed-loop monitoring of spend and
compliance patterns
     </p>
			</short-description>
		</level0-item>
		<level0-item ID="3D9ADA40CB734470A2D9BD1AA7664B8B" OriginalMap="SAP Supplier Relationship Management: Contract Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6C2E523E5251464ABEA54DAB1B1376CD">
			<title>Contract Management</title>
			<level1-item ID="8FDA82A273FF454EA04278F9D8C09B1B" OriginalMap="SAP Supplier Relationship Management: Legal Contract Repository" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="AE0A4ABD75DE49A3910E75899D6E6C38">
				<title>Legal Contract Repository</title>
				<process ID="5199DA2F888B4C25BAB4BE1AD2F5B5C3" OriginalMap="SAP Supplier Relationship Management: Create Master Agreement Template" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9B007AB8D6DA4924922F4DBB9A8367AD">
					<title>Create Master Agreement Template</title>
					<short-description>The first to use xCLM as a central repository is to create the
template for the master agreement. The master agreement template
determines which fields ans screens are available for certain type
of master agreement.</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="21EB3B6666D145EAA43B60A2C807B376" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9ACB7BFA1B304FA2A5DEDEAC91B129FF">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="B94D828FD1994A0381E687F968F6F226" OriginalMap="SAP Supplier Relationship Management: Create Master Agreement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="838F1014B36F4C60B3468F50A05C2E0F">
					<title>Create Master Agreement</title>
					<short-description>The master agreement template is used as starting point to create a
master agreement. The master agreement is the container for legal
contract and contains the meta data for the legal contract. Typical
master agreement content is, to just mention a few, reminder dates,
alerts and the collaboration list which determines the
authorization.  </short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="2C8C921BE36247D6B023C644ED5057DE" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="0166DDE89AD94A74816B12D897F1B018">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="AC4274B4B38E4FBF83FDFA757CF8311F" OriginalMap="SAP Supplier Relationship Management: Upload Contract Document" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="48EA3E3C7E28467F9421A000B30D744D">
					<title>Upload Contract Document</title>
					<short-description>After the master agreement is created the contract document or
contract documents can be uploaded and associated to the master
agreement. The contract documents have an own status and can go
through an approval workflow in xCLM.</short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="2023A46F914B4545913BE5E97DC4ED54" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CC61BB1C65F74E33AD15A126FBC8816F">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="FF072DF08B824976AB46BB704184A412" OriginalMap="SAP Supplier Relationship Management: Search Contract Repository" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="857C9F483658407B9B43A3980F37C941">
					<title>Search Contract Repository</title>
					<short-description>xCLM provides comprehensive search capabilities which allow a
company to gain visibility to their contracts. The search result
shows all the master agreements and contract documents in the
repository, but only the authorized user is able to access the
details of a master agreement/contract document.  </short-description>
					<sap-cover>1</sap-cover>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="102F509CCD374551912C316064FAFC10" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3F0E64DC73E2479EBE429EC85B602C5B">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<short-description>
      The user can create a master agreement as a container for the meta
data of contract document. The contract documents can be uploaded
to the repositroy and associated to a master agreement. The master
agreement can store multiple contract documents which can be
created outside of the system, legacy and 3rd party contracts.
Customers can gain visibility,gain control and generate automated
alerts.
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
				</short-description>
			</level1-item>
			<level1-item ID="97785CE0C1EC457BBB2F3392B1D66610" OriginalMap="SAP Supplier Relationship Management: Contract Authoring" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1BB844E67DFB467BAD54DA3155435C40">
				<title>Contract Authoring</title>
				<process ID="AEEC94810C4245C3B07C067AC6B39BA6" OriginalMap="SAP Supplier Relationship Management: Clause and Template Library" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C1ED9B7D97A14FD0B570D5DD49E15E96">
					<title>Clause and Template Library</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">Clauses refer to parts
of the legally approved language that is intended to be used within
contracts and contract templates. An authorized user is able to
create and maintain clauses in the clause library. Approved clauses
have to be grouped into sections, the approved sections can be used
for template. In additional approved clauses can be used during
legal contract authoring if additional language is needed.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Templates are used as
staring point for the authoring of legal contracts to ensure
compliance with legal terms.</p>
					</short-description>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="023534CEC68E494DADDA89D750BEB792" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="19EE31B521864828815A223EADD71CAE">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="087BDDF136B94F95BE7F34D4749AE619" OriginalMap="SAP Supplier Relationship Management: Legal Contract Authoring with DUET" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B218B687ED6942E38B90A38CE2788EB8">
					<title>Legal Contract Authoring with DUET</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">In case DUET is enabled,
the legal contract creator can initiate the authoring process for a
legal contract by selecting an approved legal contract templates in
the template library. The approved legal template is used as a
starting point for the legal contract authoring process. </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">The user is able to work
with MS Word/DUET on his legal contract. The legal contract can be
modified during the authoring process by updating existing clauses,
adding additional clause from the clause library to the legal
contract. </p>
						<p xmlns="http://www.w3.org/TR/REC-html40">The contract authoring
is performed in MS Word with the additional support through the
Duet contract pane, which allows the contract creator to add
attributes and master data to the legal contract. After the legal
contract is checked in, the master agreement gets updated with the
integrated attributes of the legal contract. In case of a DUET
enabled system the integrated information between legal contract
and master agreeement is kept in sync.  </p>
					</short-description>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="1A14675F08A0414A994489306DA2F572" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="22B2E158EF794C35A63023FB64FBE0B9">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="9A78984DF6A24782B56ED7528174360F" OriginalMap="SAP Supplier Relationship Management: Legal Contract Authoring without DUET" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="05EF5B25518A4370AE3015A42A90D31D">
					<title>Legal Contract Authoring without DUET</title>
					<short-description>The contract creator has to select a master agreement template to
get started with the process. The master agreement is the container
for the legal contract and contains the meta data for the legal
contract. After the user has filled out the master agreement he can
select the contract template and run the contract generate
transaction, which will create a legal contract that is associated
to the master agreement.   </short-description>
					<sap-cover>2</sap-cover>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="FBDF4C21C11F4B8BB943B938DBC43D5D" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DB42B91DE73C4324B800E020073030C9">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="C86344D4A98F4B8C8D116FCA38949104" OriginalMap="SAP Supplier Relationship Management: Internal Legal Contract Collaboration" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F432C54349774ADF85716ED7FBC470B4">
					<title>Internal Legal Contract Collaboration</title>
					<sap-cover>1</sap-cover>
					<short-description>To verify and confirm the content and completeness of the legal
contract, the contract creator can collaborate internally with
stakeholders on the master agreement and the legal contract.</short-description>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="2DAB07E5ADED43EE8CBF5742C9ADBAF3" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6DC5803FFBFD4AD68C91AA464AB6B7A8">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<short-description>Many companies use legal contract templates as a starting point for
legal contract authoring. The business scenario starts with the
creation of clauses which have to be grouped into sections.
Sections can be added to templates. Approved templates can be used
as a starting point for contract authoring. After you select an
appropriate template, you can develop and finalize the legal
contract using internal and external collaboration capabilities.</short-description>
				<business-objective-ref Ref="18BC2AD7885641A7BDE053C9E8527036" ID="8EB9087BFFE74FE8A259A9CD271469BA" OriginalMap="SAP Supplier Relationship Management: Collaborate with business partners" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="09635D5600674609A9A46EB033F0B0AA">
					<title>Collaborate with business partners</title>
				</business-objective-ref>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="CDDED8DDE85246688B7C9FD75EDA517F" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9C9877D84DE74606A91AFA6FADA86170">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="DD211BB75BBC42388C844500E320FD2B" OriginalMap="SAP Supplier Relationship Management: Contract Negotiation" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="04022D3A9B074C59940EB2DA16E089EE">
				<title>Contract Negotiation</title>
				<process ID="F5B58755FD8C4C5E9D9BD61D1F262F47" OriginalMap="SAP Supplier Relationship Management: External Collaboration for the Legal Contract" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="A26B5838555C48BB881B59F020F501C9">
					<title>External Collaboration for the Legal Contract</title>
					<sap-cover>1</sap-cover>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">To collaborate externally with a supplier, the contract creator
has to change the phase of the legal contract to make the contract
available for the external party. The supplier can access the
supplier portal and check out the  legal contract. The supplier can
offline modify the legal contract and upload the changed version to
the supplier portal. The internal user can review the supplier
version and determine which changes of supplier he would like to
accept/reject.</p>
					</short-description>
					<process-ref Ref="E80EAB308A8111D912D100306E055DA7" ID="74C95F479E334F318AB8207C7B83F68F" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Developing Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DD479EDAA09247EEBF7B29B67FBD9516">
						<title>Developing Contracts</title>
					</process-ref>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="251D0CE2BA114DD4BF74FB7A043239D7" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9BE3B445AFFC4E91BA4D68AAB67F9FE7">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<process ID="CBD5AD085BD445A08529001753C63FC9" OriginalMap="SAP Supplier Relationship Management: Renegotiation of an Operational Contract" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D659973F7E9745CFBDE2087FDD8FB899">
					<title>Renegotiation of an Operational Contract</title>
					<sap-cover>1</sap-cover>
					<short-description>
       An expiring operational contract can be renegotiated through a
bidding event. The contract information is transferred and an RFQ
is created.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The winning bid can be used to update the operational contract or a
new operational contract can be created out of the bidding event. 
      </short-description>
					<process-ref Ref="5ADF0D4186867001E10000000A114AB6" ID="80936C5AF1CC4BB28C4A572E90B36EC2" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Negotiating Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C0242F970D904AE1BEED82CFFE5AB96C">
						<title>Negotiating Contracts</title>
					</process-ref>
					<product-ref Ref="B637DB2403AA450D8270552DE6459447" ID="C2B32D2A2AFF463FB6B42463CC270594" type="SAP" key="SAP xApp Contract Lifecycle Management" OriginalMap="SAP Supplier Relationship Management: SAP Contract Lifecycle Management (SAP CLM)" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="146E4A9839A14F5DBA75565F2112B977">
						<title>SAP Contract Lifecycle Management (SAP CLM)</title>
					</product-ref>
				</process>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">The legal contract
creator can decide to collaborate with the supplier. The legal
contract negotiation with the supplier is done offline via email
and can be used to negotiate legal language, commercial terms and
line item information. The contract can be made available for the
supplier via the supplier portal. Furthermore an operational
contract can be renegotiated through a bidding event.</p>
				</short-description>
				<business-objective-ref Ref="18BC2AD7885641A7BDE053C9E8527036" ID="974FF83D76FD40BDB22197E066970444" OriginalMap="SAP Supplier Relationship Management: Collaborate with business partners" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BF6F8FB4E291403CB0D622AA798065AF">
					<title>Collaborate with business partners</title>
				</business-objective-ref>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="DDF002D7EF854DAF887FAF9AA0A3E93C" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="5E64DFAF941B45DCB1E3BCA87D142ED3">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="2D2D2742F0294B6BBEC4B62AE1944533" OriginalMap="SAP Supplier Relationship Management: Contract Execution" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="A6B4BE0BE08C4F909F6580C00502BAE1">
				<title>Contract Execution</title>
				<process ID="907AD0805B8B43B2A02CFCCA14B47773" OriginalMap="SAP Supplier Relationship Management: Integration of Legal and Operational Contract in ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6881207C3A6A4081A80F56EB4B5CBAC3">
					<title>Integration of Legal and Operational Contract in ERP</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="14E952E1FA7640DEBDB43EC0487DF330" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="27463CB0780A4069AE6946FB05D90C51">
						<title>SAP Industry Package</title>
					</product-ref>
					<short-description>After the legal contract is released in xCLM, the legal contract
creator can initiate the creation of an operational contract in ERP
out of the legal contract. If the legal contract creator decides to
create an operational contract, all the integrated attributes of
the legal contract are transferred and an operational contract in
ERP is created.</short-description>
				</process>
				<process ID="8277B9488766424AA29C26D9FF997471" OriginalMap="SAP Supplier Relationship Management: Central Operational Contract Repository" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2439FA928B044DB4B01A9480EA273D21">
					<title>Central Operational Contract Repository</title>
					<sap-cover>1</sap-cover>
					<short-description>A common repository for all kind of operational purchasing
contracts, accessible from all purchasing processes.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="4C88EB96310E4683831DEA612713D04D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3CF68B2E05E5460E82079BEFBDA6B3EB">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="34C4C771C8EE4DD1BBE3018A55729900" ID="A84C4413B87A45CBA10165BA5B5A9224" OriginalMap="SAP Supplier Relationship Management: Reduce transaction costs" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DC05B28EC2A84846B20ABA600F7BE89C">
					<title>Reduce transaction costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="B1168F7CBA594BCDB5E98CE900E4E625" ID="ABE2B90ED8C24C6995FFCA2A50EA9187" OriginalMap="SAP Supplier Relationship Management: Standardize processes for consistency, efficiency" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9D69C295182F4A2FA47BD0F9BB52BE97">
					<title>Standardize processes for consistency, efficiency</title>
				</business-objective-ref>
				<process ID="B9966D7F540F48978A537D57C1FC895D" OriginalMap="SAP Supplier Relationship Management: Using Contracts for Source of Supply Assignment" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="70834712A01747398DBF50AF2EA886A8">
					<title>Using Contracts for Source of Supply Assignment</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="F59F0A908A8311D912D100306E055DA7" ID="50930EF031A64AC49337EFBB82208676" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Executing Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="A6B9972BFB304E4DB74D3577FCD8BBC0">
						<title>Executing Contracts</title>
					</process-ref>
					<short-description>The sourcing process can be controlled by the information that is
stored within the contracts. The system automatically calculates
the prices according to conditions that are stored within contracts
and select the appropriate contract. Furthermore other criteria
such as target quantity, delivery time, min./max. order quantity
etc., can be taken into account.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A99C825BF46F4FAA91B26124BAC66FAC" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D032602898D2485DA13E4F18D18800D4">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="EA89BB15FA6746FA80AF349808ADF4BE" OriginalMap="SAP Supplier Relationship Management: Flexible Pricing and Discounts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E3B5C172BA48418BBB9ABF56D76EB7EF">
					<title>Flexible Pricing and Discounts</title>
					<sap-cover>1</sap-cover>
					<short-description>Flexible pricing and discounts with special rebates for contract
hierarchies.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="93E7E556922943509F93A4D3E62DB519" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4684B4F005BE4A97A093955A9BF5E54B">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="40499D414F94486D9DB43E73F113AF18" OriginalMap="SAP Supplier Relationship Management: Integration Between Contract and SRM Catalog" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CCF2D5FA7A96415BA109AEBD1269763D">
					<title>Integration Between Contract and SRM Catalog</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="F59F0A908A8311D912D100306E055DA7" ID="C77F2CF947E6404E8E5FCF7F2D8BECD0" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Executing Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E08C233E747D418197A836CEB675A417">
						<title>Executing Contracts</title>
					</process-ref>
					<short-description>
						<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
							<span lang="EN-GB" style="mso-ansi-language: EN-GB">Integration between operational
contract and SRM Catalog allows to determine whether a contract is
to be used as a source of supply from your company’s
catalog.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
						<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
							<span lang="EN-GB" style="mso-ansi-language: EN-GB">This has the advantage that
employees can choose items that are subject to the agreed terms and
conditions of a contract.</span>
						</p>
						<br xmlns="http://www.w3.org/TR/REC-html40"></br>
						<p style="MARGIN: 0cm 0cm 0pt" xmlns="http://www.w3.org/TR/REC-html40">
							<span lang="EN-GB" style="mso-ansi-language: EN-GB">The purchaser can decide whether
only selected items</span>
							<span lang="EN-US" style="mso-ansi-language: EN-US">are transferred to the catalog or
the complete contract should be uploaded to the catalog.</span>
						</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="BCB2D75C23C3437DB6659146AD53E368" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BEF436E904FA4CC98236812E1D5921BD">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="4234ECB05E824BD498CB6FF8900B5A5D" OriginalMap="SAP Supplier Relationship Management: Quota Arrangements" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E64A991AB88A479F95A733847345FE05">
					<title>Quota Arrangements</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="F59F0A908A8311D912D100306E055DA7" ID="C2C8024BD21A4CC98C415E0260DA51C0" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Executing Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4378A5D7F1A746DE9B99778AFCC8692B">
						<title>Executing Contracts</title>
					</process-ref>
					<short-description>Quota arrangements allow you to define target percentages and
distribute them between two or more purchasing contracts. A quota
arrangement ensures that a contract is guaranteed both a minimum
sales volume and a percentage of the total purchasing volume of the
product category or product. A quota arrangement has the highest
priority in the sourcing process.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="72B8C6EB188F447DBCF20D54EC716A21" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9A10951A92904E3797B1072FE754BF75">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="7A69E2E99C164550AC1F9DD93EDA9A92" OriginalMap="SAP Supplier Relationship Management: Records Management Integration" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BAEF718EF9D546E1BEF9D3B9FEB1CE4C">
					<title>Records Management Integration</title>
					<sap-cover>1</sap-cover>
					<short-description>With the integration of Records Management and Contract Management
it is possible to create a record file in the Records Management.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="13BD5C61AC034D97961ECD014B520FB0" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="715A54A7A3594214BA55A55D563FE334">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="19F750F80DE94B6EB6764D72EC83600B" OriginalMap="SAP Supplier Relationship Management: Contract Distribution for Global Outline Agreements" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="18FA3EDCA0AE429BA180AFCC0DA3DE1B">
					<title>Contract Distribution for Global Outline Agreements</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="69CA893FB7B0183BE10000000A114AB6" ID="E9F1688420834600B4430825283318CA" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Processing Global Outline Agreements" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C3D1D7DF3A454B0491F3E12277E4888E">
						<title>Processing Global Outline Agreements</title>
					</process-ref>
					<short-description>
       Enhanced and improved contract distribution for Global Outline
Agreements.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The capability of contract distribution enables an enterprise to
negotiate and manage Global Outline Agreements and to use them
locally.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       After a contract has been negotiated it can be distributed to SAP
or non-SAP backend systems, to create contracts which serve as a
basis to create local purchase orders. Also, it is possible to
create local scheduling agreements to enable tight and lean local
replenishment processes.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The centrally negotiated quantities or target values can be split
and distributed according to local needs, taking central policies
into account. To respect local requirements, local contracts can be
changed or enhanced according to local needs. A local user (e.g.
product category champion) can subscribe to a global contract. If a
problem occurs with a global contract (for example the supplier
product fails a central quality check), it can be automatically
locked. As a consequence all local contracts are locked and it is
no longer possible to create purchase orders or local
call-offs.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Local contracts can be updated by changing the Global Outline
Agreement.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="E71AA9B5B05643E4B7EE5806D55D44E7" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6A1B1998FCC84DC38BA324222C384201">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="67E37F82BDAB4AEF90638820771B33C6" OriginalMap="SAP Supplier Relationship Management: Enhanced Control and Risk Mitigation of Currency Fluctuations" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="7CE18520151449F1B240315ED33506F6">
					<title>Enhanced Control and Risk Mitigation of Currency Fluctuations</title>
					<sap-cover>1</sap-cover>
					<short-description>Enhanced control and risk mitigation of currency fluctuations with
Fixed Exchange Rates for operational contracts.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="C8711310B4D348A79239C3045B342C4D" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="63925F33E2B5448B8282E441D3A08299">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>
					<p xmlns="http://www.w3.org/TR/REC-html40">The released operational
contract can be used as source of supply within SAP Supplier
Relationship Management. The creation of purchase orders can be
triggered automatically (for example by incoming demands from an
external MRP system) or manually by a purchaser who creates a
purchase order.</p>
					<p xmlns="http://www.w3.org/TR/REC-html40">A third-party process,
in which a purchase item will be directly delivered to a customer,
is supported within Contract Management. For Self-Service
Procurement via catalogs it is possible to link catalog items with
contracts to derive centrally contracted prices and volume
discounts.</p>
				</short-description>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="01035DDA75024B62AED342010AE47748" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E6A87088829349749A4C7666953A4779">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="8B9D66DEBEA94C659AF9CC99383DACD0" OriginalMap="SAP Supplier Relationship Management: Contract Monitoring" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8EA9CA274613473E952A4423F61C0424">
				<title>Contract Monitoring</title>
				<business-objective-ref Ref="51D0F9E5BAE4434CAB6D46243A09921E" ID="C74D1BA710C248DDAF3E4C2860009C2A" OriginalMap="SAP Supplier Relationship Management: Better decisions with accurate and up-to-date information" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D221E9371C9049EFB7290A0040CEA834">
					<title>Better decisions with accurate and up-to-date information</title>
				</business-objective-ref>
				<business-objective-ref Ref="F21A5F47F283404199761C6327C3F385" ID="04EBF94C5DCD4FA0B3939396EE47B0D6" OriginalMap="SAP Supplier Relationship Management: Improved quality and accuracy" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BD926C395B0446F19E0F0479D6ACA072">
					<title>Improved quality and accuracy</title>
				</business-objective-ref>
				<process ID="91F0934A0663443FBB035587E419B7D8" OriginalMap="SAP Supplier Relationship Management: Contract Compliance Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C18D00C731594C439E7968D05619ACAB">
					<title>Contract Compliance Management</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="95D718608A8711D912D100306E055DA7" ID="36CDE6133E39440A8D551366449E282A" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Monitoring Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="671F6FCE6E4B4FC99576AAEA94C24976">
						<title>Monitoring Contracts</title>
					</process-ref>
					<short-description>
       Monitoring compliance through alerts on target value/target
quantity against released value/released:
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
						<ul class="noindent" xmlns="http://www.w3.org/TR/REC-html40">
							<li>
         All the purchase orders and invoices created against all the
contracts in SRM and ERP systems
         <br></br>
							</li>
							<li>
         All the purchase orders and invoices created with all the
suppliers in SRM and ERP
         <br></br>
							</li>
							<li>The product categories created in SRM and ERP systems</li>
						</ul>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="BAB6E2F011B641D0AD3602774AB0B4E5" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="77F5570AB1B146A0AD35A061CE308BF5">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="175EC6C5DE2E4D08BEE17E53F37F55FB" OriginalMap="SAP Supplier Relationship Management: Monitoring Expiration of Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="006E181BD5BD4CA3BEAAD1B43CCC14B7">
					<title>Monitoring Expiration of Contracts</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="95D718608A8711D912D100306E055DA7" ID="E5A776313A1F4353A762055EF8BF932A" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Monitoring Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="066AB57C9A724FB396C4493F3842B5C8">
						<title>Monitoring Contracts</title>
					</process-ref>
					<short-description>More meaningful and accurate alerts with enhanced control of the
alert trigger for expiring contracts, the relationship between the
target and the released value, and the relationship between the
target and the released quantity. Accordingly, the necessary
categories can be better considered.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="9027B7E56C9B48C88D3FF58550D0BB25" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="530D363680CB4387A68E41AC690BE193">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="D71176A3D018428ABA8DF7CE88A846D6" OriginalMap="SAP Supplier Relationship Management: Maverick Buying Analysis" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="83B0D95C257A4A6B8EB35D363B87BDA4">
					<title>Maverick Buying Analysis</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="95D718608A8711D912D100306E055DA7" ID="69917B85D8A44EFEB2E65C85660756C6" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Monitoring Contracts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="95A16F21BCB3443FB7AF7F35AE0FDA6A">
						<title>Monitoring Contracts</title>
					</process-ref>
					<short-description>There is also a report where you can view the volume of spend
released from purchase orders that were created with no reference
to a contract.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="9495D979F3384243BABCEE278DE15BC9" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="7226BB2B2D9C40B090BBB5FFAE51A1AF">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>
      SAP Business Information Warehouse allows purchasers to monitor
contracts by providing overview reports and sending alerts for
expiring contracts.
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
      Purchasers can evaluate target value/quantity and release
value/quantity, number of contract items and expiration dates of
released contracts. This enables a strategic purchaser to control
maverick spend that is outside of corporate contracts.
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
      Purchasers can also use BW alerts for target quantities, target
values, or validity period for contracts. Local call-offs against
distributed contracts can be monitored on individual or aggregated
level.
     </short-description>
			</level1-item>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">Contracts are one of the
most important documents in an enterprise. Your company´s contracts
are significant to daily operations, because they represent all
business relationships throughout the enterprise. To ensure that
your company gets most out of their contracts and limit risk
exposure, it has to be ensured that the contract terms and
conditions are met and that the contract is based on the approved
legal language.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">Many companies use
clauses and legal contract templates as a starting point for legal
contract authoring. The legal contract is the
legally binding contract document which is signed by both parties
and contains legal language and the terms and conditions.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">The business scenario
starts with the creation of clauses which are grouped into sections
and sections are used to create templates. After you select an
appropriate template, you can develop and finalize the legal
contract using internal and external collaboration
capabilities.</p>
				<p xmlns="http://www.w3.org/TR/REC-html40"> </p>
				<p xmlns="http://www.w3.org/TR/REC-html40">
      The finalized legal
contract can be stored in a central repository which provides
visibility to authorized users.
      <br></br>
      The strategic purchaser creates the operational contract and, if
applicable, triggers a workflow to approve the operational
contract. Upon approval, the contract can then be used as a source
of supply for upcoming purchasing requests. The operational
contract is a structured contract document with header and line
item part which is used for execution purposes.
      <br></br>
      The Operational Contract Management is the process for creating and
maintaining contracts and managing Global Outline Agreement.
Contracts that have been created can appear as sources of supply in
the system and be assigned directly or displayed as possible
selections. In the case of purchase orders, release values are
posted directly to the contract. If you are using the SAP Business
Information Warehouse (BW), you can trigger reports that generate
an overview of the contracts release value.
      <br></br>
				</p>
			</short-description>
		</level0-item>
		<level0-item ID="5762502DB3C145B59901A9265B840E28" OriginalMap="SAP Supplier Relationship Management: Collaborative Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="58CBDA5041E8465185DF1AD3C32CE2CB" modified="8/14/24 08:18:06 PM">
			<title>Collaborative Procurement</title>
			<level1-item ID="DAAA38960A634AA1AE0D864212DDB430" OriginalMap="SAP Supplier Relationship Management: Self-Service Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="59E32671A32A411692387571253E292A">
				<title>Self-Service Procurement</title>
				<process ID="6AD2E6F1258645F8A4BFB9DFA705C192" OriginalMap="SAP Supplier Relationship Management: Manual Requirements Definition" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="5199D0FA583E43D383995BC076485D08">
					<title>Manual Requirements Definition</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="BF771B3D14197A3FE10000000A114AB6" ID="840C988D9E6843E9B980248F5F5CFBA2" variantOf="70E50F59446646E6A27077293B2B0483" OriginalMap="SAP Supplier Relationship Management: Processing Shopping Carts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2726E691228F4D86A32A8484F3BF11D8">
						<title>Processing Shopping Carts</title>
					</process-ref>
					<process-ref Ref="1E0727908BE411D912D100306E055DA7" ID="3DDD153B54864A4296BEF808DEB130A3" variantOf="B7C348B5212E4FABA5B335FB5F56DA74" OriginalMap="SAP Supplier Relationship Management: Searching in Catalog Data" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="52EA2EE68BAA47DFA3B8FCAEB239F241">
						<title>Searching in Catalog Data</title>
					</process-ref>
					<short-description>There are various ways to create a shopping cart with products and
services. SRM provides different user interfaces for requisitioning
for different user groups. Casual users are assigned to the
wizard-based shopping cart with a simplified and structured
three-step navigation. The professional shopping cart can be used
by more experienced users for more complex procurement tasks,
including service procurement and limit items.</short-description>
					<content><![CDATA[
       There is even more flexible configuration possible via Customizing.
Employees can search catalogs compiled for their needs. They can
use entire shopping carts as templates, making it easy to make
repeat orders— for example, to obtain office equipment for new
members of staff.
       ]]><br xmlns="http://www.w3.org/TR/REC-html40"></br><![CDATA[
       If multiple catalogs are connected to SRM, users can perform a
cross-catalog search and obtain list of items. They can also enter
a description of their requirement or a product number from the
product master. Secretaries and assistants, for example, can shop
on behalf of their managers or a specific group of employees.
       ]]><br xmlns="http://www.w3.org/TR/REC-html40"></br><![CDATA[
       Employees can attach documents to their shopping carts, such as
pictures or a Microsoft Word document with a detailed technical
description of the item they have selected. This feature provides
managers as well as suppliers with additional information about the
request. If defined in the system settings, G/L accounts will be
assigned automatically to shopping cart items. Costs can be
distributed across cost centers, WBS-elements, and asset by
percentage , quantity and value. A budget check can also be
performed for certain account assignment objects and displayed in
the shopping cart application and during approval.
       ]]><br xmlns="http://www.w3.org/TR/REC-html40"></br><![CDATA[
       When employees have filled their shopping cart, they can either
place an order straight away or hold it for subsequent completion.
Users can check the status of their shopping cart (both the
approval status and the status of the last created document) at any
time of the workflow process. They can display basic details of the
follow-on documents by navigating directly from the graphic, even
if the documents have been created in a backend system.
      ]]></content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="FEA157107BB0406AADF46789A41E4552" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="AC2490D20F20495ABFBCC4392E938A5E">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="FC3CF20A608A4E3A92568924D850E682" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B63059388C124C7087A65D9BB2625FFF">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="6D26A8D31EDD4441A1CE3DAB3747CAD5" OriginalMap="SAP Supplier Relationship Management: Approval of Requisition" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="05AD6FC2B6F0409381A3166359EFDCB6">
					<title>Approval of Requisition</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="BF771B3D14197A3FE10000000A114AB6" ID="3326B57E05FE41E0AC7DF346E39A9974" variantOf="70E50F59446646E6A27077293B2B0483" OriginalMap="SAP Supplier Relationship Management: Processing Shopping Carts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DD194A70DEB44176ABEF24F0C6DE3E56">
						<title>Processing Shopping Carts</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">When a shopping cart is
released for ordering, the system checks whether approval is
necessary. Criteria for initiating an approval workflow can include
the product category or the total value of a shopping cart etc.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Approval processes
typically run on several process levels. Throughout these process
levels, a document can require different kinds of checks and can
involve agents with different roles, for example:</p>
						<ul class="noindent" xmlns="http://www.w3.org/TR/REC-html40">
							<li>A purchaser must complete a document lacking important
information.</li>
							<li>A specialist must check and approve technical or other
product-related information in the document.</li>
							<li>A manager must give financial approval, for example, if a
shopping cart exceeds an employees individual spending limit.</li>
						</ul>
						<p xmlns="http://www.w3.org/TR/REC-html40">
        The Universal Work List
(UWL) in addition to automatic email notification is used for
delivering workflow work items to the responsible agents. From the
UWL, the responsible agent can navigate directly to where the task
can be completed.
        <br></br>
						</p>
					</short-description>
					<content>
						<p xmlns="http://www.w3.org/TR/REC-html40">Responsibility for
approving the items of a document can be distributed among several
agents.  If they reject it, employees receive a work item,
informing them of the rejection. They can navigate from the work
item directly to the shopping cart to make changes.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Employees can add
additional approvers or reviewers to the approval process, using
the approval preview integrated in the shopping cart, the status
application, and the inbox. Adding and changing approvers is
useful, for example, if the responsible manager is away for a
period of time, as it reduces the waiting time for approval and
speeds up the procurement cycle.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">In addition to the
online approval that requires the approver to log on to the system,
processing possibilities are available that do not require logon
(offline mode), where users process the work items in an e-mail in
their usual mail client.</p>
					</content>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="6A169631FA5A48B9A79FFE9FABDE44F3" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F9CCAC692D074D70BEE360D36DA1ACB1">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="57E3663939C54F9688CAEE997115A832" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1C09383DF9184E3D8D589A2F524545B2">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="598537C49E98434A9A6834B416673189" OriginalMap="SAP Supplier Relationship Management: Goods Receipt" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8FEA61387F644D7CB16E9AE74D82426A">
					<title>Goods Receipt</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="D0561B3D15197B3FE10000000A114AB6" ID="10983641D3874D4D9E0873143A7C6120" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supplier Relationship Management: Confirming Receipt of Inbound Goods in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4622E072601D4D72A584B3D7F7D4FB47">
						<title>Confirming Receipt of Inbound Goods in SRM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="059B8C55524B4696A5892F217C65C48C" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C4B909B1AA1046358D17514E49D46C2C">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<process-ref Ref="6EBA6746CC604FBAA46BDF57BB59AFB4" ID="D1771F8CBE1041699575B331816F54E0" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Inbound Processing and Receipt Confirmation without Warehouse Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8965D4E7205040A5A73C468A1CC9F716">
						<title>Inbound Processing and Receipt Confirmation without Warehouse Management</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">When goods are delivered, a confirmation has to be created to
confirm the reciept of the goods (service).</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">In SRM, requesters can create confirmations themselves, even if
the purchase order is in the backend system. It is possible to
create express confirmations directly in the Check Status
application without having to switch to another application.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Alternatively, an internal dispatcher or shipping department can
take delivery of goods and confirm centrally. In this case, an
additional approval workflow through the requisitioner is possible.
Then, the goods receipt is posted in the backend system.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Once employees save the confirmation it is sent to their
responsible manager for approval.  In the same way, if the
confirmation is created by the supplier and sent via XML to the
system, a work item is sent to the requester for approval.</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="1860A23E0BB54F4BBE426802154B7AC2" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6EB06A43A891492BA90712A8A68499D4">
						<title>SAP Industry Package</title>
					</product-ref>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="6F65B721D3B74410B649345FEFA68C4D" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8552C068C66C4D289265AE620E7EA9A2">
						<title>SAP ERP</title>
					</product-ref>
				</process>
				<process ID="BDC8CCE9AD7C4611A60FB6EC06525042" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="4CA91AFAA4F8446B9149D935153567F4">
					<title>Invoice Processing</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="D6BE030A1F11489EA60E38F22C33A494" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="06C43E33F5E44A75B9A0A0C4CF4E95FD">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="649349419F709979E10000000A114AB6" ID="E1B991473AC447F9B8E6FB0798464648" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Verifying Logistics Invoices in Background" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9DA107EDC97E46EFAA1F86F5B21B6D98">
						<title>Verifying Logistics Invoices in Background</title>
					</process-ref>
					<process-ref Ref="3A99623C19545D6FE10000000A114AB6" ID="47BEA625B0A149B9B913DAABE0473878" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Verifying Logistics Invoices online" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="261253D8AC4C4DEFA065563BF80A09FA">
						<title>Verifying Logistics Invoices online</title>
					</process-ref>
					<process-ref Ref="408CFAF08A7811D912D100306E055DA7" ID="D6F77D2E11934EE2A2738346DB6142EF" variantOf="349429CA3F974BACAA4A23767BF3637E" OriginalMap="SAP Supplier Relationship Management: Processing Invoices in SRM using IMS" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="01042DC545964A10B29416796402C912">
						<title>Processing Invoices in SRM using IMS</title>
					</process-ref>
					<short-description>
       You can use this business process to display and process invoices
both in SAP Enterprise Buyer (SAP EBP) and SAP Supplier
Self-Services (SAP SUS).
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       As supplier or service provider, all invoices that you enter or
process in SAP Enterprise Buyer must be approved by a responsible
internal employee. For goods and services with a low purchase
value, invoices and credit memos can also be created without a
purchase order reference. Moreover, it is also possible to create
express invoices in the check status application.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       In SAP Supplier Self-Services (SAP SUS) invoices can be entered
with reference to a purchase order, shipping notification, or
contact person before they are sent to the customer.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       If, following a purchase order, the goods supplied or the service
provided turn out to be defective or the price charged is too high,
you as an internal employee, supplier, or service provider, can
enter and process credit memos or subsequent debits/credits in SAP
Enterprise Buyer.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="10662270F04A4315B199461B80177CD1" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="0A9D3626116742BDA2E8B4200666CC81">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="6EBE01830C4546CE89AE698B01B98250" OriginalMap="SAP Supplier Relationship Management: Analyzing Self-Service Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="5BE6C9CDA12E44189B6667D2755E04E4">
					<title>Analyzing Self-Service Procurement</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="BA790EF0FFAA11DA12D100306E055DA7" ID="CC54E8CD64294F51A5DE81E68E164D0F" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Analyzing Self-Service Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="FACB7C67409C4820A3F7FAB77A46AA89">
						<title>Analyzing Self-Service Procurement</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to analyze self-service
procurement from different aspects. SRM delivers a number of
reports focusing especially on this area. Based on best business
practice, the reports can be immediately deployed, or they can be
used as a starting point to define customer designed reports.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">The user can monitor self-service procurement through the entire
procurement process, and especially focus on analyzing shopping
carts and the purchasing from different organizational units and
requisitioners.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">A complete list of all queries available in the standard is
provided under service.sap.com/srm-inst. Choose Self-Service
Procurement in column Area.</p>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="42D982B46E86470788541234E8387231" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="82B0B79568BF41A3B529C8C7EEABED56">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>Your employees can use this business scenario to create and manage
requisitions. This relieves your purchasing department of a huge
administrative burden while making the procurement process both
faster and more responsive.</short-description>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="5ED87DDD8B4D40F6AC9143D2C744BCC6" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C0284877E3214E228A7E10A17F77D3BE">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="3C0E414BC17D4521B31CEF00DF11E0D2" OriginalMap="SAP Supplier Relationship Management: Increase collaboration (internally &amp; externally" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="293C2CBFD0B54F55951EA96DF3475375">
					<title>Increase collaboration (internally &amp; externally</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="F81D92CE5A24463089D88F9CD5923B15" OriginalMap="SAP Supplier Relationship Management: Services Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1128721032EF419E927593474461F464">
				<title>Services Procurement</title>
				<process ID="70740C99D5C7498FB45D75D48AF44B10" OriginalMap="SAP Supplier Relationship Management: Service Request Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="06F077002EE74811B7EAF73568C88C30">
					<title>Service Request Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="A252ACA0277644D88C6C1BB3895B591A" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BF99CC1465434311BEAA11C76BC28DFC">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="AD6D6740E7A12D45E10000000A114AB6" ID="0F61927AA18A41C8AADB4DA4CF1B8B98" variantOf="70E50F59446646E6A27077293B2B0483" OriginalMap="SAP Supplier Relationship Management: Requesting external staff" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C660FBB9FC4341559A17E6927E110275">
						<title>Requesting external staff</title>
					</process-ref>
					<process-ref Ref="BF771B3D14197A3FE10000000A114AB6" ID="FC5B8C6A30E443BEBDF474644790B638" variantOf="70E50F59446646E6A27077293B2B0483" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Shopping Carts" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="15B87B9B059945A3AF0AD1BE043B9102">
						<title>Processing Shopping Carts</title>
					</process-ref>
					<short-description>
       In order to collaborate on service specifications with a supplier,
Service Procurement allows you to send a request for a service to
suppliers before actually ordering. This request for proposal (RFP)
process enables you to find the best or quickest possible available
service agent.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       You can specify the requirement using various criteria, for example
a description of the required service, the number of service agents
and the names of the specific service agents, when you already know
them.. Documents, attachments, and skill competencies can be added
to the request and within the same, limit items and lump sums can
be defined to cover additional costs such as e.g. expenses.. Also,
a precise response time can be determined where time-critical
processes are involved. Furthermore, the service supplier can be
specified here. To ensure that the requesters are in line with the
contracts negotiated by the purchasing department, it is only
possible to assign suppliers for which a source of supply can be
found. Several suppliers can be selected for one request. Reporting
and analytical data is provided to simplify decisions pertaining to
the assignment of suppliers. This closes the gaps between strategic
tasks done by a purchaser and the operational work by requestors.
Suppliers can send a reply, in which they enter or change a service
agent, change the amount of single items, or delete items
completely. The replies can be checked and compared in the Check
Status application. The most suitable offer can then be ordered and
the system sends a rejection to all other suppliers. If posting a
request for proposal (RFP) is not required, SAP Enterprise Buyer
offers an easy-entry screen with service-specific fields for
temporary labor and consulting services. The easy-entry screen
allows both comfortable and flexible procurement of services.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D67C65C8019E42CE89859D1D2B768495" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1844836492A94EEAA592396CF63EA8FF">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="3DD32A0132EE4E7683F5E0FB53FF1F42" OriginalMap="SAP Supplier Relationship Management: Integrated Requisition Creation - Materials Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="04DAD6A2758E4817BB3590E6B33136E0">
					<title>Integrated Requisition Creation - Materials Management</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="DF890975CC7041A2954A4A5A243C3E19" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="216AF27B3A21459982E8E7743AA07E27">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>
       With the integration of Materials Management SAP Supplier
Relationship Management (SRM), it is possible to process demand
originating out of Materials Management systems further in SRM.
This integration allows you to utilize the benefits of SRM and to
optimize supplier collaboration and communication using SAP
Supplier Self-Services also for maintenance demand.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The requester creates a requisition in the Materials Management
system to get a service done. He can determine required external
services and materials using master data or free text description.
These items can be structured hierarchically.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       After releasing the requisition it is then transferred to SRM,
where purchase orders can be either automatically created or the
demand can be manually processed and sourced. All sourcing
capabilities can be used for the maintenance demand.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The purchase order is sent to the supplier either via XML, EDI,
fax, e-mail or by using SAP Supplier Self-Services. Processing the
purchase order via SAP Supplier Self-Services, the supplier can
accept or reject the purchase order. He has the possiblity to add a
comment and change service date, quantity and prices.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       After execution of the services and/or delivery of the goods, the
supplier enters actual performed services and actual consumed
materials. The requester gets a work item in his inbox to approve
or reject the confirmation.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       After the invoice is created, the maintenance order is updated with
actual costs from the invoice.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="99FA27534CD54C718C12FA377F736982" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8309684E44564C65AA55C3C217472ABF">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="00DE74B5AA3749EB88D9323F6CF197F0" OriginalMap="SAP Supplier Relationship Management: Service Delivery Entry" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="EFA4F2508DB94C0EB8DD543C0EB2FD55">
					<title>Service Delivery Entry</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="97E86B403DBB2C45E10000000A114AB6" ID="4BA596FD07C24E54B6152A17C121948A" variantOf="79B889EC3D824CB6AD2F2AA5EDA92D5C" OriginalMap="SAP Supplier Relationship Management: Entering Services in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2C4E6564D8BC442FAB5908F6557AE11F">
						<title>Entering Services in SRM</title>
					</process-ref>
					<short-description>
       When services are rendered, a confirmation has to be created.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       According to the purchasing policies on the degree of supplier
integration, you can choose two ways of creating a confirmation.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The first option is to transfer the workload of entering a
confirmation to the supplier or the respective service agent. In
this case the service agent can enter his working hours into a time
sheet and can add all additional costs that occurred during the
service performance. The confirmation can be partial or in total
and is, after it is saved, sent to the requestor via XML.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The second option is that a clerk in the buying organisation enters
the performed times and expenses according to a information given
by the service agent.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Once the clerk saves the confirmation it is sent to their
responsible manager for approval. In the same way, if the
confirmation is created by the supplier and sent via XML to the
system, a work item is sent to the requester for approval.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The service entry form within the confirmation allows detailed
specification of limit items such as expenses and overtime. Items
can either be added in free text form, from a catalog or from
master data. Time recording for these items is also possible if
required.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="F27412566F7E45C78294850BA6962628" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8E2C6DD246DE4AC6898C6DDA5E439211">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="170B3BD7B6394E7BAAFCC4FC9D452827" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="31FF1FC739BF4C30A98F62EF77D6C2A2">
					<title>Invoice Processing</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="68D764C5407E4E4A9D49C2A06EA089CF" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DFAF1D6950A444D2941784E28A27294C">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="649349419F709979E10000000A114AB6" ID="DB64A2066CFD40F59EB0378F6623C0F2" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Verifying Logistics Invoices in Background" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D731D1196C884F6CA60B194FC4C6D8D6">
						<title>Verifying Logistics Invoices in Background</title>
					</process-ref>
					<process-ref Ref="3A99623C19545D6FE10000000A114AB6" ID="B63370B5AE27423199AF743FC6FCB5D8" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Verifying Logistics Invoices online" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CCAF712DE08645A9A77699001D03018E">
						<title>Verifying Logistics Invoices online</title>
					</process-ref>
					<process-ref Ref="408CFAF08A7811D912D100306E055DA7" ID="A97D22F1D03B44FF91B97B126E3AAF68" variantOf="349429CA3F974BACAA4A23767BF3637E" OriginalMap="SAP Supplier Relationship Management: Processing Invoices in SRM using IMS" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="14A273A51DB144798F6829BFFA49D982">
						<title>Processing Invoices in SRM using IMS</title>
					</process-ref>
					<short-description>
       You can use this business process to display and process invoices
both in SAP Enterprise Buyer (SAP EBP) and SAP Supplier
Self-Services (SAP SUS).
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       As supplier or service provider, all invoices that you enter or
process in SAP Enterprise Buyer must be approved by a responsible
internal employee. For goods and services with a low purchase
value, invoices and credit memos can also be created without a
purchase order reference. Moreover, it is also possible to create
express invoices in the check status application.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       In SAP Supplier Self-Services (SAP SUS) invoices can be entered
with reference to a purchase order, shipping notification, or
contact person before they are sent to the customer.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       If, following a purchase order, the goods supplied or the service
provided turn out to be defective or the price charged is too high,
you as an internal employee, supplier, or service provider, can
enter and process credit memos or subsequent debits/credits in SAP
Enterprise Buyer.
      </short-description>
					<process-ref Ref="BDC8CCE9AD7C4611A60FB6EC06525042" ID="084C17C6AA6E485C80780656EA33183E" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CA2AC6E10659486C847D22F4806E916E">
						<title>Invoice Processing</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="5372241D3430420EB89D54A83E095479" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2DC4AF7E25C24F6CB1325000687B083C">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="173842EAD6E54D688791833F6BF30B9B" OriginalMap="SAP Supplier Relationship Management: Analyzing Services Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E71751BD729C4180B5136B0696012E3E">
					<title>Analyzing Services Procurement</title>
					<sap-cover>1</sap-cover>
					<short-description>
       You can use this business process to analyze service procurement
from different aspects. SRM delivers a number of reports focusing
especially on this area. Based on best business practice, the
reports can be immediately deployed, or they can be used as a
starting point to define customer designed reports.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The user can monitor service procurement through the entire process
requisitioning or creation of shopping cart, the issue of purchase
orders, confirmation and invoicing. The system provides you with,
for example, status reports for procurement, showing the status for
each individual procurement document. You can also choose to work
with exception reports, focusing only on items which need special
attention.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       A complete list of all queries available in the standard for
NetWeaver 2004s is provided under service.sap.com/srm-inst. Choose
Self-service, plan-driven and service procurement in the column
Area.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="3E0283D0E4874CC9951974F360A8195F" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2E338391BADD4AF1AB96B6B45BEA75BF">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>You can use this business scenario to cover the entire service
procurement process. The process starts when you create a request.
Next, the purchase order is created. Times and expenses are entered
in the system. Then, the invoice is entered. You can integrate your
suppliers into the procurement process by connecting a supplier
system like Supplier Self-Services to your procurement system. This
way, your service providers can enter services performed and create
invoices for these services. All documents created by your
suppliers have to be approved by an internal employee.</short-description>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="A0958C7E956F4558B478AB9995775C6B" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="47F8640C8B714CEA8EA2E0BEAE855B61">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="EC4D9FB3D57345B792ED7A684B242AB8" OriginalMap="SAP Supplier Relationship Management: Increase collaboration (internally &amp; externally" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9782E2180D524482A5412294658AFF2A">
					<title>Increase collaboration (internally &amp; externally</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="AD968B266EAA4777A4F8E60581445313" OriginalMap="SAP Supplier Relationship Management: Direct / Plan-Driven Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="A2088A99DB0D42CBACECC4663271D7B0">
				<title>Direct / Plan-Driven Procurement</title>
				<process ID="2B23DD984189417BB5BB67B003506114" OriginalMap="SAP Supplier Relationship Management: Planned Requirements Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="892AD56F93B8416BA17E7229C58E4324">
					<title>Planned Requirements Processing</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="F2FC404A2A5A4B4BB15AFD57EF199221" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="82CEEDC5F9C44786B925E473484D51AE">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="CCDC0D4186867001E10000000A114AB6" ID="0FCA0D5D3F7645BFAC69CA973AFD90DA" variantOf="70E50F59446646E6A27077293B2B0483" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Purchase Requisitions in ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CE6EDDC825634B3097401500E17EC537">
						<title>Processing Purchase Requisitions in ERP</title>
					</process-ref>
					<short-description>
       After a requirement has been successfully created and transferred
from an external system, such as PM, PS or MRP, the requirement can
be processed in SRM and a Purchase order can be generated.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       SRM offers numerous functions to maintain incomplete requirements
and Purchase Orders. Supplier can be specified either manually or
by searching for source of supply. If no source of supply exist the
the purchaser can utilize direct integration to the RFx/Auctioning
process to identify a new source of supply.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       If the purchase order is complete, it can send it to the vendor who
will enter it and issue a purchase order response.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       For each product category in the shopping cart or external
requirement, you can define where the individual documents are to
be created (either locally in the Enterprise Buyer system or in the
backend system).
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The process is fully supported by SAP Workflow to secure compliance
and efficiency in procurement process.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="967619031D7C4FDA8524C5242703E909" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3F8266673B3C42828055055FDC856FCE">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="F3A5378F4A0B431F9141D72E4466F183" OriginalMap="SAP Supplier Relationship Management: Goods Receipt" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="CC4C40EC516D4FC8817ACF72EF88F30B">
					<title>Goods Receipt</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="D0561B3D15197B3FE10000000A114AB6" ID="06E6C9488D7549F1869A1D1C46AA4E37" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" OriginalMap="SAP Supplier Relationship Management: Confirming Receipt of Inbound Goods in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="7BF916C8FE1B4C1892AA9E0916AB0E6F">
						<title>Confirming Receipt of Inbound Goods in SRM</title>
					</process-ref>
					<process-ref Ref="0D524E6A3D7C4A53B6121D291A6BFA52" ID="CEF76702375B4528B0CCF67E71D0D7EF" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Inbound Processing and Receipt Confirmation with Warehouse Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="41EE7F3C95254894A29E7BAB1A278F8A">
						<title>Inbound Processing and Receipt Confirmation with Warehouse Management</title>
					</process-ref>
					<process-ref Ref="6EBA6746CC604FBAA46BDF57BB59AFB4" ID="F55D248E3A514902A73FCEAB901B5860" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Inbound Processing and Receipt Confirmation without Warehouse Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3737D36CA05840ED8D666C5E4747EF05">
						<title>Inbound Processing and Receipt Confirmation without Warehouse Management</title>
					</process-ref>
					<short-description>
						<p xmlns="http://www.w3.org/TR/REC-html40">When goods are delivered, a confirmation has to be created to
confirm the reciept of the goods (service).</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">In SRM, requesters can create confirmations themselves, even if
the purchase order is in the backend system. It is possible to
create express confirmations directly in the Check Status
application without having to switch to another application.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Alternatively, an internal dispatcher or shipping department can
take delivery of goods and confirm centrally. In this case, an
additional approval workflow through the requisitioner is possible.
Then, the goods receipt is posted in the backend system.</p>
						<p xmlns="http://www.w3.org/TR/REC-html40">Once employees save the confirmation it is sent to their
responsible manager for approval.  In the same way, if the
confirmation is created by the supplier and sent via XML to the
system, a work item is sent to the requester for approval.</p>
					</short-description>
					<process-ref Ref="598537C49E98434A9A6834B416673189" ID="66D0C67FD25E46C4B30A6F1F41A3E5F9" OriginalMap="SAP Supplier Relationship Management: Goods Receipt" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="9013AA9F105C4B29886869CB5A8AD16F">
						<title>Goods Receipt</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="345E668E31F24022BE45B0AC1D14D554" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="31B23D0C619146968F66584E3AF736C4">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="72E148F9659F4D5A92E6479386253791" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="20FFAF09A95C4584B967BB91CF42DEF2">
					<title>Invoice Processing</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="47F8F99676D34007AD52077AD63AB168" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B512E4F9DAF445A49AF3CD0B92385F1C">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="649349419F709979E10000000A114AB6" ID="B2D81527A2D34B2399F3FF5B34A578A8" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Verifying Logistics Invoices in Background" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F752A27DD6FF4547BD3B13C01CADDB37">
						<title>Verifying Logistics Invoices in Background</title>
					</process-ref>
					<process-ref Ref="3A99623C19545D6FE10000000A114AB6" ID="C95C01B610B9492494748170878CCCA7" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Verifying Logistics Invoices online" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="39B36619B6854E5A89CDA93CD02E665E">
						<title>Verifying Logistics Invoices online</title>
					</process-ref>
					<process-ref Ref="408CFAF08A7811D912D100306E055DA7" ID="D83ACA69BF6E4D33BF44C4131D24A5E8" variantOf="349429CA3F974BACAA4A23767BF3637E" OriginalMap="SAP Supplier Relationship Management: Processing Invoices in SRM using IMS" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="94271DF9AA2E4EA7B65544A2D29CB5D6">
						<title>Processing Invoices in SRM using IMS</title>
					</process-ref>
					<short-description>
       You can use this business process to display and process invoices
both in SAP Enterprise Buyer (SAP EBP) and SAP Supplier
Self-Services (SAP SUS).
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       As supplier or service provider, all invoices that you enter or
process in SAP Enterprise Buyer must be approved by a responsible
internal employee. For goods and services with a low purchase
value, invoices and credit memos can also be created without a
purchase order reference. Moreover, it is also possible to create
express invoices in the check status application.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       In SAP Supplier Self-Services (SAP SUS) invoices can be entered
with reference to a purchase order, shipping notification, or
contact person before they are sent to the customer.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       If, following a purchase order, the goods supplied or the service
provided turn out to be defective or the price charged is too high,
you as an internal employee, supplier, or service provider, can
enter and process credit memos or subsequent debits/credits in SAP
Enterprise Buyer.
      </short-description>
					<process-ref Ref="BDC8CCE9AD7C4611A60FB6EC06525042" ID="02A566A494744B54A9A226290669E754" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BD4D77CC91BD40C7B091B25A39931CE0">
						<title>Invoice Processing</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="BD96ADBD240242B0A5C993D246B8B314" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="64955A328FA142B9B2E754173749526F">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="351309EDC8A941419E97C56BCA3870E9" OriginalMap="SAP Supplier Relationship Management: Analyzing Plan-Driven Procurement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="6A464A0399F747739DDC458B54E8D94C">
					<title>Analyzing Plan-Driven Procurement</title>
					<sap-cover>1</sap-cover>
					<short-description>
       You can use this business process to analyze plan-driven
procurement from different aspects. SRM delivers a number of
reports focusing especially on this area. Based on best business
practice, the reports can be immediately deployed, or they can be
used as a starting point to define customer designed reports.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The user can monitor the procurement through the entire process,
from requisitioning, issue of purchase orders, goods receipt and
invoicing. The system provides you with, for example, status
reports for procurement, showing the status for each individual
procurement document. You can also choose to work with exception
reports, focusing only on items which need special attention.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="97D502CDAB2346A895624B4151CC4645" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="038984A2DFC84320A8695FDCCFEE6732">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>You can use this business scenario to procure requirements that
have been generated in systems other than SAP Supplier Relationship
Management (external systems). By integrating the SRM system with
planning, design, and maintenance systems, you can accelerate your
procurement and integrate the operational procurement with your
Supply Chain Management solution. The business scenario supports
the special procurement form third-party order processing. Here the
product goes directly from the supplier to the customer of the
purchasing company. The purchase order to the supplier contains the
necessary information for this.</short-description>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="C3BACA71B0E1442C84CCF565116972F7" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3E4A2333F6FA4F2DA5237252D6EFB60B">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="954C5DFAE6294936904966284FAB50EE" OriginalMap="SAP Supplier Relationship Management: Increase collaboration (internally &amp; externally" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2BEA0777EE62499F8F3077F4DF400257">
					<title>Increase collaboration (internally &amp; externally</title>
				</business-objective-ref>
			</level1-item>
			<short-description>
     Collaborative Operational Procurement covers the purchase of goods
and services for indirect (maintenance, repair, and operations) and
direct (production) materials.
     <br xmlns="http://www.w3.org/TR/REC-html40"></br>
     With SAP SRM, the process is decentralized, but the purchasing
organization centrally creates the controls that manage the
process, roles, and sourcing objectives.
     <br xmlns="http://www.w3.org/TR/REC-html40"></br>
     You use roles to assign the activities that internal employees or
external business partners perform in a business scenario. You can
use contracts to control spend and enforce compliance at individual
plant locations. SAP SRM integrates operational procurement with
planning, maintenance, project, and order-processing systems to
requisition and source materials for key business processes.
     <br xmlns="http://www.w3.org/TR/REC-html40"></br>
     This section outlines the various functions within Operational
Procurement, including:
     <br xmlns="http://www.w3.org/TR/REC-html40"></br>
				<ul class="noindent" xmlns="http://www.w3.org/TR/REC-html40">
					<li>Self-Service Procurement</li>
					<li>Services Procurement</li>
					<li>Plan-Driven Procurement</li>
				</ul>
			</short-description>
		</level0-item>
		<level0-item ID="556BE0C2C8FD4F61B4D86A08C924393F" OriginalMap="SAP Supplier Relationship Management: Supplier Collaboration" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D062F0366EAB4D92AB42A03AE7D536D6">
			<title>Supplier Collaboration</title>
			<level1-item ID="C383AB0764FF48798C06ACD010F1C87F" OriginalMap="SAP Supplier Relationship Management: Web-based Supplier Interaction" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DF631425396E46288E713E48D023DDAF">
				<title>Web-based Supplier Interaction</title>
				<process ID="6D2370FA66EB4BBD88797420FCA8BD89" OriginalMap="SAP Supplier Relationship Management: Order Collaboration" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3EE34E9F9A9949308760DA079A9E23DB">
					<title>Order Collaboration</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="523C6C40D8332D45E10000000A114AB6" ID="EB9E6AE9F359437788B38B8208C44662" variantOf="F4429AFA6B874036B36A25BF9975643B" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Sales Orders in SRM-SUS" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="597AB9162A4A4AC39F678857B05CEA98">
						<title>Processing Sales Orders in SRM-SUS</title>
					</process-ref>
					<process-ref Ref="DF7E504175217101E10000000A114AB6" ID="AFF04AEB845F4AB69BF54F41F1D21D74" variantOf="649826BE29E94C56A3AD29EB76FDE408" OriginalMap="SAP Supplier Relationship Management: Processing Delivery Schedules" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2423BC81C38B463BA6D9A170A211E881">
						<title>Processing Delivery Schedules</title>
					</process-ref>
					<short-description>
       Order collaboration enable your purchasing department to
collaborate directly with the supplier regarding purchase orders
and order responses. The suppliers can receive your purchase order
and create the purchase order response. Partial deliveries are
supported as well as advanced shipping notifications in an easy to
use web interface.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Shipping notifications can also be created directly by the
supplier. In the area of Service Procurement this process also
supports service orders and allows your purchasing department to
request for external staff and check the availability of the
required resources.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Alerts for new PO, unacknowledged PO and changed PO and a print and
download functionality makes the order collaboration more flexible
and efficient.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="FF714FD501774FECA341F30F2DDA4901" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E478D34F0E734B52A96E42AC2FB9CC27">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="75CC67F6B1A84362866153B98E786253" OriginalMap="SAP Supplier Relationship Management: Design Collaboration" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="EBF33317FF1F481699E6625C7692B4CD">
					<title>Design Collaboration</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="D07C40D08BD111D912D100306E055DA7" ID="014868CFA54249FCB64BBD9B734BD2AE" variantOf="50960CEBFA6349298F469554B9B3111C" OriginalMap="SAP Supplier Relationship Management: Processing Collaborative Bidding Events Using cFolders" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D54E9DB8F3714413986B447478A16B91">
						<title>Processing Collaborative Bidding Events Using cFolders</title>
					</process-ref>
					<short-description>
       Design Collaboration covers:
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Document Versioning - A wide variety of objects/documents can be
assigned to any folder, including office documents or CAD drawings.
The version control mechanism ensures that all collaboration
partners can track the change history of a document.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Document Handling - Allows you to edit directly all file types
supported by a front-end PC. Checked-out documents are stored in
the list of favorites. Documents are locked during
check-in/check-out.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Redlining &amp; Markups - The integrated ECL viewing capabilities
allow the markup or redlining of 2D and 3D drawings.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Integration into RFX Processes - Before initiating a request for
quotation (RFQ), a purchaser can create a collaboration within
cFolders and invite engineers to add product specifications.
Suppliers can access the product specifications in cFolders
directly, via a link in SAP Bidding Engine. 
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       When creating a bid, private supplier areas are automatically
created in cFolders, where specific product information can be
stored. All, engineers, purchasers, and suppliers can collaborate
together on the content of the bids. Finally, purchasers and
suppliers can evaluate incoming bids together.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       During creation of an opportunity, purchasers can add attachments
to specify their product description. The initiator can also add
dynamic attributes (flexibly maintained fields to allow for
additional information when needed). These attributes are created
in advance by the administrator and are company specific. A
purchaser can also ask suppliers to submit plant-specific
conditions.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="5A4F07645BDA4305A9905AD8D40C9154" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="39AB980E84824D46BA6344C9788B4DBC">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="0EEBE86E10BE40C6B294011925BE3E4F" OriginalMap="SAP Supplier Relationship Management: Confirmation" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="89F112C056314A598C9C2736F3E29A2B">
					<title>Confirmation</title>
					<process-ref Ref="CB3E6C40D8332D45E10000000A114AB6" ID="5AE2399C757C4876894496A6C3996F0D" variantOf="F4429AFA6B874036B36A25BF9975643B" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Shipping Notifications" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2E8A18B514BB43078E1789FFD0B98D5A">
						<title>Processing Shipping Notifications</title>
					</process-ref>
					<process-ref Ref="D0561B3D15197B3FE10000000A114AB6" ID="850B055CF9CC4E18A83F21CE72D120A4" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Confirming Receipt of Inbound Goods in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="FF65123DBB904B2ABF29150C196354D9">
						<title>Confirming Receipt of Inbound Goods in SRM</title>
					</process-ref>
					<process-ref Ref="97E86B403DBB2C45E10000000A114AB6" ID="65EF0B1B657D432B87563AC5EE44B7D7" variantOf="79B889EC3D824CB6AD2F2AA5EDA92D5C" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Entering Services in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="23C94BDDD1104CCEA2A008A9F1AA2D8C">
						<title>Entering Services in SRM</title>
					</process-ref>
					<sap-cover>1</sap-cover>
					<short-description>Suppliers can use this process to create, edit and send
confirmations. Confirmations can be created for indirect items,
direct items as well as services. In the case of services a Time
Entry sheet is available to enter the quantity, dates and times of
the services provided.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="830109FDB97441E4B1F682E5DCD32D11" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="83FF80D9DB0F4F97B79527E299CD0651">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="800CBE201E72473D827DF2991E505CFE" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="74E7E177CB7942789FA14544A2986CE3">
					<title>Invoice Processing</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="DFF705AEAA3E446C9A96329586D6DD85" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1F4610C4D78747CD9AC61C5DC892AF40">
						<title>SAP ERP</title>
					</product-ref>
					<process-ref Ref="BDC8CCE9AD7C4611A60FB6EC06525042" ID="1B98D5B4B8074C55BB8BE3F42F03D5B0" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="130A879520E34F6092B6096334659C2E">
						<title>Invoice Processing</title>
					</process-ref>
					<process-ref Ref="72E148F9659F4D5A92E6479386253791" ID="B75B71AA86EE438CA23F1F2F6F436209" OriginalMap="SAP Supplier Relationship Management: Invoice Processing" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="7500D131416447BA9C709D7ED67A5FEE">
						<title>Invoice Processing</title>
					</process-ref>
					<short-description>
       You can use this business process to display and process invoices
both in SAP Enterprise Buyer (SAP EBP) and SAP Supplier
Self-Services (SAP SUS).
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       As supplier or service provider, all invoices that you enter or
process in SAP Enterprise Buyer must be approved by a responsible
internal employee. For goods and services with a low purchase
value, invoices and credit memos can also be created without a
purchase order reference. Moreover, it is also possible to create
express invoices in the check status application.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       In SAP Supplier Self-Services (SAP SUS) invoices can be entered
with reference to a purchase order, shipping notification, or
contact person before they are sent to the customer.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       If, following a purchase order, the goods supplied or the service
provided turn out to be defective or the price charged is too high,
you as an internal employee, supplier, or service provider, can
enter and process credit memos or subsequent debits/credits in SAP
Enterprise Buyer.
      </short-description>
					<process-ref Ref="93FFD3A2AD57463EA141190ED100115F" ID="7D9DE8DA7BD2434CBBEB2376571A6CD0" OriginalMap="SAP Supplier Relationship Management: Invoice Communication" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B6BD80D5BB0A47A3BAD9F516C83FD6B4">
						<title>Invoice Communication</title>
					</process-ref>
					<process-ref Ref="54B12B3D3FE7793FE10000000A114AB6" ID="36F1F3D814634C869836D8406186AC0F" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Invoices in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="7EFCF47370B04477AEACEC4F20FB14EA">
						<title>Processing Invoices in SRM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="43142522683143FE91BAB6390C1FE792" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="42EE2B90FC3C4826BF1E8E465D43B830">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="212009EAE5E647C487E90DC21BC771A6" OriginalMap="SAP Supplier Relationship Management: Financial Settlement" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8E9A5E5F279046A8B03AC05A14579634">
					<title>Financial Settlement</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="C744445C70744862ABC1913965C67B7B" type="SAP" key="S12" OriginalMap="SAP Supplier Relationship Management: SAP ERP" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B050E6BEB18B458C9B90DBA4AE151B19">
						<title>SAP ERP</title>
					</product-ref>
					<short-description>Following to the ordering and receiving process, the financial side
of the transaction needs to be handled. SAP offers several
processes to increase efficiency of the financial settlement.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="CBF49E473D7B4BE09868B31CE153542B" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="BC8B710302E64416B5B32FB521C4D006">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>
      Web-based Supplier interaction covers the operational supplier
collaboration from design collaboration to financial settlement.
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
      With the design collaboration process you interact with your
supplier regarding product specifications.
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
      Order collaboration enable your purchasing department to
collaborate directly with the supplier regarding purchase orders
and order responses. Confirmation, Invoice processing and financial
settlement can also be managed in interaction with your
suppliers.
      <br xmlns="http://www.w3.org/TR/REC-html40"></br>
      The process “Supplier managed content” relieves your purchasing
department from updating the catalog content by allowing suppliers
to update their products in your catalogues.
     </short-description>
				<process ID="A941E563A2BE441F996FAC811E1C6EFB" OriginalMap="SAP Supplier Relationship Management: Supplier Managed Content" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D8B07D5C3961415E8B1BD1CF042F9E76">
					<title>Supplier Managed Content</title>
					<sap-cover>1</sap-cover>
					<short-description>You can use this business scenario to get the burdon of managing
catalog data from your own organization to the responsibility of
the supplier. This means the supplier manages catalog data content
through the usage of the SAP Enterprise Portal where he is able to
upload the catalog data to the SAP SRM-MDM Catalog.</short-description>
					<process-ref Ref="931F576302EE4AA0B7F4B4FFC75FC9DA" ID="89E096321D1B45538C5ED383BDC072AD" OriginalMap="SAP Supplier Relationship Management: Supplier Managed Content" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="018F0C813B4347E9B0C6BAFCAED18A62">
						<title>Supplier Managed Content</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="66C0EC8F10AD49729A8898DAE235C7CD" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="A5D6D2ABB5CB42BEB6E0723CA7EED7AE">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="F7CCE9FF22EE4C779303C9F54E8E7532" OriginalMap="SAP Supplier Relationship Management: Increase collaboration (internally &amp; externally" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="10624FA01A5E485B8F3E8EC760AE17EE">
					<title>Increase collaboration (internally &amp; externally</title>
				</business-objective-ref>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="78F27220E784441194794A9CC825385F" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="AD425C50AEBC41D09F809C5E96EE86E3">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="766F41938CCB4159A1E7BBFCE5D74D18" OriginalMap="SAP Supplier Relationship Management: Direct Document Exchange" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="8380D02533B04003A073FF96AF188DA4">
				<title>Direct Document Exchange</title>
				<process ID="610B0408E14646DA9A22CCD18266354D" OriginalMap="SAP Supplier Relationship Management: Order Communication" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B419E0CFA75B44A7AA22DF9AC321D9F1">
					<title>Order Communication</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="065A1B3D15197B3FE10000000A114AB6" ID="A2DE554B7187450FB0F88CA21E03EE73" variantOf="649826BE29E94C56A3AD29EB76FDE408" OriginalMap="SAP Supplier Relationship Management: Processing Purchase Orders in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="0B64B3B10CD14CB2BA2152FE0517F200">
						<title>Processing Purchase Orders in SRM</title>
					</process-ref>
					<short-description>
       Complete purchase orders can be sent to the vendor as a printout,
or by e-mail, fax, or XML (eSOA) either from SRM (extended classic,
standalone deployment) or the backend system (classic deployment).
Part of Order communication is the Supplier's possibility to
confirm the order and submit an Order Confirmation
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       The communication channel is defined in the vendor master and can
be overwritten individually in the purchasing document.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="FFB4C8B1FF5B4C96B447611774FD9C00" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="367EF12881E343AAB8054A7E2AFBD71C">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="FC25B70A2FA04B928FF219C735F23426" OriginalMap="SAP Supplier Relationship Management: ASN / Service Entry" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="39125A50E7AF4D62BFC0FE673F630BA6">
					<title>ASN / Service Entry</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="CB3E6C40D8332D45E10000000A114AB6" ID="4A53851904A44F50AE341A76961A0ADC" variantOf="F4429AFA6B874036B36A25BF9975643B" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Shipping Notifications" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D7E47D73D8174E0F8DD63401F3C59A1E">
						<title>Processing Shipping Notifications</title>
					</process-ref>
					<process-ref Ref="D0561B3D15197B3FE10000000A114AB6" ID="E544BF25C38D4E3B800E512D698D644D" variantOf="4DA3FAE72CB34A22B27C5CE0A5A08BAB" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Confirming Receipt of Inbound Goods in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="1688E7E5FFE2457FAF71FB8ADBB77536">
						<title>Confirming Receipt of Inbound Goods in SRM</title>
					</process-ref>
					<process-ref Ref="97E86B403DBB2C45E10000000A114AB6" ID="0903CB0326D742B19F9713961A9A76AE" variantOf="79B889EC3D824CB6AD2F2AA5EDA92D5C" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Entering Services in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="05F77A8195154054B9F8ADB9457BEA17">
						<title>Entering Services in SRM</title>
					</process-ref>
					<short-description>Advanced shipping notifications and service entries can be created
by the supplier and send to the purchasing organization by XML.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="A01485F6CA4541E1B60BCB9557F2BFB7" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="639E90B599B44EE89EAB4985A7DD006D">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="93FFD3A2AD57463EA141190ED100115F" OriginalMap="SAP Supplier Relationship Management: Invoice Communication" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="D7BAF996CE024DA398C7FC649DF12B5D">
					<title>Invoice Communication</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="FC25B70A2FA04B928FF219C735F23426" ID="5D7167A743EB48979F8AD3B54D2C4F7C" OriginalMap="SAP Supplier Relationship Management: ASN / Service Entry" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3B9244930E374A54B84F6D2EEF915316">
						<title>ASN / Service Entry</title>
					</process-ref>
					<short-description>Invoices (including ERS) can be sent to the vendor as a printout,
or by e-mail, fax, or XML (eSOA) either from SRM (extended classic,
standalone deployment) or the backend system (classic deployment).</short-description>
					<process-ref Ref="54B12B3D3FE7793FE10000000A114AB6" ID="A80B98A351884DF3A4D418F5DF0CE378" variantOf="349429CA3F974BACAA4A23767BF3637E" icon="technical-process-variant.gif" OriginalMap="SAP Supplier Relationship Management: Processing Invoices in SRM" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="101B606C140647C4AAED4E8E4EDA6DDA">
						<title>Processing Invoices in SRM</title>
					</process-ref>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="6630D1AA32A04132A3E35A593355CF84" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="85841509F6964ADD9CD18E3080B7C406">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>The ability to exchange any document in any format across
heterogeneous systems is a fundamental requirement for
intra-enterprise and inter-enterprise collaboration. SAP SRM
helps ensure smooth document exchange with a set of generic
adapters that facilitate messaging between SAP and non-SAP systems
– both internally and externally. This exchange helps integrate the
SAP supplier portal component fully with the operational
procurement and materials management processes used by ERP systems.</short-description>
				<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="CBDAD5AA9EC44FE5900C352FBC729A6B" OriginalMap="SAP Supplier Relationship Management: Increase collaboration (internally &amp; externally" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="21330A8FC2BB4DC39CF5074A848429C9">
					<title>Increase collaboration (internally &amp; externally</title>
				</business-objective-ref>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="9D08469497C64904931B443426723B70" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B1996601003B4E468F659CCEE53B5275">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
			</level1-item>
			<level1-item ID="3C273EB522DB4A13ACD5DD3036C20463" OriginalMap="SAP Supplier Relationship Management: Supplier Network" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="ADE7BB01318544F69DC4E1160D9EA63E">
				<title>Supplier Network</title>
				<process ID="86F573A775E8447282875BCA85E3B973" OriginalMap="SAP Supplier Relationship Management: Supplier Onboarding Services" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="3730E16695DC4735970C8707578ED563">
					<title>Supplier Onboarding Services</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="7B1563885048407DB90CCA721C4974AD" ID="38EDD9309B754457B6745515EF4EAF4A" OriginalMap="SAP Supplier Relationship Management: Document Exchange Services" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="5F93EE1AD5044B6189CAC29FACBAE01C">
						<title>Document Exchange Services</title>
					</process-ref>
					<process-ref Ref="1F6575A0A52B11D912D100306E055DA7" ID="B1129111E2104EB7891DC72D7A5ED7DC" variantOf="F4429AFA6B874036B36A25BF9975643B" OriginalMap="SAP Supplier Relationship Management: Performing Order Collaboration Using Supplier Network" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="607A21B3A52D49648CCE75000E4C4667">
						<title>Performing Order Collaboration Using Supplier Network</title>
					</process-ref>
					<short-description>Buyers will have access to Supplier Invitation tools, allowing
buyers to invite existing or new suppliers to trade with them via
the network. An e-mail will be sent to suppliers who are invited to
join the SAP Supplier Network. This e-mail gives the supplier
access to the network and enables him to register.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="7F86BEC5F21147E6BB5E7B89068BCC67" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F660A91A4C3C45A199E78AC82581AF3A">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="7B1563885048407DB90CCA721C4974AD" OriginalMap="SAP Supplier Relationship Management: Document Exchange Services" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="DCC9F9C8F7BA48A68082178A8E258F97">
					<title>Document Exchange Services</title>
					<sap-cover>1</sap-cover>
					<process-ref Ref="1F6575A0A52B11D912D100306E055DA7" ID="19288E7F4694451CB1D6A7C418EFA714" variantOf="F4429AFA6B874036B36A25BF9975643B" OriginalMap="SAP Supplier Relationship Management: Performing Order Collaboration Using Supplier Network" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F971456BB8554FB9A1472981F01C7A94">
						<title>Performing Order Collaboration Using Supplier Network</title>
					</process-ref>
					<short-description>
       Document exchange service allows purchasers of the buying
organization to send and receive purchasing documents via the SAP
Supplier Network.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       Documents that are currently covered through the document exchange
service of the SAP Supplier Network are: Purchase Order, Purchase
Order Change, Purchase Order Response, Advance Shipping
Notification, Invoice, Credit Notes.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
       It is integrated with SAP procurement systems (SAP SRM or SAP
ERP) on the side of the buyer. On the side of the supplier back-end
integration can be established.
      </short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="1DB6068B8593402EA99919C65774E3EE" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="297FABC91C2740CB936F74E5154CBAC8">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>The SAP® Supplier Network offering is a global document exchange
platform that allows buying organizations to transact business
electronically with thousands of suppliers through a single,
standards-based network connection. This offering complements the
supplier enablement capabilities of the SAP™ Supplier
Relationship Management solution by simplifying and accelerating
supplier on-boarding and by providing hosted order management for
maintenance, repair, and operations (MRO) items as well as direct
goods available through the network’s suppliers. The result is a
comprehensive, closed-loop solution for non strategic procurement
collaboration that can be implemented in a matter of weeks.</short-description>
				<business-objective-ref Ref="78D9AA2AC07440CFB4463385F7B2FB44" ID="78AB45D4D3134FC1B09744DA224150AD" OriginalMap="SAP Supplier Relationship Management: Increase collaboration (internally &amp; externally" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="968997F455F54B4C8AF2C66ADCCF8D8B">
					<title>Increase collaboration (internally &amp; externally</title>
				</business-objective-ref>
				<business-objective-ref Ref="287F51EAECBD42F9AA2A301A4125A89E" ID="20D4767A3C4143749C7446CEBD761877" OriginalMap="SAP Supplier Relationship Management: Automation and standardization of business processes" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="509456A480EB4EE6ABE077A43266DB69">
					<title>Automation and standardization of business processes</title>
				</business-objective-ref>
			</level1-item>
			<short-description>
     Use supplier collaboration capabilities to integrate with suppliers
of all sizes. Supplier Collaboration extend throughout the entire
supplier relationship lifecycle.
     <br xmlns="http://www.w3.org/TR/REC-html40"></br>
     Supplier Collaboration contains the processes and technical
capabilities to link suppliers into the buying organizations
purchasing processes.
    </short-description>
		</level0-item>
		<level0-item ID="9EB827403D824F05BECFF1865F396B3E" OriginalMap="SAP Supplier Relationship Management: Supply Base Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F49CACBAB7E84EC5928EEB69A8C3335E" modified="8/14/24 08:17:48 PM">
			<title>Supply Base Management</title>
			<level1-item ID="6D6A8F8628834C689B130DF453641794" OriginalMap="SAP Supplier Relationship Management: Supplier Development &amp; Performance Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="62B3F4DE955E4A0D91893AD7667E8DE9">
				<title>Supplier Development &amp; Performance Management</title>
				<process ID="881618D8DD8D4340A75316AFC7AC4811" OriginalMap="SAP Supplier Relationship Management: Supplier KPIs and Measure Definition" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2FA7BF010CC747EC8A75DDF338124F32">
					<title>Supplier KPIs and Measure Definition</title>
					<sap-cover>1</sap-cover>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="1520931696394C2487B9CD4187F86E0E" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="51AE788B787B4D3AA44C71E7EF52B806">
						<title>SAP Industry Package</title>
					</product-ref>
					<short-description>SAP offers different methodologies for measuring supplier
performance. The quantitative key performance indicators (KPIs),
cover areas such as delivery, reliability and compliance. The
solution automatically calculates these KPIs from the procurement
process itself. With SAP´s questionnaire tool the user can design
questionnaires for measurement of soft factors. The questionnaire
can be distributed to selected survey participants and the answers
collected and consolidated for reporting. Surveys can also be
triggered by events, like for example the registration of a
confirmation or an invoice.</short-description>
				</process>
				<process ID="547A2D11CA7940DC872F322F8D5C74BD" OriginalMap="SAP Supplier Relationship Management: Supplier Scorecard Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="36E78A3E6562403AB42FDFAB11ED4819">
					<title>Supplier Scorecard Management</title>
					<sap-cover>3</sap-cover>
					<short-description>
       Supplier scorecard management provides the ability to compare
supplier performance data with respective plan KPIs in order to
optimize the supplier portfolio. Different target are assigned to
suppliers, depending on their segment. Depending on the supplier
segment different KPI´s are relevant. They must be analyzed taking
all these factors into account.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="C95AA5C8E9CE48D8A0888E695C8E4748" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="83412032FCE8410F9F6ECF0AB01AE2FE">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="168A990B24B24D819936E28B14D291D3" OriginalMap="SAP Supplier Relationship Management: Supplier Performance Evaluation and Reporting" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="F098C5E35B914C458CC2253AD65A0ECA">
					<title>Supplier Performance Evaluation and Reporting</title>
					<sap-cover>1</sap-cover>
					<short-description>
       Supplier performance can be analyzed in SAP BI, where all data,
cross multiple system, is collected and presented in various
reports The user can get a total score for the different suppliers
and drill down to the different groups for factors such as quality,
service, and delivery. SAP offers a large variety of standard
reports, including tables and charts. By cross combining data, such
as business volume and performance score, the reports support
decisions such as phasing out a low performers versus work on
improving the relationship.
       <br xmlns="http://www.w3.org/TR/REC-html40"></br>
					</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="6DC6BB7F95164940BBACEB99904D18AC" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="2EE89F5E65CC49A28AE62294290A1F70">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="E81F697B92E5493183D4D2F9508886D2" OriginalMap="SAP Supplier Relationship Management: Supplier Audits" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="AC32D19AE50444AA9C6A7C9F832E0ABB">
					<title>Supplier Audits</title>
					<sap-cover>3</sap-cover>
					<short-description>Conducting supplier audits ensures that suppliers meet the
established product and process quality requirements. Supplier
audits drive continuous improvement and can be carried out for
both, new or established suppliers.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="9275F4F73C804CE580C2FBFC7D27E2C1" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="E14EFE2392C646B987BBCB67C7D4A029">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<process ID="28344A7E47F64E94A8CFD4E63B51AD4C" OriginalMap="SAP Supplier Relationship Management: Action Management" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="C1A16CD976D04272BEACDF5B85E16B38">
					<title>Action Management</title>
					<sap-cover>3</sap-cover>
					<short-description>After identifying a low performer the next step is to take actions
on order to improve the performance and the relationship with the
supplier. This needs involvement from various internal resources as
well as interaction with the specific supplier.  It is important
to, in a collaborative environment, set targets for improvements,
to define the responsible person, to determine a deadline and to
follow up on the action.</short-description>
					<product-ref Ref="A28CD939659742FF95D25ED9DCC7C07E" ID="D22EA47F53FD49CCAFE8A58CC77759C7" type="SAP" key="SAP Industry Package" OriginalMap="SAP Supplier Relationship Management: SAP Industry Package" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B57B7D1341F144609FB83F5863839CD1">
						<title>SAP Industry Package</title>
					</product-ref>
				</process>
				<short-description>SAP SRM Supplier Development &amp; Performance Management helps you
to analyze your supplier base and to evaluate their performance. It
supports you in making decisions and taking action in order to
improve your supplier base and to generate bottom line savings on
your procurement. SAP provides different methodologies for
performance measurements on an ongoing basis.  In SAP BI, several
reports are available to help you to analyze the result and support
you in improving your supply base.</short-description>
				<business-objective-ref Ref="18BC2AD7885641A7BDE053C9E8527036" ID="40E477AC35844EC3905C2DA95BA243F6" OriginalMap="SAP Supplier Relationship Management: Collaborate with business partners" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="AE56E71CD8AC455BB0EEED21A382BFB5">
					<title>Collaborate with business partners</title>
				</business-objective-ref>
			</level1-item>
			<short-description>With supply base management you identify new suppliers, evaluate
existing suppliers and work on improving supplier performance and
improve your supplier portfolio. With a mix of analysis and
collaboration tools you are able to measure and develop supplier
performance in a proactive way. This helps you reducing risk and
making sure that your suppliers are best in class.</short-description>
		</level0-item>
		<folder ID="0FF7C74E9B8E4B838AE20CD3202495B1" pool="true" pool-position="right" OriginalMap="SAP Supplier Relationship Management: SAP NetWeaver" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="B6F9BF1FF873401A9B87375B3FFD5CA3">
			<title>SAP NetWeaver</title>
			<referencemap ID="1CADB3F7FCB040E58FAB496D10001367" Ref="004F8486F21E4522943507897144041B" Title="SAP NetWeaver - Technology Map Edition 2007" icon="solutionmap.gif" File="SAP%20Business%20Maps/004F8486F21E4522943507897144041B.ssm" visible="true" is-pool="false" contentElementType="" OriginalMap="SAP Supplier Relationship Management: SAP NetWeaver - Technology Map Edition 2007" OriginalMapID="91A6C8EE3E694F2FA92118EC5A4C51A3" SrcID="198E02DD85394FA6B7AFD4BE2E12D673"></referencemap>
		</folder>
	</folder></solutionmap>
