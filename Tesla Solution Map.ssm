				<process ID="DACAF79A65004B7C97A7E3EE78AB5FDE" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Procurement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="DCB0642A7FDC458DB5C31A1D115BAFFC">
					<sap-cover>1</sap-cover>
					<title>Vehicle Procurement</title>
					<process-ref icon="process-ref.gif" ID="FCF2BF48BBD24398AA2BEAAD59604FED" Ref="8773EC40D72611D812D100306E055DA7" variantOf="D1287BD0D72611D812D100306E055DA7" OriginalMap="Automotive - Sales &amp; Service Organizations: Vehicle Procurement" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A210A3B7A2B7425490400A8C447C8AEF">
						<title>Vehicle Procurement</title>
					</process-ref>
					<short-description>
						<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process to manage the procurement of vehicles with your OEM (original equipment manufacturer). After selecting a vehicle you create a purchase order and therefore instruct your OEM to supply the vehicle. Once the ordered vehicle enters your grounds you create goods receipt. By processing the invoice sent by the OEM you complete this process.</P>
					</short-description>
					<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="F77F436EEC7345288C0A4D3F946F0D08" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F538F05A79C14FFEAF0D81E05EF9B198">
						<title>SAP Vehicle Management for Automotive</title>
					</product-ref>
