				</product-ref>
			</process>
			<process ID="4D85D8CF52D04AEEBE4721B5BFF59B35" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Profitability Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="1818D589C01042FBB4D86F0A53C4C787">
				<!--#!#161616#!#-->
				<sap-cover>1</sap-cover>
				<title>Customer Profitability Analysis</title>
				<process-ref icon="technical-variant-ref.gif" ID="DC206CE4D89D45D4A2B5A24EB4BABBA0" Ref="F6615E3EBDA64068E10000000A114AB6" variantOf="164D8D28E9DA48F091D9E17F59B044C0" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Profitability Analysis" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="F7081790DEFF4B91A32E47DA27A69317">
					<title>Customer Profitability Analysis</title>
				</process-ref>
				<process-ref icon="technical-variant-ref.gif" ID="9AD41C9F7058478BBA2732FA092A005D" Ref="1C19AFB3A573459FB17FF9075EB5" variantOf="164D8D28E9DA48F091D9E17F59B044C0" OriginalMap="Automotive - Sales &amp; Service Organizations: Profitability Analysis in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BA9EF2DACDC14208ACB40F1B061EAA56">
					<title>Profitability Analysis in ERP</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to calculate customer profitability, which is one of the most frequently used methods for customer valuation. Customer profitability is most easily calculated as the difference between revenue and costs. It is more useful, however, to perform detailed customer contribution margin analysis including different revenue types, product costs, marketing costs, and sales costs, to produce a differentiated picture of customer profitability.</P>
				</short-description>
				<product-ref Ref="999E64EA02ED4FD18A0BD49DFC180254" ID="CCE5CE58159B46E5AED0640878D7D34E" type="SAP" key="S12" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="636BDF91C98A475CB8986C6815222866">
					<title>SAP ERP</title>
				</product-ref>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="1266F9F51B884C3CB47236064CED0475" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="42FAC49EFBF347B6B5CBFA0BFBC6214E">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="EEECF98F95BE48EB837947D80FB6C064" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Survey Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="97687BA90FB04A66857A8075803135F7">
				<sap-cover>1</sap-cover>
				<title>Survey Analytics</title>
				<process-ref icon="process-ref.gif" ID="7A4116288C19469485C06A87C32787B5" Ref="E89E653E81623F68E10000000A114AB6" variantOf="37D977B6D3BE462D879584E5E0D2BE0F" OriginalMap="Automotive - Sales &amp; Service Organizations: Survey Analytics" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2CAF2D5B0A454C3CA0E9121B69E7D9ED">
					<title>Survey Analytics</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Uses a customer survey to determine how satisfied customers are with the products and services offered by the company, and how loyal they are to the company.</P>
				</short-description>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="76BEEF9CFD1A40D79098CBE31D21B4C9" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D83DBF3F15F440118322E91716FAB6E3">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="15A2ACBF32104BCF9793F49CF8CAD2AB" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Proposals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A67B5C115498486D8707558E253C7516">
				<sap-cover>1</sap-cover>
				<title>Product Proposals</title>
				<process-ref icon="process-ref.gif" ID="CD18E8C3D24E47C895FD4C98F928F7D1" Ref="2D86653E81623F68E10000000A114AB6" variantOf="BE8EBE6D82E44ACD850777B46B0BCC13" OriginalMap="Automotive - Sales &amp; Service Organizations: Product Proposals" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5481C43AB21E47F68EB4ACC7B254F30A">
					<title>Product Proposals</title>
				</process-ref>
				<short-description>You can use this business process to define product proposals for particular target groups or marketing profiles, meaning that the relevant product proposals are only used if the business partners selecting the product(s) belong to the given target group or match the relevant marketing profile defined in the rule.</short-description>
				<product-ref Ref="94FE6266E0364072A9462472CF7EE51A" ID="DB27BA9D5FA849F7AE63EBAA1F4D3D2D" type="SAP" key="SAP Vehicle Management for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Vehicle Management for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="316EEC9869144B13BE6E1C32D4EE1DEF">
					<title>SAP Vehicle Management for Automotive</title>
				</product-ref>
			</process>
			<process ID="CE255870F2B4481CBCBA3437546482E1" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Quotation Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FB72649EA96E41ACB8A4FD72ACA27E8F">
				<!--#!#16161616#!#-->
