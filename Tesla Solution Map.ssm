					<title>Value Collaterals</title>
					<hyperlink ID="7D0A43A63C9B4D0EADAED4BCBE859918" href="http://download.sap.com/SMIGlobal/download.epd?context=669EA7555D24A7C836486C9667E5FD5BC42735F7974897CF36D8F80C6ADFB5FB0B494D19368CE926E6946B4E4EC25F7C18A2062A13083CAD" openInSeparateBrowser="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Deutsche Steinkohle AG" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="33CE026E663E46D1AFA0EEEF435280EB">
						<title>Success Story: Deutsche Steinkohle AG</title>
					</hyperlink>
					<hyperlink ID="E662792EFC084723ACBE66AA976B9AE3" href="http://download.sap.com/SMIGlobal/download.epd?context=12D14A1F706E770F6247B0D20CA90DC8330ED5DE2AE6E0AE2D06858879B3E591180C22C0750EE331B53B99DCD87D9762E2FE7EFEBC41C3D9" openInSeparateBrowser="false" OriginalMap="Automotive - Sales &amp; Service Organizations: Success Story: Hella KGaA Hueck &amp; Co" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E77C0CA872E842C1991EE4C851080A2B">
