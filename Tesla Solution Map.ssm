			</process>
			<process ID="FB5217B1DC834FA49B50CED1E4C3EF06" businessArea="Marketing" responsibleOrgUnit="BSG M" runningNumber="CPF 046" variantOf="982D15F76DBD4FB4976FB2058048C735" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Validation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="054F98852E844E1381073B5A9EE9E8AD">
				<title>Trade Promotion Validation</title>
				<bpr-element-ref ID="1F860FA2FCAC4379AFA108110A736A04" Ref="urn:bprid#982D15F76DBD4FB4976FB2058048C735" elementname="BusinessProcess" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Validation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8BE7AB31AA2C439FA5F49ECC4ABDE1DF">
					<title>Trade Promotion Validation</title>
				</bpr-element-ref>
				<short-description>During store visits, the field sales rep also checks on current promotions to see if they are, in fact, in place and at the appropriate price. The rep also checks for distribution, placement and regular pricing conditions. The field representative also gathers information regarding the activities of competitors, especially regarding promotion execution in the store when competitors are running promotions concurrently with those of the rep's company.</short-description>
				<sap-cover>1</sap-cover>
				<process-ref ID="FBEBAA4672AC47A2BD19B43885403123" Ref="3A956C3ED392A113E10000000A114AB6" variantOf="982D15F76DBD4FB4976FB2058048C735" icon="technical-variant-ref.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Validation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="765266D981EF42D093A0183EF7CE79EC">
					<title>Trade Promotion Validation</title>
				</process-ref>
				<process-ref Ref="982D15F76DBD4FB4976FB2058048C735" ID="742FBA0B5F584BBA9F96E2730554A85C" variantOf="982D15F76DBD4FB4976FB2058048C735" OriginalMap="Automotive - Sales &amp; Service Organizations: Trade Promotion Validation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4AFBB5CDD60541C08B98E5926CC4E2EE">
					<title>Trade Promotion Validation</title>
				</process-ref>
