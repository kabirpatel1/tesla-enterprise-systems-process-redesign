				</business-objective-ref>
				<business-objective-ref Ref="34C4C771C8EE4DD1BBE3018A55729900" ID="03B7DBED026F421BA6935D6F52D4143F" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce transaction costs" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2C065ABDEF5349E28E34161A49A22B92">
					<title>Reduce transaction costs</title>
				</business-objective-ref>
				<business-objective-ref Ref="70172A73069E4B309BCCDF4E9AD11689" ID="C0434A50F9F741BA9DB9764D7DDDFEF3" OriginalMap="Automotive - Sales &amp; Service Organizations: Reduce administration, improve business processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="81D440AA205544C482DEAC30E3214554">
					<title>Reduce administration, improve business processes</title>
				</business-objective-ref>
				<business-objective-ref Ref="F6D4B713A62D41AF8077FE7ABE33E9EB" ID="66CE89128F064821AEB9A10C92D4C9DC" OriginalMap="Automotive - Sales &amp; Service Organizations: Improve recruiting, hiring &amp; HR processes" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BD8F137E218D4739835D140F6B62D0DC">
					<title>Improve recruiting, hiring &amp; HR processes</title>
				</business-objective-ref>
				<cbs-ref Ref="508EBEDAC0F74902AEAEE3AF17D417C3" ID="8B592FB2074C4FEE86E5F927AABA807D" OriginalMap="Automotive - Sales &amp; Service Organizations: Management of Global Employees: Transfer and Repatriation" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="0EC80BB079BA4BF380FA6589E5B4DCE7">
					<title>Management of Global Employees: Transfer and Repatriation</title>
				</cbs-ref>
				<cbs-ref Ref="CFBD83BD873747F2BAC865CDFAA02ADD" ID="F0C0F819147841A0A6387C7F2298F96B" OriginalMap="Automotive - Sales &amp; Service Organizations: CATS: Recording Working Times with additional Data" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="5A1D3B8D88A445028DF9AF1519B721CF">
