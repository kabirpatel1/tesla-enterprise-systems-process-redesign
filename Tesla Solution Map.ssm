			<process ID="359E5A2413864F7DBB86715F662054BB" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Help Desk" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E78263BE3C3640349A61DB36064AAB30">
				<!--#!#161616#!#-->
				<sap-cover>1</sap-cover>
				<title>Help Desk</title>
				<process-ref icon="technical-variant-ref.gif" ID="E7D5790882EC4E9C87BADFC94BAA1038" Ref="82A3C59294FE48BD9309D9E3EDEE" variantOf="8D63D7B03B854C0BAEAAC313E05FB3BE" OriginalMap="Automotive - Sales &amp; Service Organizations: IT Help Desk" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FE817B7201374A5CAA081AEB65A3E38F">
					<title>IT Help Desk</title>
				</process-ref>
				<process-ref icon="technical-variant-ref.gif" ID="EEE0179451D74353AC4629556460BC3B" Ref="AB7AAB5A5E8C435F9A117444E6EA" variantOf="8D63D7B03B854C0BAEAAC313E05FB3BE" OriginalMap="Automotive - Sales &amp; Service Organizations: Information Help Desk" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="120FFD69082C4BC3A6FFC290A2E9CC9C">
					<title>Information Help Desk</title>
				</process-ref>
				<short-description>Enables agents to assist customers with their queries concerning products or services and to resolve service issues using the solutions database, case management, and service requests.</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="FC56DE54D94A48ADB22C43C3ADB9C7AA" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A5A03257D5AE404F9617E4599BFC6710">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="DC94959485C64CDBB0757DD63701C5DB" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service and Support with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D62C39EAF83340AE8C2B545E18AC9632">
				<sap-cover>1</sap-cover>
				<title>Customer Service and Support with Interaction Center</title>
				<process-ref icon="process-ref.gif" ID="3C9495A1D4E04D7685A0150CD9104854" Ref="4B73C448DB7F482BA8F690D96F42" variantOf="307DD147AE1845EE95DF81062BE703C6" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Service and Support with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="542A9D956C62456D84311DD22A403FBA">
					<title>Customer Service and Support with Interaction Center</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Allows customer service agents to handle complaints, address customer concerns, answer technical questions, assist with returned materials, and make exchanges. Customers can be identified using the relevant partner information or data about their installed base. Agents use the solution database to search for a suitable solution for their customer’s problem, create service orders, determine existing contracts, and select products from proposals if needed.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="C80410EECE2F4CE4A8C6B122FE2ECE02" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4C4F315B8F1843AAA37E86C978F04101">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="A0A020B130914F4A86E8A3F1EE4F4B46" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Complaints Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="BCD4CF26B65847DE943CC7FFF5561133">
				<sap-cover>1</sap-cover>
				<title>Complaints Processing</title>
				<process-ref icon="process-ref.gif" ID="F3D5D9BFDC084A2DB692F58E085012BF" Ref="26A4C76C6E34443C9978D6E69DE5" variantOf="1F348B17245F4C45B8DE003F59E40F61" OriginalMap="Automotive - Sales &amp; Service Organizations: Complaints Processing with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="679D88D506FC4F9DA58D1440A451BBE2">
					<title>Complaints Processing with Interaction Center</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">Tracks established procedures for passing complaint information into the enterprise for resolution so that dissatisfied customers become satisfied customers and companies can plan and manage return material costs.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="E2E6D98927B64EF2BD19416F869AF0C6" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="375148E91558485CB52C03AE532B948A">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="BE5D131D48154DFDA18F9A8C1135C496" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: E-Mail Response Management with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="A293D4B66CED45BA8E51FD689C0D3F00">
				<sap-cover>1</sap-cover>
				<title>E-Mail Response Management with Interaction Center</title>
				<process-ref icon="process-ref.gif" ID="9EECB98EA4E74631A8EC003E56208EA5" Ref="17F3C040D02B8125E10000000A114AB6" variantOf="99508595595A43CF82A79F9E8DACABA4" OriginalMap="Automotive - Sales &amp; Service Organizations: E-Mail Response Management with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2EC593B36CFC454BBAD49986D52C61F1">
					<title>E-Mail Response Management with Interaction Center</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use this process to optimize, automate, and manage incoming e-mail handling in the Interaction Center (IC), thus reducing the overall time and cost associated with e-mail processing. Agents are provided with tools to ensure quick and consistent handling of e-mails, while managers are provided with tools to configure, administer, and evaluate the system.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="644B511F738D4298A5CD83A72BFA90E2" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="9FCB3E8A9504417DBA2D2F6A57EECA1B">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="82FE6FA0ED7E4A1187F31A310B182BC0" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Managing and Analyzing Interaction Center Operations" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="8DF57CD78E914F2088E8F49374A9454C">
				<sap-cover>1</sap-cover>
				<title>Managing and Analyzing Interaction Center Operations</title>
				<process-ref icon="process-ref.gif" ID="F43F692125804CDE8B5CE76EE4C77836" Ref="0559CBFF766641E0BBFB6A6CA195" variantOf="6E2C358B22B949F5A88DBB58DFACB6DB" OriginalMap="Automotive - Sales &amp; Service Organizations: Managing and Analyzing Interaction Center Operations" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="6C0A3C62DAC8490CB1B87F531192D86E">
					<title>Managing and Analyzing Interaction Center Operations</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You can use this business process to ensure smooth operations of your interaction center (IC). By monitoring and analyzing your IC, you can optimize operations, reduce costs, and ensure customer satisfaction.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="C3FB4AE622AD47CEA438C440C39410D1" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="095BD28A11654077B47FD2F10B1FB3CF">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="8B6F8B5468124860B303D800AC26DB4F" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Surveying Customers with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="3953B20F6AC74572BCEE750E691B2C8D">
				<sap-cover>1</sap-cover>
				<title>Surveying Customers with Interaction Center</title>
				<process-ref icon="process-ref.gif" ID="F3035C58DE0D4F609DA3C6A0565B5A17" Ref="B398C84AFEE14E9CA39843F90ADD1FA8" variantOf="42F296B36DF24BCBAE6A4657CE188452" OriginalMap="Automotive - Sales &amp; Service Organizations: Customer Information and Feedback with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4738DCF7D0D44D3BAE629ABE34F8A192">
					<title>Customer Information and Feedback with Interaction Center</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">You use this business process to contact your existing customer base and use this contact for purposes like validating account information or surveying customers about a specific topic (e.g. customer satisfaction). As a result, you improve the quality of your customer data, gather valuable insight about customer attitudes and perceptions and can also use the interaction to generate additional business or generate additional leads for your sales force or partners to follow up on. This leads to increased revenues and higher customer satisfaction.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="BBA9CD73A7DB4D0484252C05AE30D2A5" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="CD35968C13564DC2A3C787B888B34891">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<process ID="20DD0FAB35E743E9BE86F2BE6B0705C5" bprrefid="" OriginalMap="Automotive - Sales &amp; Service Organizations: Lead Processing" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="C2638A20DA794347BB4178F6004EF48A">
				<sap-cover>1</sap-cover>
				<title>Lead Processing</title>
				<process-ref icon="process-ref.gif" ID="97C879FF8C814BF59604890D130D182F" Ref="F1D908D887FD4224B974D2D0F06B9418" variantOf="4883C2523F844A08AEF20A136829ACB1" OriginalMap="Automotive - Sales &amp; Service Organizations: Lead Processing with Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FCA3C7B97D3D40CBB3AE8B87EC7C3A23">
					<title>Lead Processing with Interaction Center</title>
				</process-ref>
				<short-description>
					<P xmlns="http://www.w3.org/TR/REC-html40">This process enables manual and automatic qualification of leads to set the lead qualification level. Lead processing also includes the creation of orders-on-behalf or own orders from a lead.</P>
				</short-description>
				<product-ref Ref="6C3017B66D3543B5A937FAEADEE2A35F" ID="C56091E4FECB4D0BA79B15C033182326" type="SAP" key="SAP After Sales Support for Automotive" OriginalMap="Automotive - Sales &amp; Service Organizations: SAP Aftersales Support for Automotive" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E028E33FB24E4418AA505E500FAB0127">
					<title>SAP Aftersales Support for Automotive</title>
				</product-ref>
			</process>
			<bpr-element-ref ID="C5756E914BF84F81B9ED1B3C89FEBB3F" elementname="Scenario" Ref="urn:bprid#3049A7A2C691471681F0E4EC2A9EAB07" OriginalMap="Automotive - Sales &amp; Service Organizations: Interaction Center" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="68EE6757AB404EA7BAB91E911EC582FD">
				<title>Interaction Center</title>
			</bpr-element-ref>
			<business-objective-ref Ref="9DE313AAAD0F49C493CA7788334B973C" ID="624D2604255B4582B97138AC438F48FC" OriginalMap="Automotive - Sales &amp; Service Organizations: Better service levels" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="29D6C6B6B2544E5D939CBCE24ED2922E">
				<title>Better service levels</title>
			</business-objective-ref>
			<short-description>
				<p xmlns="http://www.w3.org/TR/REC-html40">This scenario supports
all direct customer and dealer communication via multiple channels,
such as email, telephone, SMS within an interaction center. The
scenario is automotive-specific and provides holisitc customer and
vehicle information as well as the relationships in between. Using
these capabilities companies can effectively manage marketing
campaigns, satisfaction surveys, complaints, appraisals, service
requests, roadside assistance, call backs, and accessory sales.
Users can search and display all customer and vehicle information
and manage business transactions, such as responses to complaints.
Consistent, reliable, and perosnalized communication proivdes a
unique customer experience call by call.</p>
			</short-description>
			<business-objective-ref Ref="BAB6BE504B794C1AA17558F1A444FE82" ID="50F7D835247E48B4A7BFD314011AFA93" OriginalMap="Automotive - Sales &amp; Service Organizations: Add 24x7 customer service" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="4CFE9A1EDC5043539DB8DBE6C033761F">
				<title>Add 24x7 customer service</title>
			</business-objective-ref>
