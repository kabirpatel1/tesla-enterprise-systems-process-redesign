				</process-ref>
				<process-ref Ref="AF27F54CF8024701A9BC2A391845" ID="294FF6E306D84BCA8CAB5CCCAC4FE65A" variantOf="D23B49C32221413BB5F222585DFF3FBE" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing in CRM" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="E13E66C9777D4901BA5EE342E0256EC6">
					<title>Service Order Processing in CRM</title>
				</process-ref>
				<process-ref Ref="DBB62957288F4E26879A0C4969A211DC" ID="4D22EAE9903141DD87B4DE6869D2E12F" variantOf="D23B49C32221413BB5F222585DFF3FBE" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing in ERP" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="2D4F9F3098D549A8A76CC09F2EBF4125">
					<title>Service Order Processing in ERP</title>
				</process-ref>
				<process-ref Ref="07AE393509BE48C386D571AFD68F" ID="D820F7839135411BB4930C4B10DFBB7C" variantOf="D23B49C32221413BB5F222585DFF3FBE" icon="technical-process-variant.gif" OriginalMap="Automotive - Sales &amp; Service Organizations: Service Order Processing with CRM Mobile Service for Handheld" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="FB84162F9328472792E109D69470DE66">
