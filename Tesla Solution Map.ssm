			</process>
			<process ID="26B977E1CD0944D9BAC3601127C0352B" businessArea="Sales" responsibleOrgUnit="CRM" runningNumber="CRM 131" variantOf="35B401CC52C140F58172E97A3F4AE18B" OriginalMap="Automotive - Sales &amp; Service Organizations: Sales Order Processing (Third Party Order Processing)" OriginalMapID="4737C4AEFF9E794E8ADFC17DF0FB88F8" SrcID="D3772148B60C4B24855E93442A86305D">
